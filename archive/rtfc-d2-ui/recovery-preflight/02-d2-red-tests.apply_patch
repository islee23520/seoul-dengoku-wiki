+            Assert.That(UguiHudBuilder.Find(surface.Root, "battle-end-turn"), Is.Null);
+            Assert.That(UguiHudBuilder.Find(surface.Root, "battle-move-n"), Is.Null);
+            Assert.That(UguiHudBuilder.Find(surface.Root, "battle-melee"), Is.Null);
