        "type": {
          "enum": [
            "number",
            "integer",
            "boolean",
            "string"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "object",
          "required": [
            "min",
            "max"
