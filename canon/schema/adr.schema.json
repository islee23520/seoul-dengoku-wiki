        },
        "document": {
          "type": "object",
          "required": [
            "id",
            "blockIds"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^doc\\.[A-Za-z0-9-]+$"
            },
            "blockIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "additionalProperties": false
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "locales/ko-KR/adr-003.json",
