{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gdd-doc.schema.json",
  "title": "GDD normalized document and domain collection",
  "description": "Shared structural contract for GDD domain collections and documents. J2 must dispatch checkSchema to $defs/collection or $defs/document, check path/domain/identity/source consistency and validateDocumentBlocks. Existing readCanonJson requires exact per-path oneOf titles and cannot load this generic schema. codeFence is intentionally schema-valid but renderDocument must reject it until J2 adds lossless rendering. A source excerpt is not a whole-file migration.",
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "inline": {
      "oneOf": [
        {
          "type": "object", "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string", "minLength": 1, "pattern": "^[^\r\n]+$" }
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["kind", "text", "href"],
          "properties": {
            "kind": { "const": "link" },
            "text": { "type": "string", "minLength": 1 },
            "href": { "type": "string", "minLength": 1 }
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["kind", "text", "targetDocumentId"],
          "properties": {
            "kind": { "const": "docLink" },
            "text": { "type": "string", "minLength": 1 },
            "targetDocumentId": { "type": "string", "pattern": "^doc\\.[A-Za-z0-9-]+$" }
          }, "additionalProperties": false
        }
      ]
    },
    "cell": { "type": "string", "minLength": 1, "pattern": "^[^|\r\n]+$" },
    "block": {
      "oneOf": [
        {
          "type": "object", "required": ["id", "kind", "level", "inlines"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "kind": { "const": "heading" },
            "level": { "enum": [1, 2, 3, 4] },
            "inlines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inline" } }
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["id", "kind", "inlines"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "kind": { "const": "paragraph" },
            "inlines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inline" } }
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["id", "kind", "ordered", "items"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "kind": { "const": "list" },
            "ordered": { "enum": [true, false] },
            "items": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inline" } } }
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["id", "kind", "header", "rows"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "kind": { "const": "table" },
            "header": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cell" } },
            "rows": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cell" } } }
          }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["id", "kind", "fence", "info", "text"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "kind": { "const": "codeFence" },
            "fence": { "type": "string", "pattern": "^`{3,}$" },
            "info": { "type": "string", "pattern": "^[^`\\r\\n]*$" },
            "text": { "type": "string" }
          }, "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object", "required": ["path", "lineStart", "lineEnd", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?:(?:rules|architecture|references|proposals|system-design|art)/[A-Za-z0-9-]+(?:/[A-Za-z0-9-]+)*|[A-Za-z0-9-]+)\\.md$" },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }, "additionalProperties": false
    },
    "entry": {
      "type": "object", "required": ["id", "path", "locale", "status", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^doc\\.[A-Za-z0-9-]+$" },
        "path": { "type": "string", "pattern": "^locales/ko-KR/(?:rules|architecture|references|root|proposals|system-design|art)/[A-Za-z0-9-]+\\.json$" },
        "locale": { "const": "ko-KR" },
        "status": { "enum": ["accepted", "proposal", "retired"] },
        "source": { "$ref": "#/$defs/source" }
      }, "additionalProperties": false
    },
    "collection": {
      "type": "object", "required": ["schemaVersion", "domain", "locale", "documents"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "domain": { "enum": ["rules", "architecture", "references", "root", "proposals", "system-design", "art"] },
        "locale": { "const": "ko-KR" },
        "documents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
      }, "additionalProperties": false
    },
    "document": {
      "type": "object", "required": ["schemaVersion", "locale", "status", "source", "document", "blocks"],
      "properties": {
        "schemaVersion": { "const": 1 }, "locale": { "const": "ko-KR" },
        "status": { "enum": ["accepted", "proposal", "retired"] },
        "source": { "$ref": "#/$defs/source" },
        "document": {
          "type": "object", "required": ["id", "blockIds"],
          "properties": {
            "id": { "type": "string", "pattern": "^doc\\.[A-Za-z0-9-]+$" },
            "blockIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
          }, "additionalProperties": false
        },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
      }, "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/collection" },
    { "$ref": "#/$defs/document" }
  ]
}
