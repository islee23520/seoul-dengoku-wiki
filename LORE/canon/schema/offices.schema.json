{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offices.schema.json",
  "title": "Offices-and-Ranks canon (offices-only pilot)",
  "description": "Structural contract for LORE/canon/{tables/office-tiers,relations/state-office-titles,locales/ko-KR/offices-and-ranks}.json. FK, cardinality and document-order integrity are enforced by TOOL/tools/wiki/offices-canon.mjs, not by this schema.",
  "$defs": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "inline": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "text"],
          "properties": { "kind": { "const": "text" }, "text": { "type": "string", "minLength": 1, "pattern": "^[^\\n\\r]+$" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "text", "href"],
          "properties": {
            "kind": { "const": "link" },
            "text": { "type": "string", "minLength": 1, "pattern": "^[^\\n\\r]+$" },
            "href": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "cell": { "type": "string", "minLength": 1, "pattern": "^[^|\\n\\r]+$" },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "kind", "level", "inlines"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "heading" },
            "level": { "enum": [1, 2, 3] },
            "inlines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inline" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "kind", "inlines"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "paragraph" },
            "inlines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inline" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "kind", "header"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "table" },
            "header": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cell" } },
            "rows": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/cell" } } },
            "source": { "const": "state-office-titles" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "title": "tables/office-tiers.json",
      "type": "object",
      "required": ["schemaVersion", "rows"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "order"],
            "properties": { "id": { "pattern": "^T[1-9][0-9]*$" }, "order": { "type": "integer", "minimum": 1 } },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "relations/state-office-titles.json",
      "type": "object",
      "required": ["schemaVersion", "rows"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stateId", "tierId", "titleKey"],
            "properties": {
              "stateId": { "pattern": "^S[0-9]{2}$" },
              "tierId": { "pattern": "^T[1-9][0-9]*$" },
              "titleKey": { "$ref": "#/$defs/id" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "locales/ko-KR/offices-and-ranks.json",
      "type": "object",
      "required": ["schemaVersion", "locale", "texts", "document", "blocks"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "locale": { "const": "ko-KR" },
        "texts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/cell" } },
            "additionalProperties": false
          }
        },
        "document": {
          "type": "object",
          "required": ["id", "blockIds"],
          "properties": { "id": { "$ref": "#/$defs/id" }, "blockIds": { "type": "array", "items": { "$ref": "#/$defs/id" } } },
          "additionalProperties": false
        },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      },
      "additionalProperties": false
    }
  ]
}
