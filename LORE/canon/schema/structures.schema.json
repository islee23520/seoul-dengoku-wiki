{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structures.schema.json",
  "title": "Structures canon (second JSON-canon domain)",
  "description": "Structural contract for LORE/canon/{tables/documents,tables/structure-kinds,relations/structure-kind-details,locales/ko-KR/structures}.json. Shared definitions are intentionally duplicated from offices.schema.json (no cross-file $ref). FK, cardinality, path and document-order integrity are enforced by TOOL/tools/wiki/structures-canon.mjs, not by this schema.",
  "$defs": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "docId": {
      "type": "string",
      "pattern": "^doc\\.[A-Za-z0-9-]+$"
    },
    "inline": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\n\\r]+$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "text",
            "href"
          ],
          "properties": {
            "kind": {
              "const": "link"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\n\\r]+$"
            },
            "href": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "text",
            "targetDocumentId"
          ],
          "properties": {
            "kind": {
              "const": "docLink"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\n\\r]+$"
            },
            "targetDocumentId": {
              "$ref": "#/$defs/docId"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "cell": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^|\\n\\r]+$"
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "level",
            "inlines"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "heading"
            },
            "level": {
              "enum": [
                1,
                2,
                3
              ]
            },
            "inlines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "inlines"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "paragraph"
            },
            "inlines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "header"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "const": "table"
            },
            "header": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/cell"
              }
            },
            "source": {
              "const": "structure-kinds"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "title": "tables/documents.json",
      "type": "object",
      "required": [
        "schemaVersion",
        "rows"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/schemaVersion"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/docId"
              },
              "path": {
                "type": "string",
                "pattern": "^[a-z-]+/[A-Za-z0-9-]+\\.md$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "tables/structure-kinds.json",
      "type": "object",
      "required": [
        "schemaVersion",
        "rows"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/schemaVersion"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "order"
            ],
            "properties": {
              "id": {
                "pattern": "^structure\\.[a-z]+$"
              },
              "order": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "relations/structure-kind-details.json",
      "type": "object",
      "required": [
        "schemaVersion",
        "rows"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/schemaVersion"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kindId",
              "docId",
              "textKey"
            ],
            "properties": {
              "kindId": {
                "pattern": "^structure\\.[a-z]+$"
              },
              "docId": {
                "$ref": "#/$defs/docId"
              },
              "textKey": {
                "$ref": "#/$defs/id"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "locales/ko-KR/structures.json",
      "type": "object",
      "required": [
        "schemaVersion",
        "locale",
        "texts",
        "document",
        "blocks"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/schemaVersion"
        },
        "locale": {
          "const": "ko-KR"
        },
        "texts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "$ref": "#/$defs/cell"
              }
            },
            "additionalProperties": false
          }
        },
        "document": {
          "type": "object",
          "required": [
            "id",
            "blockIds"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/docId"
            },
            "blockIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "additionalProperties": false
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
