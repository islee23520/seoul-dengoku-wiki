{
  "schema": "cpa-style-profile.v1",
  "id": "shared-target-drawing-v2",
  "compiler": "shared-style-cpa-training.v1",
  "axes": [
    {
      "axis": "lineEdge",
      "keep": "Dark, controlled silhouette and hair edges; lighter economical nose, lip, eyelid and garment interior marks.",
      "drop": "Uniform thick comic outlines, sketchy doubled edges, or blurred silhouette."
    },
    {
      "axis": "colorPlane",
      "keep": "Matte restrained brown/navy/olive color fields, clear cheek and garment planes, limited soft skin transitions. Not pure flat vector.",
      "drop": "Photographic skin modeling, glossy plastic skin, saturated candy palette, or soft airbrush replacing plane boundaries."
    },
    {
      "axis": "shadow",
      "keep": "Connected angular jaw/neck shadow groups and broad cloth folds; small nose shadow and restrained cheek transitions.",
      "drop": "Many tiny modeled folds, cinematic rim lighting, or shadows that erase the broad grouping."
    },
    {
      "axis": "faceAbstraction",
      "keep": "Economical nose and mouth marks, defined brows and stylized irises, angular jaw; local stubble and age marks remain subordinate.",
      "drop": "Photoreal pores/individual lash rendering, enlarged glossy anime eyes, or generic face substitution."
    },
    {
      "axis": "texture",
      "keep": "Grouped hair ribbons/clumps with a few loose strands; quiet cloth fields. K1009 straps/radio are content-specific detail, not a license for global fabric weave.",
      "drop": "Hair rendered as dense luminous threads; pervasive woven grain, painterly noise, or material detail dominating the face."
    }
  ],
  "roleExclusions": [
    "No exemplar face, baldness, bob cut, eye color, clothing, straps, glasses, pose, framing or background transfer",
    "Muted palette is a rendering rubric, not authority to override authored content colors",
    "No same-face requirement across genders; no literal jaw/face proportion replacement in the name of abstraction"
  ],
