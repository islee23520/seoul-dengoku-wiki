# Each user runs this service on their own computer. No GitHub setup is required.
PORTAL_MODE=local
PORTAL_BASE_PATH=/tools
PORTAL_HOST=127.0.0.1
PORTAL_PORT=18765
# Opt-in one machine-owner workspace on one owned RFC1918 LAN or 100.64/10 IP.
# No wildcard binds. Default stays loopback; network clients share owner 1.
PORTAL_NETWORK_ACCESS=false
# Optional exact lowercase name, e.g. dengoku-tools.local; not DNS provisioning.
# Leave unset when disabled. mDNS only supports a selected LAN IP on macOS.
# PORTAL_LOCAL_HOSTNAME=dengoku-tools.local
PORTAL_MDNS=false
WIKI_BASE_URL=https://seoul-dengoku.linalab.io/wiki/
# Empty uses the native user home: ~/.seoul-dengoku-tools/portal
PORTAL_STORAGE_PATH=
PORTAL_ORIGINALS_DB=
PORTAL_TEMPLATE_MANIFEST=
PORTAL_TEMPLATE_PINS=
# Personal HTTPS alternative (replace PORTAL_MODE/host/port/storage above).
# PORTAL_MODE=personal
# PORTAL_PUBLIC_URL=https://sss.linalab.io/tools
# PORTAL_OWNER_EMAIL=lysk9884@gmail.com
# PORTAL_ACCESS_ISSUER=https://linalab.cloudflareaccess.com
# Set the dedicated owner-only Access application's AUD; no shared-app fallback.
# PORTAL_ACCESS_AUDIENCE=
# PORTAL_SESSION_SECRET=
# PORTAL_HOST=0.0.0.0
# PORTAL_PORT=18765
# PORTAL_STORAGE_PATH=/private
# PORTAL_TEMPLATE_MANIFEST=/inputs/template-manifest.json
# PORTAL_TEMPLATE_PINS=/inputs/template-pins.json
# Optional personal-only server provider: supply both privately or leave both unset.
# Authenticated owner sessions bind independently without entering credentials.
# PORTAL_PERSONAL_PROVIDER_URL=http://127.0.0.1:18317/v1
# PORTAL_PERSONAL_PROVIDER_KEY=
# No ambient OpenAI/CLIProxy fallback. Local and hosted modes ignore this pair.
# Docker host publication must be 127.0.0.1:18765 only; origin HTTP stays private.
# Historical hosted mode only: PORTAL_MODE=hosted plus explicit HTTPS public URL,
# session secret and GitHub OAuth configuration. Not needed for local use.
# Provider URL/key are entered explicitly in the local UI and held only in memory.
PORTAL_MCP_ENDPOINTS=[]
PORTAL_MAX_STORAGE_BYTES=536870912
# Optional overrides; release defaults are relative to dist/server.mjs, not current directory.
PORTAL_PUBLIC_PATH=
PORTAL_TOKENS_PATH=
