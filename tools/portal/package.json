{
	"name": "seoul-dengoku-tools-portal",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"ssstool": "dist/cli.mjs",
		"tools-portal": "dist/cli.mjs",
		"tools-portal-mcp": "dist/mcp.mjs"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"test": "bun test --preload ./test/local-ai-test-setup.ts",
		"typecheck": "tsc --noEmit",
