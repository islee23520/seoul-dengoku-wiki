{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seoul-dengoku.local/schema/character-look.v1.json",
  "title": "Portrait and full-body character record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "characterId",
    "name"
  ],
  "properties": {
    "faceMode": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "face-selection.schema.json#/$defs/faceMode"
        }
      ]
    },
    "faceSelection": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "face-selection.schema.json#/$defs/faceSelection"
        }
      ]
    },
    "uniqueFaceRequired": {
      "type": "boolean"
    },
    "uniqueFaceSource": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "face-selection.schema.json#/$defs/uniqueFaceSource"
        }
      ]
    },
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "characterId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "sourceStatus": {
      "enum": [
        "authored-draft",
        "art-proposal",
        "approved"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "lookId": {
      "type": "string",
      "minLength": 1
    },
    "variantId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "mood": {
      "type": "string",
      "minLength": 1
    },
    "occupation": {
      "type": "string",
      "minLength": 1
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ageCategory",
        "gender",
        "face",
        "hair",
        "eyes",
        "skin",
        "build"
      ],
      "properties": {
        "ageCategory": {
          "enum": [
            "adult",
            "minor"
          ]
        },
        "gender": {
          "type": "string",
          "minLength": 1
        },
        "face": {
          "$ref": "#/$defs/trait"
        },
        "hair": {
          "$ref": "#/$defs/trait"
        },
        "eyes": {
          "$ref": "#/$defs/trait"
        },
        "skin": {
          "$ref": "#/$defs/trait"
        },
        "build": {
          "$ref": "#/$defs/trait"
        }
      }
    },
    "outfit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "headwear",
        "upper",
        "lower",
        "footwear",
        "marks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "headwear": {
          "$ref": "#/$defs/trait"
        },
        "upper": {
          "$ref": "#/$defs/trait"
        },
        "lower": {
          "$ref": "#/$defs/trait"
        },
        "footwear": {
          "$ref": "#/$defs/trait"
        },
        "marks": {
          "$ref": "#/$defs/trait"
        }
      }
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equipped",
        "narrativeOnly"
      ],
      "properties": {
        "equipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "narrativeOnly": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portrait",
        "full-body"
      ],
      "properties": {
        "portrait": {
          "type": "string",
          "minLength": 1
        },
        "full-body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "face": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "$ref": "#/$defs/slotTrait"
            },
            "faceShape": {
              "$ref": "#/$defs/slotTrait"
            },
            "eyeColor": {
              "$ref": "#/$defs/slotTrait"
            },
            "eyeShape": {
              "$ref": "#/$defs/slotTrait"
            },
            "eyebrowShape": {
              "$ref": "#/$defs/slotTrait"
            },
            "lipColor": {
              "$ref": "#/$defs/slotTrait"
            },
            "mouthShape": {
              "$ref": "#/$defs/slotTrait"
            },
            "noseShape": {
              "$ref": "#/$defs/slotTrait"
            },
            "beardShape": {
              "$ref": "#/$defs/slotTrait"
            }
          }
        },
        "hair": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "$ref": "#/$defs/slotTrait"
            },
            "shape": {
              "$ref": "#/$defs/slotTrait"
            },
            "color": {
              "$ref": "#/$defs/slotTrait"
            },
            "length": {
              "$ref": "#/$defs/slotTrait"
            }
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "build": {
              "$ref": "#/$defs/slotTrait"
            },
            "weight": {
              "$ref": "#/$defs/measurementTrait"
            },
            "bustSize": {
              "$ref": "#/$defs/slotTrait"
            },
            "height": {
              "$ref": "#/$defs/measurementTrait"
            },
            "skin": {
              "$ref": "#/$defs/slotTrait"
            }
          }
        },
        "outfit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headwear": {
              "$ref": "#/$defs/slotTrait"
            },
            "upper": {
              "$ref": "#/$defs/slotTrait"
            },
            "lower": {
              "$ref": "#/$defs/slotTrait"
            },
            "footwear": {
              "$ref": "#/$defs/slotTrait"
            },
            "marks": {
              "$ref": "#/$defs/slotTrait"
            },
            "neckline": {
              "$ref": "#/$defs/slotTrait"
            }
          }
        },
        "accessories": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "$ref": "#/$defs/slotTrait"
            },
            "shape": {
              "$ref": "#/$defs/slotTrait"
            },
            "color": {
              "$ref": "#/$defs/slotTrait"
            },
            "material": {
              "$ref": "#/$defs/slotTrait"
            },
            "mounting": {
              "$ref": "#/$defs/slotTrait"
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characterId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "personId": {
          "type": "string"
        },
        "ethnicity": {
          "$ref": "#/$defs/slotTrait"
        },
        "origin": {
          "$ref": "#/$defs/slotTrait"
        },
        "gender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/slotTrait"
            }
          ]
        },
        "ageCategory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/slotTrait"
            }
          ]
        },
        "age": {
          "type": "integer",
          "minimum": 0
        },
        "ageAsOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "personId": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval": {
      "enum": [
        "authored-draft",
        "art-proposal",
        "approved"
      ]
    },
    "canonicalContext": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "characterId",
            "name",
            "personId",
            "registry",
            "background"
          ],
          "properties": {
            "characterId": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "personId": {
              "type": "string",
              "minLength": 1
            },
            "registry": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "pointer",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^$|^/"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "background": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "pointer",
                  "sha256",
                  "text"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pointer": {
                    "type": "string",
                    "pattern": "^$|^/"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "birthContext": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "birthDate",
            "age",
            "ageAsOf",
            "source"
          ],
          "properties": {
            "birthDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "age": {
              "type": "integer",
              "minimum": 0
            },
            "ageAsOf": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gender": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "ethnicity": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "ageCategory": {
          "type": "string"
        },
        "rank": {
          "type": "string"
        },
        "genderUserLocked": {
          "type": "boolean"
        }
      }
    },
    "artProposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headwear": {
          "type": [
            "string",
            "null"
          ]
        },
        "slots": {
          "$ref": "#/properties/slots"
        },
        "face": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "hair": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "upper": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "lower": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "footwear": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "ethnicity": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "origin": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "build": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "eyes": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "skin": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "eyeColor": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "hairShape": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "hairColor": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "bustSize": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "weight": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "height": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "approvedAppearance": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedOutfit": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedEquipmentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approvalNote": {
          "type": "string"
        },
        "accessories": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "outfit": {
          "type": "string"
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "carriedWeapons": {
          "type": "string"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identityRole": {
          "type": "string"
        },
        "identitySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "generationOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gender": {
          "type": "string",
          "minLength": 1
        },
        "ageCategory": {
          "type": "string",
          "minLength": 1
        },
        "mood": {
          "type": "string",
          "minLength": 1
        },
        "occupation": {
          "type": "string",
          "minLength": 1
        },
        "hair": {
          "type": "string",
          "minLength": 1
        },
        "upper": {
          "type": "string",
          "minLength": 1
        },
        "variantId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stateId": {
      "type": [
        "string",
        "null"
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "styleId": {
          "type": "string"
        },
        "referenceSha256": {
          "type": "string"
        },
        "portraitShotId": {
          "type": "string"
        },
        "crop": {
          "type": "string"
        },
        "referenceRole": {
          "type": "string"
        }
      }
    },
    "imageReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record": {
          "type": "string"
        },
        "imageSha256": {
          "type": "string"
        },
        "verdict": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "generationContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "portraitShotId": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "camera": {
          "type": "string"
        },
        "pose": {
          "type": "string"
        },
        "styleReferenceRole": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "background": {
          "type": "string"
        }
      }
    },
    "imageSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "trait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "source"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "authored-draft",
            "art-proposal",
            "approved",
            "unknown"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "string"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "status",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "authored-draft",
            "art-proposal",
            "approved"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "slotTrait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "source"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "approved",
            "authored-draft",
            "art-proposal",
            "derived-proposal",
            "unknown"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "derived": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "string"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "derived-proposal"
              }
            }
          },
          "then": {
            "required": [
              "derived"
            ],
            "properties": {
              "derived": {
                "const": true
              },
              "source": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          "else": {
            "properties": {
              "derived": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  null,
                  "unconfirmed"
                ]
              },
              "source": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "source": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "measurementTrait": {
      "allOf": [
        {
          "$ref": "#/$defs/slotTrait"
        },
        {
          "if": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          },
          "then": {
            "required": [
              "unit"
            ],
            "properties": {
              "unit": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "unit"
            ],
            "properties": {
              "unit": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "appearance"
        ]
      },
      "then": {
        "required": [
          "sourceStatus",
          "lookId",
          "appearance",
          "outfit",
          "equipment",
          "pose"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      }
    }
  ]
}
