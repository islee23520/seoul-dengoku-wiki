{
	"name": "portrait-generator-preflight",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"portrait-generator": "dist/cli.js"
	},
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist/*.js",
		"README.md",
		"install.sh",
		"install.ps1"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "bun test",
		"build": "tsc -p tsconfig.build.json && bun run build:node-cli",
		"build:node-cli": "bun build src/cli.ts --target node --define import.meta.main=false --outfile dist/cli.js",
		"compile": "bun build src/cli.ts --compile --outfile dist/portrait-generator",
		"compile:installer": "bun build src/install-cli.ts --compile --outfile dist/portrait-install"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.2",
		"@types/node": "26.6.5",
		"portrait-acceptance": "file:../acceptance",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"zod": "4.6.5"
	}
}
