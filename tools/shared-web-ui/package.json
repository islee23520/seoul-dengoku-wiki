{
  "name": "@seoul-dengoku/shared-web-ui",
  "version": "0.1.2",
  "type": "module",
  "sideEffects": ["./dist/tokens.css", "./dist/styles.css"],
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run",
    "build": "bun build ./src/index.jsx --target browser --external react --outdir dist && cp src/styles.css src/tokens.css src/index.d.ts dist/"
  },
  "peerDependencies": { "react": "^18.3.1 || ^19.0.0" },
  "devDependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vitest": "5.1.0"
  }
}
