                            <ui:VisualElement name="battle-cell-11-6" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-0-7" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-1-7" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-2-7" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-3-7" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-4-7" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-5-7" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-6-7" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-7-7" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-8-7" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-9-7" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-10-7" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-11-7" class="jk-grid-cell" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:ScrollView name="battle-log" class="jk-log jk-panel">
                        <ui:Label class="jk-section" text="전투 기록" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="settlement-panel" class="jk-panel">
                    <ui:Label class="jk-section" text="정산" />
                    <ui:Label name="settlement-outcome" class="jk-body" text="" />
                    <ui:Button name="action-settle" class="jk-button jk-button--primary" text="정산 적용" focusable="true" />
                    <ui:Button name="return-action" class="jk-button jk-button--primary" text="복귀" focusable="true" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
