                            <ui:VisualElement name="battle-cell-9-4" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-10-4" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-11-4" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-0-5" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-1-5" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-2-5" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-3-5" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-4-5" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-5-5" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-6-5" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-7-5" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-8-5" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-9-5" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-10-5" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-11-5" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-0-6" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-1-6" class="jk-grid-cell" />
                            <ui:VisualElement name="battle-cell-2-6" class="jk-grid-cell" />
