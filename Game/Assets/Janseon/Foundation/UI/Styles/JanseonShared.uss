/* Design.md tokens — shared primitives. Dual-resolution via jk-res-720 / jk-res-1080. */
:root {
    --bg-void: rgb(11, 17, 28);
    --bg-panel: rgb(20, 28, 42);
    --bg-panel-raised: rgb(27, 37, 54);
    --bg-well: rgb(14, 22, 34);
    --stroke-quiet: rgb(42, 53, 72);
    --stroke-focus: rgb(201, 162, 39);
    --stroke-danger: rgb(139, 58, 58);
    --text-primary: rgb(230, 234, 240);
    --text-secondary: rgb(154, 166, 178);
    --text-muted: rgb(107, 118, 132);
    --accent-line: rgb(61, 126, 166);
    --accent-safe: rgb(63, 107, 84);
    --accent-talk: rgb(91, 107, 138);
    --accent-fight: rgb(139, 74, 58);
    --signal-live: rgb(201, 162, 39);
    --grid-line: rgb(36, 48, 68);
    --ally-cell: rgb(42, 74, 92);
    --foe-cell: rgb(92, 42, 42);
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 16px;
    --space-4: 24px;
    --space-5: 40px;
    --radius-sm: 2px;
    --radius-md: 4px;
    --route-width: 360px;
    --hud-width: 280px;
    --log-width: 280px;
    --cell-size: 64px;
    --rail-min-height: 64px;
    --type-display: 36px;
    --type-title: 24px;
    --type-section: 18px;
    --type-body: 15px;
    --type-caption: 12px;
    --display-tracking: 0.72px;
    --focus-w: 2px;
    --title-start-min-width: 200px;
    --title-start-min-height: 40px;
    --settlement-max-width: 520px;
}

.jk-res-720 {
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 16px;
    --space-4: 24px;
    --space-5: 40px;
    --radius-sm: 2px;
    --radius-md: 4px;
    --route-width: 360px;
    --hud-width: 280px;
    --log-width: 280px;
    --cell-size: 64px;
    --rail-min-height: 64px;
    --type-display: 36px;
    --type-title: 24px;
    --type-section: 18px;
    --type-body: 15px;
    --type-caption: 12px;
    --display-tracking: 0.72px;
    --focus-w: 2px;
    --title-start-min-width: 200px;
    --title-start-min-height: 40px;
    --settlement-max-width: 520px;
}

.jk-res-1080 {
    --space-1: 6px;
    --space-2: 12px;
    --space-3: 24px;
    --space-4: 36px;
    --space-5: 56px;
    --radius-sm: 3px;
    --radius-md: 6px;
    --route-width: 540px;
    --hud-width: 420px;
    --log-width: 420px;
    --cell-size: 96px;
    --rail-min-height: 96px;
    --type-display: 48px;
    --type-title: 32px;
    --type-section: 22px;
    --type-body: 18px;
    --type-caption: 14px;
    --display-tracking: 0.96px;
    --focus-w: 3px;
    --title-start-min-width: 280px;
    --title-start-min-height: 52px;
    --settlement-max-width: 780px;
}

.jk-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--bg-void);
    color: var(--text-primary);
    padding: var(--space-4);
}

.jk-panel {
    background-color: var(--bg-panel);
    border-color: var(--stroke-quiet);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: var(--space-3);
}

.jk-button {
    background-color: var(--bg-panel-raised);
    border-color: var(--stroke-quiet);
    border-width: 1px;
    border-radius: var(--radius-md);
    color: var(--text-primary);
    padding: 10px 18px;
    margin: 4px 0;
    font-size: var(--type-body);
    unity-font-style: normal;
    white-space: normal;
    overflow: hidden;
}

.jk-button:hover {
    background-color: var(--bg-panel);
    border-color: var(--accent-line);
}

.jk-button:focus,
.jk-button.jk-focused {
    border-color: var(--stroke-focus);
    border-width: 2px;
}

.jk-res-1080 .jk-button:focus,
.jk-res-1080 .jk-button.jk-focused {
    border-width: 3px;
}

.jk-button:disabled {
    color: var(--text-muted);
    border-color: var(--stroke-quiet);
}

.jk-button--primary {
    border-bottom-width: 2px;
    border-bottom-color: var(--accent-line);
}

.jk-button--primary:focus,
.jk-button--primary.jk-focused {
    border-bottom-color: var(--accent-line);
}

.jk-button.jk-button--danger {
    border-color: var(--accent-fight);
}

.jk-chip {
    background-color: var(--bg-well);
    border-color: var(--stroke-quiet);
    border-width: 1px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    padding: 6px 10px;
    margin: 0 4px;
    font-size: var(--type-caption);
    white-space: normal;
    overflow: hidden;
}

.jk-chip--current {
    color: var(--text-primary);
    border-bottom-width: 2px;
    border-bottom-color: var(--signal-live);
}

.jk-chip--done {
    color: var(--text-muted);
}

.jk-card {
    background-color: var(--bg-panel);
    border-color: var(--stroke-quiet);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: 12px 16px;
    margin: 6px 0;
    color: var(--text-primary);
    white-space: normal;
    overflow: hidden;
    max-height: 72px;
}

.jk-card:focus {
    border-color: var(--stroke-focus);
    border-width: 2px;
}

.jk-rail {
    flex-direction: row;
    align-items: center;
    background-color: var(--bg-panel);
    border-color: var(--stroke-quiet);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: var(--space-2);
    margin-bottom: var(--space-3);
    min-height: var(--rail-min-height);
    height: var(--rail-min-height);
}

.jk-route {
    flex-direction: column;
    background-color: var(--bg-panel);
    border-color: var(--stroke-quiet);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: 12px;
    width: var(--route-width);
    min-width: var(--route-width);
    max-width: var(--route-width);
}

.jk-route-node {
    background-color: var(--bg-well);
    border-color: var(--stroke-quiet);
    border-width: 1px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    padding: 8px 12px;
    margin: 4px 0;
    font-size: var(--type-body);
    white-space: normal;
    overflow: hidden;
}

.jk-route-node--current {
    color: var(--text-primary);
    border-color: var(--signal-live);
    border-left-width: 3px;
    border-left-color: var(--accent-line);
}

.jk-route-node--dim {
    color: var(--text-muted);
}

.jk-grid {
    flex-direction: column;
    background-color: var(--bg-well);
    border-color: var(--grid-line);
    border-width: 1px;
    padding: 4px;
}

.jk-grid-row {
    flex-direction: row;
}

.jk-grid-cell {
    width: var(--cell-size);
    height: var(--cell-size);
    min-width: var(--cell-size);
    min-height: var(--cell-size);
    max-width: var(--cell-size);
    max-height: var(--cell-size);
    margin: 2px;
    background-color: var(--bg-panel);
    border-color: var(--grid-line);
    border-width: 1px;
    align-items: center;
    justify-content: center;
    font-size: var(--type-caption);
    color: var(--text-secondary);
}

.jk-grid-cell--ally {
    background-color: var(--ally-cell);
    color: var(--text-primary);
}

.jk-grid-cell--foe {
    background-color: var(--foe-cell);
    color: var(--text-primary);
}

.jk-meter {
    height: 12px;
    min-height: 12px;
    background-color: var(--bg-well);
    border-color: var(--stroke-quiet);
    border-width: 1px;
    border-radius: var(--radius-sm);
    margin: 4px 0 10px 0;
    overflow: hidden;
    flex-direction: row;
}

.jk-meter__fill {
    height: 100%;
    width: 0;
    min-width: 0;
    background-color: var(--accent-line);
}

.jk-meter__fill--hp {
    background-color: var(--accent-safe);
}

.jk-meter__fill--ap {
    background-color: var(--accent-line);
}

.jk-log {
    width: var(--log-width);
    min-width: var(--log-width);
    max-width: var(--log-width);
    margin-left: 12px;
    flex-grow: 1;
}

.jk-log-entry {
    color: var(--text-secondary);
    font-size: var(--type-caption);
    margin: 2px 0;
    white-space: normal;
    overflow: hidden;
}

.jk-meta {
    color: var(--text-muted);
    font-size: var(--type-caption);
    margin-top: 4px;
    white-space: normal;
}

.jk-body {
    font-size: var(--type-body);
    color: var(--text-primary);
    white-space: normal;
    overflow: hidden;
    letter-spacing: 0;
}

.jk-title {
    font-size: var(--type-title);
    color: var(--text-primary);
    margin-bottom: 8px;
    white-space: normal;
    overflow: hidden;
}

.jk-display {
    font-size: var(--type-display);
    color: var(--text-primary);
    margin-bottom: 12px;
    letter-spacing: var(--display-tracking);
    white-space: normal;
    overflow: hidden;
}

.jk-section {
    font-size: var(--type-section);
    color: var(--text-primary);
    margin-bottom: 8px;
    white-space: normal;
    overflow: hidden;
}

.jk-cjk {
    white-space: normal;
    overflow: hidden;
    text-overflow: clip;
}

.jk-hidden {
    display: none;
}

.jk-motion-off {
    transition-duration: 0s;
}
