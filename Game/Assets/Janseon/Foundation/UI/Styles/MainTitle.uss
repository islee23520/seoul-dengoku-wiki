/* MainTitle layout — Design.md §5.1 */
#main-title-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgb(11, 17, 28);
    padding: var(--space-5);
}

#main-title-mark {
    font-size: var(--type-display);
    color: rgb(230, 234, 240);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
    letter-spacing: var(--display-tracking);
    white-space: normal;
    overflow: hidden;
    max-width: 640px;
}

#main-title-sub {
    font-size: var(--type-body);
    color: rgb(154, 166, 178);
    margin-bottom: 28px;
    -unity-text-align: middle-center;
    max-width: 420px;
    white-space: normal;
    overflow: hidden;
    letter-spacing: 0;
}

#main-title-start {
    min-width: var(--title-start-min-width);
    min-height: var(--title-start-min-height);
    -unity-text-align: middle-center;
}

.main-title-fold {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 18%;
    height: 2px;
    background-color: rgb(42, 53, 72);
}
