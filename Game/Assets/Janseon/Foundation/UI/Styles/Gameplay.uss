/* Gameplay layout — Design.md §3 / §5.2. Sizes come from jk-res-* tokens. */
#gameplay-root {
    flex-grow: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgb(11, 17, 28);
    padding: var(--space-4);
}

#stage-rail {
    margin-bottom: var(--space-3);
    min-height: var(--rail-min-height);
    height: var(--rail-min-height);
}

#gameplay-body {
    flex-grow: 1;
    flex-direction: row;
}

#route-rail {
    width: var(--route-width);
    min-width: var(--route-width);
    max-width: var(--route-width);
    margin-right: var(--space-3);
}

#gameplay-detail {
    flex-grow: 1;
    flex-direction: column;
}

#encounter-choices {
    flex-direction: column;
}

#choice-negotiate {
    border-left-width: 3px;
    border-left-color: rgb(91, 107, 138);
}

#choice-bypass {
    border-left-width: 3px;
    border-left-color: rgb(63, 107, 84);
}

#choice-combat {
    border-left-width: 3px;
    border-left-color: rgb(139, 74, 58);
}

#battle-row {
    flex-direction: row;
    flex-grow: 1;
}

#battle-hud {
    width: var(--hud-width);
    min-width: var(--hud-width);
    max-width: var(--hud-width);
    margin-right: 12px;
}

#battle-grid {
    flex-grow: 0;
}

#battle-log {
    width: var(--log-width);
    min-width: var(--log-width);
    max-width: var(--log-width);
}

#settlement-panel {
    max-width: var(--settlement-max-width);
    align-self: center;
    margin-top: 24px;
}

#settlement-outcome {
    min-height: 24px;
    margin-bottom: 8px;
    white-space: normal;
    overflow: hidden;
}

#return-action {
    min-width: 160px;
    margin-top: 12px;
}

.jk-slot-footer {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-top: var(--space-2);
}

.jk-slot-icons {
    flex-direction: row;
    align-items: center;
}

.jk-slot-icon {
    width: var(--space-4);
    height: var(--space-4);
    margin-right: var(--space-1);
}

.jk-slot-unit {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.jk-slot-unit-label {
    font-size: var(--type-caption);
    color: var(--text-primary);
    -unity-text-align: middle-center;
    white-space: normal;
}
