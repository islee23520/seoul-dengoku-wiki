      ],
      "kind": "regex",
      "from": "^(\\|(?: [^|\\n]*\\|){3}) [^|\\n]*\\|((?: [^|\\n]*\\|){5})$",
      "flags": "gm",
      "to": "$1$2",
      "expect": 36,
      "reason": "이전 자료 표의 급수 열 삭제(4번째 열)"
    },
