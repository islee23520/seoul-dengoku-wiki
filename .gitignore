# Site build outputs (built locally, deployed prebuilt to Vercel)
dist/

# Extracted geography release artifacts
GAME-REFERENCE/data/seoul-geography-20260830/openfreemap/release/

# Tooling dependencies (tools/package-lock.json is the tracked source of truth)
node_modules/

# IDE
.idea/
.vscode/
**/.vscode/
*.csproj
*.sln
!Backend/server/**/*.csproj
!Backend/server/**/*.sln
*.slnx
*.user

# OMO state stays local — the whole directory is always untracked (owner directive 2026-09-19).
/.omo/
*.log

# Local Unity player output
GAME/Builds/

# UTF performance-test runner droppings
GAME/Assets/Resources/PerformanceTestRunInfo.json
GAME/Assets/Resources/PerformanceTestRunInfo.json.meta
GAME/Assets/Resources/PerformanceTestRunSettings.json
GAME/Assets/Resources/PerformanceTestRunSettings.json.meta

# Burst/WebGL player sidecar from local builds
GAME/Data/

# Oddland donor payload: owner-authorized graphic/SFX/VFX import reproduced by
# TOOL/tools/art/import-oddland-donor.mjs from the external volume; ~1.6 GB exceeds the LFS quota,
# so only the manifest under docs/assets/bom/donor/ is tracked.
GAME/Assets/Quarantine/
GAME/Assets/Quarantine.meta

# Regenerable SQLite replica (HTML is tracked)
design-store/*.sqlite
design-store/*.receipt.json
GDD/design-store/*.sqlite
GDD/design-store/*.receipt.json

# Local pilgrimage bake attempts (receipts stay tracked)
art-process/node_modules/
art-process/out/**/*.png

# generated wiki output & tool dirs
/Wikis/
/.zcode/
