Game/[Bb]uilds/

# Tooling dependencies (tools/package-lock.json is the tracked source of truth)
node_modules/

# IDE
.idea/
.vscode/
**/.vscode/
*.csproj
*.sln
*.slnx
*.user

# Shared OMO context: policy/decisions/research are source, not session state.
# Categories admit future documents normally; stage reviewed paths only.
/.omo/*
!/.omo/README.md
!/.omo/policies/
!/.omo/rules/
!/.omo/contracts/
!/.omo/decisions/
!/.omo/plans/
!/.omo/design/
!/.omo/research/
!/.omo/research-private/
!/.omo/evidence/
/.omo/evidence/*
!/.omo/evidence/summaries/
!/.omo/evidence/receipts/

# Machine/runtime data stays local even inside shared categories.
/.omo/**/sessions/
/.omo/**/tasks/
/.omo/**/locks/
/.omo/**/cache/
/.omo/**/tmp/
/.omo/**/temp/
/.omo/**/raw/
/.omo/**/captures/
/.omo/**/archives/
/.omo/**/*-profile/
/.omo/**/*-prof*/
/.omo/**/auth.json
/.omo/**/credentials*
