# macOS
.DS_Store

# Senpi session state (created by memory reflection / hooks)
.senpi/

# Local credentials
.env
.env.*
!.env.example
Game/.unity-remote-token
.vercel/
.env.vercel.local

# Unity generated state
Game/[Ll]ibrary/
Game/[Tt]emp/
