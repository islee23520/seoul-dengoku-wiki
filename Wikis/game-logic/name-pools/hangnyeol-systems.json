  "systems": [
    {
      "id": "ohaeng",
      "name": "오행상생법",
      "summary": "목화토금수를 세대 순서로 돌린다. 글자 자체가 아니라 글자의 부수(변)에 원소를 싣는 방식이 관측된다. 수확 원자료의 예시 표는 32세 (木)변부터 41세 (水)변까지 다섯 세대 주기를 두 번 돈다.",
      "sequence": ["木", "火", "土", "金", "水"],
      "carrier": "radical",
      "sources": ["s-ohaeng-method", "s-ohaeng-radical"]
    },
    {
      "id": "cheongan",
      "name": "천간법",
      "summary": "십간 갑을병정무기경신임계를 세대마다 하나씩 배정한다. 원자료에 남은 적용 가계는 풍양 조씨 전직공파다. 십간을 대신하는 통용 대체자 목록은 확인되지 않았다.",
      "sequence": ["甲", "乙", "丙", "丁", "戊", "己", "庚", "辛", "壬", "癸"],
      "carrier": "character",
      "sources": ["s-cheongan"]
    },
    {
      "id": "jiji",
      "name": "지지법",
      "summary": "십이지 자축인묘진사오미신유술해를 세대 순서로 돌린다. 원자료에 남은 적용 가계는 전주 이씨 효령대군파다. 지지 하나에 대응하는 항렬자는 문중이 따로 정하므로 모든 문중에 공통인 대응표는 없다.",
      "sequence": ["子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥"],
      "carrier": "character",
      "sources": ["s-jiji"]
    },
    {
      "id": "sugyo",
      "name": "수교법",
      "summary": "일이삼사오륙칠팔구십을 세대 순서로 돌린다. 숫자를 글자 안에 실어 쓰며, 원자료에 남은 적용 가계는 안동 권씨 대동항렬이다.",
      "sequence": ["一", "二", "三", "四", "五", "六", "七", "八", "九", "十"],
      "carrier": "character",
      "sources": ["s-sugyo"]
    },
    {
      "id": "samhaeng",
      "name": "삼행법",
      "summary": "수곡토 세 글자를 세대 순서로 돌린다. 원자료에 남은 적용 가계는 한산 이씨 대동항렬이다. 이 행의 인용은 라이브 재대조를 아직 거치지 않았다.",
      "sequence": ["水", "穀", "土"],
      "carrier": "character",
      "sources": ["s-samhaeng"]
    },
    {
      "id": "jari",
      "name": "항렬자의 자리",
      "summary": "두 글자 이름에서 항렬자가 앞(상자)에 오는지 뒤(하자)에 오는지는 문중이 정한 자리를 따른다. 한글 발음이 같아도 한자가 다르면 항렬자를 쓴 것이 아니다. 세대마다 자리를 번갈아 바꾸는 관행은 원자료에서 확인되지 않아 미확인으로 남긴다.",
      "positions": ["first", "second"],
      "sources": ["s-jari", "s-hanja-differs"]
    },
    {
      "id": "sesu",
      "name": "세수",
      "summary": "세(世)는 시조를 1세로 두고 아래로 내려가며 세고, 대(代)는 후손에서 위로 올라가며 센다. 시조로부터 세수가 같은 사람이 같은 세대이며 동항이라 부른다. 항렬은 장손 계통일수록 낮고 지손 계통일수록 높아서 나이가 적은 사람이 윗항렬일 수 있다. 따라서 나이나 연령대는 세수의 근거가 되지 못한다.",
      "sources": ["s-sesu-dongshang", "s-se-vs-dae", "s-age-not-sesu"]
    },
    {
      "id": "munjung-banpo",
      "name": "문중 제정과 반포",
      "summary": "항렬자는 개인이 고르는 것이 아니라 문중이 족보를 편찬할 때 일정한 대수만큼 정해 반포한다. 형제의 이름에 같은 글자가 있어도 문중이 정한 글자가 아니면 항렬자가 아니다. 같은 세대에 속하면 촌수와 관계없이 같은 항렬자를 쓴다.",
      "sources": ["s-banpo", "s-hangnyeol-def", "s-same-gen-same-char"]
    },
    {
      "id": "daechae",
      "name": "대체 항렬자와 이름 변경",
      "summary": "정해진 항렬자를 기휘 등으로 쓸 수 없으면 항렬을 쓰지 않거나 문중이 둔 예비 항렬자를 쓴다. 안동 권씨는 36대손 항렬 赫에 예비 항렬자 奇·景·英을 두었다. 법적 이름은 가족관계등록부의 기재이며 개명은 별도 절차다.",
      "sources": ["s-daechae", "s-daechae-andong", "s-gaemyeong"]
    }
  ]
}
