{
  "schema_version": 1,
  "id": "portrait-validation-default-v1",
  "description": "Deterministic portrait asset QA example. Numeric checks describe pixels only; curation is separately bound to user feedback.",
  "nodes": [
    {
      "id": "load_target",
      "type": "load_rgba",
      "params": {
        "path": "Tool/art/portrait/original/target.png",
        "sha256": "c3a7e4815de6acaef28faf429395417a001bfe8088df633537c6e1a2aa9109a9"
      }
    },
    {
      "id": "normalize_target",
      "type": "normalize_alpha_zero_rgb",
      "inputs": { "image": { "node": "load_target", "output": "image" } }
    },
    {
      "id": "target_mask",
      "type": "alpha_mask",
      "inputs": { "image": { "node": "normalize_target", "output": "image" } },
      "params": { "threshold": 1, "min": 1 }
    },
    {
      "id": "bundle_mask",
      "type": "bundle_union",
      "inputs": { "masks": [
        { "node": "target_mask", "output": "mask" },
        { "node": "target_mask", "output": "mask" }
      ] }
    },
    {
      "id": "outside_owner",
      "type": "ownership_outside",
      "inputs": {
        "candidate": { "node": "bundle_mask", "output": "mask" },
        "owner": { "node": "target_mask", "output": "mask" }
      },
      "params": { "max": 0 }
    },
    {
      "id": "self_overlap",
      "type": "overlap",
      "inputs": {
        "a": { "node": "bundle_mask", "output": "mask" },
        "b": { "node": "target_mask", "output": "mask" }
      }
    },
    {
      "id": "mask_holes",
      "type": "holes",
      "inputs": { "mask": { "node": "target_mask", "output": "mask" } },
      "params": { "max": 0 }
    },
    {
      "id": "mask_fragments",
      "type": "connected_fragments",
      "inputs": { "mask": { "node": "target_mask", "output": "mask" } },
      "params": { "min_fragment_pixels": 2, "max": 0 }
    },
    {
      "id": "mask_seam",
      "type": "seam_band",
      "inputs": {
        "a": { "node": "target_mask", "output": "mask" },
        "b": { "node": "bundle_mask", "output": "mask" }
      },
      "params": { "radius": 1 }
    },
    {
      "id": "visible_without_outside",
      "type": "occlusion_visible",
      "inputs": {
        "target": { "node": "target_mask", "output": "mask" },
        "occluders": [{ "node": "outside_owner", "output": "mask" }]
      },
      "params": { "min": 1 }
    },
    {
      "id": "target_palette",
      "type": "palette_extract",
      "inputs": {
        "image": { "node": "normalize_target", "output": "image" },
        "mask": { "node": "visible_without_outside", "output": "mask" }
      },
      "params": { "colors": 8 }
    },
    {
      "id": "palette_preview",
      "type": "lut_preview",
      "inputs": {
        "image": { "node": "normalize_target", "output": "image" },
        "palette": { "node": "target_palette", "output": "palette" }
      }
    },
    {
      "id": "source_over_preview",
      "type": "composite_source_over",
      "inputs": { "images": [
        { "node": "normalize_target", "output": "image" },
        { "node": "palette_preview", "output": "image" }
      ] }
    },
    {
      "id": "emit_preview",
      "type": "emit_artifact",
      "inputs": { "value": { "node": "source_over_preview", "output": "image" } },
      "params": { "path": "palette-source-over-preview.png" }
    },
    {
      "id": "emit_seam",
      "type": "emit_artifact",
      "inputs": { "value": { "node": "mask_seam", "output": "mask" } },
      "params": { "path": "seam-band.png", "color": [255, 64, 160] }
    },
    {
      "id": "portrait_curation",
      "type": "curation_checkpoint",
      "inputs": { "artifacts": [
        { "node": "emit_preview", "output": "artifact" },
        { "node": "emit_seam", "output": "artifact" }
      ] }
    }
  ]
}
