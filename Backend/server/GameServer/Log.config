<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>

  <log4net>
    <appender name="DayRollingLogToFile" type="log4net.Appender.RollingFileAppender">
      <File value="Log/log_game_server" />
      <appendToFile value="true" />
      <rollingStyle value="date" />
      <staticLogFileName value="false" />
      <datePattern value='"_"yyyy-MM-dd".log"' />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%-2thread] %-5level %message%newline" />
      </layout>
    </appender>

    <appender name="UserLogAppender" type="log4net.Appender.RollingFileAppender">
      <PreserveLogFileNameExtension value="true"/>
      <File value="Log/GameLog/log_user.log" />
      <encoding value="utf-8"/>
      <encoding type="System.Text.UTF8Encoding"/>
      <appendToFile value="true"/>
      <rollingStyle value="Composite"/>
      <datePattern value='"_"yyyy-MM-dd".log"' />
      <maxSizeRollBackups value="30"/>
      <maximumFileSize value="100MB"/>
      <countDirection value="1"/>
      <layout type="log4net.Layout.PatternLayout">
      <param name="ConversionPattern" value="%message %newline"/>
      </layout>
    </appender>

    <appender name="StageDropRuleLogAppender" type="log4net.Appender.RollingFileAppender">
      <File value="Log/RandomLogs/log_stage_drop" />
      <appendToFile value="true" />
      <rollingStyle value="date" />
      <staticLogFileName value="false" />
      <datePattern value='"_"yyyy-MM-dd".log"' />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %message%newline" />
      </layout>
    </appender>

    <appender name="SummonLogAppender" type="log4net.Appender.RollingFileAppender">
      <File value="Log/RandomLogs/log_summon" />
      <appendToFile value="true" />
      <rollingStyle value="date" />
      <staticLogFileName value="false" />
      <datePattern value='"_"yyyy-MM-dd".log"' />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %message%newline" />
      </layout>
    </appender>


    <appender name="TraceAppender" type="log4net.Appender.TraceAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%message%newline" />
      </layout>
    </appender>

    <appender name="AsyncForwarder" type="Log4Net.Async.ParallelForwardingAppender,Log4Net.Async">
      <appender-ref ref="DayRollingLogToFile" />
    </appender>

    <logger name="debug">
      <level value="ALL" />
      <appender-ref ref="TraceAppender" />
      <appender-ref ref="DayRollingLogToFile" />
    </logger>

    <logger name="userLog">
      <level value="ALL" />
      <appender-ref ref="UserLogAppender" />
    </logger>

    <logger name="dropLog">
      <level value="ALL" />
      <appender-ref ref="StageDropRuleLogAppender" />
      <appender-ref ref="TraceAppender" />
    </logger>

    <logger name="summon">
      <level value="ALL" />
      <appender-ref ref="SummonLogAppender" />
      <appender-ref ref="TraceAppender" />
    </logger>

    <root>
    </root>
  </log4net>
</configuration>