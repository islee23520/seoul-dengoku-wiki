{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seoul-dengoku.linalab.io/lore/chronology/authoring.schema.json",
  "allOf": [
    {
      "$ref": "../authoring.shared.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "properties": {
        "domain": {
          "const": "chronology"
        },
        "id": {
          "type": "string",
          "pattern": "^(?:__EXAMPLE__:chronology|(?:ARC:[A-Za-z0-9-]+|DOC:[A-Za-z0-9-]+))$"
        },
        "data": {
          "type": "object",
          "properties": {
            "sequence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "anchor",
                  "order",
                  "date"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^(?:__EXAMPLE__:[A-Za-z0-9_-]+|ARC:[A-Za-z0-9-]+|EVENT:[A-Za-z0-9-]+)$"
                  },
                  "anchor": {
                    "$ref": "../authoring.shared.schema.json#/$defs/anchor"
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "date": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "status",
                          "value"
                        ],
                        "properties": {
                          "status": {
                            "const": "known"
                          },
                          "value": {
                            "type": "string",
                            "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "status",
                          "reason"
                        ],
                        "properties": {
                          "status": {
                            "enum": [
                              "unknown",
                              "undecided"
                            ]
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    {"if": {"properties": {"id": {"pattern": "^(?:DOC:|__EXAMPLE__)"}}}, "else": {"properties": {"data": {"required": ["sequence"]}}}}
  ]
}
