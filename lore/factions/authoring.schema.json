{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seoul-dengoku.linalab.io/lore/factions/authoring.schema.json",
  "allOf": [
    {
      "$ref": "../authoring.shared.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "properties": {
        "domain": {
          "const": "factions"
        },
        "id": {
          "type": "string",
          "pattern": "^(?:__EXAMPLE__:factions|(?:S(?:0[1-9]|1[0-6])|HC[0-9]{2}|HP[0-9]{2}|XT0[1-5]|DOC:[A-Za-z0-9-]+))$"
        },
        "data": {
          "type": "object",
          "properties": {
            "governance": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    {"if": {"properties": {"id": {"pattern": "^(?:DOC:|__EXAMPLE__)"}}}, "else": {"properties": {"data": {"required": ["governance"]}}}}
  ]
}
