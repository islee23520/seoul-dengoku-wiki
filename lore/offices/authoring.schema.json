{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seoul-dengoku.linalab.io/lore/offices/authoring.schema.json",
  "allOf": [
    {
      "$ref": "../authoring.shared.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "properties": {
        "domain": {
          "const": "offices"
        },
        "id": {
          "type": "string",
          "pattern": "^(?:__EXAMPLE__:offices|DOC:[A-Za-z0-9-]+)$"
        },
        "data": {
          "type": "object",
          "properties": {
            "tier": {
              "type": "string",
              "minLength": 1
            },
            "territorialScale": {
              "$ref": "#/$defs/territorialScale"
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^DOC:(?!Offices-and-Ranks$)"
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "tier"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "territorialScale": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "territorial-scale.v2"
        },
        "scope": {
          "const": "seoul-only"
        },
        "geographicSource": {
          "type": "object",
          "properties": {
            "path": {
              "const": "lore/regions/seoul-electoral-titles.json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "schema": {
              "const": "seoul-geography-staging.v1"
            }
          },
          "required": [
            "path",
            "sha256",
            "schema"
          ],
          "additionalProperties": false
        },
        "geographicEmpireId": {
          "const": "geography:empire:seoul"
        },
        "rankOrder": {
          "type": "array",
          "prefixItems": [
            {
              "const": "empire"
            },
            {
              "const": "kingdom"
            },
            {
              "const": "duchy"
            },
            {
              "const": "county"
            },
            {
              "const": "barony"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true
        },
        "levels": {
          "type": "object",
          "properties": {
            "empire": {
              "type": "object",
              "properties": {
                "sourcePointer": {
                  "const": "/titles"
                },
                "rank": {
                  "const": "empire"
                },
                "count": {
                  "const": 1
                }
              },
              "required": [
                "sourcePointer",
                "rank",
                "count"
              ],
              "additionalProperties": false
            },
            "kingdom": {
              "type": "object",
              "properties": {
                "sourcePointer": {
                  "const": "/titles"
                },
                "rank": {
                  "const": "kingdom"
                },
                "count": {
                  "const": 6
                },
                "partitionSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "sourcePointer",
                "rank",
                "count",
                "partitionSha256"
              ],
              "additionalProperties": false
            },
            "duchy": {
              "type": "object",
              "properties": {
                "sourcePointer": {
                  "const": "/titles"
                },
                "rank": {
                  "const": "duchy"
                },
                "count": {
                  "const": 25
                }
              },
              "required": [
                "sourcePointer",
                "rank",
                "count"
              ],
              "additionalProperties": false
            },
            "county": {
              "type": "object",
              "properties": {
                "sourcePointer": {
                  "const": "/titles"
                },
                "rank": {
                  "const": "county"
                },
                "count": {
                  "const": 48
                }
              },
              "required": [
                "sourcePointer",
                "rank",
                "count"
              ],
              "additionalProperties": false
            },
            "barony": {
              "type": "object",
              "properties": {
                "representation": {
                  "const": "county-detail-slot"
                },
                "idField": {
                  "const": "slotId"
                },
                "parentField": {
                  "const": "countyTitleId"
                }
              },
              "required": [
                "representation",
                "idField",
                "parentField"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "empire",
            "kingdom",
            "duchy",
            "county",
            "barony"
          ],
          "additionalProperties": false
        },
        "map": {
          "type": "object",
          "properties": {
            "minimumPolygonRank": {
              "const": "county"
            },
            "selectableRanks": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "county"
                },
                {
                  "const": "duchy"
                },
                {
                  "const": "kingdom"
                },
                {
                  "const": "empire"
                }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true
            },
            "baronyPolygon": {
              "const": false
            }
          },
          "required": [
            "minimumPolygonRank",
            "selectableRanks",
            "baronyPolygon"
          ],
          "additionalProperties": false
        },
        "slotEditions": {
          "type": "object",
          "properties": {
            "dated": {
              "type": "object",
              "properties": {
                "sourcePointer": {
                  "const": "/countySlots"
                },
                "edition": {
                  "const": "sgis-20250630"
                },
                "baseDate": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "count": {
                  "const": 426
                },
                "geometryVerified": {
                  "const": true
                },
                "currentBoundaryCertification": {
                  "const": false
                }
              },
              "required": [
                "sourcePointer",
                "edition",
                "baseDate",
                "count",
                "geometryVerified",
                "currentBoundaryCertification"
              ],
              "additionalProperties": false
            },
            "currentCorrespondence": {
              "type": "object",
              "properties": {
                "sourcePointer": {
                  "const": "/currentCorrespondenceSlots"
                },
                "edition": {
                  "const": "seoul-dong-correspondence-20260701-checked20261013"
                },
                "administrativeCandidateDate": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
                },
                "count": {
                  "const": 427
                },
                "geometryVerified": {
                  "const": false
                }
              },
              "required": [
                "sourcePointer",
                "edition",
                "administrativeCandidateDate",
                "checkedAt",
                "count",
                "geometryVerified"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "dated",
            "currentCorrespondence"
          ],
          "additionalProperties": false
        },
        "geographicParent": {
          "type": "object",
          "properties": {
            "sourceField": {
              "const": "feudalParentTitleId"
            },
            "meaning": {
              "const": "geographic-only"
            },
            "politicalLiegeInference": {
              "const": false
            },
            "crossDistrictExceptions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "titleId": {
                    "const": "geography:county:seoul-constituency:중구성동구을선거구"
                  },
                  "parentTitleId": {
                    "const": "geography:empire:seoul"
                  },
                  "mapKingdomTitleId": {
                    "const": "geography:kingdom:seoul:01"
                  },
                  "kind": {
                    "const": "cross-district-empire-direct"
                  }
                },
                "required": [
                  "titleId",
                  "parentTitleId",
                  "mapKingdomTitleId",
                  "kind"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "sourceField",
            "meaning",
            "politicalLiegeInference",
            "crossDistrictExceptions"
          ],
          "additionalProperties": false
        },
        "politicalAxis": {
          "type": "object",
          "properties": {
            "currentCenters": {
              "const": 3
            },
            "geographicKingdomEquivalence": {
              "const": false
            },
            "preserveStablePoliticalIdentities": {
              "const": true
            },
            "preserveNonterritorialKingship": {
              "const": true
            }
          },
          "required": [
            "currentCenters",
            "geographicKingdomEquivalence",
            "preserveStablePoliticalIdentities",
            "preserveNonterritorialKingship"
          ],
          "additionalProperties": false
        },
        "scaleImpliesPersonalOwnership": {
          "const": false
        },
        "scaleImpliesTitleRank": {
          "const": false
        },
        "scaleImpliesFacilityAccess": {
          "const": false
        },
        "slotExistenceImpliesGrant": {
          "const": false
        }
      },
      "required": [
        "schema",
        "scope",
        "geographicSource",
        "geographicEmpireId",
        "rankOrder",
        "levels",
        "map",
        "slotEditions",
        "geographicParent",
        "politicalAxis",
        "scaleImpliesPersonalOwnership",
        "scaleImpliesTitleRank",
        "scaleImpliesFacilityAccess",
        "slotExistenceImpliesGrant"
      ],
      "additionalProperties": false
    }
  }
}
