  "api_endpoint": {
    "generate": "POST /api/settlements/:settlementId/generate-npcs",
    "params": { "seed": "결정론적 시드 (선택)", "count": "생성 수 (선택, 기본 인구 비례)" },
    "response": { "npcs": "생성된 인물 배열", "unit_eligibility": "부대 편성 가능 목록" }
  }
