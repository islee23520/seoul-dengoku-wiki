{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seoul-dengoku.linalab.io/lore/authoring.shared.schema.json",
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": [
        "en",
        "ko"
      ],
      "properties": {
        "en": {"$ref": "#/$defs/textValue"},
        "ko": {"$ref": "#/$defs/textValue"}
      },
      "additionalProperties": false
    },
    "tableCell": {
      "type": "object",
      "required": ["en", "ko"],
      "properties": {
        "en": {"anyOf": [{"$ref": "#/$defs/textValue"}, {"const": ""}]},
        "ko": {"anyOf": [{"$ref": "#/$defs/textValue"}, {"const": ""}]}
      },
      "additionalProperties": false
    },
    "textValue": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/textRun"}}
      ]
    },
    "textRun": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "link": {
          "type": "object",
          "required": ["domain", "slug"],
          "properties": {
            "domain": {"type": "string", "minLength": 1},
            "slug": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*(/[A-Za-z0-9_][A-Za-z0-9_-]*)?$"},
            "anchor": {"$ref": "#/$defs/anchor"}
          },
          "additionalProperties": false
        },
        "strong": {"const": true},
        "href": {"type": "string", "pattern": "^https://\\S+$"}
      },
      "not": {"required": ["link", "href"]},
      "additionalProperties": false
    },
    "localeHeader": {
      "type": "object",
      "required": [
        "title",
        "summary",
        "tense"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "tense": {
          "enum": ["past", "present"]
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "refs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "original-fiction",
            "observed",
            "computed",
            "inference",
            "source-fact"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["observed", "computed", "inference", "source-fact"]}}},
          "then": {"properties": {"refs": {"minItems": 1}}}
        }
      ],
      "additionalProperties": false
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "anchor"],
          "properties": {
            "kind": {"const": "rule"},
            "anchor": {"$ref": "#/$defs/anchor"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "anchor", "language", "text"],
          "properties": {
            "kind": {"const": "code"},
            "anchor": {"$ref": "#/$defs/anchor"},
            "language": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
            "info": {"type": "string", "minLength": 1},
            "text": {
              "type": "object",
              "required": ["en", "ko"],
              "properties": {
                "en": {"type": "string", "minLength": 1},
                "ko": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "anchor",
            "text"
          ],
          "properties": {
            "kind": {
              "enum": [
                "heading",
                "paragraph",
                "quote"
              ]
            },
            "anchor": {
              "$ref": "#/$defs/anchor"
            },
            "depth": {"type": "integer", "minimum": 1, "maximum": 6},
            "text": {
              "$ref": "#/$defs/localizedText"
            }
          },
          "if": {"properties": {"kind": {"const": "heading"}}},
          "then": {"required": ["depth"]},
          "else": {"not": {"required": ["depth"]}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "anchor",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "list"
            },
            "ordered": {"const": true},
            "start": {"type": "integer", "minimum": 0},
            "anchor": {
              "$ref": "#/$defs/anchor"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/localizedText"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "anchor",
            "columns",
            "rows"
          ],
          "properties": {
            "kind": {
              "const": "table"
            },
            "anchor": {
              "$ref": "#/$defs/anchor"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/localizedText"
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/tableCell"
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "anchor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9가-힣][A-Za-z0-9가-힣_-]*$"
    },
    "envelope": {
      "type": "object",
      "required": [
        "version",
        "domain",
        "id",
        "slug",
        "status",
        "tense",
        "provenance",
        "source",
        "locales",
        "content",
        "data"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "domain": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "slug": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": ["draft", "approved", "excluded"]
        },
        "tense": {
          "type": "object",
          "required": ["en", "ko"],
          "properties": {
            "en": {"enum": ["past", "present"]},
            "ko": {"enum": ["past", "present"]}
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": ["original_anchor", "original_hash", "history"],
          "properties": {
            "original_anchor": {"type": "string", "minLength": 1},
            "original_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
            "history": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "locales": {
          "type": "object",
          "required": [
            "en",
            "ko"
          ],
          "properties": {
            "en": {
              "$ref": "#/$defs/localeHeader"
            },
            "ko": {
              "$ref": "#/$defs/localeHeader"
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "anchor"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        }
      },
      "additionalProperties": false
    }
  }
}
