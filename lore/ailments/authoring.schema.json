{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seoul-dengoku.linalab.io/lore/ailments/authoring.schema.json",
  "allOf": [
    {
      "$ref": "../authoring.shared.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "properties": {
        "domain": {
          "const": "ailments"
        },
        "id": {
          "type": "string",
          "pattern": "^(?:__EXAMPLE__:ailments|DOC:[A-Za-z0-9-]+)$"
        },
        "data": {
          "type": "object",
          "properties": {
            "symptom": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    {"if": {"properties": {"id": {"pattern": "^(?:DOC:|__EXAMPLE__)"}}}, "else": {"properties": {"data": {"required": ["symptom"]}}}}
  ]
}
