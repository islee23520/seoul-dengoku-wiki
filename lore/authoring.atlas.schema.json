{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seoul-dengoku.linalab.io/lore/authoring.atlas.schema.json",
  "$defs": {
    "localized": {"$ref": "authoring.shared.schema.json#/$defs/localizedText"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "authoring.shared.schema.json#/$defs/node"}
    },
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "localizedList": {"type": "array", "items": {"$ref": "#/$defs/localized"}},
    "stateId": {"type": "string", "pattern": "^(?:__EXAMPLE__:state|S(?:0[1-9]|1[0-6]))$"},
    "humanId": {"type": "string", "pattern": "^(?:__EXAMPLE__:human|K[0-9]{3,4})$"},
    "houseId": {"type": "string", "pattern": "^(?:__EXAMPLE__:house|H[CP][0-9]{2})$"},
    "theaterId": {"type": "string", "pattern": "^(?:__EXAMPLE__:theater|XT0[1-5])$"},
    "syntheticId": {"type": "string", "pattern": "^(?:__EXAMPLE__:synthetic|[HFV][0-9]{2})$"},
    "groupId": {"type": "string", "pattern": "^(?:__EXAMPLE__:group|G(?:0[1-9]|1[0-9]|2[0-7]))$"},
    "entryId": {"type": "string", "pattern": "^(?:__EXAMPLE__:entry|G(?:0[1-9]|1[0-9]|2[0-7])E[0-9]{2})$"},
    "batchId": {"type": "string", "pattern": "^(?:__EXAMPLE__:batch|M(?!007$)[0-9]{3})$"},
    "reservationBatchId": {"type": "string", "pattern": "^(?:__EXAMPLE__:batch|M[0-9]{3})$"},
    "arcId": {"type": "string", "pattern": "^(?:__EXAMPLE__:arc|ARC-(?:H-H[CP][0-9]{2}|T-XT0[1-5]|S-[HFV]|G-G(?:0[1-9]|1[0-9]|2[0-7])))$"},
    "metadata": {
      "type": "object",
      "required": ["owner", "source_kind", "source_anchors"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "source_kind": {"const": "original-fiction"},
        "source_anchors": {"$ref": "#/$defs/stringList"},
        "revision": {"type": "integer", "minimum": 1},
        "projection_targets": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "required": ["id", "display_name", "document_status", "owner", "support_reviewers", "revision", "last_verified_commit", "source_kind", "source_anchors", "dependencies", "related_ids", "projection_targets", "change_ledger_entry", "verification_state"],
      "properties": {
        "id": {"enum": ["WNA-001", "__EXAMPLE__:document"]},
        "display_name": {"$ref": "#/$defs/localized"},
        "document_status": {"const": "active"},
        "owner": {"type": "string", "minLength": 1},
        "support_reviewers": {"$ref": "#/$defs/stringList"},
        "revision": {"type": "string", "pattern": "^(?:r[0-9]+|__EXAMPLE__:revision)$"},
        "last_verified_commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|__EXAMPLE__:commit)$"},
        "source_kind": {"const": "original-fiction"},
        "source_anchors": {"$ref": "#/$defs/stringList"},
        "dependencies": {"$ref": "#/$defs/stringList"},
        "related_ids": {"$ref": "#/$defs/stringList"},
        "projection_targets": {"$ref": "#/$defs/stringList"},
        "change_ledger_entry": {"type": "string", "pattern": "^(?:CL-[0-9]{4}|__EXAMPLE__:change)$"},
        "verification_state": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "writingContract": {
      "type": "object",
      "required": ["narrative_register", "guide_register", "viewpoint", "honorifics", "multicultural_rule", "synthetic_rule", "hostile_rule", "source_kind_visible"],
      "properties": {
        "narrative_register": {"type": "string", "minLength": 1},
        "guide_register": {"type": "string", "minLength": 1},
        "viewpoint": {"type": "string", "minLength": 1},
        "honorifics": {"type": "string", "minLength": 1},
        "multicultural_rule": {"type": "string", "minLength": 1},
        "synthetic_rule": {"type": "string", "minLength": 1},
        "hostile_rule": {"type": "string", "minLength": 1},
        "source_kind_visible": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "projectionPage": {
      "type": "object",
      "required": ["title", "summary", "intro"],
      "properties": {
        "title": {"$ref": "#/$defs/localized"},
        "summary": {"$ref": "#/$defs/localized"},
        "intro": {"$ref": "#/$defs/localized"},
        "banner": {"$ref": "#/$defs/localized"}
      },
      "additionalProperties": false
    },
    "stateCorridor": {
      "type": "object",
      "required": ["ho", "name", "station", "group_id"],
      "properties": {
        "ho": {"type": "integer", "minimum": 1},
        "name": {"$ref": "#/$defs/localized"},
        "station": {"$ref": "#/$defs/localized"},
        "group_id": {"$ref": "#/$defs/groupId"}
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["id", "display_name", "capital_station", "region", "government", "offices", "power", "power_basis", "corridors", "origin"],
      "properties": {
        "id": {"$ref": "#/$defs/stateId"},
        "display_name": {"$ref": "#/$defs/localized"},
        "capital_station": {"$ref": "#/$defs/localized"},
        "region": {"$ref": "#/$defs/localized"},
        "government": {"$ref": "#/$defs/localized"},
        "offices": {"$ref": "#/$defs/localizedList"},
        "power": {"$ref": "#/$defs/localized"},
        "power_basis": {"$ref": "#/$defs/localizedList"},
        "corridors": {"type": "array", "items": {"$ref": "#/$defs/stateCorridor"}},
        "origin": {"$ref": "#/$defs/localized"}
      },
      "additionalProperties": false
    },
    "human": {
      "type": "object",
      "required": ["id", "name", "role", "stage", "state_id", "state_name", "source_anchor"],
      "properties": {
        "id": {"$ref": "#/$defs/humanId"},
        "name": {"$ref": "#/$defs/localized"},
        "role": {"$ref": "#/$defs/localized"},
        "stage": {"enum": ["주요", "S1", "S2", "S3"]},
        "state_id": {"$ref": "#/$defs/stateId"},
        "state_name": {"$ref": "#/$defs/localized"},
        "source_anchor": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "charter": {
      "type": "object",
      "required": ["public_mission", "mandate_domains", "forbidden_powers"],
      "properties": {
        "public_mission": {"$ref": "#/$defs/localized"},
        "mandate_domains": {"$ref": "#/$defs/localizedList"},
        "forbidden_powers": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": false
    },
    "membership": {
      "type": "object",
      "required": ["classes", "entry_routes", "dual_membership_policy"],
      "properties": {
        "classes": {"type": "array", "items": {"enum": ["APPRENTICE", "LICENSED_MEMBER", "CORE_MEMBER", "OFFICER", "STEWARD"]}},
        "entry_routes": {"type": "array", "items": {"enum": ["OPEN_EXAM", "APPRENTICESHIP", "LATERAL_ADMISSION", "CHARTER_ADOPTION"]}},
        "dual_membership_policy": {"const": "DISCLOSURE_REQUIRED"},
        "steward": {"$ref": "#/$defs/localized"}
      },
      "additionalProperties": false
    },
    "succession": {
      "type": "object",
      "required": ["state", "caretaker_triad", "trigger_events"],
      "properties": {
        "state": {"const": "NORMAL"},
        "designated": {"$ref": "#/$defs/localized"},
        "caretaker_triad": {"$ref": "#/$defs/localizedList"},
        "trigger_events": {"$ref": "#/$defs/localizedList"}
      },
      "additionalProperties": false
    },
    "regency": {
      "type": "object",
      "required": ["active", "triad"],
      "properties": {"active": {"type": "boolean"}, "triad": {"$ref": "#/$defs/localizedList"}},
      "additionalProperties": false
    },
    "protectedGuest": {
      "type": "object",
      "required": ["id", "kind", "terms"],
      "properties": {
        "id": {"type": "string", "pattern": "^(?:__EXAMPLE__:guest|H[CP][0-9]{2}-PG[0-9]{2})$"},
        "kind": {"enum": ["exchange_fellow", "licensed_auditor", "technical_observer", "protocol_envoy", "visiting_performer", "broadcast_witness"]},
        "terms": {"$ref": "#/$defs/localized"}
      },
      "additionalProperties": false
    },
    "aiStewardship": {
      "type": "object",
      "required": ["system_ids", "authorized_functions", "prohibited_functions", "human_veto_required", "dual_key_shutdown"],
      "properties": {
        "system_ids": {"type": "array", "items": {"type": "string", "pattern": "^(?:__EXAMPLE__:ai|H[CP][0-9]{2}-AI)$"}},
        "authorized_functions": {"$ref": "#/$defs/localizedList"},
        "prohibited_functions": {"type": "array", "items": {"enum": ["lethal_force", "unilateral_shutdown_of_life_support"]}},
        "accountable_human": {"$ref": "#/$defs/localized"},
        "human_veto_required": {"type": "boolean"},
        "dual_key_shutdown": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "required": ["to", "kind", "summary"],
      "properties": {
        "to": {"oneOf": [{"$ref": "#/$defs/stateId"}, {"const": "시민"}]},
        "kind": {"enum": ["continuity", "audit", "verification", "access", "emergency", "supply", "certification", "cold_chain", "protocol", "procurement", "rights", "neutrality", "safety"]},
        "summary": {"$ref": "#/$defs/localized"}
      },
      "additionalProperties": false
    },
    "act": {
      "type": "object",
      "required": ["act", "summary"],
      "properties": {"act": {"type": "integer", "minimum": 1, "maximum": 3}, "summary": {"$ref": "#/$defs/localized"}},
      "additionalProperties": false
    },
    "houseAct": {
      "type": "object",
      "required": ["act", "title", "summary"],
      "properties": {"act": {"type": "integer", "minimum": 1, "maximum": 3}, "title": {"$ref": "#/$defs/localized"}, "summary": {"$ref": "#/$defs/localized"}},
      "additionalProperties": false
    },
    "house": {
      "type": "object",
      "required": ["id", "display_name", "house_class", "house_kind", "status", "owner", "source_kind", "source_anchors", "revision", "projection_targets", "states", "exclusive_state_ids", "charter", "membership", "succession", "regency", "protected_guests", "ai_stewardship", "obligations", "arcs", "prose"],
      "properties": {
        "id": {"$ref": "#/$defs/houseId"}, "display_name": {"$ref": "#/$defs/localized"},
        "house_class": {"enum": ["CORPORATION", "INFRA_OPERATOR", "PROFESSIONAL_GUILD", "CIVIC_COMPACT", "DATA_TRUST"]},
        "house_kind": {"enum": ["corporate-successor", "civic-professional"]}, "status": {"const": "ACTIVE"},
        "owner": {"type": "string", "minLength": 1}, "source_kind": {"const": "original-fiction"}, "source_anchors": {"$ref": "#/$defs/stringList"},
        "revision": {"type": "integer", "minimum": 1}, "projection_targets": {"$ref": "#/$defs/stringList"},
        "states": {"type": "array", "items": {"$ref": "#/$defs/stateId"}}, "exclusive_state_ids": {"type": "array", "items": {"$ref": "#/$defs/stateId"}},
        "charter": {"$ref": "#/$defs/charter"}, "membership": {"$ref": "#/$defs/membership"}, "succession": {"$ref": "#/$defs/succession"}, "regency": {"$ref": "#/$defs/regency"},
        "protected_guests": {"type": "array", "items": {"$ref": "#/$defs/protectedGuest"}}, "ai_stewardship": {"$ref": "#/$defs/aiStewardship"},
        "obligations": {"type": "array", "items": {"$ref": "#/$defs/obligation"}}, "arcs": {"type": "array", "items": {"$ref": "#/$defs/houseAct"}}, "prose": {"$ref": "#/$defs/nodes"}
      },
      "additionalProperties": false,
      "if": {"properties": {"id": {"enum": ["HC19", "HC20"]}}, "required": ["id"]},
      "then": {"properties": {"membership": {"properties": {"steward": false}}, "succession": {"properties": {"designated": false}}, "ai_stewardship": {"properties": {"accountable_human": false}}}},
      "else": {"properties": {"membership": {"required": ["steward"]}, "ai_stewardship": {"required": ["accountable_human"]}}},
      "allOf": [{"if": {"properties": {"id": {"enum": ["HC16", "HC17", "HC18", "HC19", "HC20", "HC21", "HC22"]}}, "required": ["id"]}, "then": {"properties": {"succession": {"properties": {"designated": false}}}}, "else": {"properties": {"succession": {"required": ["designated"]}}}}]
    },
    "routes": {
      "type": "object",
      "required": ["trade", "energy", "data", "refugee", "diaspora", "security", "ai_custody", "monster_migration"],
      "properties": {
        "trade": {"$ref": "#/$defs/localized"}, "energy": {"$ref": "#/$defs/localized"}, "data": {"$ref": "#/$defs/localized"}, "refugee": {"$ref": "#/$defs/localized"},
        "diaspora": {"$ref": "#/$defs/localized"}, "security": {"$ref": "#/$defs/localized"}, "ai_custody": {"$ref": "#/$defs/localized"}, "monster_migration": {"$ref": "#/$defs/localized"}
      },
      "additionalProperties": false
    },
    "scenarioSummary": {
      "type": "object", "required": ["id", "summary"],
      "properties": {"id": {"type": "string", "minLength": 1}, "summary": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "seoulRoute": {
      "type": "object", "required": ["evidence_kind", "verified_geography", "staging_nodes", "route_design", "outbound_boundary", "fixed_duration"],
      "properties": {
        "evidence_kind": {"enum": ["verified-geography-plus-original-fiction", "verified-concept-plus-original-fiction"]}, "verified_geography": {"$ref": "#/$defs/localized"},
        "staging_nodes": {"$ref": "#/$defs/localizedList"}, "route_design": {"$ref": "#/$defs/localized"}, "outbound_boundary": {"$ref": "#/$defs/localized"}, "fixed_duration": {"$ref": "#/$defs/localized"}
      }, "additionalProperties": false
    },
    "travelConstraints": {
      "type": "object", "required": ["seasonal_conditions", "suspension_conditions", "rule"],
      "properties": {"seasonal_conditions": {"$ref": "#/$defs/localizedList"}, "suspension_conditions": {"$ref": "#/$defs/localizedList"}, "rule": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "supplyFlow": {
      "type": "object", "required": ["kind", "contents", "handoff_rule"],
      "properties": {"kind": {"$ref": "#/$defs/localized"}, "contents": {"$ref": "#/$defs/localized"}, "handoff_rule": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "supplyChain": {
      "type": "object", "required": ["flows", "separation_rule"],
      "properties": {"flows": {"type": "array", "items": {"$ref": "#/$defs/supplyFlow"}}, "separation_rule": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "checkpoint": {
      "type": "object", "required": ["id", "place", "function", "checks", "authority_state_ids"],
      "properties": {"id": {"type": "string", "pattern": "^(?:__EXAMPLE__:checkpoint|XT0[1-5]-CP-[A-Z0-9-]+)$"}, "place": {"$ref": "#/$defs/localized"}, "function": {"$ref": "#/$defs/localized"}, "checks": {"$ref": "#/$defs/localizedList"}, "authority_state_ids": {"type": "array", "items": {"$ref": "#/$defs/stateId"}}}, "additionalProperties": false
    },
    "rumorTier": {
      "type": "object", "required": ["tier", "rule"], "properties": {"tier": {"enum": ["확인", "보류", "전언"]}, "rule": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "languageRumor": {
      "type": "object", "required": ["record_language", "interpreter_rule", "rumor_reliability", "prohibited_inference"],
      "properties": {"record_language": {"$ref": "#/$defs/localized"}, "interpreter_rule": {"$ref": "#/$defs/localized"}, "rumor_reliability": {"type": "array", "items": {"$ref": "#/$defs/rumorTier"}}, "prohibited_inference": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "stateInterest": {
      "type": "object", "required": ["state_id", "interest", "leverage", "red_line"],
      "properties": {"state_id": {"$ref": "#/$defs/stateId"}, "interest": {"$ref": "#/$defs/localized"}, "leverage": {"$ref": "#/$defs/localized"}, "red_line": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "ecologyInteraction": {
      "type": "object", "required": ["group_id", "interaction", "operational_response", "nonlethal_constraint"],
      "properties": {"group_id": {"$ref": "#/$defs/groupId"}, "interaction": {"$ref": "#/$defs/localized"}, "operational_response": {"$ref": "#/$defs/localized"}, "nonlethal_constraint": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "openingEvent": {
      "type": "object", "required": ["scenario_id", "timeline_placement", "trigger", "conflict", "player_decision"],
      "properties": {"scenario_id": {"type": "string", "minLength": 1}, "timeline_placement": {"$ref": "#/$defs/localized"}, "trigger": {"$ref": "#/$defs/localized"}, "conflict": {"$ref": "#/$defs/localized"}, "player_decision": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "entryPoint": {
      "type": "object", "required": ["id", "place", "role", "first_decision"],
      "properties": {"id": {"type": "string", "pattern": "^(?:__EXAMPLE__:entry-point|XT0[1-5]-ENTRY-[A-Z0-9-]+)$"}, "place": {"$ref": "#/$defs/localized"}, "role": {"$ref": "#/$defs/localized"}, "first_decision": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "theater": {
      "type": "object",
      "required": ["id", "display_name", "owner", "source_kind", "source_anchors", "revision", "projection_targets", "verified", "inference", "original_fiction", "states", "japan_bridge_removable", "routes", "scenario_chains", "prose", "seoul_route", "travel_constraints", "supply_chain", "checkpoints", "language_rumor_protocol", "state_interests", "hostile_ecology_interaction", "opening_event", "player_entry_points", "explicit_unknowns"],
      "properties": {
        "id": {"$ref": "#/$defs/theaterId"}, "display_name": {"$ref": "#/$defs/localized"}, "owner": {"type": "string", "minLength": 1}, "source_kind": {"const": "original-fiction"}, "source_anchors": {"$ref": "#/$defs/stringList"}, "revision": {"type": "integer", "minimum": 1}, "projection_targets": {"$ref": "#/$defs/stringList"},
        "verified": {"$ref": "#/$defs/localized"}, "inference": {"$ref": "#/$defs/localized"}, "original_fiction": {"$ref": "#/$defs/localized"}, "states": {"type": "array", "items": {"$ref": "#/$defs/stateId"}}, "japan_bridge_removable": {"type": "boolean"},
        "routes": {"$ref": "#/$defs/routes"}, "scenario_chains": {"type": "array", "items": {"$ref": "#/$defs/scenarioSummary"}}, "prose": {"$ref": "#/$defs/nodes"}, "seoul_route": {"$ref": "#/$defs/seoulRoute"},
        "travel_constraints": {"$ref": "#/$defs/travelConstraints"}, "supply_chain": {"$ref": "#/$defs/supplyChain"}, "checkpoints": {"type": "array", "items": {"$ref": "#/$defs/checkpoint"}}, "language_rumor_protocol": {"$ref": "#/$defs/languageRumor"},
        "state_interests": {"type": "array", "items": {"$ref": "#/$defs/stateInterest"}}, "hostile_ecology_interaction": {"type": "array", "items": {"$ref": "#/$defs/ecologyInteraction"}}, "opening_event": {"$ref": "#/$defs/openingEvent"},
        "player_entry_points": {"type": "array", "items": {"$ref": "#/$defs/entryPoint"}}, "explicit_unknowns": {"$ref": "#/$defs/localizedList"}
      }, "additionalProperties": false
    },
    "syntheticRelation": {
      "type": "object", "required": ["target", "kind", "reason"],
      "properties": {"target": {"type": "string", "pattern": "^(?:__EXAMPLE__:[A-Za-z0-9_-]+|K[0-9]{3,4}|H[CP][0-9]{2})$"}, "kind": {"enum": ["custodian", "steward_house", "work_peer"]}, "reason": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "synthetic": {
      "type": "object",
      "required": ["id", "display_name", "callsign", "cls", "owner", "source_kind", "source_anchors", "revision", "projection_targets", "state_id", "house_id", "body_platform", "custody_legal", "memory_continuity", "energy_parts", "maintenance", "network_safety", "emergent_goal", "divergence_recovery", "relations", "prose"],
      "properties": {
        "id": {"$ref": "#/$defs/syntheticId"}, "display_name": {"$ref": "#/$defs/localized"}, "callsign": {"$ref": "#/$defs/localized"}, "cls": {"enum": ["H", "F", "V"]}, "owner": {"type": "string", "minLength": 1}, "source_kind": {"const": "original-fiction"}, "source_anchors": {"$ref": "#/$defs/stringList"}, "revision": {"type": "integer", "minimum": 1}, "projection_targets": {"$ref": "#/$defs/stringList"},
        "state_id": {"$ref": "#/$defs/stateId"}, "house_id": {"$ref": "#/$defs/houseId"}, "body_platform": {"$ref": "#/$defs/localized"}, "custody_legal": {"$ref": "#/$defs/localized"}, "memory_continuity": {"$ref": "#/$defs/localized"}, "energy_parts": {"$ref": "#/$defs/localized"}, "maintenance": {"$ref": "#/$defs/localized"}, "network_safety": {"$ref": "#/$defs/localized"}, "emergent_goal": {"$ref": "#/$defs/localized"}, "divergence_recovery": {"$ref": "#/$defs/localized"},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/syntheticRelation"}}, "prose": {"$ref": "#/$defs/nodes"}
      }, "additionalProperties": false
    },
    "bestiaryClass": {
      "type": "object", "required": ["common_ecology", "variant_relation", "command_scope"],
      "properties": {"common_ecology": {"$ref": "#/$defs/localized"}, "variant_relation": {"$ref": "#/$defs/localized"}, "command_scope": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "groupLinks": {
      "type": "object", "required": ["states", "houses", "theaters", "synthetics", "corporations_successor_only"],
      "properties": {
        "states": {"type": "array", "items": {"$ref": "#/$defs/stateId"}}, "houses": {"type": "array", "items": {"$ref": "#/$defs/houseId"}}, "theaters": {"type": "array", "items": {"$ref": "#/$defs/theaterId"}}, "synthetics": {"type": "array", "items": {"$ref": "#/$defs/syntheticId"}}, "corporations_successor_only": {"type": "array", "items": {"$ref": "#/$defs/houseId"}}
      }, "additionalProperties": false
    },
    "scenarioOutline": {
      "type": "object", "required": ["id", "title", "stage", "trigger", "actors", "mechanism", "choices", "outcomes", "moral_cost", "dossier_ref"],
      "properties": {"id": {"type": "string", "minLength": 1}, "title": {"$ref": "#/$defs/localized"}, "stage": {"type": "integer", "minimum": 1, "maximum": 3}, "trigger": {"$ref": "#/$defs/localized"}, "actors": {"$ref": "#/$defs/stringList"}, "mechanism": {"$ref": "#/$defs/localized"}, "choices": {"$ref": "#/$defs/localizedList"}, "outcomes": {"$ref": "#/$defs/localized"}, "moral_cost": {"$ref": "#/$defs/localized"}, "dossier_ref": {"$ref": "#/$defs/groupId"}}, "additionalProperties": false
    },
    "groupScenario": {
      "type": "object", "required": ["id", "title", "summary"],
      "properties": {"id": {"type": "string", "minLength": 1}, "title": {"$ref": "#/$defs/localized"}, "summary": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "groupCorridor": {
      "type": "object", "required": ["ho", "name", "station", "host_state"],
      "properties": {"ho": {"type": "integer", "minimum": 1}, "name": {"$ref": "#/$defs/localized"}, "station": {"$ref": "#/$defs/localized"}, "host_state": {"$ref": "#/$defs/stateId"}}, "additionalProperties": false
    },
    "hostileGroup": {
      "type": "object",
      "required": ["id", "display_name", "bestiary", "category", "owner", "source_kind", "source_anchors", "revision", "projection_targets", "modern_anxiety", "fictional_origin", "territory_migration", "economy", "lifecycle", "senses", "hierarchy", "links", "escalation", "combat_counterplay", "negotiation", "moral_cost", "scenario_links", "dossier_prose", "prose"],
      "properties": {
        "id": {"$ref": "#/$defs/groupId"}, "display_name": {"$ref": "#/$defs/localized"}, "bestiary": {"$ref": "#/$defs/bestiaryClass"}, "category": {"enum": ["animal-urban", "humanoid-mutant", "rogue-robot", "biomechanical", "infected", "human"]},
        "owner": {"type": "string", "minLength": 1}, "source_kind": {"const": "original-fiction"}, "source_anchors": {"$ref": "#/$defs/stringList"}, "revision": {"type": "integer", "minimum": 1}, "projection_targets": {"$ref": "#/$defs/stringList"},
        "modern_anxiety": {"$ref": "#/$defs/localized"}, "fictional_origin": {"$ref": "#/$defs/localized"}, "territory_migration": {"$ref": "#/$defs/localized"}, "economy": {"$ref": "#/$defs/localized"}, "lifecycle": {"$ref": "#/$defs/localized"}, "adaptation": {"$ref": "#/$defs/localized"}, "senses": {"$ref": "#/$defs/localized"}, "hierarchy": {"$ref": "#/$defs/localized"}, "links": {"$ref": "#/$defs/groupLinks"},
        "escalation": {"$ref": "#/$defs/localized"}, "combat_counterplay": {"$ref": "#/$defs/localized"}, "negotiation": {"$ref": "#/$defs/localized"}, "moral_cost": {"$ref": "#/$defs/localized"}, "scenario_links": {"$ref": "#/$defs/stringList"},
        "scenario_outlines": {"type": "array", "items": {"$ref": "#/$defs/scenarioOutline"}}, "scenarios": {"type": "array", "items": {"$ref": "#/$defs/groupScenario"}}, "corridor": {"$ref": "#/$defs/groupCorridor"},
        "dossier_prose": {"$ref": "#/$defs/nodes"}, "prose": {"$ref": "#/$defs/nodes"}
      }, "additionalProperties": false
    },
    "monsterBatch": {
      "type": "object", "required": ["id", "entry_ids", "owner", "source_kind", "source_anchors", "projection_targets"],
      "properties": {"id": {"$ref": "#/$defs/reservationBatchId"}, "entry_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entryId"}}, "owner": {"type": "string", "minLength": 1}, "source_kind": {"const": "original-fiction"}, "source_anchors": {"$ref": "#/$defs/stringList"}, "projection_targets": {"$ref": "#/$defs/stringList"}}, "additionalProperties": false
    },
    "entryBestiary": {
      "type": "object", "required": ["kind", "formation", "battlefield_role", "scope_note"],
      "properties": {"kind": {"enum": ["common-organism", "mutant-organism", "machine", "biomechanical-organism", "infected-person", "person", "humanoid", "habitat", "event"]}, "formation": {"enum": ["single", "group", "site", "event"]}, "battlefield_role": {"$ref": "#/$defs/localized"}, "scope_note": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "entryLinks": {
      "type": "object",
      "properties": {"states": {"type": "array", "items": {"$ref": "#/$defs/stateId"}}, "houses": {"type": "array", "items": {"$ref": "#/$defs/houseId"}}, "theaters": {"type": "array", "items": {"$ref": "#/$defs/theaterId"}}, "synthetics": {"type": "array", "items": {"$ref": "#/$defs/syntheticId"}}, "scenarios": {"$ref": "#/$defs/stringList"}},
      "additionalProperties": false
    },
    "monsterEntry": {
      "type": "object", "required": ["id", "display_name", "bestiary", "group_id", "role_class", "links", "prose"],
      "properties": {"id": {"$ref": "#/$defs/entryId"}, "display_name": {"$ref": "#/$defs/localized"}, "bestiary": {"$ref": "#/$defs/entryBestiary"}, "group_id": {"$ref": "#/$defs/groupId"}, "role_class": {"$ref": "#/$defs/localized"}, "links": {"$ref": "#/$defs/entryLinks"}, "prose": {"$ref": "#/$defs/nodes"}}, "additionalProperties": false
    },
    "monsterContent": {
      "type": "object", "required": ["entries"],
      "properties": {"id": {"$ref": "#/$defs/batchId"}, "owner": {"type": "string", "minLength": 1}, "source_kind": {"const": "original-fiction"}, "source_anchors": {"$ref": "#/$defs/stringList"}, "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/monsterEntry"}}}, "additionalProperties": false
    },
    "arc": {
      "type": "object", "required": ["id", "title", "house_ids", "theater_ids", "synthetic_classes", "group_ids", "acts", "owner", "source_kind", "source_anchors"],
      "properties": {"id": {"$ref": "#/$defs/arcId"}, "title": {"$ref": "#/$defs/localized"}, "house_ids": {"type": "array", "items": {"$ref": "#/$defs/houseId"}}, "theater_ids": {"type": "array", "items": {"$ref": "#/$defs/theaterId"}}, "synthetic_classes": {"type": "array", "items": {"enum": ["H", "F", "V"]}}, "group_ids": {"type": "array", "items": {"$ref": "#/$defs/groupId"}}, "acts": {"type": "array", "items": {"$ref": "#/$defs/act"}}, "owner": {"type": "string", "minLength": 1}, "source_kind": {"const": "original-fiction"}, "source_anchors": {"$ref": "#/$defs/stringList"}}, "additionalProperties": false
    },
    "relation": {
      "type": "object", "required": ["from", "kind", "to", "reason"],
      "properties": {"from": {"type": "string", "pattern": "^(?:__EXAMPLE__:[A-Za-z0-9_-]+|S(?:0[1-9]|1[0-6])|H[CP][0-9]{2}|XT0[1-5]|[HFV][0-9]{2}|K[0-9]{3,4}|G(?:0[1-9]|1[0-9]|2[0-7]))$"}, "kind": {"enum": ["operates_in", "pressures", "custodied_by", "supply-rivalry", "supply-partner", "platform-rivalry", "affiliate", "build-contract", "retail-rivalry"]}, "to": {"type": "string", "pattern": "^(?:__EXAMPLE__:[A-Za-z0-9_-]+|S(?:0[1-9]|1[0-6])|H[CP][0-9]{2}|XT0[1-5]|[HFV][0-9]{2}|K[0-9]{3,4}|G(?:0[1-9]|1[0-9]|2[0-7]))$"}, "from_label": {"$ref": "#/$defs/localized"}, "to_label": {"$ref": "#/$defs/localized"}, "reason": {"$ref": "#/$defs/localized"}}, "additionalProperties": false
    },
    "change": {
      "type": "object", "required": ["id", "summary", "owner"],
      "properties": {"id": {"type": "string", "pattern": "^(?:CL-[0-9]{4}|__EXAMPLE__:change)$"}, "summary": {"$ref": "#/$defs/localized"}, "owner": {"type": "string", "minLength": 1}}, "additionalProperties": false
    },
    "unaffiliated": {
      "type": "object", "required": ["name", "character_id"],
      "properties": {"name": {"$ref": "#/$defs/localized"}, "character_id": {"type": "string", "minLength": 1}}, "additionalProperties": false
    },
    "atlas": {
      "type": "object",
      "required": ["schema", "document", "writing_contract", "projection_pages", "states", "humans", "unaffiliated", "houses", "theaters", "synthetics", "hostile_groups", "monster_batches", "monster_contents", "arcs", "relations", "change_ledger"],
      "properties": {
        "schema": {"const": "world-narrative-atlas.v2"},
        "document": {"$ref": "#/$defs/document"},
        "writing_contract": {"$ref": "#/$defs/writingContract"},
        "projection_pages": {"type": "object", "patternProperties": {"^[A-Za-z0-9_][A-Za-z0-9_/-]*$": {"$ref": "#/$defs/projectionPage"}}, "additionalProperties": false},
        "states": {"type": "array", "items": {"$ref": "#/$defs/state"}},
        "humans": {"type": "array", "items": {"$ref": "#/$defs/human"}},
        "unaffiliated": {"type": "object", "patternProperties": {"^(?:__EXAMPLE__:unaffiliated|K[0-9]{4})$": {"$ref": "#/$defs/unaffiliated"}}, "additionalProperties": false},
        "houses": {"type": "array", "items": {"$ref": "#/$defs/house"}},
        "theaters": {"type": "array", "items": {"$ref": "#/$defs/theater"}},
        "synthetics": {"type": "array", "items": {"$ref": "#/$defs/synthetic"}},
        "hostile_groups": {"type": "array", "items": {"$ref": "#/$defs/hostileGroup"}},
        "monster_batches": {"type": "array", "items": {"$ref": "#/$defs/monsterBatch"}},
        "monster_contents": {"type": "object", "patternProperties": {"^(?:__EXAMPLE__:batch|M(?!007$)[0-9]{3})$": {"$ref": "#/$defs/monsterContent"}}, "additionalProperties": false},
        "arcs": {"type": "array", "items": {"$ref": "#/$defs/arc"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
        "change_ledger": {"type": "array", "items": {"$ref": "#/$defs/change"}}
      },
      "additionalProperties": false
    }
  }
}
