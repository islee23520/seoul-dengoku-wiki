{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seoul-dengoku.linalab.io/lore/overview/authoring.schema.json",
  "allOf": [
    {
      "$ref": "../authoring.shared.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "properties": {
        "domain": {
          "const": "overview"
        },
        "id": {
          "type": "string",
          "pattern": "^(?:__EXAMPLE__:overview|DOC:[A-Za-z0-9-]+)$"
        },
        "data": {
          "type": "object",
          "required": [
            "consequence"
          ],
          "properties": {
            "consequence": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
