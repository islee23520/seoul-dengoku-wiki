        }
      ],
      "rows": [
        [
          {
            "en": "Surface holdings",
            "ko": "지상 점유"
          },
          {
            "en": "The sixteen states at the opening",
            "ko": "개막일 16국"
          }
        ],
        [
          {
            "en": "Rail locations",
            "ko": "철도 위치"
          },
          {
            "en": "Mapped stations and tracks",
            "ko": "지도에 기록된 역과 선로"
