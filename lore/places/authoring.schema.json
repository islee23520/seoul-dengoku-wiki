{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seoul-dengoku.linalab.io/lore/places/authoring.schema.json",
  "allOf": [
    {
      "$ref": "../authoring.shared.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "properties": {
        "domain": {
          "const": "places"
        },
        "id": {
          "type": "string",
          "pattern": "^(?:__EXAMPLE__:places|DOC:[A-Za-z0-9-]+)$"
        },
        "data": {
          "type": "object",
          "properties": {
            "layer": {
              "type": "string",
              "minLength": 1
            },
            "station_aliases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "aliases", "observed_lines", "source"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                  "observed_lines": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
                  "source": {"type": "string", "format": "uri"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    {"if": {"properties": {"id": {"pattern": "^(?:DOC:|__EXAMPLE__)"}}}, "else": {"properties": {"data": {"required": ["layer"]}}}}
  ]
}
