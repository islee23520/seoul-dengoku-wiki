{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seoul-dengoku.linalab.io/lore/bestiary/authoring.schema.json",
  "allOf": [
    {
      "$ref": "../authoring.shared.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "properties": {
        "domain": {
          "const": "bestiary"
        },
        "id": {
          "type": "string",
          "pattern": "^(?:__EXAMPLE__:bestiary|G(?:0[1-9]|1[0-9]|2[0-7])(?:E[0-9]{2})?|DOC:[A-Za-z0-9-]+)$"
        },
        "data": {
          "type": "object",
          "properties": {
            "ecology": {
              "type": "object",
              "required": [
                "description",
                "variants"
              ],
              "properties": {
                "description": {
                  "$ref": "../authoring.shared.schema.json#/$defs/localizedText"
                },
                "variants": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "source_batch"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^(?:__EXAMPLE__:[A-Za-z0-9_-]+|G(?:0[1-9]|1[0-9]|2[0-7])E[0-9]{2})$"
                      },
                      "source_batch": {
                        "type": "string",
                        "pattern": "^(?:__EXAMPLE__:[A-Za-z0-9_-]+|M(?!007$)[0-9]{3})$"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "integration": {
              "type": "object",
              "required": [
                "manifest",
                "excluded"
              ],
              "properties": {
                "manifest": {
                  "const": "TOOL/tools/wiki/confirmed-integration-manifest.json"
                },
                "excluded": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "kind"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^(?:B[0-9]{3}|M[0-9]{3}|G(?:0[1-9]|1[0-9]|2[0-7]))$"
                      },
                      "kind": {
                        "enum": [
                          "social",
                          "monsters",
                          "groups"
                        ]
                      }
                    },
                    "additionalProperties": false,
                    "allOf": [
                      {"if": {"properties": {"kind": {"const": "social"}}}, "then": {"properties": {"id": {"pattern": "^B[0-9]{3}$"}}}},
                      {"if": {"properties": {"kind": {"const": "monsters"}}}, "then": {"properties": {"id": {"pattern": "^M[0-9]{3}$"}}}},
                      {"if": {"properties": {"kind": {"const": "groups"}}}, "then": {"properties": {"id": {"pattern": "^G(?:0[1-9]|1[0-9]|2[0-7])$"}}}}
                    ]
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    {"if": {"properties": {"id": {"pattern": "^(?:DOC:|__EXAMPLE__)"}}}, "else": {"properties": {"data": {"required": ["ecology", "integration"]}}}}
  ]
}
