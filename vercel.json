{
  "outputDirectory": "docs-site/dist",
  "buildCommand": null,
  "rewrites": [
    {
      "source": "/prototype/:path*",
      "destination": "https://character-forge-iota.vercel.app/prototype/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://character-forge-iota.vercel.app/_next/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://character-forge-iota.vercel.app/assets/:path*"
    },
    {
      "source": "/render-lab/:path*",
      "destination": "https://character-forge-iota.vercel.app/render-lab/:path*"
    },
    {
      "source": "/textures/:path*",
      "destination": "https://character-forge-iota.vercel.app/textures/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://character-forge-iota.vercel.app/api/:path*"
    }
  ]
}
