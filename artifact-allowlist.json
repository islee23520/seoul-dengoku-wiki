    "portrait-tokens": "^person-[0-9]{4}\\.json$",
    "portrait-reviews": "^person-[0-9]{4}\\.json$",
    "portraits": "^person-[0-9]{4}\\.png$",
    "clan-crests": "^(?:[a-z0-9-]+\\.svg|index\\.json)$",
