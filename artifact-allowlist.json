    "state-flags": "^(?:S(?:0[1-9]|1[0-6])|concept-sheet)\\.webp$"
  },
  "assets": {
    "pattern": "^(.+)-[A-Za-z0-9_-]{8}\\.(?:js|css)$",
    "libraryDirectory": "lib",
    "appChunks": [
      "CategoriesPage",
      "CharacterDraftPage",
      "CharacterArtToolPage",
      "DocumentsPage",
      "FamiliesPage",
      "FamilyDetailPage",
      "FamilyTree",
      "FeedbackPage",
      "LicensePage",
      "OpeningTerritoryMap",
      "PeoplePage",
      "PersonDetailPage",
      "RelationsGraphPage",
      "TimelineOverview",
      "clanFamilyCatalog",
      "index",
      "peopleCatalog",
      "portrait-catalog",
      "retainerGraph",
      "rolldown-runtime",
      "world"
    ]
  },
  "routes": [
    { "path": "/", "disposition": "page" },
    { "path": "/states", "disposition": "page" },
    { "path": "/states/:stateSlug", "disposition": "page" },
    { "path": "/updates", "disposition": "page" },
    { "path": "/feedback", "disposition": "page" },
    { "path": "/license", "disposition": "page" },
    { "path": "/people", "disposition": "page" },
    { "path": "/people/relations", "disposition": "page" },
    { "path": "/people/draft", "disposition": "page" },
    { "path": "/tools/character-art", "disposition": "page" },
    { "path": "/people/art", "disposition": "page" },
    { "path": "/people/:personId", "disposition": "page" },
    { "path": "/families", "disposition": "page" },
    { "path": "/families/:clanId", "disposition": "page" },
    { "path": "/documents", "disposition": "page" },
    { "path": "/categories", "disposition": "page" },
    { "path": "/categories/:categoryId", "disposition": "page" },
    { "path": "/world/Cast-State-:stateId", "disposition": "legacy-redirect" },
    { "path": "/world/Core-Characters", "disposition": "legacy-redirect" },
    { "path": "/world/Cast-Unaffiliated", "disposition": "legacy-redirect" },
    { "path": "/world/Cast-Index", "disposition": "legacy-redirect" },
    { "path": "/world/Cast-Index-S4", "disposition": "legacy-redirect" },
    { "path": "/world/Cast-Corridors-Index", "disposition": "legacy-redirect" },
    { "path": "/world/Cast-Relations", "disposition": "legacy-redirect" },
    { "path": "/regions/*", "disposition": "legacy-redirect" },
    { "path": "/world/regions/*", "disposition": "legacy-redirect" },
    { "path": "/en/:domain/:slug", "disposition": "article" },
    { "path": "/:domain/:slug", "disposition": "article" },
    { "path": "/:domain/", "disposition": "article" },
    { "path": "*", "disposition": "fallback-home" }
  ]
}
