{
  "name": "janseon-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repository tooling only. Not shipped with the Unity game.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node policy/normalize-creative-names.mjs && node wiki/test-build-wiki.mjs && node wiki/test-unity-architecture-docs.mjs",
    "test:names": "node policy/normalize-creative-names.mjs",
    "write:names": "node policy/normalize-creative-names.mjs --write",
    "test:design-store": "node --test store/test-design-store-capture.mjs",
    "test:mda-store": "node --test design-store/test-mda-store.mjs",
    "remote:setup": "node unity/setup-unity-remote.mjs",
    "remote:start": "node unity/start-unity-remote.mjs",
    "remote:cli": "node unity/run-unity-remote-cli.mjs",
    "test:unity-remote": "node --test unity/test-unity-remote.mjs",
    "deploy:hub:test": "node --test deploy/test-hub-deploy.mjs deploy/test-hub-docker-contract.mjs",
    "deploy:hub:build": "node deploy/build-hub-docker.mjs",
    "deploy:hub": "node deploy/deploy-hub.mjs"
  },
  "dependencies": {
    "entities": "8.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "parse5": "8.0.1"
  }
}
