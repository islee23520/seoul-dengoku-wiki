    "traits": [
      {
        "id": "reject-one-sided-extension-files",
        "name": {
          "ko": "한쪽 연장 철 거부",
          "en": "Reject One-Sided Extension Files"
        },
        "description": {
          "ko": "배나경은 한쪽 날인이나 대행 날인을 계약 연장의 충분한 근거로 받아들이지 않는다.",
          "en": "Bae Nagyeong does not accept a one-sided or deputy stamp as sufficient grounds for a contract extension."
        },
        "behavior": {
          "ko": "양쪽 사본의 잉크 색을 구분하고 한쪽만 날인된 연장은 철하지 않으며 대행 날인을 연장이라 부르는 문구를 지운다.",
          "en": "They distinguish the two sides' copies by ink color, refuse to file one-sided extensions, and erase wording that calls a deputy stamp an extension."
        },
        "stress": {
          "ko": "빈 서명란이 외부 파견 동의로 바뀔 우려가 있으면 사본의 날인 조건과 연장 문구를 더 엄격히 살필 수 있다.",
          "en": "If blank signatures risk becoming consent to outside deployment, they may scrutinize copies' stamp conditions and extension wording more closely."
        },
        "relationship": {
          "ko": "배초담과 사본을 교환하면서도 공동 날인 없는 연장을 요구하는 상대에게는 절차적 선을 지킬 수 있다.",
          "en": "They may exchange copies with Bae Chodam while maintaining procedural boundaries against requests for extensions lacking both sides' stamps."
        },
        "effects": []
      },
      {
        "id": "preserve-blank-guarantee-fields",
        "name": {
          "ko": "빈 보증 칸 보존",
          "en": "Preserve Blank Guarantee Fields"
        },
        "description": {
          "ko": "배나경은 실종된 임하준의 보증인 공란을 임의의 동의로 채워서는 안 된다고 여긴다.",
          "en": "Bae Nagyeong treats the missing Im Hajun's blank guarantor field as something that must not be filled with presumed consent."
        },
        "behavior": {
          "ko": "총관이 없는 서명란에서는 펜을 놓고 임하준의 보증인 칸을 공란으로 지킨다.",
          "en": "They set down the pen at signature fields lacking the superintendent and preserve Im Hajun's guarantor field as blank."
        },
        "stress": {
          "ko": "자신의 사본이 외부 파견 동의의 증거로 쓰일 가능성이 보이면 공란의 의미를 더 명확히 남기려 할 수 있다.",
          "en": "If their copy could be used as evidence of consent to outside deployment, they may try to record the meaning of its blanks more explicitly."
        },
        "relationship": {
          "ko": "한소미의 공동통치안을 서명란에 올리되 이를 실종자의 보증이나 자동 연장으로 대신하지 않도록 선을 그을 수 있다.",
          "en": "They may place Han Somi's joint-governance plan in signature fields while separating it from the missing person's guarantee or automatic extension."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "급수 사본을 색으로 구분하고 한쪽 날인 연장을 거부했다. 계약 조건 판단과 우회 급수 행동을 반영하며 협상 전권은 없다.",
      "en": "He distinguishes water-contract copies by ink and rejects one-sided extensions. Conditional judgment and alternate supply are reflected, not plenipotentiary authority."
    },
