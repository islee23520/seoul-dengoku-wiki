        "name": {
          "ko": "붕괴 보고 즉시 조치",
          "en": "Act on collapse reports"
        },
        "description": {
          "ko": "2125년 침수 구간 붕괴 보고를 미루지 않고 당장 폐쇄했다.",
          "en": "In 2125 he did not sit on the collapse report of a flooded section and closed it on the spot. By this deed the signature of the work-squad courier post rose into the ledger."
        },
        "behavior": {
          "ko": "2125년 침수 구간 붕괴 보고를 미루지 않고 당장 폐쇄했다.",
          "en": "In 2125 he did not sit on the collapse report of a flooded section and closed it on the spot. By this deed the signature of the work-squad courier post rose into the ledger."
        },
        "stress": {
          "ko": "작업반 전령 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the work-squad courier duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
