    "skills": [
      {
        "id": "stock-recording",
        "name": {
          "ko": "출고 기록",
          "en": "Dispatch recording"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "흔적 보존",
          "en": "Preserves traces"
        },
        "description": {
          "ko": "화재에서 인명 장부를 구조하고 동부 군량 출고를 기록한다. 비공개 배급을 의심하지만 공개를 일반 원칙으로 삼았다는 근거는 없다.",
          "en": "Rescues the register of people and records eastern military dispatches. Questions hidden rations without evidence of universal disclosure principles."
        },
        "behavior": {
          "ko": "확인된 선택에서는 흔적 보존을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "기록 소실 때 출고 흔적 확인에 매달릴 수 있다.",
          "en": "May concentrate on dispatch traces when records disappear."
        },
        "relationship": {
          "ko": "전나경과 열쇠를 나누며 남윤경의 비공개 배급을 의심한다.",
          "en": "Shares keys with Jeon Nagyeong and questions Nam Yungyeong’s hidden rations."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "교구 명부와 선거 봉인을 지켜 다음 대주교 비밀 선거의 절차와 명동역 인준이 끊기지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "교구 명부와 선거 봉인이 지워져 교황 없는 선출의 정당성 논쟁에서 자신의 서명이 의심받는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "전나경과 열쇠를 나누며 남윤경의 비공개 배급을 의심한다.",
          "en": "Shares keys with Jeon Nagyeong and questions Nam Yungyeong’s hidden rations."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "화재에서 인명 장부를 구조하고 동부 군량 출고를 기록한다. 비공개 배급을 의심하지만 공개를 일반 원칙으로 삼았다는 근거는 없다.",
      "en": "Rescues the register of people and records eastern military dispatches. Questions hidden rations without evidence of universal disclosure principles."
    },
