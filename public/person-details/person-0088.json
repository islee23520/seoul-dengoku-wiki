    "traits": [
      {
        "id": "k423-trait-1",
        "name": {
          "ko": "공개하되 인준하지 않음",
          "en": "Disclosure without ratification"
        },
        "description": {
          "ko": "유언 공개와 서부안 인준을 별개로 다룬다.",
          "en": "Treats disclosure of wills separately from approval of the western plan."
        },
        "behavior": {
          "ko": "유언 공개와 서부안 인준을 별개로 다룬다.",
          "en": "Treats disclosure of wills separately from approval of the western plan."
        },
        "stress": {
          "ko": "취임 뒤에도 확대안을 인준하지 않는다.",
          "en": "Still refuses the expansion proposal after taking office."
        },
        "relationship": {
          "ko": "임초원과 기술 동맹을 유지하고 수문국과 원본을 공동 봉인한다.",
          "en": "Maintains a technical alliance with Im Chowon and jointly seals originals with the Sluice."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "취임 뒤 임하준의 세 유언을 공개하고 한재목의 서부 확대안을 인준하지 않았다. 공정 원본을 수문국과 공동 봉인하는 데 동의했으나 유언의 내용이나 실종 경위는 공개 행동만으로 확정할 수 없다.",
      "en": "After taking office, he disclosed Im Hajun’s three wills and refused the western expansion proposal. He agreed to seal process originals jointly with the Sluice, but disclosure alone establishes neither the wills’ contents nor the disappearance’s cause."
    },
