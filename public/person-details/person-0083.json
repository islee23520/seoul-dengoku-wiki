    "traits": [
      {
        "id": "stop-for-missing-pages",
        "name": {
          "ko": "쪽수 빠지면 중지",
          "en": "Stop for Missing Pages"
        },
        "description": {
          "ko": "여다솜은 인증 사본의 완전성을 회의 진행보다 앞세운다.",
          "en": "Yeo Dasom places the completeness of certification copies ahead of meeting progress."
        },
        "behavior": {
          "ko": "인증 사본의 쪽수가 빠지면 필기를 멈추고 인질 대체 칸이 빈 초안은 철하지 않는다.",
          "en": "Yeo Dasom stops writing when certification pages are missing and refuses to file drafts with blank hostage-alternative fields."
        },
        "stress": {
          "ko": "연구자 명단이 분할 복속의 할당표가 될 우려가 있으면 불완전한 문서를 남기는 데 더욱 신중할 수 있다.",
          "en": "If researcher lists risk becoming allocation tables for divided subjugation, Yeo Dasom may be especially cautious about recording incomplete documents."
        },
        "relationship": {
          "ko": "정호준의 초안을 옮기고 정유라의 종료조건을 묶을 때도 필요한 문서가 빠지지 않는지를 중시할 수 있다.",
          "en": "When transcribing Jeong Hojun's draft and bundling Jeong Yura's termination clauses, Yeo Dasom may emphasize that required documents are not omitted."
        },
        "effects": []
      },
      {
        "id": "smaller-nations-review-first",
        "name": {
          "ko": "약소국 열람 먼저",
          "en": "Smaller Nations Review First"
        },
        "description": {
          "ko": "여다솜은 기술공유 자료에서 약소국 대표의 선행 열람을 중시한다.",
          "en": "Yeo Dasom prioritizes smaller nations' representatives reviewing technical-sharing materials first."
        },
        "behavior": {
          "ko": "약소국 대표가 기술공유 사본을 열람한 뒤에만 강국 자리에 올린다.",
          "en": "Yeo Dasom places technical-sharing copies before powerful nations only after smaller nations' representatives have reviewed them."
        },
        "stress": {
          "ko": "기술원장이 강국 급수계약의 부록으로 밀릴 우려가 있으면 선행 열람 순서를 더욱 고수할 수 있다.",
          "en": "If the technical ledger risks being reduced to an appendix of a powerful nation's water contract, Yeo Dasom may insist more firmly on that review order."
        },
        "relationship": {
          "ko": "우오름과 급수 최저선 사본을 교환할 때도 자료 접근이 강국의 조건에 종속되지 않도록 중시할 수 있다.",
          "en": "In exchanging minimum-water copies with U Oreum, Yeo Dasom may seek to keep access independent of powerful nations' conditions."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "공유 사본과 종료조건을 기록하고 정전 중 수술을 지속했다. 이례적 일화는 제한 숙련으로 남기며 의료 경력 전반이나 조약 체결권은 만들지 않는다.",
      "en": "She records sharing copies and termination clauses and continued surgery during a blackout. That episode supports limited skill, not a full medical career or treaty authority."
    },
