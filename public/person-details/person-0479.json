    "skills": [
      {
        "id": "communal-scale-substitution",
        "name": {
          "ko": "공동 저울 교체",
          "en": "Communal scale substitution"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "k479-disposition",
        "name": {
          "ko": "사적 저울 거부",
          "en": "Rejecting private scales"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 교도. 직함은 경매 서기.",
          "en": "Office. Rank: lay instructor. Title: auction clerk."
        },
        "stress": {
          "ko": "공포. 경매 서기 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the auction clerk duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k479-choice",
        "name": {
          "ko": "공동 계량 선택",
          "en": "Choosing shared measurement"
        },
        "description": {
          "ko": "일화. 2125년 파렴치한 저울을 경매장에서 걷어 공동 저울로 바꿨다. 이 일로 경매 서기 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he took a dishonest scale off the auction floor and replaced it with a common scale. By this deed the signature of the auction clerk post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "stress": {
          "ko": "공포. 경매 서기 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the auction clerk duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "부정 저울을 걷어 공동 저울로 바꿨다. 공통 기준을 택한 행동은 있으나 정밀 계측 경력은 없다.",
      "en": "Replaces a dishonest scale with a communal one. Choosing a common standard does not establish precision metrology experience."
    },
