      {
        "id": "displaced-queue-representation",
        "name": {
          "ko": "피난 대기열 대표",
          "en": "Displaced queue representation"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "줄을 해산시키지 않음",
          "en": "Keeps the queue together"
        },
        "description": {
          "ko": "피난 인파가 몰리자 배급 중단 요구를 밀어내고 원장을 유지했다. 임시표와 비상배급 마차로 줄을 이어 간다.",
          "en": "Keeps the register when displaced crowds arrive and pushes back against suspended rations. Sustains the queue with temporary tickets and relief carts."
        },
        "behavior": {
          "ko": "확인된 선택에서는 줄을 해산시키지 않음을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "배급 중단 앞에서 인파 유지에 힘을 쏟을 수 있다.",
          "en": "May focus on keeping people together when rations are threatened."
        },
        "relationship": {
          "ko": "천솔빛의 줄에서 인파를 대표하고 전나경의 마차를 우선한다.",
          "en": "Represents the crowd in Cheon Solbit’s queue and prioritizes Jeon Nagyeong’s carts."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "교구 명부와 선거 봉인을 지켜 다음 대주교 비밀 선거의 절차와 명동역 인준이 끊기지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "교구 명부와 선거 봉인이 지워져 교황 없는 선출의 정당성 논쟁에서 자신의 서명이 의심받는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "천솔빛의 줄에서 인파를 대표하고 전나경의 마차를 우선한다.",
          "en": "Represents the crowd in Cheon Solbit’s queue and prioritizes Jeon Nagyeong’s carts."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "피난 인파가 몰리자 배급 중단 요구를 밀어내고 원장을 유지했다. 임시표와 비상배급 마차로 줄을 이어 간다.",
      "en": "Keeps the register when displaced crowds arrive and pushes back against suspended rations. Sustains the queue with temporary tickets and relief carts."
    },
