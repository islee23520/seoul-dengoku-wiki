    "skills": [
      {
        "id": "k118-officer-training",
        "name": {
          "ko": "장교단 훈련",
          "en": "Officer corps training"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "k118-choice",
        "name": {
          "ko": "보호와 강제를 함께",
          "en": "Protection mixed with coercion"
        },
        "description": {
          "ko": "부하를 가족처럼 책임지되 훈련 중 이탈은 용서하지 않는다. 부품 대신 복무 등록을 표준 교범에 넣고 싶어 한다.",
          "en": "He took responsibility for his men like family but never forgave desertion during training. He wanted to put service registration in place of parts into the standard manual."
        },
        "behavior": {
          "ko": "일화. 2125년 역사 화재 때 인명 장부부터 꺼내 들고 나왔다. 이 일로 고덕 장교단 교관 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In the 2125 station fire he carried out the roster of lives first. By this deed the signature of the Godeok officer corps instructor post rose into the ledger."
        },
        "stress": {
          "ko": "공포. 규격맹의 시민권 규격이 고덕 훈련장을 뚫고 들어와 장교 호적이 빈 명부가 되는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That the The Gauge's citizenship standard would pierce the Godeok training ground and the officer registry would become an empty roster. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 김우찬의 작전표를 훈련으로 번역하는 지휘 관계이고, 서남 경비대장 이강묵과 차단문 전술을 거래하며, 백온의 가족 명부를 강제복무와 묶어 원한을 산다.",
          "en": "Relations. A command relation translating Kim Woochan's operations table into training, trading barrier-gate tactics with Lee Gangmuk, the southwest guard captain, and earning grudges by binding Baek On's family roster to forced service."
        },
        "effects": []
      },
      {
        "id": "k118-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 병장. 직함은 고덕 장교단 교관. 훈련 실적과 가족 배급을 함께 공개하지만, 비밀 결사 암호는 교관 수첩에만 남겨 공식 명령망을 우회한다.",
          "en": "Office. Rank: sergeant. Title: Godeok officer corps instructor. He published training records and family rations together but kept the secret society's codes only in the instructor's notebook, bypassing the official order network."
        },
        "behavior": {
          "ko": "관직. 품계 병장. 직함은 고덕 장교단 교관. 훈련 실적과 가족 배급을 함께 공개하지만, 비밀 결사 암호는 교관 수첩에만 남겨 공식 명령망을 우회한다.",
          "en": "Office. Rank: sergeant. Title: Godeok officer corps instructor. He published training records and family rations together but kept the secret society's codes only in the instructor's notebook, bypassing the official order network."
        },
        "stress": {
          "ko": "공포. 규격맹의 시민권 규격이 고덕 훈련장을 뚫고 들어와 장교 호적이 빈 명부가 되는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That the The Gauge's citizenship standard would pierce the Godeok training ground and the officer registry would become an empty roster. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 김우찬의 작전표를 훈련으로 번역하는 지휘 관계이고, 서남 경비대장 이강묵과 차단문 전술을 거래하며, 백온의 가족 명부를 강제복무와 묶어 원한을 산다.",
          "en": "Relations. A command relation translating Kim Woochan's operations table into training, trading barrier-gate tactics with Lee Gangmuk, the southwest guard captain, and earning grudges by binding Baek On's family roster to forced service."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "일화. 2125년 역사 화재 때 인명 장부부터 꺼내 들고 나왔다. 이 일로 고덕 장교단 교관 자리의 서명이 장부에 올랐다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Anecdote. In the 2125 station fire he carried out the roster of lives first. By this deed the signature of the Godeok officer corps instructor post rose into the ledger. Titles and ambitions are not treated as accomplished authority or results."
    },
