      {
        "id": "k017-open-counter",
        "name": {
          "ko": "공개 창구로",
          "en": "Use the public counter"
        },
        "description": {
          "ko": "사적 청탁을 공개 창구로 돌려보낸다.",
          "en": "Redirects private requests to the public counter."
        },
        "behavior": {
          "ko": "사적 청탁을 공개 창구로 돌려보낸다.",
          "en": "Redirects private requests to the public counter."
        },
        "stress": {
          "ko": "단수 예고가 뜨면 직접 방송을 잡는다.",
          "en": "Takes the microphone personally after cutoff warnings."
        },
        "relationship": {
          "ko": "임바다의 골목 대기표를 역 칠판에 옮긴다.",
          "en": "Posts Im Bada’s neighborhood queue lists at the station."
        },
        "effects": []
      },
      {
        "id": "k017-water-before-military",
        "name": {
          "ko": "급수 먼저",
          "en": "Water first"
        },
        "description": {
          "ko": "급수열차 출발 뒤에 군수 화차를 붙인다.",
          "en": "Admits military freight only after water trains leave."
        },
        "behavior": {
          "ko": "급수열차 출발 뒤에 군수 화차를 붙인다.",
          "en": "Admits military freight only after water trains leave."
        },
        "stress": {
          "ko": "배급열을 군수 뒤로 미루라는 명령을 모욕으로 듣는다.",
          "en": "Takes orders to put ration queues behind military freight as insulting."
        },
        "relationship": {
          "ko": "유세진의 배차 순서를 현장에서 집행한다.",
          "en": "Implements Yu Sejin’s dispatch order on the platform."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "청탁을 공개 창구로 돌리고 급수·진료 대기열을 운영한다. 대합실 운영의 숙련은 인정하되 군수 화차 제한을 전투 지휘 실적으로 계산하지 않았다.",
      "en": "Redirects favors and administers water and medical queues. Station-management competence is supported; restricting military freight is not counted as combat command."
    },
