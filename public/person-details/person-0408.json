    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "교전 자제",
          "en": "Restrains escalation"
        },
        "description": {
          "ko": "호송 인원을 배치하고 봉인 명령 전 발포 권한을 주지 않는다. 발포를 자랑하는 사람을 호송에서 내린다.",
          "en": "Deploys escort personnel and withholds firing authority before sealed orders. Removes those who boast about shooting from escorts."
        },
        "behavior": {
          "ko": "확인된 선택에서는 교전 자제을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "무장 사절 접근 때 명령 확인을 먼저 할 수 있다.",
          "en": "May check orders first when armed envoys approach."
        },
        "relationship": {
          "ko": "선한솜과 교대를 나누며 하서진의 초안을 길에서 지킨다.",
          "en": "Shares shifts with Seon Hansom and protects Ha Seojin’s drafts on the road."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "시청역과 정동 외곽 순찰을 표준 서식의 현장 뼈대로 키워 강국의 호위비를 계약호위로 대체한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "순찰이 암사 순찰열차와 마주쳐 교전 한 방으로 공동교섭이 전쟁으로 바뀌는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
