    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "대상 취급에 이의",
          "en": "Objects to being treated as a lot"
        },
        "description": {
          "ko": "시작가 없는 번호를 남긴 사건 뒤 조정 호가에 이의를 올리고 증서가 물건 번호로 불리지 않기를 청한다. 낙찰 결과는 확인되지 않는다.",
          "en": "After a number is left without an opening price, challenges adjusted bids and asks that certificates not be treated as goods numbers. The award outcome is unknown."
        },
        "behavior": {
          "ko": "확인된 선택에서는 대상 취급에 이의을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "번호만 남을 때 호가와 명칭에 항의할 수 있다.",
          "en": "May challenge bids and labels when reduced to a number."
        },
        "relationship": {
          "ko": "은태호의 호가에 이의를 내고 윤서린의 빈칸 복원을 원한다.",
          "en": "Challenges Eun Taeho’s bids and seeks restoration of Yun Seorin’s blank entry."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "교구 명부와 선거 봉인을 지켜 다음 대주교 비밀 선거의 절차와 명동역 인준이 끊기지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "교구 명부와 선거 봉인이 지워져 교황 없는 선출의 정당성 논쟁에서 자신의 서명이 의심받는 것.",
