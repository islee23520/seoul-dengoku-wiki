    "traits": [
      {
        "id": "block-unsigned-departures",
        "name": {
          "ko": "서명 없는 출발 저지",
          "en": "Block Unsigned Departures"
        },
        "description": {
          "ko": "유은영은 배차표와 서명이 없는 출발을 그대로 진행시키지 않는 편이다.",
          "en": "Yu Eunyoung favors stopping departures that lack a dispatch sheet and signature."
        },
        "behavior": {
          "ko": "배차표 없는 열차를 세워 서명 없는 출발을 막았다.",
          "en": "Yu Eunyoung stopped a train without a dispatch sheet and blocked its unsigned departure."
        },
        "stress": {
          "ko": "출발 요구와 기록 누락이 충돌한다면 서명 없는 출발을 막는 쪽을 택할 수 있다.",
          "en": "If a demand to depart conflicts with missing records, Yu Eunyoung may choose to block the unsigned departure."
        },
        "relationship": {
          "ko": "출발을 요구하는 상대에게는 구두 주장보다 배차표와 서명을 중시할 수 있다.",
          "en": "With someone seeking departure, Yu Eunyoung may prioritize the dispatch sheet and signature over verbal assertions."
        },
        "effects": []
      },
      {
        "id": "position-boundaries",
        "name": {
          "ko": "직위 경계",
          "en": "Position Boundaries"
        },
        "description": {
          "ko": "유은영은 자기 직위의 기록과 열쇠를 넘어서는 권한을 만들지 않는 편이다.",
          "en": "Yu Eunyoung avoids inventing authority beyond the position's records and keys."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 넘기며 기록 없는 출발을 임의로 정당화하지 않는다.",
          "en": "Yu Eunyoung transfers only the position's keys and records and does not arbitrarily justify an undocumented departure."
        },
        "stress": {
          "ko": "당직 공백에 대한 우려와 출발 요구가 겹치더라도 없는 권한을 만들어 해결하지 않으려 할 수 있다.",
          "en": "Even when fear of a duty gap coincides with departure demands, Yu Eunyoung may resist resolving them through invented authority."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 넘길 수 있는 기록과 권한의 경계를 분명히 하려 할 수 있다.",
          "en": "During handovers with senior duty staff, Yu Eunyoung may clarify the boundaries of transferable records and authority."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "배차표 없는 열차를 세웠다. 출발 확인의 실적은 있으나 차량 운전·정비나 조직 통솔은 확인되지 않는다.",
      "en": "He stopped a train without a dispatch sheet. Departure checks are supported, not driving, maintenance, or organizational command."
    },
