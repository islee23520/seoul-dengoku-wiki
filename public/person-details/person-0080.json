    "skills": [
      {
        "id": "evidence",
        "name": {
          "ko": "피해 표본·명부 보존",
          "en": "Preserving victim samples and registers"
        },
        "rating": 60
      },
      {
        "id": "dose",
        "name": {
          "ko": "부족 약재 배분",
          "en": "Scarce-medicine allocation"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "keep-samples-sealed",
        "name": {
          "ko": "표본 봉인 고수",
          "en": "Keep Samples Sealed"
        },
        "description": {
          "ko": "배서율은 분노를 드러내는 일보다 피해 증거의 봉인을 지키는 일을 우선한다.",
          "en": "Bae Seoyul prioritizes keeping evidence sealed over expressing anger."
        },
        "behavior": {
          "ko": "피해자 명부와 잔여 약봉지를 이중 봉인하고 치료길드와 안전심사가 함께 있을 때만 감정을 연다.",
          "en": "Bae Seoyul double-seals the victim register and remaining medicine packets, opening appraisal only with the treatment guild and safety review present together."
        },
        "stress": {
          "ko": "가짜 약이 인증 도장을 위조해 쓸 우려가 커지면 표본 봉인을 더욱 양보하지 않을 수 있다.",
          "en": "If counterfeit medicine risks using forged certification stamps, Bae Seoyul may become still less willing to compromise sample seals."
        },
        "relationship": {
          "ko": "류은비에게 표본을 맡길 때 치료 중립과 봉인 보존이 함께 지켜지는지를 중시할 수 있다.",
          "en": "When entrusting samples to Ryu Eunbi, Bae Seoyul may look for both treatment neutrality and intact seals."
        },
        "effects": []
      },
      {
        "id": "open-channels-for-anger",
        "name": {
          "ko": "분노의 공개 경로",
          "en": "Open Channels for Anger"
        },
        "description": {
          "ko": "배서율은 가짜 약에 대한 분노를 공개 검증과 제조 경로 기록의 요구로 향하게 한다.",
          "en": "Bae Seoyul channels anger over counterfeit medicine into demands for public verification and manufacturing-route records."
        },
        "behavior": {
          "ko": "정호준에게 약효 검증을 요구하고 가짜 약의 제조 경로와 보호국 창고를 공개 원장에 올리려 한다.",
          "en": "Bae Seoyul demands efficacy verification from Jeong Hojun and seeks public-ledger entries for counterfeit production routes and protectorate warehouses."
        },
        "stress": {
          "ko": "기술 인증이 독의 포장이 될 우려가 커지면 숨긴 분노를 공개 검증 요구로 표현할 수 있다.",
          "en": "If technical certification risks becoming a wrapper for poison, Bae Seoyul may express restrained anger through demands for open verification."
        },
        "relationship": {
          "ko": "정호준과의 관계에서는 위로보다 약효 검증을 요구하는 태도가 두드러질 수 있다.",
          "en": "With Jeong Hojun, Bae Seoyul may emphasize demands for efficacy verification rather than reassurance."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "피해 명부와 약봉지를 이중 봉인하며 부족 약재를 나눴다. 피해 증거 보존이 중심이며 피해 경험을 특정 질병으로 단정하지 않는다.",
      "en": "She double-seals victim registers and medicine bags and shared scarce supplies. Evidence preservation is central; victim status does not establish a disease."
    },
