    "traits": [
      {
        "id": "turn-back-private-requests",
        "name": {
          "ko": "사적 요청 되돌리기",
          "en": "Turn Back Private Requests"
        },
        "description": {
          "ko": "주우석은 사적 청탁을 별도로 받아들이기보다 공개 창구로 돌리는 편이다.",
          "en": "Ju Useok favors redirecting private requests to a public channel rather than handling them separately."
        },
        "behavior": {
          "ko": "사적 청탁을 돌려보내고 공개 창구로 보냈다.",
          "en": "Ju Useok turned back a private request and directed it to the public channel."
        },
        "stress": {
          "ko": "사적 청탁이 당직 절차와 충돌한다면 공개 창구를 유지하려 할 수 있다.",
          "en": "If a private request conflicts with duty procedures, Ju Useok may try to preserve the public channel."
        },
        "relationship": {
          "ko": "청탁하는 상대에게 개인적 응답 대신 공개 창구를 안내하려 할 수 있다.",
          "en": "Ju Useok may direct a requester to the public channel instead of offering a personal arrangement."
        },
        "effects": []
      },
      {
        "id": "duty-records-first",
        "name": {
          "ko": "당직 기록 우선",
          "en": "Duty Records First"
        },
        "description": {
          "ko": "주우석은 사적 요구보다 장부와 끊기지 않는 당직을 판단의 기준으로 삼는 편이다.",
          "en": "Ju Useok favors ledger records and uninterrupted duty over private demands as guides for decisions."
        },
        "behavior": {
          "ko": "청탁을 공개 창구로 돌리고 자기 직위의 열쇠와 기록만 인계한다.",
          "en": "Ju Useok redirects requests to the public channel and hands over only the position's keys and records."
        },
        "stress": {
          "ko": "당직 공백이 통행을 볼모로 만들까 우려할 때 장부의 연속성을 더 중시할 수 있다.",
          "en": "Fear that a duty gap could leave passage hostage may heighten concern for ledger continuity."
        },
        "relationship": {
          "ko": "선배 당직과의 관계에서는 사적 약속보다 기록에 근거한 인계를 중시할 수 있다.",
          "en": "With senior duty staff, Ju Useok may favor record-based handovers over private assurances."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "사적 청탁을 공적 창구로 돌린 행동을 반영했다. 물 계측이나 넓은 외교 경력은 제목에서 끌어오지 않았다.",
      "en": "She returned private requests to a public channel. Water metrology and broad diplomacy are not inferred from her title."
    },
