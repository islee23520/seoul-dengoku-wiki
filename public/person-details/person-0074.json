    "traits": [
      {
        "id": "stop-on-conflicting-markings",
        "name": {
          "ko": "표시 충돌에 정지",
          "en": "Stop on Conflicting Markings"
        },
        "description": {
          "ko": "허미리는 화물의 표시와 봉인이 맞지 않으면 출발보다 확인을 우선한다.",
          "en": "Heo Miri prioritizes verification over departure when cargo markings and seals conflict."
        },
        "behavior": {
          "ko": "시료 칸의 봉인끈이 의료 표시와 겹치자 동부행 출발 호각을 끊었다.",
          "en": "She stopped the eastbound departure whistle when a sample wagon’s sealing cord overlapped its medical marking."
        },
        "stress": {
          "ko": "유치선이 군사 보호권의 창구로 변할 우려가 있다면 충돌하는 표시를 그대로 통과시키지 않으려 할 수 있다.",
          "en": "If the sidings risk becoming a channel for military protection claims, she may resist letting conflicting markings pass unchecked."
        },
        "relationship": {
          "ko": "화물 표시의 재확인이 필요하다면 허서겸의 재검색을 칸 앞에서 지원할 수 있다.",
          "en": "She may support Heo Seogyeom’s reinspection at the wagon when cargo markings require verification."
        },
        "effects": []
      },
      {
        "id": "fields-over-words",
        "name": {
          "ko": "말보다 칸 구분",
          "en": "Fields Over Words"
        },
        "description": {
          "ko": "허미리는 화물을 부르는 말보다 칸 번호와 분필 색의 용도 구분을 중시한다.",
          "en": "Heo Miri trusts wagon numbers and chalk-coded uses more than verbal cargo labels."
        },
        "behavior": {
          "ko": "칸 번호를 밤마다 다시 쓰고 병기를 연구 시료로 부르라는 전갈을 분필 옆에 붙이지 않는다.",
          "en": "She rewrites wagon numbers nightly and refuses to place messages relabeling weapons as research samples beside the chalk markings."
        },
        "stress": {
          "ko": "유치 분필이 보호권 매표 번호로 바뀔 위험이 있다면 인증 없는 화물을 유치 자갈에만 세우려 할 수 있다.",
          "en": "If siding chalk risks becoming protection-ticket numbering, she may insist that uncertified cargo remain only on the gravel sidings."
        },
        "relationship": {
          "ko": "김도하가 민가 칸을 앞세우라고 압박한다면 분필 색과 배차 집행을 둘러싸고 마찰이 생길 수 있다.",
          "en": "Kim Doha’s pressure to advance household wagons may cause friction over chalk coding and dispatch enforcement."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "의료 표시와 봉인끈이 충돌한 칸의 출발을 멈췄다. 칸 구분과 이상 판단은 확인되지만 사법권이나 전투 경력은 없다.",
      "en": "She halted a car with conflicting medical marks and seals. Classification and anomaly judgment are documented, not judicial authority or combat experience."
    },
