    "skills": [
      {
        "id": "unsigned-departure-report",
        "name": {
          "ko": "무서명 출발 보고",
          "en": "Unsigned departure reporting"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "k798-disposition",
        "name": {
          "ko": "출발 완료를 유보함",
          "en": "Withholding departure completion"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "She chose the side that kept the duty line unbroken first. She trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 호송 전령. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: registrar. Title: convoy courier. She handed over only the keys and records of her own post, and never made authority she did not hold."
        },
        "stress": {
          "ko": "공포. 호송 전령 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the convoy courier duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 엠마 킹은 무표 열차의 출발 서명 누락을 에바 노바코바에게 알린다. 에바 노바코바는 탑승 증명·창 점유를 대조해 미확인 출발이 다음 배차 원장에 완료로 남지 않게 한다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Emma King reports missing departure signatures on an undocumented train to Eva Nováková. Eva compares boarding certification and slot occupation so unverified departures are not retained as complete in the next ledger."
        },
        "effects": []
      },
      {
        "id": "k798-choice",
        "name": {
          "ko": "무표 운행 정지",
          "en": "Stopping undocumented operation"
        },
        "description": {
          "ko": "일화. 2125년 배차표 없는 열차를 세워 서명 없는 출발을 막았다. 이 일로 호송 전령 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 she stopped a dispatch-sheetless train and blocked an unsigned departure. By this deed the signature of the convoy courier post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 엠마 킹은 무표 열차의 출발 서명 누락을 에바 노바코바에게 알린다. 에바 노바코바는 탑승 증명·창 점유를 대조해 미확인 출발이 다음 배차 원장에 완료로 남지 않게 한다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Emma King reports missing departure signatures on an undocumented train to Eva Nováková. Eva compares boarding certification and slot occupation so unverified departures are not retained as complete in the next ledger."
        },
        "stress": {
          "ko": "공포. 호송 전령 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the convoy courier duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 엠마 킹은 무표 열차의 출발 서명 누락을 에바 노바코바에게 알린다. 에바 노바코바는 탑승 증명·창 점유를 대조해 미확인 출발이 다음 배차 원장에 완료로 남지 않게 한다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Emma King reports missing departure signatures on an undocumented train to Eva Nováková. Eva compares boarding certification and slot occupation so unverified departures are not retained as complete in the next ledger."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "무표 열차를 세우고 서명 누락을 에바에게 알린다. 후속 원장 오기를 막는 연결을 하며 실제 배차 판정은 넘긴다.",
      "en": "Stops an undocumented train and tells Eva about missing signatures. Connects the record to review rather than deciding the dispatch itself."
    },
