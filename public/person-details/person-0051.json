    "traits": [
      {
        "id": "k051-unsigned-refusal",
        "name": {
          "ko": "비워 둔 서명",
          "en": "Unsigned refusal"
        },
        "description": {
          "ko": "가족 등록 빈칸을 보면 서명하지 않는다.",
          "en": "Withholds signature when family registration has gaps."
        },
        "behavior": {
          "ko": "가족 등록 빈칸을 보면 서명하지 않는다.",
          "en": "Withholds signature when family registration has gaps."
        },
        "stress": {
          "ko": "거부 증언이 탈주 명단으로 바뀌고, 그 명단이 암사 장교망의 징발 근거가 되는 것.",
          "en": "That refusal testimony would turn into a deserters' list, and that list would become the Amsa officer network's requisition grounds."
        },
        "relationship": {
          "ko": "김나율의 조합 서기와 거부 문장을 나누고, 백온의 가족 투표를 지지하며, 배우진의 강제등록 요구를 증언석에서 막는다.",
          "en": "Sharing refusal wording with Kim Nayul's union clerk, backing Baek On's family vote, and blocking Bae Woojin's forced-registration demands at the witness stand."
        },
        "effects": []
      },
      {
        "id": "k051-no-military-filing",
        "name": {
          "ko": "군사호적을 철하지 않는다",
          "en": "Do not file military registers"
        },
        "description": {
          "ko": "거부 증언과 군사용 호적 양식을 구분한다.",
          "en": "Separates refusal testimony from military register forms."
        },
        "behavior": {
          "ko": "거부 증언과 군사용 호적 양식을 구분한다.",
          "en": "Separates refusal testimony from military register forms."
        },
        "stress": {
          "ko": "거부 증언이 탈주 명단으로 바뀌고, 그 명단이 암사 장교망의 징발 근거가 되는 것.",
          "en": "That refusal testimony would turn into a deserters' list, and that list would become the Amsa officer network's requisition grounds."
        },
        "relationship": {
          "ko": "김나율의 조합 서기와 거부 문장을 나누고, 백온의 가족 투표를 지지하며, 배우진의 강제등록 요구를 증언석에서 막는다.",
          "en": "Sharing refusal wording with Kim Nayul's union clerk, backing Baek On's family vote, and blocking Bae Woojin's forced-registration demands at the witness stand."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "공동 증언 기록과 화재 장부 보호가 확인된다. 자발적 복무 헌장은 목표이며 이미 통과한 권리로 쓰지 않는다.",
      "en": "Joint testimony recording and saving a fire register are confirmed. A voluntary-service charter remains a goal, not an enacted right."
    },
