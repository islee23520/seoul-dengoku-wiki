    "skills": [
      {
        "id": "hearing",
        "name": {
          "ko": "증인 대질 진행",
          "en": "Witness confrontation"
        },
        "rating": 45
      },
      {
        "id": "handover",
        "name": {
          "ko": "기록·열쇠 인수인계",
          "en": "Record and key handover"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "verify-through-confrontation",
        "name": {
          "ko": "대질로 확인",
          "en": "Verify Through Confrontation"
        },
        "description": {
          "ko": "남새원은 갈린 증언을 공개 대질로 맞대어 확인하는 편이다.",
          "en": "Nam Saewon favors examining conflicting testimony through a public face-to-face confrontation."
        },
        "behavior": {
          "ko": "증인 두 명의 말이 갈라지자 공개 대질을 열었다.",
          "en": "When two witnesses gave conflicting accounts, Nam Saewon opened a public confrontation."
        },
        "stress": {
          "ko": "증언이 엇갈릴 때 한쪽 말을 곧바로 택하기보다 공개 확인을 시도할 수 있다.",
          "en": "When testimony conflicts, Nam Saewon may seek public examination rather than immediately choosing one account."
        },
        "relationship": {
          "ko": "말이 다른 증인들에게는 서로의 진술을 공개적으로 맞대는 자리를 마련하려 할 수 있다.",
          "en": "For witnesses whose accounts differ, Nam Saewon may arrange a public setting to compare their statements directly."
        },
        "effects": []
      },
      {
        "id": "no-authority-beyond-records",
        "name": {
          "ko": "기록보다 큰 권한 거부",
          "en": "No Authority Beyond Records"
        },
        "description": {
          "ko": "남새원은 자기 직위의 기록과 열쇠 밖에 없는 권한을 만들어내지 않는 편이다.",
          "en": "Nam Saewon avoids inventing authority beyond the position's records and keys."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 넘기고 없는 권한은 만들지 않는다.",
          "en": "Nam Saewon transfers only the position's keys and records without inventing authority."
        },
        "stress": {
          "ko": "갈린 증언이나 당직 공백의 우려가 생겨도 이를 근거로 권한을 임의로 넓히지 않으려 할 수 있다.",
          "en": "Even amid conflicting testimony or concern over a duty gap, Nam Saewon may resist using those pressures to expand authority."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 기록으로 넘길 수 있는 책임의 범위를 분명히 하려 할 수 있다.",
          "en": "In handovers with senior duty staff, Nam Saewon may clarify the scope of responsibility transferable through records."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "갈린 증언을 공개 대질로 확인했다. 단일 중재 사건을 반영하며 계측원의 전문 검사 능력은 확인되지 않는다.",
      "en": "She used a public confrontation to examine conflicting testimony. A single mediation is reflected, not professional testing inferred from a metrology title."
    },
