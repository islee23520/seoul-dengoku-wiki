    "skills": [
      {
        "id": "generator",
        "name": {
          "ko": "비상 발전·전압 확인",
          "en": "Emergency generation and voltage checks"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "minimum-voltage",
        "name": {
          "ko": "전압 최저선",
          "en": "Minimum Voltage"
        },
        "description": {
          "ko": "채무진은 종자 보존에 필요한 전압 최저선을 타협하기 어려운 운전 기준으로 여긴다.",
          "en": "Chae Mujin treats the minimum voltage needed for seed preservation as a firm operating threshold."
        },
        "behavior": {
          "ko": "전압이 최저선 아래면 반출 스위치를 빼고 비상 발전을 냉온고에 우선 배정한다.",
          "en": "Chae Mujin removes the release switch below the voltage threshold and prioritizes emergency power for temperature-controlled storage."
        },
        "stress": {
          "ko": "연료 고갈로 보존고가 약탈에 노출될 우려가 커지면 전압표와 발전 우선순위를 더욱 중시할 수 있다.",
          "en": "If fuel depletion threatens to expose the seed store to looting, Chae Mujin may emphasize voltage records and power priorities more strongly."
        },
        "relationship": {
          "ko": "박진솔의 봉인 시각에 발전을 맞추되 정하린의 잠금이 내려가면 반출 스위치를 빼는 조건을 지키려 할 수 있다.",
          "en": "Chae Mujin may coordinate power with Park Jinsol's sealing schedule while maintaining switch removal when Jeong Harin imposes a lock."
        },
        "effects": []
      },
      {
        "id": "no-seeds-as-collateral",
        "name": {
          "ko": "씨앗 담보 거부",
          "en": "No Seeds as Collateral"
        },
        "description": {
          "ko": "채무진은 보존할 씨앗을 군량 담보나 시세 거래의 대상으로 삼는 데 반대한다.",
          "en": "Chae Mujin opposes treating preserved seeds as military-ration collateral or speculative goods."
        },
        "behavior": {
          "ko": "씨앗을 군량 담보로 부르는 말을 끊고 남윤경이 씨앗 시세를 부르면 연료 문을 잠근다.",
          "en": "Chae Mujin cuts off talk of seeds as military collateral and locks the fuel door when Nam Yungyeong quotes seed prices."
        },
        "stress": {
          "ko": "연료를 끊겠다는 압박이 씨앗 보존을 흔들면 거래 요구보다 보존 설비의 통제를 우선할 수 있다.",
          "en": "If threats to cut fuel endanger seed preservation, Chae Mujin may prioritize control of preservation equipment over trading demands."
        },
        "relationship": {
          "ko": "남윤경과의 접촉에서는 씨앗 시세를 근거로 보존고 자원에 접근하는 것을 경계할 수 있다.",
          "en": "In dealings with Nam Yungyeong, Chae Mujin may resist access to storage resources justified by seed prices."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "발전을 냉온고에 우선 배정하고 전압표를 공개했다. 발전 운전의 반복 징후 확인이 근거이며 발명가 경력은 추가하지 않는다.",
      "en": "He prioritizes cold storage for power and posts voltage readings. Repeated operational checks support generation work, not an inventor’s career."
    },
