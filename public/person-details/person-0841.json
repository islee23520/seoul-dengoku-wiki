    "skills": [
      {
        "id": "k841-overlapping-register-check",
        "name": {
          "ko": "명부 중복 대조",
          "en": "Overlapping-register crosscheck"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "k841-action-priority",
        "name": {
          "ko": "두 명부의 겹침",
          "en": "Overlap between registers"
        },
        "description": {
          "ko": "강민서가 지지하는 백온의 난민 시민권 명단이 복구복무 기록과 한 책상에 놓인다. 손타연은 난민 명단의 이름이 복구복무 등록에도 올랐는지 한 줄씩 대조하고, 두 곳에 겹친 이름을 등기 순서대로 모아 당직 인수인계 메모에 남긴다.",
          "en": "The refugee citizenship list of Baek On, which Gang Minseo backs, is laid on the same desk as the restoration-service records. Son Tayeon checks line by line whether each name on the refugee list also appears in the restoration-service registration, gathers the names found in both in registry order, and leaves them in the duty handover memo."
        },
        "behavior": {
          "ko": "강민서가 지지하는 백온의 난민 시민권 명단이 복구복무 기록과 한 책상에 놓인다. 손타연은 난민 명단의 이름이 복구복무 등록에도 올랐는지 한 줄씩 대조하고, 두 곳에 겹친 이름을 등기 순서대로 모아 당직 인수인계 메모에 남긴다.",
          "en": "The refugee citizenship list of Baek On, which Gang Minseo backs, is laid on the same desk as the restoration-service records. Son Tayeon checks line by line whether each name on the refugee list also appears in the restoration-service registration, gathers the names found in both in registry order, and leaves them in the duty handover memo."
        },
        "stress": {
          "ko": "복구복무 기록관 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the restoration service registrar duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k841-bounded-handover",
        "name": {
          "ko": "기록으로 잇는 당직",
          "en": "Duty linked by records"
        },
        "description": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "behavior": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "stress": {
          "ko": "복구복무 기록관 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the restoration service registrar duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "강민서가 지지하는 백온의 난민 시민권 명단이 복구복무 기록과 한 책상에 놓인다. 손타연은 난민 명단의 이름이 복구복무 등록에도 올랐는지 한 줄씩 대조하고, 두 곳에 겹친 이름을 등기 순서대로 모아 당직 인수인계 메모에 남긴다. 짧은 행위와 인수인계가 근거여서 다른 분야의 숙련이나 보정은 발급하지 않았다.",
      "en": "The refugee citizenship list of Baek On, which Gang Minseo backs, is laid on the same desk as the restoration-service records. Son Tayeon checks line by line whether each name on the refugee list also appears in the restoration-service registration, gathers the names found in both in registry order, and leaves them in the duty handover memo. The brief action and handover support only limited strengths; no unrelated proficiency or numeric trait bonus is issued."
    },
