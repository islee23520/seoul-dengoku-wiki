      {
        "recipientId": "K469",
        "recipientKind": "person",
        "type": "계약",
        "direction": "incoming",
        "role": "조채원은 문하율이 남긴 초소 차단 경위와 공동승인 문서를 양군에 전한다. 배차표나 출발 서명이 빠진 전갈은 그 누락을 함께 알려, 차단 보고가 서명 없는 이동의 근거로 바뀌지 않게 한다.",
        "status": "source-projection",
        "sourceRefs": [
