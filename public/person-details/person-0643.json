    "traits": [
      {
        "id": "k643-priority",
        "name": {
          "ko": "사본과 원본 구분",
          "en": "Separates copies and originals"
        },
        "description": {
          "ko": "고다진의 확인된 행동은 2125년 위조 도장을 들켜 사본을 불사르고 원본 칸을 지켰다.  반복 성과와 구체적 전문 경력은 미확인이다.",
          "en": "고다진: Anecdote. In 2125, caught with a forged stamp, he burned the copies and kept the original column. By this deed the signature of the medical convoy registrar post rose into the ledger. Repeated results and detailed professional experience remain unconfirmed."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: convoy hand. Title: medical convoy registrar. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "의무호송 기록관 당직이 비면 신내운수의 통행이 노선 면허의 볼모가 되는 것.",
          "en": "Fear. That the medical convoy registrar duty post would stand empty and the City's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k643-accountability",
        "name": {
          "ko": "당직의 연속성",
          "en": "Continuity of duty"
        },
        "description": {
          "ko": "큰소리보다 기록을 믿고 자기 직위의 열쇠와 기록만 넘긴다.",
          "en": "Trusts records over loud claims and hands over only the keys and records of the position."
        },
        "behavior": {
          "ko": "관직. 품계 호송원. 직함은 의무호송 기록관. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: convoy hand. Title: medical convoy registrar. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
