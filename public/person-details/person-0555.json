    "skills": [
      {
        "id": "brake",
        "name": {
          "ko": "제동 정비",
          "en": "Brake repair"
        },
        "rating": 55
      },
      {
        "id": "wheel",
        "name": {
          "ko": "차륜 결함 점검",
          "en": "Wheel-defect inspection"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "overnight-brake-restoration",
        "name": {
          "ko": "밤새 제동 복구",
          "en": "Overnight Brake Restoration"
        },
        "description": {
          "ko": "서구서는 다음 교대에 필요한 제동 복구를 밤새 이어 가는 끈기를 보였다.",
          "en": "Seo Guseo demonstrated persistence by working through the night to restore braking needed for the next shift."
        },
        "behavior": {
          "ko": "고장 난 제동을 밤새 고쳐 다음 교대의 배차를 지켰다.",
          "en": "He repaired the faulty braking overnight and preserved the next shift's dispatch."
        },
        "stress": {
          "ko": "당직 공백이 통행 종속으로 이어질까 우려되면 필요한 복구를 마치는 데 힘을 집중할 수 있다.",
          "en": "If a duty gap could leave passage dependent on a powerful state, he may concentrate on completing the needed restoration."
        },
        "relationship": {
          "ko": "선배 당직과는 다음 교대에 쓸 제동의 복구 상태를 중심으로 인계하려 할 수 있다.",
          "en": "He may center handover with the senior duty holder on the braking condition needed for the next shift."
        },
        "effects": []
      },
      {
        "id": "protect-the-next-dispatch",
        "name": {
          "ko": "다음 배차 지키기",
          "en": "Protect the Next Dispatch"
        },
        "description": {
          "ko": "서구서는 자기 작업을 다음 교대의 배차 연속성과 연결해 보는 성향을 보인다.",
          "en": "Seo Guseo shows a tendency to connect his work with dispatch continuity for the next shift."
        },
        "behavior": {
          "ko": "제동 고장을 복구해 다음 교대가 예정된 배차를 이어 갈 수 있게 했다.",
          "en": "He restored faulty braking so the next shift could continue its scheduled dispatch."
        },
        "stress": {
          "ko": "당직이 비어 통행이 강국의 볼모가 될 위험을 느끼면 다음 교대의 중단을 줄이는 일을 우선할 수 있다.",
          "en": "If vacant duty risks making passage hostage to a powerful state, he may prioritize reducing disruption to the next shift."
        },
        "relationship": {
          "ko": "선배 당직과는 다음 배차에 필요한 복구 결과와 기록을 이어 주며 협력하려 할 수 있다.",
          "en": "He may cooperate with the senior duty holder by passing along restoration results and records needed for the next dispatch."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "고장 제동을 밤새 고쳐 다음 교대를 지켰다. 정비와 지속력은 확인되며 교섭·전투는 근거가 약하다.",
      "en": "She repaired brakes overnight to preserve the next shift. Repair and persistence are supported; bargaining and combat evidence is weak."
    },
