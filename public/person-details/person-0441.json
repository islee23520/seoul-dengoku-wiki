    "skills": [
      {
        "id": "k441-training-report-review",
        "name": {
          "ko": "훈련 보고 재검토",
          "en": "Training-report review"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "k441-action-priority",
        "name": {
          "ko": "오보를 다시 연다",
          "en": "Reopen a wrong report"
        },
        "description": {
          "ko": "2125년 교량 습격 훈련에서 최초 보고가 틀리자 참관 칸을 다시 열었다.",
          "en": "In 2125, when the first report of a bridge-raid exercise proved wrong, he reopened the observation column. By this deed the signature of the power installation patrol post rose into the ledger."
        },
        "behavior": {
          "ko": "2125년 교량 습격 훈련에서 최초 보고가 틀리자 참관 칸을 다시 열었다.",
          "en": "In 2125, when the first report of a bridge-raid exercise proved wrong, he reopened the observation column. By this deed the signature of the power installation patrol post rose into the ledger."
        },
        "stress": {
          "ko": "전력장치 순찰대 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the power installation patrol duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k441-bounded-handover",
        "name": {
          "ko": "기록으로 잇는 당직",
          "en": "Duty linked by records"
        },
        "description": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "behavior": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "stress": {
          "ko": "전력장치 순찰대 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the power installation patrol duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "2125년 교량 습격 훈련에서 최초 보고가 틀리자 참관 칸을 다시 열었다. 짧은 행위와 인수인계가 근거여서 다른 분야의 숙련이나 보정은 발급하지 않았다.",
      "en": "In 2125, when the first report of a bridge-raid exercise proved wrong, he reopened the observation column. By this deed the signature of the power installation patrol post rose into the ledger. The brief action and handover support only limited strengths; no unrelated proficiency or numeric trait bonus is issued."
    },
