    "skills": [
      {
        "id": "bridge-freight-scheduling",
        "name": {
          "ko": "교량 화물 배치",
          "en": "Bridge freight scheduling"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "이중 날인 전에는 싣지 않는다",
          "en": "No loading before both seals"
        },
        "description": {
          "ko": "파손이 적대행위로 보고되자 군 송장을 봉인하고 점검 무게만 남겼다. 화물 운영과 보고의 절제를 반영한다.",
          "en": "A hostile interpretation of damage prompted sealing military invoices and keeping inspection weights. Cargo administration and restraint in reporting are supported."
        },
        "behavior": {
          "ko": "통행 무게와 교각 균열을 같은 저울에 올리고, 근거 없는 봉쇄를 병력 낭비라고 본다. 빈 면제 칸이 찍힌 송장을 위험 신호로 본다.",
          "en": "She put passage weight and pier cracks on the same scales and saw a baseless blockade as a waste of troops. She read an invoice stamped with an empty exemption column as a danger signal."
        },
        "stress": {
          "ko": "공포. 교량 화물이 일방의 군령으로 상수호위단에 넘어가 세리 원장이 빈 종이가 되는 것.",
          "en": "Fear. That the bridge freight would pass to the water-supply escort under a protection-government pretext and the customs ledger would become empty paper."
        },
        "relationship": {
          "ko": "관계. 안기준의 교량 일정을 화물 순서로 집행하는 계약이고, 원다결의 관문 저울에 무게를 맞춘다. 남호성의 의무호송을 우선 통과시킨다.",
          "en": "Relations. Held a contract executing An Giun's bridge schedule as freight order and matched weights on Won Dagyeol's gate scales. Passed Nam Hoseong's medical convoy through first."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 공동실무원. 직함은 양군 교량 통과 물류상. 교각 균열과 통행 무게를 매일 공개하고, 군 통행 송장은 아관사와 구의수비대의 이중 날인이 있기 전에는 싣지 않는다.",
          "en": "Office. Rank: sergeant. Title: bridge passage logistics merchant. She published the pier cracks and passage weights daily and loaded no military invoice before the double stamp of Go Seojun and the water engineers' council."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 공동실무원. 직함은 양군 교량 통과 물류상. 교각 균열과 통행 무게를 매일 공개하고, 군 통행 송장은 아관사와 구의수비대의 이중 날인이 있기 전에는 싣지 않는다.",
          "en": "Recorded duty and limits: Office. Rank: sergeant. Title: bridge passage logistics merchant. She published the pier cracks and passage weights daily and loaded no military invoice before the double stamp of Go Seojun and the water engineers' council."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 교량 화물이 일방의 군령으로 상수호위단에 넘어가 세리 원장이 빈 종이가 되는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That the bridge freight would pass to the water-supply escort under a protection-government pretext and the customs ledger would become empty paper."
        },
        "relationship": {
          "ko": "관계. 안기준의 교량 일정을 화물 순서로 집행하는 계약이고, 원다결의 관문 저울에 무게를 맞춘다. 남호성의 의무호송을 우선 통과시킨다.",
          "en": "Relations. Held a contract executing An Giun's bridge schedule as freight order and matched weights on Won Dagyeol's gate scales. Passed Nam Hoseong's medical convoy through first."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "파손이 적대행위로 보고되자 군 송장을 봉인하고 점검 무게만 남겼다. 화물 운영과 보고의 절제를 반영한다.",
      "en": "A hostile interpretation of damage prompted sealing military invoices and keeping inspection weights. Cargo administration and restraint in reporting are supported."
    },
