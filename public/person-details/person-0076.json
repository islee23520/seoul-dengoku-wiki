    "skills": [
      {
        "id": "patients",
        "name": {
          "ko": "환자 호송 명부 확인",
          "en": "Patient transport manifest checks"
        },
        "rating": 60
      },
      {
        "id": "dose",
        "name": {
          "ko": "부족 약재 배분",
          "en": "Scarce-medicine allocation"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "triage-lists-first",
        "name": {
          "ko": "중증도 명부 먼저",
          "en": "Triage Lists First"
        },
        "description": {
          "ko": "진마루는 호송을 서두르더라도 환자의 중증도 확인을 앞세운다.",
          "en": "Jin Maru puts patient-severity checks first even when transport is urgent."
        },
        "behavior": {
          "ko": "중증도 명부를 먼저 확인하고 호송 명부에 심사·주민·방재의 세 서명을 요구한다.",
          "en": "Jin Maru checks the triage list first and requires review, resident, and disaster-response signatures on the transport roster."
        },
        "stress": {
          "ko": "호송 지연의 부담이 커져도 환자가 인질 이동에 휘말릴 우려가 있으면 명부 확인을 놓지 않을 수 있다.",
          "en": "Even under pressure to avoid delays, Jin Maru may retain roster checks if patients risk becoming part of a hostage transfer."
        },
        "relationship": {
          "ko": "이봄결의 봉쇄 해제와 출발 동시 선언 아래에서도 환자 명부와 출발 조건을 함께 확인하려 할 수 있다.",
          "en": "Under Lee Bomgyeol's coordinated reopening and departure orders, Jin Maru may seek to verify both patient lists and departure conditions."
        },
        "effects": []
      },
      {
        "id": "no-militarized-convoys",
        "name": {
          "ko": "호송 군수화 거부",
          "en": "No Militarized Convoys"
        },
        "description": {
          "ko": "진마루는 환자 호송을 군수 운송으로 위장하거나 흡수하는 것을 거부한다.",
          "en": "Jin Maru rejects disguising patient transport as military logistics or absorbing it into them."
        },
        "behavior": {
          "ko": "환자 화차를 군수 화차로 위장하라는 쪽지를 찢고 인증과 심사 봉인이 없는 병기 의심 화차를 붙이지 않는다.",
          "en": "Jin Maru tears up requests to disguise patient cars as military freight and excludes suspected weapons cars lacking certification and review seals."
        },
        "stress": {
          "ko": "의료열차가 군수열차로 오인될 위험이 커지면 두 운송의 구분을 더욱 엄격히 요구할 수 있다.",
          "en": "If a medical train risks being mistaken for a military train, Jin Maru may insist more strictly on separating the two."
        },
        "relationship": {
          "ko": "진채온의 파견 진료 거부를 뒷받침할 때 호송도 군사 목적에 종속되지 않아야 한다고 볼 수 있다.",
          "en": "In supporting Jin Chaeon's refusal of dispatched treatment, Jin Maru may also insist that transport remain independent of military purposes."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "환자 명부와 세 서명을 확인하고 부족 약재를 배분했다. 호송 운영을 평가하고 의료 직함을 외과나 전투 숙련으로 바꾸지 않는다.",
      "en": "He checks patient manifests and three signatures and allocated scarce medicine. Transport management is supported, not surgery or combat inferred from a medical title."
    },
