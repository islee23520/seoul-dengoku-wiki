    "skills": [
      {
        "id": "rescue",
        "name": {
          "ko": "통로 개통·부상자 이송",
          "en": "Passage clearance and casualty transfer"
        },
        "rating": 50
      },
      {
        "id": "departure",
        "name": {
          "ko": "배차표·출발 확인",
          "en": "Departure and dispatch checks"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "restore-snowbound-passages",
        "name": {
          "ko": "눈길 통로 복구",
          "en": "Restore Snowbound Passages"
        },
        "description": {
          "ko": "고라호는 폭설로 막힌 통로를 직접 뚫어 이송을 가능하게 하는 실행 성향을 보인다.",
          "en": "Go Raho shows an action-oriented disposition by clearing a snowblocked passage to enable transport."
        },
        "behavior": {
          "ko": "폭설에 막힌 환승 통로를 뚫고 부상자를 먼저 옮겼다.",
          "en": "He cleared the transfer passage blocked by heavy snow and moved the injured first."
        },
        "stress": {
          "ko": "당직 공백이 통행 종속으로 이어질까 우려되면 실제로 막힌 통로를 여는 일에 집중할 수 있다.",
          "en": "If a duty gap could lead to dependent passage, he may focus on physically reopening the blocked route."
        },
        "relationship": {
          "ko": "선배 당직에게는 열린 통로와 부상자 이송 상황을 중심으로 인계하려 할 수 있다.",
          "en": "He may center handover to the senior duty holder on the reopened passage and the injured people's transport."
        },
        "effects": []
      },
      {
        "id": "the-injured-before-cargo",
        "name": {
          "ko": "부상자 화물보다 먼저",
          "en": "The Injured Before Cargo"
        },
        "description": {
          "ko": "고라호는 통로가 열렸을 때 부상자 이송을 먼저 두는 우선순위를 보였다.",
          "en": "Go Raho demonstrated a priority for moving injured people first once the passage was opened."
        },
        "behavior": {
          "ko": "폭설 통로를 뚫은 뒤 부상자를 먼저 옮겼으며 화물 처리의 구체적 순서는 기록되지 않았다.",
          "en": "He moved the injured first after clearing the snowblocked passage, although the specific cargo sequence is not recorded."
        },
        "stress": {
          "ko": "통행 중단과 당직 공백을 함께 우려하는 상황에서도 부상자 이송의 우선순위를 유지하려 할 수 있다.",
          "en": "Even amid concerns about blocked passage and vacant duty, he may seek to retain priority for transporting the injured."
        },
        "relationship": {
          "ko": "선배 당직과는 부상자를 먼저 옮긴 조치와 남은 통행 상황을 분명히 공유하려 할 수 있다.",
          "en": "He may clearly share the injured-first transport decision and the remaining passage situation with the senior duty holder."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "폭설 통로를 뚫어 부상자를 옮겼다. 노동과 이송의 한정된 강점이며 치료나 전투 수행 근거는 없다.",
      "en": "She cleared snow and moved casualties. Labor and transfer are narrow strengths, not treatment or combat performance."
    },
