    "traits": [
      {
        "id": "detect-unauthorized-crossings",
        "name": {
          "ko": "무단 도하 적발",
          "en": "Detect Unauthorized Crossings"
        },
        "description": {
          "ko": "손바호는 야간 무단 도하를 놓치지 않고 당직의 통행 경계를 지키려는 성향을 보인다.",
          "en": "Son Baho shows a disposition to uphold crossing controls, grounded in catching an unauthorized night crosser."
        },
        "behavior": {
          "ko": "야간 무단 도하자를 붙잡아 통행 위반에 직접 대응했다.",
          "en": "He directly addressed a crossing violation by catching the unauthorized night crosser."
        },
        "stress": {
          "ko": "당직 공백으로 통행이 강국의 볼모가 될 우려가 커지면 도하 감시에 더 주의를 기울일 수 있다.",
          "en": "If a duty gap threatens to leave passage hostage to a powerful state, he may become more attentive to crossings."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 통행 경계를 이어 맡을 책임을 중요하게 여길 수 있다.",
          "en": "In handovers with senior duty staff, he may emphasize responsibility for maintaining crossing controls."
        },
        "effects": []
      },
      {
        "id": "reissue-security-tokens",
        "name": {
          "ko": "보안패 재발급",
          "en": "Reissue Security Tokens"
        },
        "description": {
          "ko": "손바호는 통행 위반 뒤 경비 암호패를 바꾸어 보안 조건을 바로잡으려는 성향을 보인다.",
          "en": "Son Baho shows a disposition to restore security conditions by changing guard tokens after a crossing violation."
        },
        "behavior": {
          "ko": "무단 도하자를 붙잡은 뒤 경비 암호패를 교체했다.",
          "en": "He replaced the guard password token after catching the unauthorized crosser."
        },
        "stress": {
          "ko": "통행 통제가 흔들릴 우려가 생기면 자기 권한 안에서 보안패 갱신을 우선할 수 있다.",
          "en": "If passage control appears threatened, he may prioritize token renewal within his actual authority."
        },
        "relationship": {
          "ko": "선배 당직에게 열쇠와 기록을 넘길 때 암호패 변경 사실도 명확히 전달하려 할 수 있다.",
          "en": "When handing over keys and records to senior duty staff, he may seek to clarify the token change."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "야간 도하자를 저지하고 암호패를 바꿨다. 실제 경비 경험은 있으나 지위만으로 병력이나 장비를 배정하지 않는다.",
      "en": "He stopped a night crosser and changed security passes. Guard experience is supported; rank does not grant troops or equipment."
    },
