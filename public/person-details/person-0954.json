    "skills": [
      {
        "id": "accounts",
        "name": {
          "ko": "지급 장부 대조",
          "en": "Payment ledger reconciliation"
        },
        "rating": 50
      },
      {
        "id": "handover",
        "name": {
          "ko": "기록·열쇠 인수인계",
          "en": "Record and key handover"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "remove-duplicate-entries",
        "name": {
          "ko": "중복 줄 지우기",
          "en": "Remove Duplicate Entries"
        },
        "description": {
          "ko": "배마원은 이중 지급 기록을 대조해 중복을 바로잡는 쪽이다.",
          "en": "Bae Mawon checks double-payment records against each other to correct duplication."
        },
        "behavior": {
          "ko": "이중 지급 장부를 대조한 뒤 한 줄을 지우고 서명을 남겼다.",
          "en": "They compared the double-payment registers, removed one entry, and left a signature."
        },
        "stress": {
          "ko": "중복 기록이 장부의 신뢰와 연속성을 해칠 우려가 있으면 대조를 먼저 하려 할 수 있다.",
          "en": "If duplicate records threaten register reliability and continuity, they may seek comparison before correction."
        },
        "relationship": {
          "ko": "인계 상대가 삭제 이유를 확인해야 한다면 대조한 장부와 남긴 서명을 근거로 삼을 수 있다.",
          "en": "If a handover partner needs to verify a deletion, they may refer to the compared registers and retained signature."
        },
        "effects": []
      },
      {
        "id": "sign-corrections",
        "name": {
          "ko": "정정에 서명",
          "en": "Sign Corrections"
        },
        "description": {
          "ko": "배마원은 장부 정정에 자신의 서명을 남기는 책임 표시를 중시한다.",
          "en": "Bae Mawon marks responsibility for register corrections by leaving a signature."
        },
        "behavior": {
          "ko": "이중 지급 장부의 한 줄을 지운 뒤 정정에 서명을 남겼다.",
          "en": "They signed the correction after removing one entry from the double-payment register."
        },
        "stress": {
          "ko": "정정으로 기록의 연결이 불분명해질 우려가 있으면 서명으로 변경의 책임을 남기려 할 수 있다.",
          "en": "If a correction risks making record continuity unclear, they may use a signature to retain responsibility for the change."
        },
        "relationship": {
          "ko": "선배 당직과 정정된 장부를 인계할 때 남긴 서명을 확인의 단서로 삼을 수 있다.",
          "en": "When handing over the corrected register to a senior duty colleague, they may use the signature as a verification cue."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "이중 지급 장부를 대조해 정정 서명을 남겼다. 좁은 기록 운영만 확인되며 종자 재배·보존 연구는 발급하지 않는다.",
      "en": "She reconciled duplicate payment entries and signed the correction. Narrow record management is supported, not seed cultivation or preservation research."
    },
