    "skills": [
      {
        "id": "departure-check",
        "name": {
          "ko": "출발 서명 확인",
          "en": "Departure signature check"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "k430-disposition",
        "name": {
          "ko": "서명 없는 출발 거부",
          "en": "Refusing unsigned departures"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "She chose the side that kept the duty line unbroken first. She trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 배차 서기. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: registrar. Title: dispatch clerk. She handed over only the keys and records of her own post, and never made authority she did not hold."
        },
        "stress": {
          "ko": "공포. 배차 서기 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the dispatch clerk duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 엘리스 해리스는 배차표와 출발 서명이 빠진 열차를 에바 노바코바에게 알린다. 에바 노바코바는 창 점유와 탑승 증명을 확인해 서명만 보충하고 출발하는 일을 막는다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Alice Harris reports a train lacking a dispatch sheet and departure signature to Eva Nováková. Eva checks slot occupation and boarding certification so adding a signature alone does not permit departure."
        },
        "effects": []
      },
      {
        "id": "k430-choice",
        "name": {
          "ko": "확인은 배차원에게",
          "en": "Referring checks to dispatch"
        },
        "description": {
          "ko": "일화. 2125년 배차표 없는 열차를 세워 서명 없는 출발을 막았다. 이 일로 배차 서기 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 she stopped a dispatch-sheetless train and blocked an unsigned departure. By this deed the signature of the dispatch clerk post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 엘리스 해리스는 배차표와 출발 서명이 빠진 열차를 에바 노바코바에게 알린다. 에바 노바코바는 창 점유와 탑승 증명을 확인해 서명만 보충하고 출발하는 일을 막는다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Alice Harris reports a train lacking a dispatch sheet and departure signature to Eva Nováková. Eva checks slot occupation and boarding certification so adding a signature alone does not permit departure."
        },
        "stress": {
          "ko": "공포. 배차 서기 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the dispatch clerk duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 엘리스 해리스는 배차표와 출발 서명이 빠진 열차를 에바 노바코바에게 알린다. 에바 노바코바는 창 점유와 탑승 증명을 확인해 서명만 보충하고 출발하는 일을 막는다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Alice Harris reports a train lacking a dispatch sheet and departure signature to Eva Nováková. Eva checks slot occupation and boarding certification so adding a signature alone does not permit departure."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "무표 열차를 세우고 에바에게 확인을 넘긴다. 정지 판단은 확인되지만 점유 심사 전체는 에바의 일이다.",
      "en": "Stops an undocumented train and refers it to Eva. The stop is supported; the full occupancy review belongs to Eva."
    },
