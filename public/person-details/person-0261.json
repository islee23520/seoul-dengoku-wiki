      {
        "id": "herb-drying-disposition",
        "name": {
          "ko": "습기와 봉인 경계",
          "en": "Wary of moisture and seals"
        },
        "description": {
          "ko": "덜 마른 뿌리를 숨기는 손을 제지하고 무봉인 상자를 격리한다.",
          "en": "Checks concealed damp roots and isolates unsealed boxes."
        },
        "behavior": {
          "ko": "덜 마른 뿌리를 숨기는 손을 제지하고 무봉인 상자를 격리한다.",
          "en": "Checks concealed damp roots and isolates unsealed boxes."
        },
        "stress": {
          "ko": "가짜 봉인이 아이 투약 명부를 오염시킬 것을 두려워한다.",
          "en": "Fears false seals contaminating children’s medication records."
        },
        "relationship": {
          "ko": "봉감의 투약 명부와 건조 로트를 맞추고, 황세린의 배급 저울에 약초 몫을 올린다. 류은비의 약효 검증을 건조 표본으로 돕는다.",
          "en": "Matches Bonggam’s medication roster to dry batches and supports Hwang Serin’s ration scale and Ryu Eunbi’s verification."
        },
        "effects": []
      },
      {
        "id": "recorded-boundary",
        "name": {
          "ko": "부족분 나눔",
          "en": "Shares shortage"
        },
        "description": {
          "ko": "약재 부족에 처방량을 반으로 나눠 모두에게 배분했다.",
          "en": "Halved doses to share scarce medicine among everyone."
        },
        "behavior": {
          "ko": "약재 부족에 처방량을 반으로 나눠 모두에게 배분했다.",
          "en": "Halved doses to share scarce medicine among everyone."
        },
        "stress": {
          "ko": "가짜 봉인 상자가 건조 선반에 섞여 아이 투약 명부가 오염되는 것.",
          "en": "Fears false seals contaminating children’s medication records."
        },
        "relationship": {
          "ko": "봉감의 투약 명부와 건조 로트를 맞추고, 황세린의 배급 저울에 약초 몫을 올린다. 류은비의 약효 검증을 건조 표본으로 돕는다.",
