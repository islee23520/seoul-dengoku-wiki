    "traits": [
      {
        "id": "k151-choice",
        "name": {
          "ko": "차이를 남기는 거래",
          "en": "Records discrepancies in trade"
        },
        "description": {
          "ko": "인장이 마르기 전에 사본을 움직이는 사람을 위조로 부르고, 상자 무게가 장부와 다르면 즉시 저울을 갈아 끼운다. 흥정은 낮게 끝내고 구두 운임을 인정하지 않는다.",
          "en": "He called anyone who moved copies before the stamps dried a forger, and when a box's weight differed from the ledger he swapped the scales at once. He ended bargains low and honored no verbal freight."
        },
        "behavior": {
          "ko": "일화. 오서율의 증인란이 비고 무게마저 운송 장부와 어긋나는 사본 상자가 서울역 선석 앞에 선다. 마도한은 저울을 갈아 끼워 다시 달고, 반출 시각 옆에 차이를 적은 뒤 상자를 선석 밖에 둔다.",
          "en": "Anecdote. A crate of copies with O Seoyul's witness box empty and a weight that disagrees with the shipping ledger stands at the Seoul Station berth. Ma Dohan swaps the scale and weighs it again, notes the difference beside the release time, and keeps the crate outside the berth."
        },
        "stress": {
          "ko": "공포. 위조 유언 사본 한 장이 강국 호송칸에 실려 서울역이 도장 하청으로 전락하는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That one forged testament copy, loaded into a great power's convoy car, would sink Seoul Station into a stamp subcontract. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 오서율의 마른 인장만 운송하는 계약이고, 양해온의 전령 봉인과 순번을 나누며, 오해린의 결제권이 공증 운임을 삼키려 하면 경쟁한다.",
          "en": "Relations. Held a contract carrying O Seoyul's dry stamps only, split seals and order with Yang Haeon's dispatches, and competed whenever O Haerin's settlement right tried to swallow the notary freight."
        },
        "effects": []
      },
      {
        "id": "k151-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 주사. 직함은 서울역 공증사본 물류상. 아침 저울과 반출 시각을 벽에 적고, 오서율의 증인란이 빈 사본은 선석에 들이지 않는다.",
          "en": "Office. Rank: registrar. Title: Seoul Station notarized-copy logistics merchant. He wrote the morning scales and removal hours on the wall and took no copy with O Seoyul's witness line empty into the berth."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 서울역 공증사본 물류상. 아침 저울과 반출 시각을 벽에 적고, 오서율의 증인란이 빈 사본은 선석에 들이지 않는다.",
          "en": "Office. Rank: registrar. Title: Seoul Station notarized-copy logistics merchant. He wrote the morning scales and removal hours on the wall and took no copy with O Seoyul's witness line empty into the berth."
        },
        "stress": {
          "ko": "공포. 위조 유언 사본 한 장이 강국 호송칸에 실려 서울역이 도장 하청으로 전락하는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That one forged testament copy, loaded into a great power's convoy car, would sink Seoul Station into a stamp subcontract. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 오서율의 마른 인장만 운송하는 계약이고, 양해온의 전령 봉인과 순번을 나누며, 오해린의 결제권이 공증 운임을 삼키려 하면 경쟁한다.",
          "en": "Relations. Held a contract carrying O Seoyul's dry stamps only, split seals and order with Yang Haeon's dispatches, and competed whenever O Haerin's settlement right tried to swallow the notary freight."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "빈 증인란과 무게 차이를 확인하고 상자를 선석 밖에 뒀다. 운송 거부는 확인되지만 원장 독점은 야망으로 남는다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Reweighed a box with missing witnesses and logged its discrepancy before keeping it off the berth. Ledger monopoly remains an ambition. Titles and ambitions are not treated as accomplished authority or results."
    },
