    "skills": [
      {
        "id": "record-comparison",
        "name": {
          "ko": "기록 대조",
          "en": "Record comparison"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "기록 우선",
          "en": "Records first"
        },
        "description": {
          "ko": "화재에서 인명 장부를 먼저 꺼내고 개표 누락을 살핀다. 청과 조항을 요구하지만 수산 시세와 묶이는 것은 피하려 한다.",
          "en": "Rescues the register of people before other records in a fire and examines gaps in the count. Seeks produce clauses without tying them to fish prices."
        },
        "behavior": {
          "ko": "확인된 선택에서는 기록 우선을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "서명이 의심받을 때 원본 보관에 매달릴 수 있다.",
          "en": "May cling to originals when a signature is questioned."
        },
        "relationship": {
          "ko": "남윤경과 회의를 공유하되 오해린의 시세와는 거리를 둔다.",
          "en": "Shares meetings with Nam Yungyeong but keeps distance from O Haerin’s prices."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "사제단 비밀 투표의 독립성을 지켜 교황 없는 대주교 선출을 둘러싼 이의에 개표 기록으로 답한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "비밀 투표의 개표 기록이 지워져 교황 없는 선출의 정당성 논쟁에서 자신의 서명이 의심받는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "남윤경과 회의를 공유하되 오해린의 시세와는 거리를 둔다.",
          "en": "Shares meetings with Nam Yungyeong but keeps distance from O Haerin’s prices."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "화재에서 인명 장부를 먼저 꺼내고 개표 누락을 살핀다. 청과 조항을 요구하지만 수산 시세와 묶이는 것은 피하려 한다.",
      "en": "Rescues the register of people before other records in a fire and examines gaps in the count. Seeks produce clauses without tying them to fish prices."
    },
