    "skills": [
      {
        "id": "document-transport",
        "name": {
          "ko": "문서 운송 통제",
          "en": "Document transport control"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "비교 전 반출 보류",
          "en": "Withholds release before comparison"
        },
        "description": {
          "ko": "서로 다른 급수 초안이 오자 비교표가 끝날 때까지 사본 반출을 멈췄다. 운임과 면제 조항을 서면으로 확인한다.",
          "en": "Stops copy removal until comparison is complete after conflicting water drafts arrive. Checks freight and exemption terms in writing."
        },
        "behavior": {
          "ko": "확인된 선택에서는 비교 전 반출 보류을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "불일치 상자 앞에서 운송을 멈출 수 있다.",
          "en": "May stop transport over inconsistent boxes."
        },
        "relationship": {
          "ko": "하서진의 문안을 운송으로 집행하며 하윤목에게 부속 원장을 요구한다.",
          "en": "Implements Ha Seojin’s terms through transport and requests supporting ledgers from Ha Yunmok."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "강국과의 교섭안의 종료조건·감사권·인질 대체 보증 사본을 공개 운송 원장에만 유효하게 묶어 조합원이 같은 종이로 서명하게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "서기가 베낀 초안이 강국 한쪽의 대리 문서로 유통되어 공동교섭이 빈 껍데기가 되는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "하서진의 문안을 운송으로 집행하며 하윤목에게 부속 원장을 요구한다.",
          "en": "Implements Ha Seojin’s terms through transport and requests supporting ledgers from Ha Yunmok."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "서로 다른 급수 초안이 오자 비교표가 끝날 때까지 사본 반출을 멈췄다. 운임과 면제 조항을 서면으로 확인한다.",
      "en": "Stops copy removal until comparison is complete after conflicting water drafts arrive. Checks freight and exemption terms in writing."
    },
