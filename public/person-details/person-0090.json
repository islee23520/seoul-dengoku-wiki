    "traits": [
      {
        "id": "insist-on-the-family-seal",
        "name": {
          "ko": "가문 도장 고수",
          "en": "Insist on the Family Seal"
        },
        "description": {
          "ko": "박세린은 평의회 계약보다 가문 도장과 공구 일련번호의 권위를 더 오래 신뢰한다.",
          "en": "Park Serin places more enduring trust in family seals and tool serial numbers than in council contracts."
        },
        "behavior": {
          "ko": "핵심 나사를 별도 창고에 두고 평의회 연서가 있어도 가문 원로의 도장 없이는 출고하지 않는다.",
          "en": "Park stores core screws separately and refuses shipment without a family elder's seal even when council co-signatures are present."
        },
        "stress": {
          "ko": "펌프 주권이 공동기술원장에 흡수될 우려가 커지면 가문 날인 조건을 더 완강히 지킬 수 있다.",
          "en": "If pump sovereignty risks absorption into a shared technical ledger, Park may defend the family-seal condition more firmly."
        },
        "relationship": {
          "ko": "한소미의 공방 동의 중심 구상과는 출고 승인과 후계 정당성을 두고 충돌할 수 있다.",
          "en": "Park may clash with Han Somi's workshop-consent approach over shipment approval and succession legitimacy."
        },
        "effects": []
      },
      {
        "id": "caution-toward-open-designs",
        "name": {
          "ko": "공개 설계 경계",
          "en": "Caution Toward Open Designs"
        },
        "description": {
          "ko": "박세린은 공개 설계를 가문 기술의 공유보다 도둑질에 가깝게 받아들인다.",
          "en": "Park Serin views open designs as closer to theft than to sharing family technology."
        },
        "behavior": {
          "ko": "가문 핵심 부품을 분리 보관하고 혈연 가까운 공정을 가문 원장으로 되찾으려 한다.",
          "en": "Park keeps core family parts separate and seeks to reclaim bloodline-associated processes into the family ledger."
        },
        "stress": {
          "ko": "임초원이 마곡의 제자로만 인정될 우려가 커지면 공동기술원장과 공개 설계에 대한 경계가 더 강해질 수 있다.",
          "en": "If Im Chowon risks recognition only as Magok's disciple, Park may become more wary of shared technical ledgers and open designs."
        },
        "relationship": {
          "ko": "배우진이 가문을 명목 후보로 부르면 가문 기술을 지킬 기회와 종속될 위험 사이에서 망설일 수 있다.",
          "en": "If Bae Ujin invokes the family as a nominal candidate, Park may hesitate between protecting family technology and risking dependency."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "별도 부품 창고의 가문 날인을 지키고 차륜 결함을 찾아 세웠다. 보관·점검과 혈연 공정에 대한 집착을 함께 남기며 총관 권한은 없다.",
      "en": "She requires family signatures for a separate parts store and found a wheel defect. Storage and inspection coexist with attachment to kinship processes; chief-engineer authority is not implied."
    },
