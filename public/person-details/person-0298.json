    "skills": [
      {
        "id": "k297-dispatch-personnel-allocation",
        "name": {
          "ko": "배차 인원 배치",
          "en": "Dispatch personnel allocation"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "k297-priority",
        "name": {
          "ko": "빈 시각표를 메움",
          "en": "Fills timetable gaps"
        },
        "description": {
          "ko": "안도한은 시각표와 호송 인원을 공개하고 폭설 통로에서 부상자를 옮겼다. 배차조 단독 승인 야망은 의료조 견제와 충돌한다.",
          "en": "An Dohan publishes timetables and escort numbers and moved casualties through snow. His sole dispatch approval ambition conflicts with medical oversight."
        },
        "behavior": {
          "ko": "배차표와 호송 인원을 같은 칠판에 공개하되, 의료열차 우선권은 장세화의 부서 날인이 있을 때만 인정한다.",
          "en": "Office. Rank: convoy hand. Title: transfer dispatch crew leader. He published the dispatch sheet and convoy personnel on one chalkboard, but honored the medical train's priority only when Jang Sehwa's departmental stamp stood on it."
        },
        "stress": {
          "ko": "동북 말단이 막혀 신내운수가 창동과 암사 사이를 통과만 하는 하역장이 되는 것.",
          "en": "Fear. That the northeast branch would be cut and the transfer city would fall into a freight yard that only passed between Changdong and Amsa."
        },
        "relationship": {
          "ko": "장세화의 배차 실무를 맡았고, 전미리와는 계절 교대마다 승인 순서를 다투며, 이홍원에게 북부 차륜 교환 시각을 의존한다.",
          "en": "Relations. Held Jang Sehwa's dispatch work, contested the approval order with Jeon Miri at every seasonal rotation, and depended on I Hongwon for the northern wheel-exchange hours."
        },
        "effects": []
      },
      {
        "id": "k297-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 호송원. 직함은 환승 배차조장. 배차표와 호송 인원을 같은 칠판에 공개하되, 의료열차 우선권은 장세화의 부서 날인이 있을 때만 인정한다.",
          "en": "Office. Rank: convoy hand. Title: transfer dispatch crew leader. He published the dispatch sheet and convoy personnel on one chalkboard, but honored the medical train's priority only when Jang Sehwa's departmental stamp stood on it."
        },
        "stress": {
          "ko": "공포. 동북 말단이 막혀 신내운수가 창동과 암사 사이를 통과만 하는 하역장이 되는 것.",
          "en": "Fear. That the northeast branch would be cut and the transfer city would fall into a freight yard that only passed between Changdong and Amsa."
        },
        "relationship": {
          "ko": "관계. 장세화의 배차 실무를 맡았고, 전미리와는 계절 교대마다 승인 순서를 다투며, 이홍원에게 북부 차륜 교환 시각을 의존한다.",
          "en": "Relations. Held Jang Sehwa's dispatch work, contested the approval order with Jeon Miri at every seasonal rotation, and depended on I Hongwon for the northern wheel-exchange hours."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "안도한은 시각표와 호송 인원을 공개하고 폭설 통로에서 부상자를 옮겼다. 배차조 단독 승인 야망은 의료조 견제와 충돌한다.",
      "en": "An Dohan publishes timetables and escort numbers and moved casualties through snow. His sole dispatch approval ambition conflicts with medical oversight."
    },
