    "skills": [
      {
        "id": "patrol",
        "name": {
          "ko": "등잔·깃발 순찰 조정",
          "en": "Lamp and flag patrol coordination"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "wait-for-the-flag-s-return",
        "name": {
          "ko": "깃발 귀환 대기",
          "en": "Wait for the Flag's Return"
        },
        "description": {
          "ko": "채봄은 주민 깃발의 귀환을 관문 개방보다 앞선 확인 조건으로 삼는다.",
          "en": "Chae Bom treats the resident flag’s return as a prerequisite for opening the gate."
        },
        "behavior": {
          "ko": "깃발이 골목 입구로 돌아온 뒤에만 관문 개방 호각을 분다.",
          "en": "She sounds the gate-opening whistle only after the flag returns to the alley entrance."
        },
        "stress": {
          "ko": "깃발이 돌아오기 전에 연구동 빗장이 안에서 걸릴 우려가 있다면 귀환 확인 없이 개방하지 않으려 할 수 있다.",
          "en": "If the research building might be bolted from inside before the flag returns, she may resist opening without confirmed return."
        },
        "relationship": {
          "ko": "김도하의 깃발이 아직 골목에 있다면 그와의 맹세에 따라 호각을 참을 수 있다.",
          "en": "If Kim Doha’s flag remains in the alley, she may withhold the whistle in keeping with her pledge to him."
        },
        "effects": []
      },
      {
        "id": "check-the-wick-first",
        "name": {
          "ko": "심지부터 점검",
          "en": "Check the Wick First"
        },
        "description": {
          "ko": "채봄은 대담한 대응보다 등잔 심지와 조명 상태를 먼저 챙긴다.",
          "en": "Chae Bom attends to lamp wicks and lighting conditions before bold intervention."
        },
        "behavior": {
          "ko": "기름 높이로 순찰 간격을 정하고 꺼진 구간을 다시 재며 위협 때 등잔을 모두 밝혔다.",
          "en": "She sets patrol intervals by oil level, remeasures dark sections, and lit every lamp during a threat."
        },
        "stress": {
          "ko": "어두운 골목에서 깃발이 돌아오지 못할 우려가 있다면 등잔 상태와 순찰 간격을 더 세밀히 확인할 수 있다.",
          "en": "If darkness threatens the flag’s return from an alley, she may check lamp conditions and patrol spacing more closely."
        },
        "relationship": {
          "ko": "이봄결의 봉쇄를 관문에서 이어야 한다면 등잔 심지를 관리하되 임시온의 봉함 쪽지 전에는 등잔 줄을 늘리지 않을 수 있다.",
          "en": "When extending Lee Bomgyeol’s blockade at the gate, she may maintain the wicks without lengthening the lamp line before Im Sion’s sealed note arrives."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "등잔과 주민 깃발로 순찰과 관문 개방을 조정했다. 위협 때의 경계 행동은 확인되나 전투 승리나 무장 보유는 확인되지 않는다.",
      "en": "She coordinates patrols and gate opening through lamps and flags. Vigilance under threat is documented, not battle victories or weapon ownership."
    },
