    "skills": [
      {
        "id": "pump",
        "name": {
          "ko": "펌프 분해·축 교체",
          "en": "Pump disassembly and shaft replacement"
        },
        "rating": 55
      },
      {
        "id": "wheel",
        "name": {
          "ko": "차륜 결함 점검",
          "en": "Wheel-defect inspection"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "replace-only-worn-axles",
        "name": {
          "ko": "마모 축만 교체",
          "en": "Replace Only Worn Axles"
        },
        "description": {
          "ko": "정바준은 확인된 마모 부위에 수리를 한정하는 실용적 성향을 보인다.",
          "en": "Jeong Bajun shows a practical preference for repairing only the confirmed worn component."
        },
        "behavior": {
          "ko": "멈춘 펌프를 분해해 마모 축 하나만 교체하고 다시 가동했다.",
          "en": "He dismantled the stopped pump, replaced one worn axle, and restarted it."
        },
        "stress": {
          "ko": "당직 공백으로 통행이 강국에 종속될 우려가 커지면 필요한 수리에 집중하려 할 수 있다.",
          "en": "If a duty gap threatens to leave passage subject to a powerful state, he may focus on the necessary repair."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때는 교체한 축처럼 확인된 작업 내용을 중심으로 설명할 수 있다.",
          "en": "When handing over to the senior duty holder, he may focus on verified work such as the replaced axle."
        },
        "effects": []
      },
      {
        "id": "duty-continuity-through-maintenance",
        "name": {
          "ko": "정비로 당직 연결",
          "en": "Duty Continuity Through Maintenance"
        },
        "description": {
          "ko": "정바준은 구체적 정비를 당직과 장부의 연속성을 지키는 수단으로 여긴다.",
          "en": "Jeong Bajun treats concrete maintenance as a means of sustaining duty and ledger continuity."
        },
        "behavior": {
          "ko": "펌프를 재가동하는 수리로 중단을 해소하고 자기 직위의 열쇠와 기록을 넘긴다.",
          "en": "He resolves an interruption by restarting the pump and passes on the keys and records belonging to his post."
        },
        "stress": {
          "ko": "당직이 비어 통행이 강국의 볼모가 될 가능성을 느끼면 정비와 인계의 연결을 더 중시할 수 있다.",
          "en": "If vacant duty could make passage hostage to a powerful state, he may place greater weight on connecting repairs with handover."
        },
        "relationship": {
          "ko": "선배 당직과는 수리 결과와 직위 기록을 이어 주는 인계를 통해 협력하려 할 수 있다.",
          "en": "He may cooperate with the senior duty holder through handovers linking repair results to post records."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "정지 펌프를 분해해 마모 축 하나를 갈았다. 구체적 정비 수행만 평가하며 제조·발명 전체 능력은 없다.",
      "en": "He disassembled a stopped pump and replaced one worn shaft. Specific repair is supported, not comprehensive manufacture or invention."
    },
