    "skills": [
      {
        "id": "k133-water-auction",
        "name": {
          "ko": "급수 경매",
          "en": "Water auction"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "k133-choice",
        "name": {
          "ko": "낙찰보다 품질 기준",
          "en": "Quality before sale"
        },
        "description": {
          "ko": "강바람보다 수통 시세를 빨리 읽고, 저울을 속이는 상인을 아침 추첨에서 즉시 뺀다. 흥정을 노래처럼 하지만 복무 골목의 가격은 올리지 않는다.",
          "en": "She read canteen prices faster than the river wind and struck out at once from the morning lottery any merchant who cheated the scales. She bargained like a song but never raised the price in the service alleys."
        },
        "behavior": {
          "ko": "일화. 남윤경 쪽의 비상 시세 제의가 고덕 급수시장 아침 추첨 직전에 도착한다. 주단아는 제의서를 돌려보내고 경매대에 오른 원수의 수질 표본 스티커를 하나씩 읽으며, 기준에 모자란 원수는 낙찰자 이름을 적은 뒤 선석에 묶어 둔다.",
          "en": "Anecdote. An emergency price offer from Nam Yungyeong's side arrives just before the Godeok water market's morning lottery. Ju Dana sends the offer back, reads the quality-sample sticker on each lot of raw water, and ties the substandard lots to the berth after writing down the winning bidder's name."
        },
        "stress": {
          "ko": "공포. 가락의 가격 원장이 고덕 선석까지 삼켜 동부 식수가 군량 시세로 팔리는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That Garak's price ledger would swallow the Godeok berths and eastern drinking water would sell at ration prices. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 주은솔의 관문 전표와 순번을 나누는 계약이고, 정소율의 급수 구역 봉인을 경매 전 확인하며, 남윤경의 비상 시세 제의를 원한으로 돌려보낸다.",
          "en": "Relations. A contract splitting gate slips and order with Ju Eunsol, checking Jeong Soyul's water district seals before the auction, and sending Nam Yungyeong's emergency price offer back as a grudge."
        },
        "effects": []
      },
      {
        "id": "k133-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 병장. 직함은 고덕 급수시장 경매사. 경매 시작 전 수질 표본 스티커를 확인하고, 기준 미달 원수는 낙찰이 되어도 출항시키지 않는다.",
          "en": "Office. Rank: sergeant. Title: Godeok water market auctioneer. She checked water-quality specimen stickers before the auction opened and let no substandard raw water sail even after a winning bid."
        },
        "behavior": {
          "ko": "관직. 품계 병장. 직함은 고덕 급수시장 경매사. 경매 시작 전 수질 표본 스티커를 확인하고, 기준 미달 원수는 낙찰이 되어도 출항시키지 않는다.",
          "en": "Office. Rank: sergeant. Title: Godeok water market auctioneer. She checked water-quality specimen stickers before the auction opened and let no substandard raw water sail even after a winning bid."
        },
        "stress": {
          "ko": "공포. 가락의 가격 원장이 고덕 선석까지 삼켜 동부 식수가 군량 시세로 팔리는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That Garak's price ledger would swallow the Godeok berths and eastern drinking water would sell at ration prices. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 주은솔의 관문 전표와 순번을 나누는 계약이고, 정소율의 급수 구역 봉인을 경매 전 확인하며, 남윤경의 비상 시세 제의를 원한으로 돌려보낸다.",
          "en": "Relations. A contract splitting gate slips and order with Ju Eunsol, checking Jeong Soyul's water district seals before the auction, and sending Nam Yungyeong's emergency price offer back as a grudge."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "일화. 남윤경 쪽의 비상 시세 제의가 고덕 급수시장 아침 추첨 직전에 도착한다. 주단아는 제의서를 돌려보내고 경매대에 오른 원수의 수질 표본 스티커를 하나씩 읽으며, 기준에 모자란 원수는 낙찰자 이름을 적은 뒤 선석에 묶어 둔다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Anecdote. An emergency price offer from Nam Yungyeong's side arrives just before the Godeok water market's morning lottery. Ju Dana sends the offer back, reads the quality-sample sticker on each lot of raw water, and ties the substandard lots to the berth after writing down the winning bidder's name. Titles and ambitions are not treated as accomplished authority or results."
    },
