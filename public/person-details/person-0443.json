    "traits": [
      {
        "id": "people-records-during-attacks",
        "name": {
          "ko": "습격 때 인명 기록",
          "en": "People Records During Attacks"
        },
        "description": {
          "ko": "고영호는 확인된 호송 습격에서 화물보다 인명 장부를 우선한 선택을 보였다.",
          "en": "Go Yeongho chose people records over cargo in the documented convoy attack."
        },
        "behavior": {
          "ko": "호송 도중 습격을 만났을 때 화물보다 인명 장부부터 챙겼다.",
          "en": "When attacked during a convoy, they secured the people ledger before the cargo."
        },
        "stress": {
          "ko": "당직 공백으로 통행이 외부 세력의 볼모가 될 우려가 있으면 물자보다 통행을 잇는 인명 기록을 우선할 수 있다.",
          "en": "If a duty gap threatens to make passage hostage to outside powers, they may prioritize people records supporting passage over goods."
        },
        "relationship": {
          "ko": "선배 당직에게는 화물 상태와 별개로 보존한 인명 장부를 빠짐없이 인계하려 할 수 있다.",
          "en": "They may seek to hand the preserved people ledger fully to the senior duty holder regardless of cargo condition."
        },
        "effects": []
      },
      {
        "id": "preserve-duty-records",
        "name": {
          "ko": "당직 기록 보존",
          "en": "Preserve Duty Records"
        },
        "description": {
          "ko": "고영호는 큰소리보다 장부를 신뢰하며 당직 기록의 연속성을 중시한다.",
          "en": "Go Yeongho trusts ledger entries over loud claims and values continuity in duty records."
        },
        "behavior": {
          "ko": "습격 때 장부를 챙긴 선택과 함께 자기 직위의 열쇠와 기록만 다음 당직에 넘기는 범위를 지킨다.",
          "en": "Alongside saving the ledger during the attack, they keep handovers limited to their role's keys and records."
        },
        "stress": {
          "ko": "전령 당직이 비어 통행이 외부 통제에 놓일 우려가 생기면 인계 기록의 누락을 더 신중히 살필 수 있다.",
          "en": "If an empty messenger duty risks outside control of passage, they may check handover records more carefully for omissions."
        },
        "relationship": {
          "ko": "선배 당직과는 구두 확약보다 이어받을 열쇠와 기록을 분명히 하는 협력을 선호할 수 있다.",
          "en": "With the senior duty holder, they may prefer clear keys-and-records handovers over verbal assurances."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "습격 중 화물보다 인명 장부를 챙겼다. 호송 중 선택을 평가하며 전투 승리와 임상 치료는 없다.",
      "en": "He chose personnel registers over cargo during an attack. The convoy choice is supported, not combat victory or clinical care."
    },
