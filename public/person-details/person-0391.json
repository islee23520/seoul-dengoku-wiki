    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "이의를 기록에 묶음",
          "en": "Ties objections to records"
        },
        "description": {
          "ko": "쌓인 이의서마다 명부 줄을 붙여 접수하고 선거 전에 봉인 목록을 정리했다. 가격 압박에 대한 원한도 있다.",
          "en": "Registers objections with their corresponding roster lines and orders the seal list before voting. Also carries resentment about price pressure."
        },
        "behavior": {
          "ko": "확인된 선택에서는 이의를 기록에 묶음을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "압박이 오면 이의를 목록으로 고정하려 할 수 있다.",
          "en": "May insist on listing objections under pressure."
        },
        "relationship": {
          "ko": "근솔이와 유찰 품목을 비교하고 한재목의 압박을 거부한다.",
          "en": "Compares failed-auction goods with Geun Soli and rejects Han Jaemok’s pressure."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "교구 명부와 선거 봉인을 지켜 다음 대주교 비밀 선거의 절차와 명동역 인준이 끊기지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "교구 명부와 선거 봉인이 지워져 교황 없는 선출의 정당성 논쟁에서 자신의 서명이 의심받는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
