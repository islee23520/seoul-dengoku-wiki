    "skills": [
      {
        "id": "wheel",
        "name": {
          "ko": "차륜 결함 점검",
          "en": "Wheel-defect inspection"
        },
        "rating": 50
      },
      {
        "id": "handover",
        "name": {
          "ko": "기록·열쇠 인수인계",
          "en": "Record and key handover"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "stop-for-wheel-defects",
        "name": {
          "ko": "바퀴 결함에 정지",
          "en": "Stop for Wheel Defects"
        },
        "description": {
          "ko": "안남늘은 바퀴의 실제 결함을 확인하면 운행보다 정지를 우선하는 성향을 보인다.",
          "en": "An Namneul shows a disposition to prioritize stopping over continued movement when a wheel defect is detected."
        },
        "behavior": {
          "ko": "탈선 직전 바퀴 결함을 손으로 감지해 열차를 세웠다.",
          "en": "He detected a wheel defect by touch and stopped the train just before derailment."
        },
        "stress": {
          "ko": "운행 지속과 결함 대응이 충돌하면 통행을 지키기 위해 먼저 멈추는 선택을 할 수 있다.",
          "en": "If continued operation conflicts with addressing a defect, he may choose to stop first to protect passage."
        },
        "relationship": {
          "ko": "선배 당직에게 인계할 때 자신이 확인한 바퀴 결함과 정지 사실을 중요하게 전달할 수 있다.",
          "en": "During handover to senior duty staff, he may emphasize the wheel defect he detected and the resulting stop."
        },
        "effects": []
      },
      {
        "id": "no-invented-authority",
        "name": {
          "ko": "없는 권한 만들지 않기",
          "en": "No Invented Authority"
        },
        "description": {
          "ko": "안남늘은 결함에 대응하더라도 자기 직위에 없는 권한을 내세우지 않는 태도를 지닌다.",
          "en": "An Namneul maintains a boundary against claiming powers his position does not grant, even when addressing defects."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 넘기며 결함 발견을 근거로 별도의 권한을 만들어 내지 않는다.",
          "en": "He transfers only his position’s keys and records without treating defect detection as a source of additional authority."
        },
        "stress": {
          "ko": "당직 공백이 두려워도 대응 범위를 넓히기보다 맡은 권한 안에서 연속성을 지키려 할 수 있다.",
          "en": "Even if he fears a duty gap, he may seek continuity within his remit rather than expand his authority."
        },
        "relationship": {
          "ko": "선배 당직과는 넘길 수 있는 열쇠와 기록의 범위를 분명히 하는 관계를 선호할 수 있다.",
          "en": "With senior duty staff, he may favor clear boundaries around which keys and records he can transfer."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "탈선 직전 바퀴 결함을 만져내 열차를 세웠다. 점검의 좁은 강점이며 부품 상인의 거래 이력은 원문에 없다.",
      "en": "He detected a wheel defect by touch and stopped a train. Narrow inspection is supported; a parts trader’s transaction history is absent."
    },
