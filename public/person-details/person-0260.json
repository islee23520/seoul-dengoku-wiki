      {
        "id": "passage-guidance",
        "name": {
          "ko": "통행 안내·표 확인",
          "en": "Passage guidance and pass checking"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "passage-guidance-disposition",
        "name": {
          "ko": "보호비 안내 거부",
          "en": "Rejects fee-based coercive guidance"
        },
        "description": {
          "ko": "칼보다 말로 길을 나누고 눈 덮인 표지를 직접 닦는다.",
          "en": "Shares routes with words rather than a knife and cleans snowy signs."
        },
        "behavior": {
          "ko": "칼보다 말로 길을 나누고 눈 덮인 표지를 직접 닦는다.",
          "en": "Shares routes with words rather than a knife and cleans snowy signs."
        },
        "stress": {
          "ko": "피난 표지가 군사 이정표로 바뀔 것을 두려워한다.",
          "en": "Fears refuge signs becoming military route markers."
        },
        "relationship": {
          "ko": "모봉의 산악 운송을 입구에서 받고, 복모의 우회로 표시를 이정표에 옮긴다. 용국의 순찰과 횃불 교대를 나눈다.",
          "en": "Receives Mobong’s cargo, updates Bokmo’s signs and shares torch shifts with Yongguk."
        },
        "effects": []
      },
      {
        "id": "recorded-boundary",
        "name": {
          "ko": "정찰 뒤 안내",
          "en": "Guidance after reconnaissance"
        },
        "description": {
          "ko": "무장 안내는 정찰 보고 뒤에 연다.",
          "en": "Opens armed guidance after reconnaissance reports."
        },
        "behavior": {
          "ko": "무장 안내는 정찰 보고 뒤에 연다.",
          "en": "Opens armed guidance after reconnaissance reports."
        },
        "stress": {
          "ko": "안내 표지가 군사 호송 이정표로 덧칠되어 피난로가 지워지는 것.",
          "en": "Fears refuge signs becoming military route markers."
        },
        "relationship": {
          "ko": "모봉의 산악 운송을 입구에서 받고, 복모의 우회로 표시를 이정표에 옮긴다. 용국의 순찰과 횃불 교대를 나눈다.",
          "en": "Receives Mobong’s cargo, updates Bokmo’s signs and shares torch shifts with Yongguk."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "통행 시각과 신도 표를 게시하며 안내를 보호비로 바꾸는 사람을 길에서 내려보낸다. 검문 줄 사건은 군사 통제에 대한 미해결 압력이다.",
      "en": "Posts passage times with member passes and removes people who turn guidance into protection fees. The checkpoint line remains unresolved military pressure."
    },
