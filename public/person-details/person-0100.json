    "skills": [
      {
        "id": "bridge",
        "name": {
          "ko": "교량 출입 통제",
          "en": "Bridge entry control"
        },
        "rating": 65
      },
      {
        "id": "guard",
        "name": {
          "ko": "출입 저지·암호패 교체",
          "en": "Entry control and pass replacement"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "direct-code-token-control",
        "name": {
          "ko": "암호패 직접 관리",
          "en": "Direct Code Token Control"
        },
        "description": {
          "ko": "채구름은 야간 암호패 관리를 부하에게 넘기지 않고 직접 맡으려 한다.",
          "en": "Chae Gureum keeps nighttime code-token control personally rather than delegating it to subordinates."
        },
        "behavior": {
          "ko": "야간 암호패를 직접 관리하고 교량 출입에 암호패와 공정 감독의 이중 확인을 요구한다.",
          "en": "Chae personally controls night code tokens and requires both a token and process-supervisor confirmation for bridge entry."
        },
        "stress": {
          "ko": "점검 공백이 보호군 주둔으로 이어질 우려가 커지면 직접 암호패 관리와 명부 재확인을 강화할 수 있다.",
          "en": "If inspection gaps threaten protection-force occupation, Chae may tighten personal token control and roster rechecks."
        },
        "relationship": {
          "ko": "김보람의 지휘를 집행하더라도 야간 출입을 넓히려는 요구에는 직접 확인 원칙을 내세울 수 있다.",
          "en": "Even while carrying out Kim Boram's command, Chae may invoke direct verification against demands to broaden nighttime access."
        },
        "effects": []
      },
      {
        "id": "no-outside-guards",
        "name": {
          "ko": "외부 수비 거부",
          "en": "No Outside Guards"
        },
        "description": {
          "ko": "채구름은 보호군 명목으로 교량 수비를 외부에 넘기는 일을 배신으로 본다.",
          "en": "Chae Gureum regards transferring bridge defense to outside protection forces as betrayal."
        },
        "behavior": {
          "ko": "무장 난입자를 문 밖에 붙들어 명부를 재점검했고 교량 접근의 순찰대 단독 봉쇄권을 추구한다.",
          "en": "Chae held an armed intruder outside for a roster recheck and seeks exclusive patrol authority over bridge closures."
        },
        "stress": {
          "ko": "암사 보호군이 점검 공백을 구원으로 내세우면 외부 주둔과 수비 이양을 더 강하게 거부할 수 있다.",
          "en": "If Amsa's protection force presents inspection gaps as a rescue opportunity, Chae may reject outside stationing and defense transfer more strongly."
        },
        "relationship": {
          "ko": "최나래와 순찰을 나누면서도 야간 봉쇄가 장민재의 급수 창구를 닫으면 시민 급수권과 충돌할 수 있다.",
          "en": "While sharing patrols with Choe Narae, Chae may clash with civic water rights when night closures shut Jang Minjae's supply counter."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "무장 난입자를 문밖에 붙들고 명부 재점검을 열었다. 실제 저지와 순찰을 반영하지만 대규모 승전이나 외부 지휘권은 없다.",
      "en": "He held an armed intruder outside and reopened manifest checks. Actual restraint and patrol work are reflected, not large victories or external command."
    },
