    "traits": [
      {
        "id": "distrust-initial-reports",
        "name": {
          "ko": "최초 보고 불신",
          "en": "Distrust Initial Reports"
        },
        "description": {
          "ko": "백아래는 오류가 드러난 최초 보고를 그대로 확정하지 않는 신중함을 보인다.",
          "en": "Baek Arae shows caution against treating an initial report as final once an error is revealed."
        },
        "behavior": {
          "ko": "교량 습격 훈련에서 최초 보고가 틀리자 참관 칸을 다시 열었다.",
          "en": "When the initial report in a bridge-attack drill proved wrong, he reopened the observation section."
        },
        "stress": {
          "ko": "기록 오류가 당직 연속성을 흔들 우려가 있으면 최초 보고를 다시 확인하려 할 수 있다.",
          "en": "If a record error threatens duty continuity, he may seek to check the initial report again."
        },
        "relationship": {
          "ko": "선배 당직과는 오류가 확인된 보고를 무조건 받아들이기보다 재검토 필요를 나누려 할 수 있다.",
          "en": "With senior duty staff, he may share the need for review rather than unconditionally accept a report known to be wrong."
        },
        "effects": []
      },
      {
        "id": "resume-observation",
        "name": {
          "ko": "참관 재개",
          "en": "Resume Observation"
        },
        "description": {
          "ko": "백아래는 잘못된 보고 뒤 관찰을 다시 열어 판단을 검토 가능하게 두는 성향을 보인다.",
          "en": "Baek Arae shows a disposition to keep judgment open to review by resuming observation after a faulty report."
        },
        "behavior": {
          "ko": "교량 습격 훈련의 보고 오류에 대응해 참관 칸을 재개방했다.",
          "en": "He reopened the observation section in response to the bridge-attack drill’s reporting error."
        },
        "stress": {
          "ko": "틀린 정보로 당직을 이어 갈 우려가 생기면 다시 살필 기회를 확보하려 할 수 있다.",
          "en": "If he risks carrying duty forward on incorrect information, he may seek another opportunity to observe."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 참관을 다시 열었다는 사실과 재검토 필요를 함께 전하려 할 수 있다.",
          "en": "During handover to senior duty staff, he may convey both the resumed observation and the need for review."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "틀린 최초 보고를 받아 참관 칸을 열었다. 검토와 경비 생업을 평가하며 사격·대규모 통솔은 발급하지 않는다.",
      "en": "He reopened observer access after a wrong initial report. Review and guard livelihood are supported; marksmanship and large-unit command are not issued."
    },
