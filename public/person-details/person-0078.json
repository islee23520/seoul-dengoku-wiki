    "traits": [
      {
        "id": "double-sealed-transport",
        "name": {
          "ko": "이중 봉인 호송",
          "en": "Double-Sealed Transport"
        },
        "description": {
          "ko": "우다온은 원본 릴의 이동에 안전심사와 송신 검증의 독립된 잠금이 필요하다고 여긴다.",
          "en": "U Daon treats separate safety-review and transmission-verification locks as necessary for moving original reels."
        },
        "behavior": {
          "ko": "두 자물쇠가 채워진 뒤에만 릴 상자를 출발시키고 방재대가 요청해도 단독 호송을 거절한다.",
          "en": "U Daon dispatches reel boxes only after both locks are secured and refuses solo transport even at the disaster-response unit's request."
        },
        "stress": {
          "ko": "호송 중 릴 교체가 우려되면 이중 잠금과 단독 이동 금지를 더욱 고수할 수 있다.",
          "en": "Concern about reels being swapped during transport may strengthen U Daon's insistence on dual locks and no solo journeys."
        },
        "relationship": {
          "ko": "정호준과 협력할 때 안전심사를 편의상 생략할 절차가 아니라 호송의 조건으로 유지하려 할 수 있다.",
          "en": "In working with Jeong Hojun, U Daon may retain safety review as a transport condition rather than waive it for convenience."
        },
        "effects": []
      },
      {
        "id": "no-reading-before-verification",
        "name": {
          "ko": "검증 전 낭독 거부",
          "en": "No Reading Before Verification"
        },
        "description": {
          "ko": "우다온은 검증되지 않은 방송 문구에 자신의 낭독을 보태지 않는다.",
          "en": "U Daon withholds personal narration from broadcast wording that has not been verified."
        },
        "behavior": {
          "ko": "검증 전에는 방송 문구를 읽지 않고 편집 흔적 검증을 위해 최지우에게 원본을 넘긴다.",
          "en": "U Daon refuses to read broadcast wording before verification and passes originals to Choi Jiu for checking editing traces."
        },
        "stress": {
          "ko": "조작된 목소리가 유언 진본으로 인준될 우려가 있으면 낭독보다 검증 완료를 우선할 수 있다.",
          "en": "If a manipulated voice risks certification as an authentic testament, U Daon may prioritize completed verification over narration."
        },
        "relationship": {
          "ko": "최지우와의 협력에서는 검증을 맡기되 정치 일정에 따른 원본 개봉 지연에는 동의하기 어려울 수 있다.",
          "en": "U Daon may rely on Choi Jiu's verification while resisting delays in opening originals for political scheduling."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "이중 잠금 뒤에만 릴을 호송하고 단독 이동을 거부한다. 원본 보존과 장부 대조가 근거이며 전문 음향 분석을 추가하지 않는다.",
      "en": "She moves reels only after dual locks and refuses solo delivery. Preservation and ledger checks are supported, not professional audio analysis."
    },
