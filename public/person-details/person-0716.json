    "skills": [
      {
        "id": "k716-shift-negotiation",
        "name": {
          "ko": "교대 조건 조정",
          "en": "Shift condition negotiation"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "k716-choice",
        "name": {
          "ko": "다음 교대를 목표로",
          "en": "Works toward the next shift"
        },
        "description": {
          "ko": "일화. 2125년 태업 작업반과 밤새 조건을 나눠 다음 교대를 열었다. 이 일로 관문 당직 자리의 서명이 장부에 올랐다. 이 선택을 넘어선 지속 성향은 미확인이다.",
          "en": "Anecdote. In 2125 he shared terms with a slowdown work squad through the night and opened the next shift. By this deed the signature of the gate duty post rose into the ledger. A lasting disposition beyond this choice is unconfirmed."
        },
        "behavior": {
          "ko": "일화. 2125년 태업 작업반과 밤새 조건을 나눠 다음 교대를 열었다. 이 일로 관문 당직 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he shared terms with a slowdown work squad through the night and opened the next shift. By this deed the signature of the gate duty post rose into the ledger."
        },
        "stress": {
          "ko": "공포. 관문 당직 당직이 비면 암사·고덕의 관문 통행과 급수 인계가 끊기는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That the gate duty duty post would stand empty and passage through the Amsa and Godeok gates and water-supply handovers would be interrupted. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k716-boundary",
        "name": {
          "ko": "당직 연속성을 중시",
          "en": "Values duty continuity"
        },
        "description": {
          "ko": "당직 공백을 피하고 기록을 믿는 원문 성향이다. 반복 문구이므로 개인의 특별한 장점으로 확대하지 않는다.",
          "en": "The source favors unbroken shifts and written records. Repeated wording does not establish a distinctive exceptional virtue."
        },
        "behavior": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "stress": {
          "ko": "공포. 관문 당직 당직이 비면 암사·고덕의 관문 통행과 급수 인계가 끊기는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That the gate duty duty post would stand empty and passage through the Amsa and Godeok gates and water-supply handovers would be interrupted. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "일화. 2125년 태업 작업반과 밤새 조건을 나눠 다음 교대를 열었다. 이 일로 관문 당직 자리의 서명이 장부에 올랐다. 단일 일화와 반복 당직 문구만 있어 장기 성향·광범위 경력·후속 결과는 미확인이다.",
      "en": "Anecdote. In 2125 he shared terms with a slowdown work squad through the night and opened the next shift. By this deed the signature of the gate duty post rose into the ledger. Only one anecdote and repeated duty wording are available; enduring disposition, broader experience, and later results remain unconfirmed."
    },
