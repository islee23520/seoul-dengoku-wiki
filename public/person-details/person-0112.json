    "traits": [
      {
        "id": "seal-retrieved-boxes",
        "name": {
          "ko": "회수 상자 봉인",
          "en": "Seal Retrieved Boxes"
        },
        "description": {
          "ko": "류다인은 회수한 불량 부품과 피해 기록을 함께 봉인해 증거의 연결을 지키려 한다.",
          "en": "Ryu Dain seeks to preserve the connection between defective retrieved parts and harm records by sealing them together."
        },
        "behavior": {
          "ko": "회수 부품과 피해 명부를 같은 함에 넣고 골목펌프 정비사와 평의회 전령이 함께 볼 때만 감정을 위해 연다.",
          "en": "They place retrieved parts and the affected-person register in one box and open it for appraisal only before both an alley-pump mechanic and council messenger."
        },
        "stress": {
          "ko": "가짜 패킹으로 펌프가 멈추고 외부 주둔의 명분이 될 우려가 커지면 회수품의 봉인과 공동 확인을 더 중시할 수 있다.",
          "en": "If fake packing threatens a pump shutdown that could justify outside stationing, they may emphasize sealing retrieved parts and joint inspection."
        },
        "relationship": {
          "ko": "허겸과 평의회 전령에게 공동 확인을 기대하며 종마루의 증언과 회수 증거를 서로 대조하려 할 수 있다.",
          "en": "They may expect joint verification from Heo Gyeom and the council messenger and compare Jong Maru's testimony with retrieved evidence."
        },
        "effects": []
      },
      {
        "id": "no-shifting-defect-costs",
        "name": {
          "ko": "불량 비용 전가 거부",
          "en": "No Shifting Defect Costs"
        },
        "description": {
          "ko": "류다인은 불량 부품의 책임을 수습 비용이라는 말로 떠넘기는 중개인을 용납하지 않는다.",
          "en": "Ryu Dain rejects intermediaries who disguise responsibility for defective parts as cleanup costs to be passed on."
        },
        "behavior": {
          "ko": "불량 비용을 전가하는 중개인을 공방 밖으로 밀어내고 한소미에게 출고 중지를 요구하며 가짜 부품의 출고 공방 공개를 추진한다.",
          "en": "They push cost-shifting intermediaries out of the workshop, ask Han Somi to halt shipments, and seek disclosure of the workshop that shipped fake parts."
        },
        "stress": {
          "ko": "결함이 펌프 정지와 보호군 주둔으로 이어질 우려가 있으면 위조 도장보다 부품의 출처와 책임을 더 집요하게 물을 수 있다.",
          "en": "If defects threaten pump shutdowns and protection-force stationing, they may press harder for origins and responsibility rather than accept forged stamps."
        },
        "relationship": {
          "ko": "한소미에게 출고 중지의 응답을 기대하고 책임을 피해자에게 넘기는 중개인과는 협력하기 어려울 수 있다.",
          "en": "They may expect Han Somi to respond to shipment-stop requests and find cooperation difficult with intermediaries who shift responsibility onto those affected."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "수압 시험에서 누수를 찾고 회수 부품과 명부를 함께 보관한다. 결함 증거와 검사에 한정하며 건강 손상을 추정하지 않는다.",
      "en": "She found leaks in a pressure test and retains returned parts with victim registers. Defect evidence and inspection are supported; health damage is not inferred."
    },
