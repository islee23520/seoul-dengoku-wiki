    "skills": [
      {
        "id": "boat",
        "name": {
          "ko": "패킹 우회 수송",
          "en": "Packing rerouting by boat"
        },
        "rating": 65
      },
      {
        "id": "trade",
        "name": {
          "ko": "공개 조건 물류 거래",
          "en": "Logistics under disclosed terms"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "civilian-boxes-first",
        "name": {
          "ko": "민수 상자 먼저",
          "en": "Civilian Boxes First"
        },
        "description": {
          "ko": "구도영은 군수 상자보다 민수용 패킹의 선적 자리를 먼저 확보한다.",
          "en": "Gu Doyeong secures loading space for civilian packing before military boxes."
        },
        "behavior": {
          "ko": "민수 패킹을 같은 배에 한 줄 실은 뒤에만 군수 상자를 태운다.",
          "en": "Gu loads military boxes only after a row of civilian packing is aboard the same boat."
        },
        "stress": {
          "ko": "군화만 배에 오르고 민수 패킹이 선창에서 썩을 우려가 커지면 민수 선적 조건을 더 엄격히 지킬 수 있다.",
          "en": "If only boots risk being shipped while civilian packing rots at the wharf, Gu may enforce the civilian-loading condition more strictly."
        },
        "relationship": {
          "ko": "임채원과 선창을 다투더라도 필터 패킹을 함께 실을 수 있다면 제한된 협력을 유지할 수 있다.",
          "en": "Despite competing with Im Chaewon for wharf space, Gu may maintain limited cooperation when filter packing can travel together."
        },
        "effects": []
      },
      {
        "id": "bypass-tolls",
        "name": {
          "ko": "통행세 우회",
          "en": "Bypass Tolls"
        },
        "description": {
          "ko": "구도영은 통행세가 패킹 운송을 막으면 민수 화물을 다른 수송 경로로 돌리려 한다.",
          "en": "Gu Doyeong favors rerouting civilian cargo when tolls obstruct packing transport."
        },
        "behavior": {
          "ko": "동부 교량 통행세가 붙자 패킹 끈을 구의 쪽 나룻배로 돌리고 군화는 성수 선창에 남겼다.",
          "en": "When eastern bridge tolls were imposed, Gu rerouted packing straps to a Guui-side ferry and left boots at the Seongsu wharf."
        },
        "stress": {
          "ko": "민수 패킹이 선창에 묶일 우려가 커지면 군수 화물과 분리한 우회 수송을 더 고려할 수 있다.",
          "en": "If civilian packing risks being stranded at the wharf, Gu may give greater consideration to rerouting it separately from military cargo."
        },
        "relationship": {
          "ko": "유하은의 가죽 마감 시각과 계약을 지키기 위해 경로가 바뀌면 선적 일정을 다시 맞출 수 있다.",
          "en": "Gu may readjust loading schedules after route changes to honor Yu Haeun's leather-finishing times and contract."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "통행세 때 패킹을 다른 나룻배로 돌리고 군화는 선창에 남겼다. 수송 대안과 민수 우선이 근거이며 군사 동맹 체결 경력은 없다.",
      "en": "He rerouted packing by boat under a toll while leaving boots at the wharf. Transport alternatives and civilian priorities are supported, not military alliance-making."
    },
