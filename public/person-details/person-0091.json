    ],
    "traits": [
      {
        "id": "undivided-night-command",
        "name": {
          "ko": "야간 지휘 불분할",
          "en": "Undivided Night Command"
        },
        "description": {
          "ko": "김보람은 주간 협의와 달리 야간 펌프수비 지휘를 나누지 않으려 한다.",
          "en": "Kim Boram resists dividing nighttime pump-defense command despite accepting daytime consultation."
        },
        "behavior": {
          "ko": "주간 교대 명부는 당회와 공유하지만 야간 출입은 암호패와 공정 감독의 이중 확인으로 제한한다.",
          "en": "Kim shares daytime shift rosters with the assembly but restricts night entry through code tokens and process-supervisor confirmation."
        },
        "stress": {
          "ko": "점검 공백이 보호군 주둔 명분이 될 우려가 커지면 야간 지휘와 출입 통제를 더 고수할 수 있다.",
          "en": "If inspection gaps risk becoming a pretext for protection-force occupation, Kim may hold more firmly to nighttime command and access control."
        },
        "relationship": {
          "ko": "한소미의 연서를 주간에는 따르더라도 야간 지휘를 나누자는 요구에는 선을 그을 수 있다.",
          "en": "Kim may follow Han Somi's co-signatures by day while drawing a boundary against sharing night command."
        },
        "effects": []
      },
      {
        "id": "no-outsourced-defense",
        "name": {
          "ko": "수비 외주 거부",
          "en": "No Outsourced Defense"
        },
        "description": {
          "ko": "김보람은 보호군 명목으로 펌프 수비를 넘기는 일을 배신으로 여긴다.",
          "en": "Kim Boram regards handing pump defense to a protection force as betrayal."
        },
        "behavior": {
          "ko": "펌프와 동부 교량 접근을 수비대의 단독 봉쇄권으로 묶으려 한다.",
          "en": "Kim seeks to place pumps and eastern bridge approaches under the guards' exclusive closure authority."
        },
        "stress": {
          "ko": "암사 보호군이 점검 공백을 구원으로 포장하면 외부 수비 이양을 더 강하게 거부할 수 있다.",
          "en": "If Amsa's protection force presents inspection gaps as a rescue opportunity, Kim may resist transferring defense even more strongly."
        },
        "relationship": {
          "ko": "최나래와 교량 순찰을 협력하더라도 급수 창구를 닫는 봉쇄는 장민재와 변오름의 반발을 부를 수 있다.",
          "en": "Even while sharing bridge patrols with Choe Narae, Kim's counter-closing blockades may provoke resistance from Jang Minjae and Byeon Oreum."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "교대 명부와 이중 출입 확인을 운영하고 결함 열차를 세웠다. 수비 조직 근거는 있으나 장수의 전투 실적이나 무장은 가져오지 않았다.",
      "en": "He manages shifts and dual entry checks and stopped a defective train. Defense organization is supported, not a general’s combat record or weapons."
    },
