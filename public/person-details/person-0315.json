    "skills": [
      {
        "id": "k314-collision-timing-testimony",
        "name": {
          "ko": "충돌 시각 진술",
          "en": "Collision timing testimony"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "k314-priority",
        "name": {
          "ko": "당사자 진술 보존",
          "en": "Preserves participant testimony"
        },
        "description": {
          "ko": "탁미르는 자신이 탄 칸의 충돌 시각과 번호를 기록한다. 충돌 경험을 부상 정도나 신체 기능 추정으로 바꾸지 않는다.",
          "en": "Tak Mireu records the time and number of the car he occupied during collision. The experience supplies no injury severity or function assessment."
        },
        "behavior": {
          "ko": "충돌 시각과 칸 번호를 같은 칠판에 적고, 암사 문장이 찍힌 화물은 심사관 입회 없이 옮기지 않는다.",
          "en": "Office. Rank: convoy hand. Title: transfer passage accident party. He wrote the collision hours and car numbers on one chalkboard and moved no freight stamped with the Amsa mark without the examiner's attendance."
        },
        "stress": {
          "ko": "자신의 증언이 무기함 은폐의 면죄부가 되어 장세화의 중립이 내부에서 깨지는 것.",
          "en": "Fear. That his testimony would become the indulgence that buried the weapons box and Jang Sehwa's neutrality would break from within."
        },
        "relationship": {
          "ko": "문시온의 심사대에서 진술을 남기고, 곽태산의 수비 당직과 시각을 맞춘다. 장세화의 부서 날인이 없는 합의서는 거부해 왔다.",
          "en": "Relations. Left a statement at Mun Sion's examination stand and matched the hours with Gwak Taesan's defense duty. He had refused any settlement without Jang Sehwa's departmental stamp."
        },
        "effects": []
      },
      {
        "id": "k314-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 호송원. 직함은 환승 통행 사고 당사자. 충돌 시각과 칸 번호를 같은 칠판에 적고, 암사 문장이 찍힌 화물은 심사관 입회 없이 옮기지 않는다.",
          "en": "Office. Rank: convoy hand. Title: transfer passage accident party. He wrote the collision hours and car numbers on one chalkboard and moved no freight stamped with the Amsa mark without the examiner's attendance."
        },
        "stress": {
          "ko": "공포. 자신의 증언이 무기함 은폐의 면죄부가 되어 장세화의 중립이 내부에서 깨지는 것.",
          "en": "Fear. That his testimony would become the indulgence that buried the weapons box and Jang Sehwa's neutrality would break from within."
        },
        "relationship": {
          "ko": "관계. 문시온의 심사대에서 진술을 남기고, 곽태산의 수비 당직과 시각을 맞춘다. 장세화의 부서 날인이 없는 합의서는 거부해 왔다.",
          "en": "Relations. Left a statement at Mun Sion's examination stand and matched the hours with Gwak Taesan's defense duty. He had refused any settlement without Jang Sehwa's departmental stamp."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "탁미르는 자신이 탄 칸의 충돌 시각과 번호를 기록한다. 충돌 경험을 부상 정도나 신체 기능 추정으로 바꾸지 않는다.",
      "en": "Tak Mireu records the time and number of the car he occupied during collision. The experience supplies no injury severity or function assessment."
    },
