    "skills": [
      {
        "id": "closure",
        "name": {
          "ko": "위험 구간 폐쇄",
          "en": "Hazardous-route closure"
        },
        "rating": 45
      },
      {
        "id": "departure",
        "name": {
          "ko": "배차표·출발 확인",
          "en": "Departure and dispatch checks"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "no-delayed-closures",
        "name": {
          "ko": "폐쇄를 미루지 않음",
          "en": "No Delayed Closures"
        },
        "description": {
          "ko": "홍북원은 침수 구간의 붕괴 위험을 보고하고 폐쇄를 지체하지 않는 편이다.",
          "en": "Hong Bugwon favors reporting collapse danger in a flooded section and closing it without delay."
        },
        "behavior": {
          "ko": "침수 구간의 붕괴 보고를 미루지 않고 당장 폐쇄했다.",
          "en": "Hong Bugwon did not delay the collapse report and immediately closed the flooded section."
        },
        "stress": {
          "ko": "위험 구간의 통행과 폐쇄가 충돌한다면 확인된 붕괴 위험에 대한 폐쇄를 우선할 수 있다.",
          "en": "If passage through a hazardous section conflicts with closure, Hong Bugwon may prioritize closing it in response to the reported collapse."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 폐쇄된 구간을 기록으로 분명히 전달하려 할 수 있다.",
          "en": "In handovers with senior duty staff, Hong Bugwon may clearly convey the closed section through records."
        },
        "effects": []
      },
      {
        "id": "hand-over-authority-limits",
        "name": {
          "ko": "권한 범위 인계",
          "en": "Hand Over Authority Limits"
        },
        "description": {
          "ko": "홍북원은 인계를 자기 직위의 열쇠와 기록 범위 안에 두는 편이다.",
          "en": "Hong Bugwon keeps handovers within the scope of the position's keys and records."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 넘기며 없는 권한은 만들지 않는다.",
          "en": "Hong Bugwon hands over only the position's keys and records without inventing authority."
        },
        "stress": {
          "ko": "당직 공백에 대한 두려움이 커져도 인계를 위해 없는 권한을 만들지 않으려 할 수 있다.",
          "en": "Even if fear of a duty gap grows, Hong Bugwon may resist inventing authority to complete a handover."
        },
        "relationship": {
          "ko": "선배 당직과는 넘길 수 있는 열쇠와 기록의 범위를 분명히 하려 할 수 있다.",
          "en": "With senior duty staff, Hong Bugwon may clarify the scope of keys and records that can be transferred."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "침수 붕괴 구간을 당장 닫았다. 즉각적인 경로 판단을 평가하고 지역 방재 지휘는 추정하지 않는다.",
      "en": "She promptly shut a flood-collapse section. Immediate route judgment is reflected, not regional disaster command."
    },
