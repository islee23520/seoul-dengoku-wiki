    "traits": [
      {
        "id": "k472-action-priority",
        "name": {
          "ko": "교대를 잇는 협의",
          "en": "Discussion to maintain shifts"
        },
        "description": {
          "ko": "2125년 가뭄에 상류 저수지 방류량을 두고 배급 대표와 밤새 나눴다.",
          "en": "In the 2125 drought he shared the upstream reservoir release volume with the ration representative through the night. By this deed the signature of the ration district clerk post rose into the ledger."
        },
        "behavior": {
          "ko": "2125년 가뭄에 상류 저수지 방류량을 두고 배급 대표와 밤새 나눴다.",
          "en": "In the 2125 drought he shared the upstream reservoir release volume with the ration representative through the night. By this deed the signature of the ration district clerk post rose into the ledger."
        },
        "stress": {
          "ko": "배급구역 서기 당직이 비면 수문국의 통행이 강국 볼모가 되는 것.",
          "en": "That the ration district clerk duty post would stand empty and the Compact's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "이서담의 배급구역 서기로 일하며 급수 배분 당직을 맡는다.",
          "en": "Serves as a ration clerk under I Seodam and manages the water allocation shift."
        },
        "effects": []
      },
      {
        "id": "k472-bounded-handover",
        "name": {
          "ko": "기록으로 잇는 당직",
          "en": "Duty linked by records"
        },
        "description": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "behavior": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "stress": {
          "ko": "배급구역 서기 당직이 비면 수문국의 통행이 강국 볼모가 되는 것.",
          "en": "That the ration district clerk duty post would stand empty and the Compact's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "이서담의 배급구역 서기로 일하며 급수 배분 당직을 맡는다.",
          "en": "Serves as a ration clerk under I Seodam and manages the water allocation shift."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "2125년 가뭄에 상류 저수지 방류량을 두고 배급 대표와 밤새 나눴다. 짧은 행위와 인수인계가 근거여서 다른 분야의 숙련이나 보정은 발급하지 않았다.",
      "en": "In the 2125 drought he shared the upstream reservoir release volume with the ration representative through the night. By this deed the signature of the ration district clerk post rose into the ledger. The brief action and handover support only limited strengths; no unrelated proficiency or numeric trait bonus is issued."
    },
