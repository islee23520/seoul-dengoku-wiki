      {
        "id": "packing",
        "name": {
          "ko": "패킹 교체·누수 판단",
          "en": "Packing replacement and leak assessment"
        },
        "rating": 60
      },
      {
        "id": "parts",
        "name": {
          "ko": "불량 부품 출고 검사",
          "en": "Defective-parts dispatch inspection"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "leak-sites-first",
        "name": {
          "ko": "누수 현장 우선",
          "en": "Leak Sites First"
        },
        "description": {
          "ko": "최나래는 도면 검토보다 현장의 누수 소리와 골목 급수 문제를 먼저 살핀다.",
          "en": "Choe Narae prioritizes on-site leak sounds and neighborhood water problems over drawing review."
        },
        "behavior": {
          "ko": "누수 현장으로 달려가 공개 설계를 시험하고 장민재의 골목 저수조 수리를 최우선에 둔다.",
          "en": "Choe rushes to leaks, tests open designs on site, and gives first priority to Jang Minjae's neighborhood reservoir repairs."
        },
        "stress": {
          "ko": "정비조가 민병으로만 차출될 우려가 커지면 골목 펌프 수리를 본래 임무로 더 강조할 수 있다.",
          "en": "If the maintenance team risks being called out only as militia, Choe may stress neighborhood pump repair more strongly as its core task."
        },
        "relationship": {
          "ko": "임초원의 공개 설계와 장민재의 급수 요구를 현장 시험과 수리 우선순위로 연결할 수 있다.",
          "en": "Choe may connect Im Chowon's open designs and Jang Minjae's supply demands through field testing and repair priorities."
        },
        "effects": []
      },
      {
        "id": "guard-against-militarized-maintenance",
        "name": {
          "ko": "정비조 군사화 경계",
          "en": "Guard Against Militarized Maintenance"
        },
        "description": {
          "ko": "최나래는 무장 호위가 정비 인원으로 섞여 정비조의 역할을 바꾸는 일을 경계한다.",
          "en": "Choe Narae is wary of armed escorts being inserted as maintenance personnel and changing the team's role."
        },
        "behavior": {
          "ko": "출동 명부에 세 대표의 서명을 요구하고 야간 무장 차출은 공구 반납 뒤에만 따른다.",
          "en": "Choe requires three representatives' signatures on deployment rosters and follows armed night call-ups only after tool return."
        },
        "stress": {
          "ko": "공구 대신 차단봉을 들게 될 위험이 커지면 정비 출동과 무장 차출의 절차를 더 분명히 나눌 수 있다.",
          "en": "If the team risks carrying barriers instead of tools, Choe may separate maintenance deployments from armed call-ups more clearly."
        },
        "relationship": {
          "ko": "김보람과 순찰을 나누더라도 정비 인원을 무장 호위로 취급하는 요구에는 경계를 세울 수 있다.",
          "en": "Even while sharing patrol duties with Kim Boram, Choe may set limits against treating maintenance workers as armed escorts."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "누수에 출동하고 공개 설계를 현장에서 시험하며 불량 부품을 돌려보냈다. 정비 조정과 실행이 중심이며 민병 경력을 부여하지 않는다.",
      "en": "She responds to leaks, tests open designs in the field, and returns faulty parts. Repair coordination and execution are central, not a militia career."
    },
