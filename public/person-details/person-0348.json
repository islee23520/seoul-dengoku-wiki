    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "두 저울을 맞춘다",
          "en": "Requires two matching scales"
        },
        "description": {
          "ko": "두 저울이 어긋나면 출고를 멈추고 정전 중 수술을 이어간 기록이 있다. 중개 수수료 비공개는 감정서 중시와 함께 남긴다.",
          "en": "They halt shipment when two scales disagree and continued surgery during an outage. Private commission ledgers coexist with an emphasis on appraisal papers."
        },
        "behavior": {
          "ko": "약재 무게를 두 저울로 재고, 한 저울만 맞는 거래는 거절한다. 큰소리 흥정보다 감정서를 남긴다. 제기동의 중립 의료국 흰십자단에서 담당 전문의의 도제로 배우며, 적아 구분 없이 중증도만으로 치료한다.",
          "en": "She weighed herb weights on two scales and refused any trade that balanced on only one. She left appraisal papers over loud bargaining."
        },
        "stress": {
          "ko": "공포. 가짜 약재가 최저선 급수와 묶여 환자 명부에 들어가는 것.",
          "en": "Fear. That counterfeit herbs would bind to the minimum-line water supply and enter the patient roster."
        },
        "relationship": {
          "ko": "관계. 류은비의 치료 길드와 협력하되, 중개 수수료 장부는 공개하지 않는다.",
          "en": "Relations. Cooperated with Ryu Eunbi's healing guild, but kept the brokerage fee ledger private."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 수련의. 직함은 약재 감별 수련의. 감정 불일치는 처방 이중확인이 끝날 때까지 출고를 멈춘다.",
          "en": "Office. Rank: member. Title: medicine brokerage appraiser. An appraisal mismatch stopped the release until the prescription was double-checked."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 수련의. 직함은 약재 감별 수련의. 감정 불일치는 처방 이중확인이 끝날 때까지 출고를 멈춘다.",
          "en": "Recorded duty and limits: Office. Rank: member. Title: medicine brokerage appraiser. An appraisal mismatch stopped the release until the prescription was double-checked."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 가짜 약재가 최저선 급수와 묶여 환자 명부에 들어가는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That counterfeit herbs would bind to the minimum-line water supply and enter the patient roster."
        },
        "relationship": {
          "ko": "관계. 류은비의 치료 길드와 협력하되, 중개 수수료 장부는 공개하지 않는다.",
          "en": "Relations. Cooperated with Ryu Eunbi's healing guild, but kept the brokerage fee ledger private."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "두 저울이 어긋나면 출고를 멈추고 정전 중 수술을 이어간 기록이 있다. 중개 수수료 비공개는 감정서 중시와 함께 남긴다.",
      "en": "They halt shipment when two scales disagree and continued surgery during an outage. Private commission ledgers coexist with an emphasis on appraisal papers."
    },
