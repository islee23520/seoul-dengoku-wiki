    "traits": [
      {
        "id": "k273-priority",
        "name": {
          "ko": "숙련 증명 요구",
          "en": "Demands demonstrated competence"
        },
        "description": {
          "ko": "조우찬은 작업 조를 순환시키고 반장과 도제에게 사고 책임을 함께 묻는다. 기술 승인 우선이 사택 불안과 충돌한다.",
          "en": "Jo Uchan rotates work crews and requires shared accident accountability from foremen and apprentices. Technical approval comes into conflict with residential anxiety."
        },
        "behavior": {
          "ko": "작업 조를 순환 배치하고, 사고 한 건에 반장과 도제의 서명을 함께 요구한다.",
          "en": "Office. Rank: assistant manager. Title: work squad leader. He rotated the work squads through stations and demanded the squad leader's and the apprentice's signatures together for every accident."
        },
        "stress": {
          "ko": "인구 많은 사택 대표가 급수 불안을 구실로 기지를 점거하는 것.",
          "en": "Fear. That populous residents' representatives would seize the base on the pretext of water anxiety."
        },
        "relationship": {
          "ko": "이홍원의 지휘로 차륜 공정을 나누고 강민서의 수리 규격을 현장 적용한다. 강다은에게 시험 차륜이 새어 나갔다는 의심을 품는다.",
          "en": "Relations. Divided the wheel process under I Hongwon's command and applied Gang Minseo's repair standards in the field. Held the suspicion that the trial wheels had leaked to Gang Daeun."
        },
        "effects": []
      },
      {
        "id": "k273-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 사원. 직함은 성하전자 작업 반장. 작업 조를 순환 배치하고, 사고 한 건에 반장과 도제의 서명을 함께 요구한다.",
          "en": "Office. Rank: assistant manager. Title: work squad leader. He rotated the work squads through stations and demanded the squad leader's and the apprentice's signatures together for every accident."
        },
        "stress": {
          "ko": "공포. 인구 많은 사택 대표가 급수 불안을 구실로 기지를 점거하는 것.",
          "en": "Fear. That populous residents' representatives would seize the base on the pretext of water anxiety."
        },
        "relationship": {
          "ko": "관계. 이홍원의 지휘로 차륜 공정을 나누고 강민서의 수리 규격을 현장 적용한다. 강다은에게 시험 차륜이 새어 나갔다는 의심을 품는다.",
          "en": "Relations. Divided the wheel process under I Hongwon's command and applied Gang Minseo's repair standards in the field. Held the suspicion that the trial wheels had leaked to Gang Daeun."
        },
        "effects": []
      }
    ],
    "narrative": {
