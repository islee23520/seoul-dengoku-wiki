  "relations": {
    "outgoing": [
      {
        "from": "문돌은",
        "type": "계약",
        "to": "두봉",
        "basis": "문돌은은 금고 설비에서 찾은 공급 이상을 두봉에게 전한다. 두봉은 예비 전원을 순환 시험하고 문돌은은 설비를 다시 점검해 전력 문제와 기계 고장을 따로 인계한다."
      }
    ],
