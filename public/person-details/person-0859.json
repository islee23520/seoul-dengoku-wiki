    "traits": [
      {
        "id": "patrol-signs-first",
        "name": {
          "ko": "초계 징후 먼저",
          "en": "Patrol Signs First"
        },
        "description": {
          "ko": "최바아는 초계에서 위험의 흔적을 먼저 읽는 데 주의를 두는 성향을 보인다.",
          "en": "Choe Baa shows a disposition to attend first to traces of danger during patrol."
        },
        "behavior": {
          "ko": "능선 초계 중 매복 흔적을 먼저 읽어 피해를 막았다.",
          "en": "During a ridge patrol, he read ambush traces early and prevented harm."
        },
        "stress": {
          "ko": "당직 단절로 통행이 위협받을까 우려되면 눈앞의 초계 징후를 더 신중히 살필 수 있다.",
          "en": "If he fears interrupted duty will threaten passage, he may examine immediate patrol signs more carefully."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 직접 읽은 매복 흔적을 공유하는 데 무게를 둘 수 있다.",
          "en": "In handovers with senior duty staff, he may emphasize sharing the ambush traces he personally recognized."
        },
        "effects": []
      },
      {
        "id": "avoid-verified-hazards",
        "name": {
          "ko": "확인된 위험 회피",
          "en": "Avoid Verified Hazards"
        },
        "description": {
          "ko": "최바아는 읽어 낸 매복 징후를 근거로 피해를 피하는 판단을 중시하는 성향을 보인다.",
          "en": "Choe Baa shows a disposition to base harm avoidance on the ambush signs he has recognized."
        },
        "behavior": {
          "ko": "능선의 매복 흔적을 알아챈 뒤 그 위험으로 인한 피해를 막았다.",
          "en": "After recognizing ambush traces on the ridge, he prevented harm from that danger."
        },
        "stress": {
          "ko": "초계를 이어 가는 일과 매복 위험이 충돌하면 확인한 징후에 근거해 피해 회피를 우선할 수 있다.",
          "en": "If continuing patrol conflicts with ambush danger, he may prioritize avoiding harm on the basis of observed signs."
        },
        "relationship": {
          "ko": "선배 당직에게는 위험 판단의 근거가 된 흔적을 함께 전달하려 할 수 있다.",
          "en": "He may seek to pass senior duty staff the traces that supported his risk judgment."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "능선의 매복 흔적으로 피해를 막았다. 관찰 강점은 있으나 정보망 소유나 전투 승전은 없다.",
      "en": "He prevented harm through ridge ambush signs. Observation is a strength, not ownership of an intelligence network or combat victories."
    },
