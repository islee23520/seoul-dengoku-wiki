    "traits": [
      {
        "id": "reproducible-records-first",
        "name": {
          "ko": "재현 기록 우선",
          "en": "Reproducible Records First"
        },
        "description": {
          "ko": "정하린은 권위보다 재현 가능한 실험 기록을 안전 판단의 근거로 삼는다.",
          "en": "Jeong Harin bases safety judgments on reproducible experimental records rather than authority."
        },
        "behavior": {
          "ko": "모든 파견과 기술 인증에 재현 기록을 요구하고 긴급 회의에서도 표본 봉인을 먼저 확인한다.",
          "en": "She requires reproducible records for every deployment and technical certification and checks sample seals even during urgent meetings."
        },
        "stress": {
          "ko": "심사 기록이 군사 감독 문서로 바뀔 우려가 있다면 검증 기록과 안전심사의 독립성을 더 중시할 수 있다.",
          "en": "If review records risk becoming military oversight documents, she may place greater weight on verifiable records and independent safety review."
        },
        "relationship": {
          "ko": "수질 표본의 검증이 필요하다면 박누리와의 표본 교환을 활용할 수 있다.",
          "en": "She may draw on her sample-exchange arrangement with Park Nuri when water samples need verification."
        },
        "effects": []
      },
      {
        "id": "lock-down-removal-under-pressure",
        "name": {
          "ko": "독촉에 반출 잠금",
          "en": "Lock Down Removal Under Pressure"
        },
        "description": {
          "ko": "정하린은 책임자의 독촉보다 안전 기준과 반출 거부권을 우선한다.",
          "en": "Jeong Harin places safety standards and removal vetoes above pressure from the research lead."
        },
        "behavior": {
          "ko": "기준 미달이면 생명안전 연구책임자가 독촉해도 반출을 잠근다.",
          "en": "She locks down removal when standards are unmet, even if the life-safety research lead presses her."
        },
        "stress": {
          "ko": "보호를 명분으로 연구자를 인질화할 위험이 있다면 안전심사 거부권을 양보하지 않으려 할 수 있다.",
          "en": "If protection is used to justify holding researchers hostage, she may resist surrendering the safety-review veto."
        },
        "relationship": {
          "ko": "배우진이 군사감독을 요구한다면 정호준과의 거부권 집행 동맹을 바탕으로 반대할 수 있다.",
          "en": "If Bae Ujin demands military oversight, she may oppose it through her veto-enforcement alliance with Jeong Hojun."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "재현 기록을 요구하고 화재 때 인명 장부를 보존했다. 반복 안전 판단을 반영하되 구조 전투나 연구 면허를 만들지 않는다.",
      "en": "She requires reproducible records and preserved personnel registers during a fire. Safety judgment is supported, not combat rescue or an invented research license."
    },
