    "skills": [
      {
        "id": "broadcast-correction",
        "name": {
          "ko": "정정 방송",
          "en": "Broadcast correction"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "k782-disposition",
        "name": {
          "ko": "오보 원문 보존",
          "en": "Preserving the original error"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 중계 당직. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: registrar. Title: relay duty. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "공포. 중계 당직 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the relay duty duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 니키타 볼코프는 보존한 거짓 속보와 정정 방송을 소피아 로시에게 전한다. 소피아 로시는 이전 소식을 받은 창구를 확인해 정정이 다른 상대에게만 전해지지 않게 한다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Nikita Volkov gives Sofia Rossi the preserved false bulletin and correction broadcast. Sofia checks counters that received the earlier news so the correction is not delivered only to different recipients."
        },
        "effects": []
      },
      {
        "id": "k782-choice",
        "name": {
          "ko": "정정 도착 중시",
          "en": "Correction arrival matters"
        },
        "description": {
          "ko": "일화. 2125년 거짓 속보를 살리고 진짜 칸에 정정 방송을 붙였다. 이 일로 중계 당직 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he killed the false bulletin and pasted a correction broadcast into the true column. By this deed the signature of the relay duty post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 니키타 볼코프는 보존한 거짓 속보와 정정 방송을 소피아 로시에게 전한다. 소피아 로시는 이전 소식을 받은 창구를 확인해 정정이 다른 상대에게만 전해지지 않게 한다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Nikita Volkov gives Sofia Rossi the preserved false bulletin and correction broadcast. Sofia checks counters that received the earlier news so the correction is not delivered only to different recipients."
        },
        "stress": {
          "ko": "공포. 중계 당직 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the relay duty duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 니키타 볼코프는 보존한 거짓 속보와 정정 방송을 소피아 로시에게 전한다. 소피아 로시는 이전 소식을 받은 창구를 확인해 정정이 다른 상대에게만 전해지지 않게 한다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Nikita Volkov gives Sofia Rossi the preserved false bulletin and correction broadcast. Sofia checks counters that received the earlier news so the correction is not delivered only to different recipients."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "거짓 속보와 정정을 함께 남겨 소피아에게 전한다. 수신자별 재전달은 전령의 후속 작업이다.",
      "en": "Keeps false and corrected bulletins together and sends them to Sofia. Recipient-specific redelivery is the courier’s follow-up."
    },
