    "skills": [
      {
        "id": "k293-water-timing-testimony",
        "name": {
          "ko": "급수 시각 증언",
          "en": "Water timing testimony"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "k293-priority",
        "name": {
          "ko": "본인 증언 고수",
          "en": "Own testimony only"
        },
        "description": {
          "ko": "평채원은 식은 주전자로 갈증을 증언하고 본인 손도장만 받는다. 압력 관찰은 전문 배관 정비 이력이 아니다.",
          "en": "Pyeong Chaewon testifies to thirst with a cold kettle and accepts only personal handprints. Pressure observation is not professional pipe maintenance."
        },
        "behavior": {
          "ko": "압력계 바늘이 멈춘 시각을 주전자 옆 종이에 적고, 연서에는 본인 손도장만 받아 서진아의 감사 함에 넣는다.",
          "en": "Office. Rank: assistant manager. Title: water pressure drop residential party. She wrote the hour the pressure needle stopped on the paper beside the kettle and put only her own handprint into the joint signature for Seo Jina's audit box."
        },
        "stress": {
          "ko": "당사자 증언이 보호 급수의 들러리 명부로 바뀌어 자신이 없는 단수의 보증인이 되는 것.",
          "en": "Fear. That the party testimony would turn into a procession roster of protected water supply and she would become the guarantor of a cutoff that never happened."
        },
        "relationship": {
          "ko": "서진아의 사택 감사 함에 당사자 손도장을 보태고, 모복의 수위 막대를 주전자 시간과 겹쳐 읽는다. 한재목의 물 협상이 쉘 이름을 빌려 쓰면 증언을 거둔다.",
          "en": "Relations. Added the party handprint to Seo Jina's housing audit box and read Mo Bok's water-level rod overlaid with the kettle hours. Withdrew her testimony whenever Han Jaemok's water talks borrowed the shell's name."
        },
        "effects": []
      },
      {
        "id": "k293-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 사원. 직함은 강남역 사택 급수 당사자. 압력계 바늘이 멈춘 시각을 주전자 옆 종이에 적고, 연서에는 본인 손도장만 받아 서진아의 감사 함에 넣는다.",
          "en": "Office. Rank: assistant manager. Title: water pressure drop residential party. She wrote the hour the pressure needle stopped on the paper beside the kettle and put only her own handprint into the joint signature for Seo Jina's audit box."
        },
        "stress": {
          "ko": "공포. 당사자 증언이 보호 급수의 들러리 명부로 바뀌어 자신이 없는 단수의 보증인이 되는 것.",
          "en": "Fear. That the party testimony would turn into a procession roster of protected water supply and she would become the guarantor of a cutoff that never happened."
        },
        "relationship": {
          "ko": "관계. 서진아의 사택 감사 함에 당사자 손도장을 보태고, 모복의 수위 막대를 주전자 시간과 겹쳐 읽는다. 한재목의 물 협상이 쉘 이름을 빌려 쓰면 증언을 거둔다.",
          "en": "Relations. Added the party handprint to Seo Jina's housing audit box and read Mo Bok's water-level rod overlaid with the kettle hours. Withdrew her testimony whenever Han Jaemok's water talks borrowed the shell's name."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "평채원은 식은 주전자로 갈증을 증언하고 본인 손도장만 받는다. 압력 관찰은 전문 배관 정비 이력이 아니다.",
      "en": "Pyeong Chaewon testifies to thirst with a cold kettle and accepts only personal handprints. Pressure observation is not professional pipe maintenance."
    },
