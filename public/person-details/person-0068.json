    "traits": [
      {
        "id": "reproducible-prescriptions-first",
        "name": {
          "ko": "재현 처방 우선",
          "en": "Reproducible Prescriptions First"
        },
        "description": {
          "ko": "진채온은 재현되지 않은 처방보다 검증 기록과 시약 봉인을 신뢰한다.",
          "en": "Jin Chaeon trusts verification records and reagent seals over unreproduced prescriptions."
        },
        "behavior": {
          "ko": "파견 진료에 재현 가능한 실험 기록을 요구하고 기준 미달이면 독촉에도 반출을 잠근다.",
          "en": "She requires reproducible experimental records for deployed care and locks removal despite pressure when standards are unmet."
        },
        "stress": {
          "ko": "진료 기록이 군사 감독 문서로 바뀔 우려가 있다면 안전 확인과 진료 쪽 거부권을 더 중시할 수 있다.",
          "en": "If care records risk becoming military oversight documents, she may give greater weight to safety checks and clinical veto enforcement."
        },
        "relationship": {
          "ko": "약효의 검증이 필요하다면 류은비에게 실험동 표본을 보내고 정하린의 거부권을 진료에서 집행할 수 있다.",
          "en": "When drug effects need verification, she may send laboratory samples to Ryu Eunbi and enforce Jeong Harin’s veto in care."
        },
        "effects": []
      },
      {
        "id": "shared-shortfall-allocation",
        "name": {
          "ko": "부족분 공동 배분",
          "en": "Shared Shortfall Allocation"
        },
        "description": {
          "ko": "진채온은 약재 부족을 일부의 독점보다 모두가 나눠 감당하는 방식으로 처리했다.",
          "en": "Jin Chaeon handled a medicine shortage by sharing the shortfall across everyone rather than reserving supplies for a few."
        },
        "behavior": {
          "ko": "약재가 부족한 때 처방량을 반으로 나누어 모두에게 배분했다.",
          "en": "During a medicine shortage, she halved prescription quantities and distributed them to everyone."
        },
        "stress": {
          "ko": "진료가 연구자를 인질로 쓰는 거래에 묶일 우려가 있다면 배분을 거래 수단으로 삼는 데 경계할 수 있다.",
          "en": "If care risks being tied to deals that hold researchers hostage, she may be wary of using allocation as bargaining leverage."
        },
        "relationship": {
          "ko": "부족 약재를 배분해야 한다면 정하린과 공유하는 안전 기준 안에서 공동 배분을 택할 수 있다.",
          "en": "If scarce medicine must be allocated, she may choose shared distribution within the safety standards she shares with Jeong Harin."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "재현 기록을 진료 조건으로 삼고 부족 약재를 나눴다. 처방 배분과 안전 확인에 한정하고 외과 수술이나 약품 제조는 없다.",
      "en": "She requires reproducible records for care and shared scarce medicine. Allocation and safety checks are supported, not surgery or drug manufacture."
    },
