    "traits": [
      {
        "id": "k527-disposition",
        "name": {
          "ko": "비공식 물자를 기록으로",
          "en": "Informal supplies into records"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 교도. 직함은 경매 서기.",
          "en": "Office. Rank: lay instructor. Title: auction clerk."
        },
        "stress": {
          "ko": "공포. 경매 서기 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the auction clerk duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k527-choice",
        "name": {
          "ko": "접수 뒤 부착 기록",
          "en": "Recording attachment after receipt"
        },
        "description": {
          "ko": "일화. 2125년 밀수 호스를 접수해 관로에 다는 대장을 남겼다. 이 일로 경매 서기 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he impounded a smuggled hose and left the ledger of its fitting to the pipeline. By this deed the signature of the auction clerk post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "stress": {
          "ko": "공포. 경매 서기 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the auction clerk duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "밀수 호스를 접수하고 관로 부착 대장을 남겼다. 대장 실무는 확인되나 직접 관로 시공은 불명확하다.",
      "en": "Receives a smuggled hose and records its pipe attachment. Ledger work is supported; direct pipe construction is unclear."
    },
