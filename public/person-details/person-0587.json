    "traits": [
      {
        "id": "stop-unsigned-departures",
        "name": {
          "ko": "서명 없는 출발 정지",
          "en": "Stop Unsigned Departures"
        },
        "description": {
          "ko": "정타준은 출발에 필요한 서명 확인을 생략하지 않는 성향을 보인다.",
          "en": "Jeong Tajun shows a reluctance to waive signature verification required for departure."
        },
        "behavior": {
          "ko": "배차표 없는 열차를 세워 서명 없는 출발을 막았다.",
          "en": "He stopped a train lacking a dispatch sheet and blocked its unsigned departure."
        },
        "stress": {
          "ko": "당직 공백이 통행의 종속을 초래할까 우려되면 서명 없는 출발을 허용하는 데 더 신중할 수 있다.",
          "en": "If a duty gap could leave passage dependent on a powerful state, he may be more cautious about permitting unsigned departures."
        },
        "relationship": {
          "ko": "선배 당직과는 출발을 막은 이유와 서명 누락을 분명히 인계하려 할 수 있다.",
          "en": "He may clearly hand over the reason for stopping departure and the missing signature to the senior duty holder."
        },
        "effects": []
      },
      {
        "id": "continuous-duty-records",
        "name": {
          "ko": "당직 연속 기록",
          "en": "Continuous Duty Records"
        },
        "description": {
          "ko": "정타준은 당직과 장부가 끊기지 않도록 기록을 이어 가는 데 무게를 둔다.",
          "en": "Jeong Tajun values carrying records forward so duty and the ledger remain continuous."
        },
        "behavior": {
          "ko": "서명 없는 출발을 막고 자기 직위의 열쇠와 기록을 넘겨 장부의 연속성을 지향한다.",
          "en": "He blocks unsigned departures and passes on his post's keys and records to support ledger continuity."
        },
        "stress": {
          "ko": "당직이 비어 통행이 강국의 볼모가 될까 우려되면 인계 기록의 연결을 더 중시할 수 있다.",
          "en": "If vacant duty could make passage hostage to a powerful state, he may place greater weight on connected handover records."
        },
        "relationship": {
          "ko": "선배 당직과는 출발 확인 기록을 이어 주는 인계를 협력의 기준으로 삼을 수 있다.",
          "en": "He may use handover of departure-verification records as a basis for cooperation with the senior duty holder."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "배차표 없는 출발을 막았다. 출발 절차의 좁은 강점만 확인되어 철도 운전이나 정비는 발급하지 않았다.",
      "en": "She prevented departure without a dispatch sheet. Narrow procedural strength is supported; driving and repair are not issued."
    },
