    "skills": [
      {
        "id": "k136-family-register",
        "name": {
          "ko": "가족 등록 기록",
          "en": "Family registration records"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "k136-choice",
        "name": {
          "ko": "거부 칸을 남김",
          "en": "Leaves room for refusal"
        },
        "description": {
          "ko": "가족 칸이 비면 등록을 멈추고, 숫자를 병력으로만 읽는 교관의 말을 원장 난외에 따로 적는다. 잉크는 검고 해석은 늦게 한다.",
          "en": "He stopped registration when the family column stood empty and wrote in the ledger's margin, separately, the instructor's words that read numbers as troops alone. His ink was black and his readings came late."
        },
        "behavior": {
          "ko": "일화. 2125년 사적 청탁을 돌려보내고 공개 창구로 보냈다. 이 일로 군사호적 등록 서기 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he sent a private petition back and passed it to the public window. By this deed the signature of the military registry registration clerk post rose into the ledger."
        },
        "stress": {
          "ko": "공포. 자신이 철한 명부가 탈주 추적의 근거가 되고, 서기가 장교망의 하부 필적이 되는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That the rosters he filed would become grounds for deserter hunts, and the clerk would become the officer network's lower handwriting. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 정소율의 행정 창구를 등록의 정통으로 삼고, 장석윤의 교관 명부와 충돌하며, 구로의 고모래가 보낸 거부 증언 사본을 난외에 붙인다.",
          "en": "Relations. Taking Jeong Soyul's administrative window as registration legitimacy, clashing with Jang Seokyun's instructor roster, and pasting in the margin the refusal testimony copies Go Morae of Guro had sent."
        },
        "effects": []
      },
      {
        "id": "k136-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 병장. 직함은 군사호적 등록 서기. 등록은 상수행정청의 낮 창구에서만 받고, 야간 장교 단독 명부는 철하지 않은 채 돌려보낸다.",
          "en": "Office. Rank: sergeant. Title: military registry registration clerk. He took registrations only at the water administration's daytime window and sent night officers' solo rosters back unfiled."
        },
        "behavior": {
          "ko": "관직. 품계 병장. 직함은 군사호적 등록 서기. 등록은 상수행정청의 낮 창구에서만 받고, 야간 장교 단독 명부는 철하지 않은 채 돌려보낸다.",
          "en": "Office. Rank: sergeant. Title: military registry registration clerk. He took registrations only at the water administration's daytime window and sent night officers' solo rosters back unfiled."
        },
        "stress": {
          "ko": "공포. 자신이 철한 명부가 탈주 추적의 근거가 되고, 서기가 장교망의 하부 필적이 되는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That the rosters he filed would become grounds for deserter hunts, and the clerk would become the officer network's lower handwriting. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 정소율의 행정 창구를 등록의 정통으로 삼고, 장석윤의 교관 명부와 충돌하며, 구로의 고모래가 보낸 거부 증언 사본을 난외에 붙인다.",
          "en": "Relations. Taking Jeong Soyul's administrative window as registration legitimacy, clashing with Jang Seokyun's instructor roster, and pasting in the margin the refusal testimony copies Go Morae of Guro had sent."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "일화. 2125년 사적 청탁을 돌려보내고 공개 창구로 보냈다. 이 일로 군사호적 등록 서기 자리의 서명이 장부에 올랐다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Anecdote. In 2125 he sent a private petition back and passed it to the public window. By this deed the signature of the military registry registration clerk post rose into the ledger. Titles and ambitions are not treated as accomplished authority or results."
    },
