    "skills": [
      {
        "id": "save-register",
        "name": {
          "ko": "위기 인명 장부 보존",
          "en": "Emergency preservation of personnel registers"
        },
        "rating": 45
      },
      {
        "id": "handover",
        "name": {
          "ko": "기록·열쇠 인수인계",
          "en": "Record and key handover"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "people-registers-first",
        "name": {
          "ko": "인명 장부 우선",
          "en": "People Registers First"
        },
        "description": {
          "ko": "진마린은 화재에서 인명 장부를 먼저 보존한 기록 우선 성향을 보인다.",
          "en": "Jin Marin shows a record-preservation priority by saving the people register first during a fire."
        },
        "behavior": {
          "ko": "역사 화재 때 인명 장부부터 꺼내 들고 나왔다.",
          "en": "They carried the people register out first during the station fire."
        },
        "stress": {
          "ko": "기록 손실과 당직 공백이 통행을 위협한다면 인명 장부 확보를 우선할 수 있다.",
          "en": "If record loss and a vacant shift threaten passage, they may prioritize securing the people register."
        },
        "relationship": {
          "ko": "선배 당직과 위기 후 인계를 한다면 보존한 인명 장부를 확인의 중심에 둘 수 있다.",
          "en": "In a post-crisis handover with a senior duty colleague, they may make the preserved people register central to verification."
        },
        "effects": []
      },
      {
        "id": "record-continuity",
        "name": {
          "ko": "기록 연속성",
          "en": "Record Continuity"
        },
        "description": {
          "ko": "진마린은 장부와 당직을 끊기지 않게 잇는 것을 중시한다.",
          "en": "Jin Marin values keeping registers and duty coverage continuous."
        },
        "behavior": {
          "ko": "인명 장부를 보존하고 자기 직위의 열쇠와 기록만 인계하는 범위를 따른다.",
          "en": "They preserve the people register and keep handovers within their own keys and records."
        },
        "stress": {
          "ko": "당직 공백으로 태욱그룹의 통행이 강국에 좌우될 우려가 커지면 기록 인계를 더 중시할 수 있다.",
          "en": "Fear that a vacant shift could leave Taewook Group's passage controlled by a powerful state may increase their emphasis on record handover."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 이어받을 장부와 열쇠를 분명히 하는 방식으로 협력할 수 있다.",
          "en": "They may cooperate with a senior duty colleague by clarifying which registers and keys are being transferred."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "화재에서 인명 장부부터 보존했다. 카드 관직 문단의 분리된 문자 오류는 설정 근거로 쓰지 않았으며 계측 숙련은 확인되지 않는다.",
      "en": "He preserved personnel registers first during a fire. A stray character in the office paragraph is not lore evidence; metrology skill is not documented."
    },
