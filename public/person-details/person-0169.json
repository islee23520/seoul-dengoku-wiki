    "skills": [
      {
        "id": "k168-hash-comparison",
        "name": {
          "ko": "원본 해시 대조",
          "en": "Original hash comparison"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "k168-choice",
        "name": {
          "ko": "독립 날인 유지",
          "en": "Maintains independent certification"
        },
        "description": {
          "ko": "공증 도장의 잉크가 번진 자리는 통과시키지 않는다. 큰 인준보다 한 장의 원본 해시를 지킨다.",
          "en": "He passed no spot where a notary stamp's ink had smudged. He guarded one original's hash over any grand ratification."
        },
        "behavior": {
          "ko": "일화. 잉크가 번진 공증 도장을 단 사본이 원본 해시 두 개를 달고 감사대에 오른다. 조이록은 어느 해시가 원본을 가리키는지 확인할 때까지 사본을 붙들어 두고, 윤서린의 봉인과 따로 두는 공증 날인 칸을 그동안 비워 둔다.",
          "en": "Anecdote. A copy with a smudged notarial stamp comes to the audit desk carrying two original hashes. Jo Irok holds the copy until it is confirmed which hash points to the original, and meanwhile leaves blank the notarial box kept apart from Yun Seorin's seal."
        },
        "stress": {
          "ko": "공포. 번진 도장이 유효한 인준처럼 유통되는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That smudged stamps would circulate as valid ratifications. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 윤서린의 봉인 권한과 겹치지만, 공증 날인은 따로 둔다.",
          "en": "Relations. Overlapped with Yun Seorin's seal authority, but kept the notary stamp separate."
        },
        "effects": []
      },
      {
        "id": "k168-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 주사. 직함은 기록 공증 감사관. 사본 공증은 원본 해시가 확인되기 전에 내보내지 않는다.",
          "en": "Office. Rank: registrar. Title: record notarization auditor. He sent out no copy notarization before the original's hash was confirmed."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 기록 공증 감사관. 사본 공증은 원본 해시가 확인되기 전에 내보내지 않는다.",
          "en": "Office. Rank: registrar. Title: record notarization auditor. He sent out no copy notarization before the original's hash was confirmed."
        },
        "stress": {
          "ko": "공포. 번진 도장이 유효한 인준처럼 유통되는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That smudged stamps would circulate as valid ratifications. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 윤서린의 봉인 권한과 겹치지만, 공증 날인은 따로 둔다.",
          "en": "Relations. Overlapped with Yun Seorin's seal authority, but kept the notary stamp separate."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "일화. 잉크가 번진 공증 도장을 단 사본이 원본 해시 두 개를 달고 감사대에 오른다. 조이록은 어느 해시가 원본을 가리키는지 확인할 때까지 사본을 붙들어 두고, 윤서린의 봉인과 따로 두는 공증 날인 칸을 그동안 비워 둔다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Anecdote. A copy with a smudged notarial stamp comes to the audit desk carrying two original hashes. Jo Irok holds the copy until it is confirmed which hash points to the original, and meanwhile leaves blank the notarial box kept apart from Yun Seorin's seal. Titles and ambitions are not treated as accomplished authority or results."
    },
