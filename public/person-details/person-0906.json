    "skills": [
      {
        "id": "log-gap",
        "name": {
          "ko": "온습도 기록 공백 대조",
          "en": "Temperature-log gap reconciliation"
        },
        "rating": 55
      },
      {
        "id": "seed",
        "name": {
          "ko": "온습도·종자 출고 확인",
          "en": "Temperature and seed-release checks"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "temperature-logs-over-requisition",
        "name": {
          "ko": "징발보다 온도 로그",
          "en": "Temperature Logs Over Requisition"
        },
        "description": {
          "ko": "서돌서는 징발 문서가 붙은 출고 요청에서도 해당 상자의 온도 기록부터 확인한다.",
          "en": "Seo Dolseo checks a box's temperature records first even when its release request carries a requisition document."
        },
        "behavior": {
          "ko": "징발 요청 상자의 온도 로그를 찾아 끊긴 구간을 표시한다.",
          "en": "They locate the requested box's temperature log and mark its interrupted intervals."
        },
        "stress": {
          "ko": "전시 징발의 압박이 커져도 기록 공백을 먼저 드러내려 할 수 있다.",
          "en": "Even under mounting wartime requisition pressure, they may seek to expose record gaps first."
        },
        "relationship": {
          "ko": "박진솔에게 출고 요청을 올릴 때 징발 문서만이 아니라 온도 공백을 함께 판단 근거로 제시할 수 있다.",
          "en": "When reporting the release request to Park Jinsol, they may present temperature gaps alongside the requisition document."
        },
        "effects": []
      },
      {
        "id": "mark-locked-boxes",
        "name": {
          "ko": "잠금 상자 표시",
          "en": "Mark Locked Boxes"
        },
        "description": {
          "ko": "서돌서는 반출 잠금이 걸린 상자를 번호로 특정해 보고하는 쪽이다.",
          "en": "Seo Dolseo identifies boxes subject to release locks by number in reports."
        },
        "behavior": {
          "ko": "정하린의 반출 잠금이 걸린 상자 번호를 온도 공백과 함께 적어 박진솔에게 올린다.",
          "en": "They report the box numbers under Jeong Harin's release lock to Park Jinsol together with the temperature gaps."
        },
        "stress": {
          "ko": "징발 요청과 반출 잠금이 맞물리면 잠금 대상 번호가 보고에서 빠지지 않도록 더 주의할 수 있다.",
          "en": "When a requisition request intersects with a release lock, they may take extra care not to omit the locked box numbers."
        },
        "relationship": {
          "ko": "정하린의 잠금과 박진솔의 확인을 연결할 때 잠금을 임의로 풀기보다 번호를 명시해 전달할 수 있다.",
          "en": "When connecting Jeong Harin's lock with Park Jinsol's review, they may relay explicit numbers rather than remove the lock themselves."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "징발 요청 상자의 온도 공백과 반출 잠금 번호를 함께 기록했다. 이 사건의 조건 대조를 평가하며 군사 명령권은 없다.",
      "en": "He recorded temperature gaps and locked-box numbers together despite a requisition request. Conditional checking is supported, not military command."
    },
