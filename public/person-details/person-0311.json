    "traits": [
      {
        "id": "k310-priority",
        "name": {
          "ko": "외부 진입 경계",
          "en": "Guards external entry"
        },
        "description": {
          "ko": "국소는 당직과 출고 시각을 공개하고 후문 수비 교대를 확인한다. 빠진 명단 한 줄에서 공모를 확정하지 않는다.",
          "en": "Gukso publishes duty and release times and checks rear-gate defense shifts. A missing roster line does not prove collusion."
        },
        "behavior": {
          "ko": "당직 명과 출고 시각을 같은 칠판에 붙이고, 외부 무장 접근은 문시온의 동행 없이 막는다.",
          "en": "Office. Rank: convoy hand. Title: Sinnae rolling-stock depot duty chief. He pasted the duty roster and release hours on one chalkboard and blocked armed outside approach without Mun Sion's escort."
        },
        "stress": {
          "ko": "기지 당직이 무기 적재의 발판이 되어 장세화의 중립이 내부에서 깨지는 것.",
          "en": "Fear. That base duty would become the footstool of arms loading and Jang Sehwa's neutrality would break from within."
        },
        "relationship": {
          "ko": "소두감의 정비 창과 당직을 나누고, 안도한의 배차표를 칠판 맨 위에 둔다. 곽태산의 수비 교대를 기지 후문에서 확인한다.",
          "en": "Relations. Split the repair shop and duty with So Dugam and put An Dohan's dispatch sheet at the top of the chalkboard. Confirmed Gwak Taesan's defense rotations at the base rear gate."
        },
        "effects": []
      },
