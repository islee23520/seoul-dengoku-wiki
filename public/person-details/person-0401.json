    "skills": [
      {
        "id": "implementation-audit",
        "name": {
          "ko": "계약 이행 대조",
          "en": "Contract implementation audit"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "구두 약속 불신",
          "en": "Distrusts oral promises"
        },
        "description": {
          "ko": "단수와 호송 지연을 같은 감사표에 적고 공개 열람 전에는 종결하지 않는다. 위조 도장 사건에서 사본을 태우고 원본을 지켰다.",
          "en": "Records outages and escort delays in one audit and refuses closure before public review. Burns copies and preserves originals in a forged-stamp incident."
        },
        "behavior": {
          "ko": "확인된 선택에서는 구두 약속 불신을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "빈칸과 비공개 회의 앞에서 종결을 늦출 수 있다.",
          "en": "May delay closure over gaps and private meetings."
        },
        "relationship": {
          "ko": "정호준의 이행을 대조하고 라진우의 원장으로 손실을 산정한다.",
          "en": "Checks Jeong Hojun’s performance and uses Ra Jinwoo’s ledger to estimate losses."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "대외 교섭안 이행 감사를 조합원 총회의 감사 권한으로 격상해 암사와 여의신의 일방 해석을 끊는다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "감사가 강국 손실만 계산하고 조합 작업장 단수·강제복무 피해를 누락하는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "정호준의 이행을 대조하고 라진우의 원장으로 손실을 산정한다.",
          "en": "Checks Jeong Hojun’s performance and uses Ra Jinwoo’s ledger to estimate losses."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "단수와 호송 지연을 같은 감사표에 적고 공개 열람 전에는 종결하지 않는다. 위조 도장 사건에서 사본을 태우고 원본을 지켰다.",
      "en": "Records outages and escort delays in one audit and refuses closure before public review. Burns copies and preserves originals in a forged-stamp incident."
    },
