    "traits": [
      {
        "id": "k046-measured-cargo-only",
        "name": {
          "ko": "도장 화물만",
          "en": "Measured cargo only"
        },
        "description": {
          "ko": "계측 없는 군수 개조를 유치선 밖으로 밀어낸다.",
          "en": "Keeps unmeasured military modifications outside the sidings."
        },
        "behavior": {
          "ko": "계측 없는 군수 개조를 유치선 밖으로 밀어낸다.",
          "en": "Keeps unmeasured military modifications outside the sidings."
        },
        "stress": {
          "ko": "용산 중계가 막히면 천왕 유치선이 가득 차 공병열차와 급수열차가 동시에 갇히는 것.",
          "en": "That when the Yongsan relay clogged, the Cheonwang siding would fill, and engineering cars and water trains would be trapped at once."
        },
        "relationship": {
          "ko": "허다온의 차륜 출고를 배차판에서 보증하고, 정시우의 계측 도장에 배차를 묶으며, 박태겸의 중계 창구와 외곽 열차를 나눈다.",
          "en": "Guaranteeing Heo Daon's wheel releases on the dispatch board, binding dispatches to Jeong Siwoo's gauging seals, and splitting the relay window and outer trains with Park Taegyeom."
        },
        "effects": []
      },
      {
        "id": "k046-no-disguised-freight",
        "name": {
          "ko": "위장 화물 거절",
          "en": "Reject disguised freight"
        },
        "description": {
          "ko": "수리 물자를 군수 화차로 위장하지 않는다.",
          "en": "Refuses to disguise repair materials as military freight."
        },
        "behavior": {
          "ko": "수리 물자를 군수 화차로 위장하지 않는다.",
          "en": "Refuses to disguise repair materials as military freight."
        },
        "stress": {
          "ko": "용산 중계가 막히면 천왕 유치선이 가득 차 공병열차와 급수열차가 동시에 갇히는 것.",
          "en": "That when the Yongsan relay clogged, the Cheonwang siding would fill, and engineering cars and water trains would be trapped at once."
        },
        "relationship": {
          "ko": "허다온의 차륜 출고를 배차판에서 보증하고, 정시우의 계측 도장에 배차를 묶으며, 박태겸의 중계 창구와 외곽 열차를 나눈다.",
          "en": "Guaranteeing Heo Daon's wheel releases on the dispatch board, binding dispatches to Jeong Siwoo's gauging seals, and splitting the relay window and outer trains with Park Taegyeom."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "출고 직전 불량품을 반환하고 계측 도장에 배차를 묶는다. 운행 기술은 인정하지만 철도 건설 경력은 없다.",
      "en": "Returns faulty parts before dispatch and ties scheduling to measurement seals. Operations are supported, not railway construction."
    },
