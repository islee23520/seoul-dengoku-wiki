    "skills": [
      {
        "id": "communal-scale-substitution",
        "name": {
          "ko": "공동 저울 교체",
          "en": "Communal scale substitution"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "k847-disposition",
        "name": {
          "ko": "저울 속임 제거",
          "en": "Removing scale deception"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 교도. 직함은 얼음 물류상.",
          "en": "Office. Rank: lay instructor. Title: ice logistics merchant."
        },
        "stress": {
          "ko": "공포. 얼음 물류상 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the ice logistics merchant duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k847-choice",
        "name": {
          "ko": "공통 도구 신뢰",
          "en": "Trust in common tools"
        },
        "description": {
          "ko": "일화. 2125년 파렴치한 저울을 경매장에서 걷어 공동 저울로 바꿨다. 이 일로 얼음 물류상 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he took a dishonest scale off the auction floor and replaced it with a common scale. By this deed the signature of the ice logistics merchant post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "stress": {
          "ko": "공포. 얼음 물류상 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the ice logistics merchant duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "속이는 저울을 거두고 공동 저울을 쓴다. 거래 규칙의 제한된 개선이며 물류망 전체 통솔은 없다.",
      "en": "Removes a deceptive scale and uses a communal one. A limited trade-rule improvement does not establish logistics-network command."
    },
