    "traits": [
      {
        "id": "k687-disposition",
        "name": {
          "ko": "문 밖에서 제지",
          "en": "Restraint outside the door"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 교도. 직함은 시장 순찰대.",
          "en": "Office. Rank: lay instructor. Title: market patrol."
        },
        "stress": {
          "ko": "공포. 시장 순찰대 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the market patrol duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k687-choice",
        "name": {
          "ko": "제지 뒤 명부 확인",
          "en": "Register checks after restraint"
        },
        "description": {
          "ko": "일화. 2125년 무장 난입자를 문 밖에서 붙들어 명부 재점검을 열었다. 이 일로 시장 순찰대 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he seized an armed intruder at the door and opened a roster recount. By this deed the signature of the market patrol post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "stress": {
          "ko": "공포. 시장 순찰대 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the market patrol duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "무장 난입자를 밖에서 붙들고 명부 재검을 열었다. 근접 제지의 한 일화이고 무기 훈련은 없다.",
      "en": "Restrains an armed intruder outside and reopens register checks. One restraint episode does not establish weapon training."
    },
