      {
        "id": "k006-strict-scales",
        "name": {
          "ko": "저울의 책임",
          "en": "Responsibility for scales"
        },
        "description": {
          "ko": "저울을 속인 선주에게 선석을 주지 않는다.",
          "en": "Removes berths from shipowners who falsify weights."
        },
        "behavior": {
          "ko": "저울을 속인 선주에게 선석을 주지 않는다.",
          "en": "Removes berths from shipowners who falsify weights."
        },
        "stress": {
          "ko": "거래 손실은 감추기보다 공개한다.",
          "en": "Discloses rather than hides trade losses."
        },
        "relationship": {
          "ko": "오해린과 운임·냉동 호송에서 경쟁한다.",
          "en": "Competes with O Haerin over rates and refrigerated escorts."
        },
        "effects": []
      },
      {
        "id": "k006-water-with-seal",
        "name": {
          "ko": "봉인 뒤 출항",
          "en": "Sail after sealing"
        },
        "description": {
          "ko": "급수 바지선은 대표 봉인을 받은 뒤 출항시킨다.",
          "en": "Sends water barges out only after representatives seal them."
        },
        "behavior": {
          "ko": "급수 바지선은 대표 봉인을 받은 뒤 출항시킨다.",
          "en": "Sends water barges out only after representatives seal them."
        },
        "stress": {
          "ko": "신용이 선석 대금을 삼킬 것을 두려워한다.",
          "en": "Fears credit claims consuming berth payments."
        },
        "relationship": {
          "ko": "이서담과 계약하되 수문 허가는 한재목에게 의존한다.",
          "en": "Contracts with Lee Seodam but relies on Han Jaemok for gate passage."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "손실 공개와 선석 추첨, 운임 흥정은 반복 실무다. 허가제 확대는 야망으로 남기고 선박 소유나 국가 규모의 경영 성과를 부여하지 않는다.",
      "en": "Loss disclosure, berth lotteries, and rate bargaining are recurring practices. Expanding the permit system remains an ambition, not evidence of ship ownership or nationwide business success."
    },
