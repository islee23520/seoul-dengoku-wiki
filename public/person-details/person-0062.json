    "skills": [
      {
        "id": "dispatch",
        "name": {
          "ko": "화차 순서 조정",
          "en": "Freight-car sequencing"
        },
        "rating": 65
      },
      {
        "id": "parts",
        "name": {
          "ko": "불량 부품 출고 검사",
          "en": "Defective-parts dispatch inspection"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "no-disguised-cargo",
        "name": {
          "ko": "위장 화물 거부",
          "en": "No Disguised Cargo"
        },
        "description": {
          "ko": "유민호는 연구 물자를 군수 화차로 위장하는 지시를 용납하지 않는다.",
          "en": "Yu Minho rejects orders to disguise research materials as military cargo."
        },
        "behavior": {
          "ko": "무기가 의심되는 화차는 인증 도장과 심사 봉인이 모두 없으면 출고하지 않는다.",
          "en": "He withholds suspected weapons wagons unless both certification stamps and review seals are present."
        },
        "stress": {
          "ko": "기지가 군사 집결지로 전용될 조짐이 있다면 화물 인증과 출고 제한을 더 엄격히 지킬 수 있다.",
          "en": "If the depot appears at risk of becoming a military assembly site, he may enforce cargo certification and shipment restrictions more strictly."
        },
        "relationship": {
          "ko": "화물의 중립성을 지킬 수 있다면 최은재의 인증에 배차를 묶는 협력을 유지할 수 있다.",
          "en": "He may maintain certification-linked dispatch cooperation with Choi Eunjae when it safeguards cargo neutrality."
        },
        "effects": []
      },
      {
        "id": "transparent-dispatch",
        "name": {
          "ko": "배차 공개",
          "en": "Transparent Dispatch"
        },
        "description": {
          "ko": "유민호는 연구·방재·주민 화물의 순서를 공개해 배차를 검증 가능하게 한다.",
          "en": "Yu Minho makes dispatch reviewable by publishing the order of research, disaster-response, and resident cargo."
        },
        "behavior": {
          "ko": "화물 순서를 매일 공개하고 출고 직전 확인된 불량 부품 상자를 되돌려 보낸다.",
          "en": "He publishes cargo order daily and returned a defective-parts box identified just before shipment."
        },
        "stress": {
          "ko": "배차망이 군사 보호권의 발판이 될 우려가 있다면 공개 순서와 인증 기준을 유지하려 할 수 있다.",
          "en": "If the dispatch network risks becoming a foothold for military protection claims, he may seek to preserve published priorities and certification standards."
        },
        "relationship": {
          "ko": "김도하가 민가 배급 화차의 우선을 요구한다면 공개 배차 순서를 둘러싼 긴장이 생길 수 있다.",
          "en": "Kim Doha’s demands to prioritize household-ration wagons may create tension over the published dispatch order."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "화물 순서를 매일 공개하고 불량 상자를 반송했다. 선로 진동 비유를 초감각으로 읽지 않고 실제 배차와 점검만 평가한다.",
      "en": "He publishes freight order and returns defective boxes. Track vibration imagery is not supernatural perception; dispatch and inspection are supported."
    },
