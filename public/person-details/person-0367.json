    "skills": [
      {
        "id": "beacon-testimony-recording",
        "name": {
          "ko": "봉화 증언 기록",
          "en": "Beacon testimony recording"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "짧은 증언으로 시간을 남긴다",
          "en": "Brief testimony preserves time"
        },
        "description": {
          "ko": "오인 호송의 밤 봉화 색을 증인으로 남기고 당사자 진술과 시간을 맞춘다. 증언의 보존은 전투 해결을 뜻하지 않는다.",
          "en": "Beacon colors from the misidentified transport night are retained and aligned with participant accounts. Preserving testimony is not resolving combat."
        },
        "behavior": {
          "ko": "교량 통과증의 접힌 자국까지 기억하고, 군사 면제 칸을 증언으로 포장하는 사신을 내려보낸다. 침묵이 길수록 증언은 짧다.",
          "en": "He remembered even the fold marks on bridge passage permits and sent down any envoy who dressed a military exemption column up as testimony. The longer the silence, the shorter the testimony."
        },
        "stress": {
          "ko": "공포. 자신의 증언이 봉쇄대의 면죄부가 되어 양군의 합의가 한쪽 군령만 남는 것.",
          "en": "Fear. That his testimony would become the blockade's indulgence and Go Seojun's joint rule would be left with one blade only."
        },
        "relationship": {
          "ko": "관계. 고서준의 교량 허가와 증언을 겹치고, 범초이의 호송 사고 진술과 시각을 맞춘다. 하윤목의 통과 원장을 증인석의 뼈대로 둔다.",
          "en": "Relations. Overlaid testimony with Go Seojun's bridge permit and matched the hours with Beom Choi's convoy accident statement. Made Ha Yunmok's passage ledger the frame of the witness stand."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 공동실무원. 직함은 양군 관문 통행 증인. 통과 시각과 봉화 색을 같은 칠판에 적고, 면제 문장이 찍힌 증언은 하윤목의 원장 게시 전까지 봉한다.",
          "en": "Office. Rank: sergeant. Title: gate passage witness. He wrote the passage hours and the beacon colors on one chalkboard and sealed any testimony stamped with an exemption clause until Ha Yunmok's ledger was posted."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 공동실무원. 직함은 양군 관문 통행 증인. 통과 시각과 봉화 색을 같은 칠판에 적고, 면제 문장이 찍힌 증언은 하윤목의 원장 게시 전까지 봉한다.",
          "en": "Recorded duty and limits: Office. Rank: sergeant. Title: gate passage witness. He wrote the passage hours and the beacon colors on one chalkboard and sealed any testimony stamped with an exemption clause until Ha Yunmok's ledger was posted."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 자신의 증언이 봉쇄대의 면죄부가 되어 양군의 합의가 한쪽 군령만 남는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That his testimony would become the blockade's indulgence and Go Seojun's joint rule would be left with one blade only."
        },
        "relationship": {
          "ko": "관계. 고서준의 교량 허가와 증언을 겹치고, 범초이의 호송 사고 진술과 시각을 맞춘다. 하윤목의 통과 원장을 증인석의 뼈대로 둔다.",
          "en": "Relations. Overlaid testimony with Go Seojun's bridge permit and matched the hours with Beom Choi's convoy accident statement. Made Ha Yunmok's passage ledger the frame of the witness stand."
        },
