    "traits": [
      {
        "id": "k303-priority",
        "name": {
          "ko": "환자 안정 전 대기",
          "en": "Waits for patient stability"
        },
        "description": {
          "ko": "복봉은 하역과 배차를 맞추고 환자 활력 전 빈 슬롯을 팔지 않는다. 송장 무게 공백의 범인은 미확인이다.",
          "en": "Bokbong aligns unloading with dispatch and does not sell empty slots before patient stability. The cause of invoice weight gaps is unknown."
        },
        "behavior": {
          "ko": "입고 중량을 두 증인이 보고, 무기 적재가 의심되는 송장은 의료조 게시 전까지 하역을 막는다.",
          "en": "Office. Rank: convoy hand. Title: transfer relay logistics merchant. Two witnesses reported intake weights, and he blocked the unloading of any invoice suspected of arms loading until the medical crew posted it."
        },
        "stress": {
          "ko": "군수 문장이 환자 칸 송장에 섞여 신내운수가 하역장으로 전락하는 것.",
          "en": "Fear. That a munitions clause would mix into patient-car invoices and the transfer city would sink into a freight yard."
        },
        "relationship": {
          "ko": "안도한의 배차 칠판과 하역 순서를 맞추고, 복용의 중립시장 시세를 송장에 옮긴다. 전미리의 환자 활력이 안정되기 전에는 빈 슬롯을 팔지 않는다.",
          "en": "Relations. Matched the unloading order with An Dohan's dispatch chalkboard and moved Bok Yong's neutral-market prices onto the invoices. He sold no empty slots before Jeon Miri's patient vitals were stable."
        },
        "effects": []
      },
      {
        "id": "k303-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 호송원. 직함은 환승 중계 물류상. 입고 중량을 두 증인이 보고, 무기 적재가 의심되는 송장은 의료조 게시 전까지 하역을 막는다.",
          "en": "Office. Rank: convoy hand. Title: transfer relay logistics merchant. Two witnesses reported intake weights, and he blocked the unloading of any invoice suspected of arms loading until the medical crew posted it."
        },
        "stress": {
          "ko": "공포. 군수 문장이 환자 칸 송장에 섞여 신내운수가 하역장으로 전락하는 것.",
          "en": "Fear. That a munitions clause would mix into patient-car invoices and the transfer city would sink into a freight yard."
        },
        "relationship": {
          "ko": "관계. 안도한의 배차 칠판과 하역 순서를 맞추고, 복용의 중립시장 시세를 송장에 옮긴다. 전미리의 환자 활력이 안정되기 전에는 빈 슬롯을 팔지 않는다.",
          "en": "Relations. Matched the unloading order with An Dohan's dispatch chalkboard and moved Bok Yong's neutral-market prices onto the invoices. He sold no empty slots before Jeon Miri's patient vitals were stable."
        },
        "effects": []
