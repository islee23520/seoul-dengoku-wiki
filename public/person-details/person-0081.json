    "skills": [
      {
        "id": "emergency-log",
        "name": {
          "ko": "비상권한 반환 기록",
          "en": "Emergency-authority return records"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "return-timing-matters",
        "name": {
          "ko": "반환 시점 중시",
          "en": "Return Timing Matters"
        },
        "description": {
          "ko": "류하늘은 비상권한의 정당성을 권한 반환 시점이 기록되어 있는지로 살피려 한다.",
          "en": "Ryu Haneul looks to recorded return times when assessing the legitimacy of emergency authority."
        },
        "behavior": {
          "ko": "통신이 끊긴 마지막 시각을 적고 비상권한이 반환되지 않은 칸에 붉은 줄을 남긴다.",
          "en": "Ryu Haneul records the last communication time and marks unreturned emergency-authority fields with red lines."
        },
        "stress": {
          "ko": "반환 기록의 소실이 군사 감독을 부를 우려가 있으면 반환 시점 칸의 보존을 더욱 중시할 수 있다.",
          "en": "If lost return records threaten renewed military oversight, Ryu Haneul may place greater emphasis on preserving return-time fields."
        },
        "relationship": {
          "ko": "윤서린이 인준에 반환 시점 칸을 요구하면 이를 권한의 정당성을 확인하는 조건으로 받아들일 수 있다.",
          "en": "When Yun Seorin requires a return-time field for ratification, Ryu Haneul may accept it as a check on authority's legitimacy."
        },
        "effects": []
      },
      {
        "id": "stop-for-missing-copies",
        "name": {
          "ko": "누락 사본에 중지",
          "en": "Stop for Missing Copies"
        },
        "description": {
          "ko": "류하늘은 비상 일지의 분산 보관이 온전해야 열람을 허용한다.",
          "en": "Ryu Haneul permits access only when distributed copies of the emergency log remain complete."
        },
        "behavior": {
          "ko": "연구책임자·안전심사·주민대표가 보관할 일지 중 한 부라도 비면 열람을 전면 중지한다.",
          "en": "Ryu Haneul suspends all access if any log copy held by the research lead, safety review, or resident representative is missing."
        },
        "stress": {
          "ko": "반환 기록이 사라질 위험이 커지면 불완전한 사본 상태에서 열람을 재개하기 어려울 수 있다.",
          "en": "If return records risk disappearing, Ryu Haneul may be reluctant to resume access while copies remain incomplete."
        },
        "relationship": {
          "ko": "임시온의 서고에 반환 일지를 맞출 때도 각 보관 주체의 사본이 유지되는지를 중시할 수 있다.",
          "en": "When aligning return logs with Im Sion's archive, Ryu Haneul may emphasize retention of each custodian's copy."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "통신 단절 시각과 반환 칸을 기록한다. 선대의 대정전 기록은 본인의 현장 경력이 아니며 현재 보존 업무만 반영했다.",
      "en": "He records interruption times and authority-return slots. His ancestor’s blackout records are not his field experience; current archival work is reflected."
    },
