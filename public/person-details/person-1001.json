    "traits": [
      {
        "id": "k1001-action-priority",
        "name": {
          "ko": "파손과 배분을 구분",
          "en": "Distinguish damage and allocation"
        },
        "description": {
          "ko": "한 구역의 관로가 터지자 그 구역을 핑계로 집단 단수를 걸자는 말이 돈다. 곽가현은 터진 구역과 나머지 구역의 급수 배분을 두 칸으로 갈라 적고, 이서담이 보증한 임바다의 시민 급수권 맹세를 당직 인수인계 첫 줄에 옮겨 둔다.",
          "en": "When one district's main bursts, talk spreads of using that district as the excuse for a mass cutoff. Gwak Gahyeon splits the water distribution into two columns, the burst district and all the others, and copies Im Bada's oath of citizens' water rights, which I Seodam guarantees, onto the first line of the duty handover."
        },
        "behavior": {
          "ko": "한 구역의 관로가 터지자 그 구역을 핑계로 집단 단수를 걸자는 말이 돈다. 곽가현은 터진 구역과 나머지 구역의 급수 배분을 두 칸으로 갈라 적고, 이서담이 보증한 임바다의 시민 급수권 맹세를 당직 인수인계 첫 줄에 옮겨 둔다.",
          "en": "When one district's main bursts, talk spreads of using that district as the excuse for a mass cutoff. Gwak Gahyeon splits the water distribution into two columns, the burst district and all the others, and copies Im Bada's oath of citizens' water rights, which I Seodam guarantees, onto the first line of the duty handover."
        },
        "stress": {
          "ko": "배급구역 서기 당직이 비면 수문국의 통행이 강국 볼모가 되는 것.",
          "en": "That the ration district clerk duty post would stand empty and the Compact's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "이서담의 배급구역 서기로 일하며 급수 배분 당직을 맡는다.",
          "en": "Serves as a ration clerk under I Seodam and manages the water allocation shift."
        },
        "effects": []
      },
      {
        "id": "k1001-bounded-handover",
