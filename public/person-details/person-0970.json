      {
        "id": "save-register",
        "name": {
          "ko": "위기 인명 장부 보존",
          "en": "Emergency preservation of personnel registers"
        },
        "rating": 45
      },
      {
        "id": "handover",
        "name": {
          "ko": "기록·열쇠 인수인계",
          "en": "Record and key handover"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "rescue-people-records-first",
        "name": {
          "ko": "인명 기록부터 구조",
          "en": "Rescue People Records First"
        },
        "description": {
          "ko": "김은호는 화재에서 인명 장부를 먼저 구해 보존한 사람이다.",
          "en": "Kim Eunho saved and preserved the people register first during a fire."
        },
        "behavior": {
          "ko": "역사 화재 때 인명 장부부터 꺼내 들고 나왔다.",
          "en": "They carried the people register out first during the station fire."
        },
        "stress": {
          "ko": "화재가 기록의 연속성을 위협한다면 인명 장부를 확보하는 데 먼저 집중할 수 있다.",
          "en": "If fire threatens record continuity, they may first focus on securing the people register."
        },
        "relationship": {
          "ko": "위기 후 당직 인계를 한다면 보존한 인명 장부를 상대와 확인하는 데 중점을 둘 수 있다.",
          "en": "In a post-crisis duty handover, they may emphasize checking the preserved people register with their counterpart."
        },
        "effects": []
      },
      {
        "id": "duty-record-accountability",
        "name": {
          "ko": "당직의 기록 책임",
          "en": "Duty Record Accountability"
        },
        "description": {
          "ko": "김은호는 자기 당직의 기록을 지켜 다음 인계로 잇는 책임을 중시한다.",
          "en": "Kim Eunho values responsibility for preserving their duty records and carrying them into the next handover."
        },
        "behavior": {
          "ko": "화재에서 장부를 보존하고 인계에서는 자기 직위의 열쇠와 기록만 넘기는 원칙을 따른다.",
          "en": "They preserve the register during fire and follow the principle of transferring only their own keys and records."
        },
        "stress": {
          "ko": "당직 공백이 태욱그룹의 통행을 강국에 좌우되게 할 우려가 있으면 기록 책임을 더 무겁게 여길 수 있다.",
          "en": "Concern that a vacant shift could leave Taewook Group's passage controlled by a powerful state may increase their sense of record responsibility."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 자신이 보존해 넘길 기록의 범위를 분명히 할 수 있다.",
          "en": "When handing over to a senior duty colleague, they may clarify which records they have preserved and can transfer."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "역사 화재에서 인명 장부를 보존했다. 기록 책임을 평가하며 수질 계측원이라는 이름에서 검사 숙련을 만들지 않는다.",
      "en": "He saved personnel registers during a station fire. Record responsibility is reflected; a water-metrology title does not create testing skill."
    },
