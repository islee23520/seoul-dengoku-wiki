    "skills": [
      {
        "id": "k123-wagon-check",
        "name": {
          "ko": "순찰열차 화차 확인",
          "en": "Patrol train wagon checking"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "k123-choice",
        "name": {
          "ko": "중립 위반 배차 거부",
          "en": "Rejects neutrality-breaking dispatch"
        },
        "description": {
          "ko": "대담하고 야간 선로의 침묵을 사람보다 잘 견딘다. 의료열차로 위장한 군수 화차를 자기 열차에 붙이라는 쪽지를 찢어 버린다.",
          "en": "Bold, she endured the night rails' silence better than people. She tore up any note telling her to couple munitions freight cars disguised as a medical train to her own train."
        },
        "behavior": {
          "ko": "일화. 2125년 능선 초계 중 매복 흔적을 먼저 읽어 피해를 막았다. 이 일로 동부 순찰열차장 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125, on a ridge patrol, she read the ambush traces first and prevented the harm. By this deed the signature of the eastern patrol train master post rose into the ledger."
        },
        "stress": {
          "ko": "공포. 자기 열차가 검은 배차표의 운반자가 되어 의료중립을 깨고 보호전쟁을 첫 불씨로 지피는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That her train would become the carrier of the black dispatch sheet, break medical neutrality, and strike the first spark of a protection war. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 박하율의 출고 순서에 열차를 묶는 계약이고, 장세화의 의료호송을 선로에서 피하려는 빚이며, 김우찬의 비밀 배차 쪽지를 거부해 지휘 갈등이 있다.",
          "en": "Relations. A contract binding her train to Park Hayul's release order, a debt trying not to dodge Jang Sehwa's medical convoy on the rails, and a command conflict refusing Kim Woochan's secret dispatch notes."
        },
        "effects": []
      },
      {
        "id": "k123-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 병장. 직함은 동부 순찰열차장. 출고 시각과 화차 목록을 고덕 게시판에 올리고, 무기 의심 화차는 정비장과 감사관의 이중 확인 없이 연결하지 않는다.",
          "en": "Office. Rank: sergeant. Title: eastern patrol train master. She put the release hours and freight lists on the Godeok board and coupled no car suspected of arms without the maintenance chief's and the auditor's double check."
        },
        "behavior": {
          "ko": "관직. 품계 병장. 직함은 동부 순찰열차장. 출고 시각과 화차 목록을 고덕 게시판에 올리고, 무기 의심 화차는 정비장과 감사관의 이중 확인 없이 연결하지 않는다.",
          "en": "Office. Rank: sergeant. Title: eastern patrol train master. She put the release hours and freight lists on the Godeok board and coupled no car suspected of arms without the maintenance chief's and the auditor's double check."
        },
        "stress": {
          "ko": "공포. 자기 열차가 검은 배차표의 운반자가 되어 의료중립을 깨고 보호전쟁을 첫 불씨로 지피는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That her train would become the carrier of the black dispatch sheet, break medical neutrality, and strike the first spark of a protection war. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 박하율의 출고 순서에 열차를 묶는 계약이고, 장세화의 의료호송을 선로에서 피하려는 빚이며, 김우찬의 비밀 배차 쪽지를 거부해 지휘 갈등이 있다.",
          "en": "Relations. A contract binding her train to Park Hayul's release order, a debt trying not to dodge Jang Sehwa's medical convoy on the rails, and a command conflict refusing Kim Woochan's secret dispatch notes."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "일화. 2125년 능선 초계 중 매복 흔적을 먼저 읽어 피해를 막았다. 이 일로 동부 순찰열차장 자리의 서명이 장부에 올랐다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Anecdote. In 2125, on a ridge patrol, she read the ambush traces first and prevented the harm. By this deed the signature of the eastern patrol train master post rose into the ledger. Titles and ambitions are not treated as accomplished authority or results."
    },
