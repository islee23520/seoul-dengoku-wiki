    "traits": [
      {
        "id": "k547-priority",
        "name": {
          "ko": "실제 출발을 가림",
          "en": "Distinguishes actual departures"
        },
        "description": {
          "ko": "정다은은 서로 다른 두 배차표를 나란히 옮기고 호송원 서명으로 실제 출발을 가렸다. 어느 표가 정치적으로 우월한지는 단정하지 않는다.",
          "en": "Jeong Daeun placed conflicting dispatch sheets side by side and used escort signatures to establish actual departures, without declaring a politically superior sheet."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: convoy hand. Title: medical convoy registrar. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "의무호송 기록관 당직이 비면 신내운수의 통행이 노선 면허의 볼모가 되는 것.",
          "en": "Fear. That the medical convoy registrar duty post would stand empty and the City's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k547-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 호송원. 직함은 의무호송 기록관. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: convoy hand. Title: medical convoy registrar. He handed over only the keys and records of his own post, and never made authority he did not hold."
