    "traits": [
      {
        "id": "the-injured-first",
        "name": {
          "ko": "부상자 먼저",
          "en": "The Injured First"
        },
        "description": {
          "ko": "오솔서는 폭설로 통로가 막힌 상황에서 부상자의 이동을 먼저 두었다.",
          "en": "O Solseo gave priority to moving injured people when snow blocked the passage."
        },
        "behavior": {
          "ko": "폭설에 막힌 환승 통로를 뚫고 부상자를 먼저 옮겼다.",
          "en": "O Solseo cleared the snow-blocked transfer passage and moved injured people first."
        },
        "stress": {
          "ko": "통로 폐색이 이동을 막는다면 부상자 이송에 필요한 통로 확보를 우선할 수 있다.",
          "en": "If a blocked passage prevents movement, O Solseo may prioritize clearing access for injured people."
        },
        "relationship": {
          "ko": "이동 순서를 두고 요구가 겹친다면 부상자를 먼저 옮기는 쪽을 지지할 수 있다.",
          "en": "If demands over movement order compete, O Solseo may favor moving injured people first."
        },
        "effects": []
      },
      {
        "id": "maintain-shift-continuity",
        "name": {
          "ko": "교대 이어가기",
          "en": "Maintain Shift Continuity"
        },
        "description": {
          "ko": "오솔서는 통행의 연속성을 위해 당직을 비우지 않는 쪽을 먼저 고른다.",
          "en": "O Solseo favors keeping duty staffed to support continuity of passage."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록을 넘겨 장부와 당직이 이어지도록 한다.",
          "en": "O Solseo hands over the position's keys and records to keep the ledger and duty connected."
        },
        "stress": {
          "ko": "폭설 같은 통행 장애가 당직 공백으로 이어질까 걱정하면 인계의 연속성을 더 살필 수 있다.",
          "en": "If a passage obstruction such as heavy snow threatens a duty gap, O Solseo may attend more closely to handover continuity."
        },
        "relationship": {
          "ko": "선배 당직과는 열쇠와 기록을 잇는 인계를 통해 교대 책임을 나누려 할 수 있다.",
          "en": "With senior duty staff, O Solseo may share shift responsibility through handovers of keys and records."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "폭설 통로를 뚫고 부상자를 먼저 옮겼다. 실제 노동과 이송의 부담은 반영하지만 의료 진단이나 전투는 부여하지 않았다.",
      "en": "He cleared a snowy passage and moved casualties first. Physical work and transport are reflected, not diagnosis or combat."
    },
