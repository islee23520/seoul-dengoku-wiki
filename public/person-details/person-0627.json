    "skills": [
      {
        "id": "k627-public-witness-confrontation",
        "name": {
          "ko": "공개 대질 진행",
          "en": "Public witness confrontation"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "k627-priority",
        "name": {
          "ko": "말을 맞대어 확인",
          "en": "Checks statements together"
        },
        "description": {
          "ko": "정하준의 확인된 행동은 2125년 증인 두 명의 말이 갈라지자 공개 대질을 열었다.  반복 성과와 구체적 전문 경력은 미확인이다.",
          "en": "정하준: Anecdote. In 2125, when the accounts of two witnesses split, he opened a public confrontation. By this deed the signature of the waiting-line surveyor post rose into the ledger. Repeated results and detailed professional experience remain unconfirmed."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: convoy hand. Title: waiting-line surveyor. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "대기열 탐사원 당직이 비면 신내운수의 통행이 노선 면허의 볼모가 되는 것.",
          "en": "Fear. That the waiting-line surveyor duty post would stand empty and the City's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k627-accountability",
        "name": {
          "ko": "당직의 연속성",
          "en": "Continuity of duty"
        },
        "description": {
          "ko": "큰소리보다 기록을 믿고 자기 직위의 열쇠와 기록만 넘긴다.",
          "en": "Trusts records over loud claims and hands over only the keys and records of the position."
        },
        "behavior": {
          "ko": "관직. 품계 호송원. 직함은 대기열 탐사원. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: convoy hand. Title: waiting-line surveyor. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "공포. 대기열 탐사원 당직이 비면 신내운수의 통행이 노선 면허의 볼모가 되는 것.",
          "en": "Fear. That the waiting-line surveyor duty post would stand empty and the City's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "정하준의 확인된 행동은 2125년 증인 두 명의 말이 갈라지자 공개 대질을 열었다.  반복 성과와 구체적 전문 경력은 미확인이다.",
      "en": "정하준: Anecdote. In 2125, when the accounts of two witnesses split, he opened a public confrontation. By this deed the signature of the waiting-line surveyor post rose into the ledger. Repeated results and detailed professional experience remain unconfirmed."
    },
