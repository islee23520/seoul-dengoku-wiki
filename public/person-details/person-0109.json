    "traits": [
      {
        "id": "no-verbal-unloading-orders",
        "name": {
          "ko": "구두 하차 거부",
          "en": "No Verbal Unloading Orders"
        },
        "description": {
          "ko": "종나솔은 장교의 동행이나 암호패가 있어도 구두 하차 명령만으로 절차를 바꾸지 않는다.",
          "en": "Jong Nasol does not alter unloading procedures on verbal orders alone, even with an accompanying officer or code token."
        },
        "behavior": {
          "ko": "출입 명부와 펌프 점검 봉인을 같은 시각에 찍고 출입문 진동이 바뀌면 하차 벨을 울리지 않는다.",
          "en": "They timestamp access registers and pump-inspection seals together and withhold the unloading bell when door vibration changes."
        },
        "stress": {
          "ko": "잠근 문이 납치 증거로 해석될 우려가 생기면 구두 설명보다 명부와 봉인 시각을 더 의지할 수 있다.",
          "en": "If a locked door risks being construed as kidnapping evidence, they may rely more on registers and seal times than verbal explanations."
        },
        "relationship": {
          "ko": "장교의 요구에도 하차 조건을 지키고 변석훈과는 전력 일지의 시각을 맞추는 확인 관계를 중시할 수 있다.",
          "en": "They may uphold unloading conditions despite officers' demands and value timestamp verification with Byeon Seokhun's power log."
        },
        "effects": []
      },
      {
        "id": "read-blank-fields-aloud",
        "name": {
          "ko": "빈칸 소리 내어 읽기",
          "en": "Read Blank Fields Aloud"
        },
        "description": {
          "ko": "종나솔은 과묵하지만 명부의 빈칸을 조용히 넘기지 않는 확인 성향을 보인다.",
          "en": "Jong Nasol is taciturn but does not silently pass over blank register entries."
        },
        "behavior": {
          "ko": "명부 빈칸을 소리 내어 읽고 자신이 본 야간 점검 동선을 다른 일지의 시각과 맞춘다.",
          "en": "They read blank register fields aloud and compare the night-inspection route they witnessed with other log times."
        },
        "stress": {
          "ko": "실종 구간의 빈 좌석이 보호군의 구원 이야기로 채워질 우려가 있으면 관찰한 사실과 미확인 부분을 더 분명히 나눌 수 있다.",
          "en": "If an empty seat in the disappearance section risks being filled by a protection-force rescue story, they may distinguish observations from unknowns more explicitly."
        },
        "relationship": {
          "ko": "고늘결의 반대편 목격과 변석훈의 일지를 대조하되 협력자에게 빈칸을 추측으로 메우지 않길 요구할 수 있다.",
          "en": "They may compare Go Neulgyeol's opposite-door observations with Byeon Seokhun's log while asking collaborators not to fill gaps with speculation."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "누수 이음매 세 곳을 찾고 출입 명부와 봉인 시각을 맞춘다. 목격과 확인이 중심이며 실종의 원인을 알고 있었다고 단정하지 않는다.",
      "en": "He found three leaking joints and synchronizes manifests and seals. Observation and checks are central; knowledge of the disappearance’s cause is not assumed."
    },
