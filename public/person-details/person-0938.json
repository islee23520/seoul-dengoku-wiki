    "skills": [
      {
        "id": "rescue",
        "name": {
          "ko": "통로 개통·부상자 이송",
          "en": "Passage clearance and casualty transfer"
        },
        "rating": 50
      },
      {
        "id": "departure",
        "name": {
          "ko": "배차표·출발 확인",
          "en": "Departure and dispatch checks"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "clear-the-passage-first",
        "name": {
          "ko": "통로 먼저 열기",
          "en": "Clear the Passage First"
        },
        "description": {
          "ko": "조달원은 폭설로 막힌 이동 경로를 먼저 여는 실무적 대응을 보였다.",
          "en": "Jo Dalwon showed a practical response by first opening a route blocked by heavy snow."
        },
        "behavior": {
          "ko": "막힌 환승 통로를 뚫어 부상자를 옮길 길을 만들었다.",
          "en": "They cleared the blocked transfer passage to create a route for moving injured people."
        },
        "stress": {
          "ko": "통로 차단이 이송과 통행을 막는다면 이동 경로 확보에 노력을 집중할 수 있다.",
          "en": "If a blocked passage prevents transport and transit, they may concentrate their effort on reopening the route."
        },
        "relationship": {
          "ko": "다른 당직과 이송을 조율해야 한다면 먼저 통로가 열려야 한다는 실무 조건을 강조할 수 있다.",
          "en": "When coordinating transport with other duty staff, they may emphasize that the passage must first be open."
        },
        "effects": []
      },
      {
        "id": "transport-the-injured-first",
        "name": {
          "ko": "부상자 우선 이송",
          "en": "Transport the Injured First"
        },
        "description": {
          "ko": "조달원은 통로가 열린 뒤 부상자를 먼저 옮기는 우선순위를 보였다.",
          "en": "Jo Dalwon prioritized moving injured people once the passage was opened."
        },
        "behavior": {
          "ko": "폭설에 막힌 환승 통로를 뚫은 뒤 부상자를 우선 이송했다.",
          "en": "After clearing the snow-blocked transfer passage, they transported injured people first."
        },
        "stress": {
          "ko": "이동이 제한된 상황에서는 부상자의 이송 순서를 먼저 확보하려 할 수 있다.",
          "en": "When movement is constrained, they may seek to secure priority transport for injured people."
        },
        "relationship": {
          "ko": "이송 순서를 놓고 조율이 필요하다면 부상자 우선을 공통 기준으로 제안할 수 있다.",
          "en": "If transport order needs coordination, they may propose prioritizing injured people as the shared criterion."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "폭설 통로를 뚫고 부상자를 옮겼다. 노동 지속력과 이송을 평가하며 개인 전투나 임상 치료는 부여하지 않는다.",
      "en": "He cleared a snowy passage and moved casualties. Physical persistence and transport are reflected, not personal combat or clinical care."
    },
