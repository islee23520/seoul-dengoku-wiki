      {
        "id": "ration-weighing-disposition",
        "name": {
          "ko": "배고픔을 함께 셈",
          "en": "Counts hunger alongside numbers"
        },
        "description": {
          "ko": "숫자와 배고픔을 같은 저울에 올리되 숨긴 식량에는 거칠어진다.",
          "en": "Weighs hunger alongside numbers but becomes rough over hidden food."
        },
        "behavior": {
          "ko": "숫자와 배고픔을 같은 저울에 올리되 숨긴 식량에는 거칠어진다.",
          "en": "Weighs hunger alongside numbers but becomes rough over hidden food."
        },
        "stress": {
          "ko": "창고가 당직 승려에게만 열릴 것을 두려워한다.",
          "en": "Fears stores opening only for duty monks."
        },
        "relationship": {
          "ko": "백온의 공개 배급표를 집행하고 서나연의 얼음·식량 호송을 검수한다. 류은비에게 북한산보국문 약품 배급 감사를 빚졌다.",
          "en": "Applies Baek On’s ration sheet, checks Seo Nayeon’s food escort and owes Ryu Eunbi for a medication audit."
        },
        "effects": []
      },
      {
        "id": "recorded-boundary",
        "name": {
          "ko": "두 눈의 저울",
          "en": "Scale under two observers"
        },
        "description": {
          "ko": "두 감시인 앞에서 검량하고 잔량을 벽에 남긴다.",
          "en": "Weighs under two observers and writes reserves on the wall."
        },
        "behavior": {
          "ko": "두 감시인 앞에서 검량하고 잔량을 벽에 남긴다.",
          "en": "Weighs under two observers and writes reserves on the wall."
        },
        "stress": {
          "ko": "난방 연료가 떨어진 밤에 배급 창고가 당직 승려 몫으로만 열리는 것.",
          "en": "Fears stores opening only for duty monks."
        },
        "relationship": {
          "ko": "백온의 공개 배급표를 집행하고 서나연의 얼음·식량 호송을 검수한다. 류은비에게 북한산보국문 약품 배급 감사를 빚졌다.",
          "en": "Applies Baek On’s ration sheet, checks Seo Nayeon’s food escort and owes Ryu Eunbi for a medication audit."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "두 감시인 앞에서 저울을 보고 잔량을 벽에 남긴다. 공정을 추구하지만 숨긴 식량에는 손이 먼저 나간다.",
      "en": "Checks scales before two observers and writes reserves on walls. Pursues fairness but reacts physically to hidden food."
    },
