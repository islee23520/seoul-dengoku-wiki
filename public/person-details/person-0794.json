    "skills": [
      {
        "id": "rescue",
        "name": {
          "ko": "통로 개통·부상자 이송",
          "en": "Passage clearance and casualty transfer"
        },
        "rating": 50
      },
      {
        "id": "departure",
        "name": {
          "ko": "배차표·출발 확인",
          "en": "Departure and dispatch checks"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "the-injured-first-on-snowbound-roads",
        "name": {
          "ko": "눈길 부상자 먼저",
          "en": "The Injured First on Snowbound Roads"
        },
        "description": {
          "ko": "황은아는 폭설로 이동이 막혔을 때 부상자의 이동을 우선한 사람이다.",
          "en": "Hwang Euna prioritized moving injured people when heavy snow blocked passage."
        },
        "behavior": {
          "ko": "막힌 환승 통로를 뚫고 부상자를 먼저 옮겼다.",
          "en": "They cleared the blocked transfer passage and moved injured people first."
        },
        "stress": {
          "ko": "통로 차단이 통행 중단으로 이어질 우려가 있으면 부상자의 이동 경로 확보를 서두를 수 있다.",
          "en": "If a blocked passage threatens continued transit, they may press to secure a route for injured people."
        },
        "relationship": {
          "ko": "이송 순서를 다른 당직과 조율해야 한다면 부상자 우선이라는 기준을 내세울 수 있다.",
          "en": "When coordinating transport order with other duty staff, they may advocate prioritizing injured people."
        },
        "effects": []
      },
      {
        "id": "verify-departure-grounds",
        "name": {
          "ko": "출발의 근거 확인",
          "en": "Verify Departure Grounds"
        },
        "description": {
          "ko": "황은아의 출발 근거 확인은 기록과 실제 통로 확보를 중시하는 제한적 성향으로 해석된다.",
          "en": "Hwang Euna's concern for departure grounds is cautiously understood as valuing records and an actually cleared route."
        },
        "behavior": {
          "ko": "폭설 때 통로를 먼저 확보한 행동과 장부를 믿는 원칙을 출발 판단의 근거로 연결한다.",
          "en": "Their route-clearing action and preference for registers provide limited grounds for evidence-based departure decisions."
        },
        "stress": {
          "ko": "통행 중단을 피해야 한다는 부담이 커지면 이동 경로와 기록의 근거를 더 확인하려 할 수 있다.",
          "en": "Pressure to avoid interrupted passage may lead them to seek firmer grounds in route availability and records."
        },
        "relationship": {
          "ko": "출발 판단을 인계 상대와 공유한다면 확보된 통로와 기록을 공통 근거로 삼을 수 있다.",
          "en": "When sharing a departure decision with a handover partner, they may use the cleared route and records as common grounds."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "폭설 통로 개통과 부상자 이송을 수행했다. 이동 부담을 반영하며 의료 면허나 전투 경력은 만들지 않는다.",
      "en": "She cleared a snowy passage and moved casualties. Physical transport is supported, not a medical license or combat history."
    },
