    "traits": [
      {
        "id": "immediate-stop-in-collapse-zones",
        "name": {
          "ko": "붕괴 구간 즉시 정지",
          "en": "Immediate Stop in Collapse Zones"
        },
        "description": {
          "ko": "조동준은 침수 구간의 붕괴 위험에 대해 즉시 통행을 멈추는 편이다.",
          "en": "Jo Dongjun favors immediately stopping passage in response to collapse danger in a flooded section."
        },
        "behavior": {
          "ko": "침수 구간 붕괴 보고를 미루지 않고 해당 구간을 당장 폐쇄했다.",
          "en": "Jo Dongjun did not delay the flooded-section collapse report and immediately closed the section."
        },
        "stress": {
          "ko": "통행 지속과 붕괴 위험이 충돌한다면 위험 구간을 닫는 쪽을 우선할 수 있다.",
          "en": "If continued passage conflicts with collapse danger, Jo Dongjun may prioritize closing the hazardous section."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 폐쇄된 구간과 위험 보고를 함께 전달하려 할 수 있다.",
          "en": "In handovers with senior duty staff, Jo Dongjun may convey both the closed section and the hazard report."
        },
        "effects": []
      },
      {
        "id": "shift-accountability",
        "name": {
          "ko": "교대 책임",
          "en": "Shift Accountability"
        },
        "description": {
          "ko": "조동준은 당직과 장부가 끊기지 않도록 자기 직위의 인계를 책임 범위로 삼는다.",
          "en": "Jo Dongjun treats the position's handover as a responsibility for keeping duty and the ledger connected."
        },
        "behavior": {
          "ko": "당직이 이어지는 쪽을 먼저 고르고 자기 직위의 열쇠와 기록만 넘긴다.",
          "en": "Jo Dongjun first chooses duty continuity and transfers only the position's keys and records."
        },
        "stress": {
          "ko": "당직 공백으로 통행이 강국의 볼모가 될까 우려하면 교대 인계를 더 중시할 수 있다.",
          "en": "Fear that a duty gap could leave passage hostage to a powerful state may increase the importance placed on shift handover."
        },
        "relationship": {
          "ko": "선배 당직과는 열쇠와 기록을 주고받는 인계로 책임을 이어가려 할 수 있다.",
          "en": "With senior duty staff, Jo Dongjun may carry responsibility forward through handovers of keys and records."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "침수 구간 붕괴를 보고받아 닫았다. 통행 위험에 대한 판단은 있으나 수색·구조 훈련은 원문에 없다.",
      "en": "He closed a flooded section on collapse reports. Route-risk judgment is supported; search and rescue training is absent."
    },
