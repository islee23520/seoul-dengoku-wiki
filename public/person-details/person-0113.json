      {
        "id": "message",
        "name": {
          "ko": "봉함 전갈 전달·대조",
          "en": "Sealed-message delivery and checks"
        },
        "rating": 60
      },
      {
        "id": "closure",
        "name": {
          "ko": "위험 구간 폐쇄",
          "en": "Hazardous-route closure"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "keep-sealed-until-arrival-is-confirmed",
        "name": {
          "ko": "도착 확인 전 봉함 유지",
          "en": "Keep Sealed Until Arrival Is Confirmed"
        },
        "description": {
          "ko": "엄미래는 증거 봉함을 도착 확인 전까지 유지해야 하는 전달 책임으로 여긴다.",
          "en": "Eom Mirae treats keeping evidence sealed until arrival confirmation as a delivery responsibility."
        },
        "behavior": {
          "ko": "봉함 매듭이 느슨하면 출발하지 않고 송신 검증의 도착 확인이 오기 전에는 봉함을 풀지 않는다.",
          "en": "They do not depart with loose seal knots or unseal evidence before arrival confirmation from transmission verification."
        },
        "stress": {
          "ko": "환승 대합실에서 가방이 열려 사본 한 장만 남을 우려가 커지면 봉함 상태와 확인 절차를 더 엄격히 점검할 수 있다.",
          "en": "If the bag risks being opened in a transfer concourse and leaving only one copy, they may check seals and confirmation procedures more strictly."
        },
        "relationship": {
          "ko": "최지우의 원본 검증 시각에 맞추되 전달 상대가 도착 확인 없이 개봉을 요구하면 거절할 수 있다.",
          "en": "They may coordinate with Choi Jiwoo's original-verification time but refuse a recipient's request to open evidence without arrival confirmation."
        },
        "effects": []
      },
      {
        "id": "neutral-convoy-order",
        "name": {
          "ko": "호송 순서 중립",
          "en": "Neutral Convoy Order"
        },
        "description": {
          "ko": "엄미래는 증거의 호송 순서가 특정 유언의 진본 지위를 결정해서는 안 된다고 여긴다.",
          "en": "Eom Mirae believes evidence convoy order must not determine which will is treated as authentic."
        },
        "behavior": {
          "ko": "당회와 기록감사의 추첨 순번을 따르고 세 유언과 음성 원본이 같은 날 같은 심사석에 닿도록 하려 한다.",
          "en": "They follow the assembly and record auditor's lottery order and seek same-day delivery of all three wills and the audio original to one review panel."
        },
        "stress": {
          "ko": "한 사본만 남아 폭동의 불씨가 될 우려가 있으면 먼저 방송하라는 요구보다 증거의 동등한 도착을 우선할 수 있다.",
          "en": "If a sole surviving copy could ignite unrest, they may prioritize equal evidence arrival over demands to broadcast one first."
        },
        "relationship": {
          "ko": "표산하의 전령로를 빌리면서도 특정 진본의 선행 전달을 요구하는 상대에게는 추첨과 사실 전달의 원칙을 지킬 수 있다.",
          "en": "They may borrow Pyo Sanha's messenger route while upholding lottery order and factual reporting against demands to deliver a favored original first."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "증거 호송의 도착 확인을 기다리고 위험 구간을 폐쇄했다. 봉함 전달과 경로 판단을 평가하며 전투 호위는 원문에 없다.",
      "en": "He waits for arrival verification before opening evidence and closed a hazardous section. Sealed delivery and route judgment are supported, not combat escort."
    },
