    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "선매보다 환자 할당",
          "en": "Patient allocation before advance purchase"
        },
        "description": {
          "ko": "부족한 처방량을 나눴고 환자 할당에 따라 물자를 댄다. 도제 학습은 보존하되 직함만으로 감별 숙련을 확대하지 않는다.",
          "en": "They divided scarce prescriptions and supply according to patient allocation. Apprenticeship is retained without turning the title into broad appraisal expertise."
        },
        "behavior": {
          "ko": "저울눈만큼 말을 아끼고, 외상 장부를 사람 얼굴보다 오래 기억한다. 선매를 권하는 사신을 손님으로 보지 않는다. 제기동의 중립 의료국 흰십자단에서 담당 전문의의 도제로 배우며, 적아 구분 없이 중증도만으로 치료한다.",
          "en": "He spared words as much as the scale's needle and remembered credit ledgers longer than faces. He did not count an envoy who recommended pre-buying as a guest."
        },
        "stress": {
          "ko": "공포. 암사나 여의신이 항생제와 해열 생약을 선매해 시장 바닥이 드러나는 것.",
          "en": "Fear. That Amsa or Yeouisin would pre-buy the antibiotics and febrifuge herbs and lay the market floor bare."
        },
        "relationship": {
          "ko": "관계. 류은비의 치료 물자를 대고, 전솔의 환자 할당을 따르며, 은태호의 가락 가격과 약재 교환 비율을 거래한다.",
          "en": "Relations. Staked care supplies for Ryu Eunbi, followed Jeon Sol's patient allocation, and traded exchange ratios between Eun Taeho's Garak prices and herbs."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 수련의. 직함은 약재 감별 수련의. 원산지와 건조 일자를 말목에 걸고, 대량 출고는 담당 전문의 전솔과 단장의 진료 배정 날인이 있어야 성립시킨다.",
          "en": "Office. Rank: member. Title: herb merchant. He hung origin and drying dates on the inspection posts and made bulk pre-buying stand only with the stamps of Ryu Eunbi and Jeon Sol, the patients' representative."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 수련의. 직함은 약재 감별 수련의. 원산지와 건조 일자를 말목에 걸고, 대량 출고는 담당 전문의 전솔과 단장의 진료 배정 날인이 있어야 성립시킨다.",
          "en": "Recorded duty and limits: Office. Rank: member. Title: herb merchant. He hung origin and drying dates on the inspection posts and made bulk pre-buying stand only with the stamps of Ryu Eunbi and Jeon Sol, the patients' representative."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 암사나 여의신이 항생제와 해열 생약을 선매해 시장 바닥이 드러나는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That Amsa or Yeouisin would pre-buy the antibiotics and febrifuge herbs and lay the market floor bare."
        },
        "relationship": {
          "ko": "관계. 류은비의 치료 물자를 대고, 전솔의 환자 할당을 따르며, 은태호의 가락 가격과 약재 교환 비율을 거래한다.",
          "en": "Relations. Staked care supplies for Ryu Eunbi, followed Jeon Sol's patient allocation, and traded exchange ratios between Eun Taeho's Garak prices and herbs."
        },
        "effects": []
      }
    ],
