    "traits": [
      {
        "id": "k145-choice",
        "name": {
          "ko": "확정에 신중함",
          "en": "Reluctant to certify"
        },
        "description": {
          "ko": "말수를 아끼고 사람보다 도장을 먼저 따진다. 한 번 찍은 인준을 번복하면 서울역 전체가 흔들린다고 믿는다.",
          "en": "He spared words and weighed the stamp before the person. He believed that reversing a ratification once would shake all of Seoul Station."
        },
        "behavior": {
          "ko": "일화. 서로 다른 세 장의 임하준 유언장이 같은 날 접수되자 인준 심사를 정지하고 필적 대조를 선언했다.",
          "en": "Anecdote. When three different wills of Im Hajun were received on the same day, he stopped the ratification examination and declared a handwriting comparison."
        },
        "stress": {
          "ko": "공포. 위조 유언장 한 장이 통과돼 서울역이 강국의 도장 하청으로 전락하는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That one forged testament would pass and Seoul Station would sink into a great power's stamp subcontract. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 윤서린의 지휘를 받으며 임초원의 총관 계승 인준을 심사한다. 황은설과 음성·문서 교차검증을 약속했고, 정유라의 공동교섭 인준 청구는 고의로 늦춘다.",
          "en": "Relations. Took Yun Seorin's command and examined Im Chowon's Superintendent-succession ratification. Promised cross-verification of voice and documents with Hwang Eunseol, and deliberately delayed Jeong Yura's joint-negotiation ratification claim."
        },
        "effects": []
      },
      {
        "id": "k145-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 주사. 직함은 인준 심사관. 공개 원본과 비공개 증언을 같은 책상에 펼치고, 증인이 두 명 미만이면 인준을 보류한다.",
          "en": "Office. Rank: registrar. Title: ratification examiner. He spread the public original and the private testimony on one desk and suspended ratification with fewer than two witnesses."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 인준 심사관. 공개 원본과 비공개 증언을 같은 책상에 펼치고, 증인이 두 명 미만이면 인준을 보류한다.",
          "en": "Office. Rank: registrar. Title: ratification examiner. He spread the public original and the private testimony on one desk and suspended ratification with fewer than two witnesses."
        },
        "stress": {
          "ko": "공포. 위조 유언장 한 장이 통과돼 서울역이 강국의 도장 하청으로 전락하는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That one forged testament would pass and Seoul Station would sink into a great power's stamp subcontract. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 윤서린의 지휘를 받으며 임초원의 총관 계승 인준을 심사한다. 황은설과 음성·문서 교차검증을 약속했고, 정유라의 공동교섭 인준 청구는 고의로 늦춘다.",
          "en": "Relations. Took Yun Seorin's command and examined Im Chowon's Superintendent-succession ratification. Promised cross-verification of voice and documents with Hwang Eunseol, and deliberately delayed Jeong Yura's joint-negotiation ratification claim."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "세 유언장이 충돌하자 심사를 멈췄지만 공동교섭 청구는 고의로 늦춘다. 검증 원칙과 기록청 권한 집중을 함께 반영한다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Suspended review when three wills conflicted, yet deliberately delays a joint negotiation claim. Verification and institutional control coexist. Titles and ambitions are not treated as accomplished authority or results."
    },
