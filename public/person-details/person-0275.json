    "traits": [
      {
        "id": "k274-priority",
        "name": {
          "ko": "생활 피해의 책임",
          "en": "Responsibility for deprivation"
        },
        "description": {
          "ko": "서진아는 청원과 잔량을 함께 공개하며 야간 단수에 입회를 요구한다. 이중 승인은 아직 야망이며 완성된 통치 제도가 아니다.",
          "en": "Seo Jina publishes petitions beside remaining water and requires attendance at nighttime cutoffs. Dual approval remains an ambition, not an established government."
        },
        "behavior": {
          "ko": "사택 청원 결과와 급수 잔량을 같은 게시판에 붙이고, 야간 단수는 감사 입회 없이 금지한다.",
          "en": "Office. Rank: assistant manager. Title: residential community auditor. She pasted the residential election results and the water-residue levels on one board and forbade night cutoffs without audit attendance."
        },
        "stress": {
          "ko": "한재목의 집단 단수 조항이 강남역 사택 인구를 하룻밤에 흩어 놓는 것.",
          "en": "Fear. That Han Jaemok's collective cutoff clause would scatter the Changdong housing population in one night."
        },
        "relationship": {
          "ko": "이홍원과 사택·기술 혼합 통치를 다투며 한재목의 물 공급 협상을 사택 측에서 감시한다. 윤초아의 시민권 원장에 강남역 이주민을 올리려 한다.",
          "en": "Relations. Contested the mixed housing-technology rule with I Hongwon and watched Han Jaemok's water-supply talks from the housing side. Sought to raise the Changdong migrants onto Yun Choa's citizenship ledger."
        },
        "effects": []
      },
      {
        "id": "k274-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 사원. 직함은 강남역 사택 감사. 사택 청원 결과와 급수 잔량을 같은 게시판에 붙이고, 야간 단수는 감사 입회 없이 금지한다.",
          "en": "Office. Rank: assistant manager. Title: residential community auditor. She pasted the residential election results and the water-residue levels on one board and forbade night cutoffs without audit attendance."
        },
        "stress": {
          "ko": "공포. 한재목의 집단 단수 조항이 강남역 사택 인구를 하룻밤에 흩어 놓는 것.",
          "en": "Fear. That Han Jaemok's collective cutoff clause would scatter the Changdong housing population in one night."
        },
        "relationship": {
          "ko": "관계. 이홍원과 사택·기술 혼합 통치를 다투며 한재목의 물 공급 협상을 사택 측에서 감시한다. 윤초아의 시민권 원장에 강남역 이주민을 올리려 한다.",
