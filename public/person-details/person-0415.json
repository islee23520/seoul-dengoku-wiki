    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "출력 기준 준수",
          "en": "Follows output thresholds"
        },
        "description": {
          "ko": "최저 출력 이하에는 독촉에도 배전을 끊고 정전 때 서고와 투표 광장에 전력을 남겼다.",
          "en": "Cuts distribution below minimum output despite pressure and preserves archive and voting-square power during a blackout."
        },
        "behavior": {
          "ko": "확인된 선택에서는 출력 기준 준수을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "연료 부족 때 배전 범위를 좁힐 수 있다.",
          "en": "May narrow power allocation when fuel runs low."
        },
        "relationship": {
          "ko": "선한솜과 방마빛의 시설을 받치되 은폐 배전은 거부한다.",
          "en": "Supports Seon Hansom’s and Bang Mabit’s facilities but refuses hidden allocation."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "서고와 조합원 직접투표 광장 전력을 하나의 공개 배전망으로 묶어 계약 감사의 품질 주권을 지킨다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "연료가 바닥난 밤에 함이 수동으로만 열리고, 그 공백을 동부 외부 통제이 메우는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "선한솜과 방마빛의 시설을 받치되 은폐 배전은 거부한다.",
          "en": "Supports Seon Hansom’s and Bang Mabit’s facilities but refuses hidden allocation."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "최저 출력 이하에는 독촉에도 배전을 끊고 정전 때 서고와 투표 광장에 전력을 남겼다.",
      "en": "Cuts distribution below minimum output despite pressure and preserves archive and voting-square power during a blackout."
    },
