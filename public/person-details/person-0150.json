    "traits": [
      {
        "id": "k149-choice",
        "name": {
          "ko": "불확실성을 표시",
          "en": "Marks uncertainty"
        },
        "description": {
          "ko": "호기심이 많고 길을 잃는 사람을 참지 못한다. 틀린 지도를 배포하는 일을 살인에 가깝다고 여긴다.",
          "en": "Curious, she could not stand people losing their way. She saw distributing a wrong map as close to murder."
        },
        "behavior": {
          "ko": "일화. 도심 북부 급수 인계가 끊긴 뒤에도 옛 급수구역이 인쇄된 지도가 상암 전파로 퍼졌다.",
          "en": "Anecdote. After water-supply handovers in the northern city center were interrupted, maps still printed with the old water-supply districts spread over the Sangam airwaves."
        },
        "stress": {
          "ko": "공포. 강국이 지도 원판을 사들여 급수 분쟁 구간을 자기 영토로 인쇄하는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That great powers would buy up the master plates and print the water-dispute zones as their own territory. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 최지우과 지도 갱신 시각을 맞추고 권미래에게 송신탑 좌표를 받는다. 윤서린은 그의 원판을 인준 첨부물로 쓴다.",
          "en": "Relations. Matched map-renewal times with Choi Jiwoo and received transmission tower coordinates from Gwon Mirae. Yun Seorin used his master plate as a ratification annex."
        },
        "effects": []
      },
      {
        "id": "k149-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 주사. 직함은 지도 복구 사서. 현장 측량과 송신 속보를 겹쳐 그리고, 출처가 하나뿐인 도로는 점선으로만 남긴다.",
          "en": "Office. Rank: registrar. Title: map-restoration librarian. He drew field surveys overlaid with transmission bulletins and left roads with a single source only as dotted lines."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 지도 복구 사서. 현장 측량과 송신 속보를 겹쳐 그리고, 출처가 하나뿐인 도로는 점선으로만 남긴다.",
          "en": "Office. Rank: registrar. Title: map-restoration librarian. He drew field surveys overlaid with transmission bulletins and left roads with a single source only as dotted lines."
        },
        "stress": {
          "ko": "공포. 강국이 지도 원판을 사들여 급수 분쟁 구간을 자기 영토로 인쇄하는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That great powers would buy up the master plates and print the water-dispute zones as their own territory. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 최지우과 지도 갱신 시각을 맞추고 권미래에게 송신탑 좌표를 받는다. 윤서린은 그의 원판을 인준 첨부물로 쓴다.",
          "en": "Relations. Matched map-renewal times with Choi Jiwoo and received transmission tower coordinates from Gwon Mirae. Yun Seorin used his master plate as a ratification annex."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "현장 측량과 속보를 대조하고 단일 출처 도로를 점선으로 남긴다. 낡은 지도를 회수한 결말이나 영토 결정권은 없다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Cross-checks surveys with reports and marks single-source roads as dotted lines. No recovery of obsolete maps or territorial authority is established. Titles and ambitions are not treated as accomplished authority or results."
    },
