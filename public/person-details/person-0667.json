    "traits": [
      {
        "id": "act-on-detected-crossings",
        "name": {
          "ko": "도하 적발 실행",
          "en": "Act on Detected Crossings"
        },
        "description": {
          "ko": "정강은은 야간 무단 도하를 발견하는 데 그치지 않고 직접 저지하는 성향을 보인다.",
          "en": "Jeong Gangeun shows a tendency to act directly against an unauthorized night crossing rather than merely note it."
        },
        "behavior": {
          "ko": "야간 무단 도하자를 붙잡고 경비 암호패를 바꿨다.",
          "en": "She caught an unauthorized night crosser and changed the guard code tokens."
        },
        "stress": {
          "ko": "당직 공백이 통행 종속으로 이어질까 우려되면 적발한 무단 도하에 직접 대응하려 할 수 있다.",
          "en": "If a duty gap could lead to dependent passage, she may favor direct action on a detected unauthorized crossing."
        },
        "relationship": {
          "ko": "선배 당직에게는 직접 저지한 일과 뒤따른 암호패 변경을 함께 넘기려 할 수 있다.",
          "en": "She may hand over both the direct interception and the subsequent code-token change to the senior duty holder."
        },
        "effects": []
      },
      {
        "id": "change-guard-code-tokens",
        "name": {
          "ko": "경비 암호패 변경",
          "en": "Change Guard Code Tokens"
        },
        "description": {
          "ko": "정강은은 무단 도하 저지 뒤 경비 확인 수단을 바꾸는 후속 조치 성향을 보인다.",
          "en": "Jeong Gangeun shows a follow-through disposition by changing guard verification tokens after stopping an unauthorized crossing."
        },
        "behavior": {
          "ko": "야간 도하자를 붙잡은 사건에서 경비 암호패를 변경했다.",
          "en": "In the night-crossing incident, she changed the guard code tokens after catching the crosser."
        },
        "stress": {
          "ko": "당직의 빈틈이 통행을 위태롭게 할까 우려되면 저지 후 암호패 변경 같은 후속 조치를 중시할 수 있다.",
          "en": "If a duty gap threatens passage, she may place weight on follow-up measures such as changing code tokens after interception."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때는 암호패 변경 사실이 누락되지 않도록 주의할 수 있다.",
          "en": "During handover, she may take care that the senior duty holder is informed of the code-token change."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "야간 침입자를 붙잡고 암호패를 변경했다. 실무 경비에 한정하고 넓은 작전 설계는 부여하지 않았다.",
      "en": "He restrained a night intruder and changed passes. Practical guard work is supported, not broad operational planning."
    },
