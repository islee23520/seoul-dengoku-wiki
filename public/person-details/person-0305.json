    "skills": [
      {
        "id": "k304-stretcher-ordering",
        "name": {
          "ko": "들것 순서 집행",
          "en": "Stretcher ordering"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "k304-priority",
        "name": {
          "ko": "당직을 연장함",
          "en": "Extends duty"
        },
        "description": {
          "ko": "국용은 행렬이 쌓이자 당직을 연장하고 배차 교대를 거부했다. 환자 우선이지만 완료된 의료호송 제도는 아니다.",
          "en": "Gukyong extended duty and refused dispatch rotation when crowds accumulated. Patient priority does not establish a completed medical escort system."
        },
        "behavior": {
          "ko": "중증도 표와 이송 시각을 당직실에 붙이고, 무기 적재 의심 칸은 심사관 입회 없이 열지 않는다.",
          "en": "Office. Rank: convoy hand. Title: transfer duty medic, duty officer of Jeon Miri. He pasted the severity table and transfer hours in the duty room and opened no car suspected of arms loading without the examiner's attendance."
        },
        "stress": {
          "ko": "환자 칸이 군수 칸으로 오인되어 호송대 전체가 무장 해제를 당하는 것.",
          "en": "Fear. That the patient cars would be mistaken for munitions cars and the whole convoy squad would be disarmed."
        },
        "relationship": {
          "ko": "전미리의 지휘로 들것 순서를 집행하고, 감모의 의료조 당직실과 병상을 나눈다. 류은비의 의료동맹 호송증을 당직 원장에 옮긴다.",
          "en": "Relations. Executed the stretcher order under Jeon Miri's command and shared the medical crew's duty room and sickbeds with Gam Mo. Moved Ryu Eunbi's medical alliance convoy passes into the duty ledger."
        },
        "effects": []
      },
      {
        "id": "k304-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 호송원. 직함은 환승 당직 의무원, 전미리의 실무 담당자. 중증도 표와 이송 시각을 당직실에 붙이고, 무기 적재 의심 칸은 심사관 입회 없이 열지 않는다.",
          "en": "Office. Rank: convoy hand. Title: transfer duty medic, duty officer of Jeon Miri. He pasted the severity table and transfer hours in the duty room and opened no car suspected of arms loading without the examiner's attendance."
        },
        "stress": {
          "ko": "공포. 환자 칸이 군수 칸으로 오인되어 호송대 전체가 무장 해제를 당하는 것.",
          "en": "Fear. That the patient cars would be mistaken for munitions cars and the whole convoy squad would be disarmed."
        },
        "relationship": {
          "ko": "관계. 전미리의 지휘로 들것 순서를 집행하고, 감모의 의료조 당직실과 병상을 나눈다. 류은비의 의료동맹 호송증을 당직 원장에 옮긴다.",
          "en": "Relations. Executed the stretcher order under Jeon Miri's command and shared the medical crew's duty room and sickbeds with Gam Mo. Moved Ryu Eunbi's medical alliance convoy passes into the duty ledger."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "국용은 행렬이 쌓이자 당직을 연장하고 배차 교대를 거부했다. 환자 우선이지만 완료된 의료호송 제도는 아니다.",
      "en": "Gukyong extended duty and refused dispatch rotation when crowds accumulated. Patient priority does not establish a completed medical escort system."
    },
