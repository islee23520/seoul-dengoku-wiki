    "traits": [
      {
        "id": "discard-forged-copies",
        "name": {
          "ko": "위조 사본 폐기",
          "en": "Discard Forged Copies"
        },
        "description": {
          "ko": "홍나원은 위조 도장이 드러난 사건에서 사본을 남기기보다 원본 칸을 지키는 쪽을 택했다.",
          "en": "In the forged-seal episode, Hong Nawon chose to protect the original-record slot rather than retain the copies."
        },
        "behavior": {
          "ko": "위조 도장이 드러난 뒤 사본을 불사르고 원본 칸을 지켰다.",
          "en": "After the forged seal was exposed, Hong Nawon burned the copies and protected the original-record slot."
        },
        "stress": {
          "ko": "기록 문제로 당직의 연속성이 흔들린다면 원본 칸을 보전하는 데 집중할 수 있다.",
          "en": "If record problems threaten duty continuity, Hong Nawon may focus on preserving the original-record slot."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 폐기된 사본과 남은 원본 칸을 구분해 전달하려 할 수 있다.",
          "en": "During handovers with senior duty staff, Hong Nawon may distinguish discarded copies from the retained original-record slot."
        },
        "effects": []
      },
      {
        "id": "original-records-matter",
        "name": {
          "ko": "원본 기록 중시",
          "en": "Original Records Matter"
        },
        "description": {
          "ko": "홍나원은 위조 도장 사건에서도 원본 기록의 자리를 보전하는 데 무게를 둔다.",
          "en": "Hong Nawon places weight on preserving the place of original records even in the forged-seal episode."
        },
        "behavior": {
          "ko": "사본을 폐기하면서도 원본 칸은 지키고 직위에 속한 기록을 인계한다.",
          "en": "Hong Nawon preserves the original-record slot while discarding copies and hands over records belonging to the position."
        },
        "stress": {
          "ko": "당직 공백으로 통행이 볼모가 될까 우려하면 원본 기록과 인계의 연속성에 더 주의를 기울일 수 있다.",
          "en": "Fear that a duty gap could leave passage hostage may increase attention to original records and handover continuity."
        },
        "relationship": {
          "ko": "선배 당직과는 큰소리보다 보전된 기록을 인계의 근거로 삼으려 할 수 있다.",
          "en": "With senior duty staff, Hong Nawon may use preserved records rather than loud assertions as the basis for handover."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "사본을 폐기하고 원본 칸을 남긴 일화와 이중 장부 정정 생애가 있다. 종자 연구와 무결한 감사 경력은 확인되지 않는다.",
      "en": "He discarded a copy and preserved the original slot, with ledger correction in his life record. Seed research and a flawless audit career are not established."
    },
