    "skills": [
      {
        "id": "k457-citizenship-register-check",
        "name": {
          "ko": "시민권 등기 대조",
          "en": "Citizenship-registration crosscheck"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "k457-action-priority",
        "name": {
          "ko": "원본과 이름 대조",
          "en": "Compare names with originals"
        },
        "description": {
          "ko": "구로역 길드 평의회가 강민서의 위원장 자리 근거로 삼은 시민권 줄을 다시 펼친다. 차예원은 복구복무자 등록을 거부해 그 줄에 오른 이름을 등기 원본과 차례로 맞추고, 평의회로 보낼 사본 끝에 자기 당직의 서명을 단다.",
          "en": "The Guro Station guild council opens again the citizenship line it took as the ground for Gang Minseo's chair. Cha Yewon matches, in order against the registry originals, the names that entered that line by refusing restoration-service registration, and signs the end of the copy bound for the council with the signature of the duty."
        },
        "behavior": {
          "ko": "구로역 길드 평의회가 강민서의 위원장 자리 근거로 삼은 시민권 줄을 다시 펼친다. 차예원은 복구복무자 등록을 거부해 그 줄에 오른 이름을 등기 원본과 차례로 맞추고, 평의회로 보낼 사본 끝에 자기 당직의 서명을 단다.",
          "en": "The Guro Station guild council opens again the citizenship line it took as the ground for Gang Minseo's chair. Cha Yewon matches, in order against the registry originals, the names that entered that line by refusing restoration-service registration, and signs the end of the copy bound for the council with the signature of the duty."
        },
        "stress": {
          "ko": "복구복무 기록관 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the restoration service registrar duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k457-bounded-handover",
        "name": {
          "ko": "기록으로 잇는 당직",
          "en": "Duty linked by records"
        },
        "description": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "behavior": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "stress": {
          "ko": "복구복무 기록관 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the restoration service registrar duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "구로역 길드 평의회가 강민서의 위원장 자리 근거로 삼은 시민권 줄을 다시 펼친다. 차예원은 복구복무자 등록을 거부해 그 줄에 오른 이름을 등기 원본과 차례로 맞추고, 평의회로 보낼 사본 끝에 자기 당직의 서명을 단다. 짧은 행위와 인수인계가 근거여서 다른 분야의 숙련이나 보정은 발급하지 않았다.",
      "en": "The Guro Station guild council opens again the citizenship line it took as the ground for Gang Minseo's chair. Cha Yewon matches, in order against the registry originals, the names that entered that line by refusing restoration-service registration, and signs the end of the copy bound for the council with the signature of the duty. The brief action and handover support only limited strengths; no unrelated proficiency or numeric trait bonus is issued."
    },
