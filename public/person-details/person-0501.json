      {
        "id": "shift-condition-negotiation",
        "name": {
          "ko": "교대 조건 협의",
          "en": "Shift condition negotiation"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "다음 당직을 협의로 연다",
          "en": "Negotiates the next duty shift"
        },
        "description": {
          "ko": "태업 작업반과 밤새 조건을 나눠 다음 교대를 열었다. 검역 기술이 아니라 노동 조건 조정이 구체적 근거다.",
          "en": "Overnight talks with a slowdown crew opened the next shift. The concrete evidence is labor coordination rather than quarantine technique."
        },
        "behavior": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "stress": {
          "ko": "공포. 검역 서기 당직이 비면 아관사의 통행이 강국 볼모가 되는 것.",
          "en": "Fear. That the quarantine clerk duty post would stand empty and the Government's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 수비대원. 직함은 구의수비대 검역 서기. 자기 직위의 열쇠와 기록만 넘기고, 전쟁과 급수의 양군 승인 없이 한쪽 군령만으로 권한을 만들지 않는다.",
          "en": "Office. Rank: sergeant. Title: quarantine clerk. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 수비대원. 직함은 구의수비대 검역 서기. 자기 직위의 열쇠와 기록만 넘기고, 전쟁과 급수의 양군 승인 없이 한쪽 군령만으로 권한을 만들지 않는다.",
          "en": "Recorded duty and limits: Office. Rank: sergeant. Title: quarantine clerk. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 검역 서기 당직이 비면 아관사의 통행이 강국 볼모가 되는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That the quarantine clerk duty post would stand empty and the Government's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "태업 작업반과 밤새 조건을 나눠 다음 교대를 열었다. 검역 기술이 아니라 노동 조건 조정이 구체적 근거다.",
      "en": "Overnight talks with a slowdown crew opened the next shift. The concrete evidence is labor coordination rather than quarantine technique."
    },
