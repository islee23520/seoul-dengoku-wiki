    "skills": [
      {
        "id": "k164-approval-date-check",
        "name": {
          "ko": "인준일 확인",
          "en": "Approval date checking"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "k164-choice",
        "name": {
          "ko": "소급 날인을 막음",
          "en": "Blocks backdated certification"
        },
        "description": {
          "ko": "헌장 사본의 접힌 자국까지 기억하고, 늦게 온 인준을 소급하자고 하면 함을 잠근다. 예의는 지키되 날짜를 고치는 손은 용서하지 않는다.",
          "en": "He remembered even the fold marks on charter copies and locked the box whenever someone proposed back-dating a late ratification. He kept his manners but never forgave a hand that changed a date."
        },
        "behavior": {
          "ko": "일화. 정유라 쪽에서 늦게 도착한 공동교섭 인준을 소급해 달라는 청구가 들어온다. 어태산은 윤서린이 맡긴 인준 함을 잠그고, 벽에 적힌 깃발별 인준일 옆에 당시 증인 두 명의 이름을 불러 다시 설 날을 잡는다.",
          "en": "Anecdote. A request comes from Jeong Yura's joint-bargaining side to backdate a late ratification. Eo Taesan locks the ratification case Yun Seorin entrusted and, beside the per-flag ratification dates on the wall, calls the names of the two original witnesses and sets a day for them to stand again."
        },
        "stress": {
          "ko": "공포. 인준 함이 강국의 보호 문장으로 덧칠되어 대한민국정부 헌장이 하청 문서가 되는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That the ratification box would be painted over with a great power's protection clause and the lesser states' charter would become a subcontract. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 윤서린이 맡긴 건국 인준 함을 지키고, 조하린의 철제 함 습도와 보관 주기를 맞추며, 정유라의 공동교섭 인준은 날짜를 속이지 않는 한에서만 꺼낸다.",
          "en": "Relations. Kept the founding ratification box entrusted by Yun Seorin, matched the humidity and custody cycles with Jo Harin's iron box, and drew out Jeong Yura's joint-negotiation ratification only so long as it did not cheat the dates."
        },
        "effects": []
      },
      {
        "id": "k164-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 주사. 직함은 각국 인준 보관인. 깃발별 인준일을 벽에 적고, 사후 추인 청구는 당시 증인 두 명이 다시 서지 않으면 받지 않는다.",
          "en": "Office. Rank: registrar. Title: states ratification custodian. He wrote each banner's ratification day on the wall and accepted no after-the-fact countersignature unless the two witnesses of the day signed again."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 각국 인준 보관인. 깃발별 인준일을 벽에 적고, 사후 추인 청구는 당시 증인 두 명이 다시 서지 않으면 받지 않는다.",
          "en": "Office. Rank: registrar. Title: states ratification custodian. He wrote each banner's ratification day on the wall and accepted no after-the-fact countersignature unless the two witnesses of the day signed again."
        },
        "stress": {
          "ko": "공포. 인준 함이 강국의 보호 문장으로 덧칠되어 대한민국정부 헌장이 하청 문서가 되는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That the ratification box would be painted over with a great power's protection clause and the lesser states' charter would become a subcontract. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 윤서린이 맡긴 건국 인준 함을 지키고, 조하린의 철제 함 습도와 보관 주기를 맞추며, 정유라의 공동교섭 인준은 날짜를 속이지 않는 한에서만 꺼낸다.",
          "en": "Relations. Kept the founding ratification box entrusted by Yun Seorin, matched the humidity and custody cycles with Jo Harin's iron box, and drew out Jeong Yura's joint-negotiation ratification only so long as it did not cheat the dates."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "늦은 인준의 소급 요구에 함을 잠그고 당시 증인 둘을 다시 부른다. 원본과 날짜를 지키되 국제 정치 경력은 부여하지 않는다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Locked the case against backdating and recalled two original witnesses. Protecting dates and originals establishes no international political career. Titles and ambitions are not treated as accomplished authority or results."
    },
