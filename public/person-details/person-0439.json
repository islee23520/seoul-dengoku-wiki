    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "사적 청탁 거절",
          "en": "Rejects private lobbying"
        },
        "description": {
          "ko": "사적 청탁을 돌려보내고 공개 창구로 보냈다. 자기 열쇠와 기록만 인계하며 없는 권한은 만들지 않는다.",
          "en": "Rejects private lobbying and directs it to the public window. Hands over only assigned keys and records without inventing authority."
        },
        "behavior": {
          "ko": "확인된 선택에서는 사적 청탁 거절을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "파벌이 교대를 막으면 인수 증인을 찾을 수 있다.",
          "en": "May seek a handover witness when factions obstruct shifts."
        },
        "relationship": {
          "ko": "선배 당직과 인계를 이어가되 권한을 확대하지 않는다.",
          "en": "Keeps handovers with senior duty workers without expanding authority."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "공동구 당직 자리에서 시청역 조합 장부를 끊기지 않게 잇고, 작업장 파벌이 갈려도 조합원 전원의 위원장 직접선거 결과를 지킨다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "공동구 당직이 비고 선거 파벌이 인수인계를 가로막아 정동노총의 통행이 강국 볼모가 되는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "선배 당직과 인계를 이어가되 권한을 확대하지 않는다.",
          "en": "Keeps handovers with senior duty workers without expanding authority."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "사적 청탁을 돌려보내고 공개 창구로 보냈다. 자기 열쇠와 기록만 인계하며 없는 권한은 만들지 않는다.",
      "en": "Rejects private lobbying and directs it to the public window. Hands over only assigned keys and records without inventing authority."
