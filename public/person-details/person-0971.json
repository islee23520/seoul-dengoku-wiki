    "skills": [
      {
        "id": "save-register",
        "name": {
          "ko": "위기 인명 장부 보존",
          "en": "Emergency preservation of personnel registers"
        },
        "rating": 45
      },
      {
        "id": "departure",
        "name": {
          "ko": "배차표·출발 확인",
          "en": "Departure and dispatch checks"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "ledgers-first-amid-attacks",
        "name": {
          "ko": "습격 속 장부 우선",
          "en": "Ledgers First Amid Attacks"
        },
        "description": {
          "ko": "이남민은 습격의 압박 속에서도 화물보다 인명 기록을 우선하는 성향을 보인다.",
          "en": "I Nammin shows a disposition to prioritize personal records over cargo even under attack pressure."
        },
        "behavior": {
          "ko": "호송 도중 습격을 만나 화물보다 인명 장부부터 챙겼다.",
          "en": "When attacked during a convoy, he secured the register of people before the cargo."
        },
        "stress": {
          "ko": "습격과 기록 단절의 우려가 겹치면 인명 장부 보존에 더 무게를 둘 수 있다.",
          "en": "If attack pressure coincides with the risk of broken record continuity, he may give greater weight to preserving the register."
        },
        "relationship": {
          "ko": "선배 당직과는 습격 중 지켜낸 장부를 이어 넘기는 데 책임을 느낄 수 있다.",
          "en": "With senior duty staff, he may feel responsible for passing onward the register preserved during the attack."
        },
        "effects": []
      },
      {
        "id": "limited-record-responsibility",
        "name": {
          "ko": "기록 책임 한정",
          "en": "Limited Record Responsibility"
        },
        "description": {
          "ko": "이남민은 기록을 지키는 책임을 자기 직위의 열쇠와 기록 범위 안에 한정한다.",
          "en": "I Nammin limits his responsibility for safeguarding records to his position’s keys and records."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 넘기고 장부 보존을 이유로 없는 권한을 만들지 않는다.",
          "en": "He hands over only his position’s keys and records without using ledger preservation to claim additional powers."
        },
        "stress": {
          "ko": "당직 공백이 두려워도 맡은 기록의 연속성을 지키는 범위에서 대응하려 할 수 있다.",
          "en": "Even if he fears a duty gap, he may respond within the scope of preserving the records entrusted to him."
        },
        "relationship": {
          "ko": "선배 당직과는 실제로 맡은 기록의 책임 범위를 분명히 하며 인계하려 할 수 있다.",
          "en": "With senior duty staff, he may seek to make the actual scope of his record responsibility clear during handover."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "습격 때 화물보다 인명 장부를 보존했다. 실제 선택만 평가하며 호송 성공 전체나 적 제압을 단정하지 않는다.",
      "en": "She preserved personnel registers over freight during an attack. The choice is reflected, not assumed overall convoy success or enemy restraint."
    },
