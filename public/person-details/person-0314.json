    "traits": [
      {
        "id": "k313-priority",
        "name": {
          "ko": "활력 안정 우선",
          "en": "Vital stability first"
        },
        "description": {
          "ko": "감모는 중증도와 이송 시각을 게시하고 의료조 연장을 집행한다. 연장을 약으로 대신한다는 말을 거부한다.",
          "en": "Gammo posts severity and transfer times and implements medical duty extensions, rejecting the idea that extended duty substitutes for medicine."
        },
        "behavior": {
          "ko": "중증도 표와 이송 시각을 당직실 문에 붙이고, 무기 적재 기록은 심사관 입회 없이 고치지 않는다.",
          "en": "Office. Rank: convoy hand. Title: medical crew duty room outpost chief. He pasted the severity table and transfer hours on the duty-room door and corrected no arms-loading record without the examiner's attendance."
        },
        "stress": {
          "ko": "당직실이 군수 대기실로 오인되어 호송대 전체가 무장 해제를 당하는 것.",
          "en": "Fear. That the duty room would be mistaken for a munitions waiting room and the whole convoy squad would be disarmed."
        },
        "relationship": {
          "ko": "전미리의 의료조 연장을 당직실에서 집행하고, 국용의 들것 순서와 병상을 나눈다. 장세화의 부서 날인을 당직 원장 맨 위에 둔다.",
          "en": "Relations. Executed Jeon Miri's medical crew extension in the duty room and split the stretcher order and sickbeds with Guk Yong. Put Jang Sehwa's departmental stamp at the top of the duty ledger."
        },
        "effects": []
      },
