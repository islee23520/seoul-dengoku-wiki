    "skills": [
      {
        "id": "save-register",
        "name": {
          "ko": "위기 인명 장부 보존",
          "en": "Emergency preservation of personnel registers"
        },
        "rating": 45
      },
      {
        "id": "handover",
        "name": {
          "ko": "기록·열쇠 인수인계",
          "en": "Record and key handover"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "choose-records-amid-fire",
        "name": {
          "ko": "화재 속 기록 선택",
          "en": "Choose Records Amid Fire"
        },
        "description": {
          "ko": "장라원은 화재 속에서 인명 장부를 우선 보존하는 선택을 했다.",
          "en": "Jang Rawon chose to preserve the people register first amid a fire."
        },
        "behavior": {
          "ko": "역사 화재 때 인명 장부부터 꺼내 들고 밖으로 나왔다.",
          "en": "They took the people register first and carried it out during the station fire."
        },
        "stress": {
          "ko": "화재처럼 기록이 사라질 위험과 당직 공백 우려가 겹치면 장부 확보에 집중할 수 있다.",
          "en": "When a risk of record destruction coincides with concern about a vacant shift, they may focus on securing the register."
        },
        "relationship": {
          "ko": "위기 뒤 선배 당직에게 인계한다면 보존한 장부를 공동 확인의 출발점으로 삼을 수 있다.",
          "en": "In a handover after a crisis, they may use the preserved register as the starting point for joint verification with a senior colleague."
        },
        "effects": []
      },
      {
        "id": "hand-over-key-access-limits",
        "name": {
          "ko": "열쇠 범위 인계",
          "en": "Hand Over Key Access Limits"
        },
        "description": {
          "ko": "장라원은 인계할 열쇠와 기록을 자기 직위의 범위 안에 두는 원칙을 따른다.",
          "en": "Jang Rawon follows the principle of limiting transferred keys and records to their own position."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 넘기고 없는 권한을 인계 내용에 보태지 않는다.",
          "en": "They transfer only their own keys and records without adding authority they do not hold."
        },
        "stress": {
          "ko": "당직 공백이 통행을 위협하더라도 인계 권한의 경계를 지키려 할 수 있다.",
          "en": "Even if a vacant shift threatens passage, they may seek to preserve the boundaries of their handover authority."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 넘길 수 있는 열쇠와 기록의 범위를 분명히 할 수 있다.",
          "en": "In handovers with a senior duty colleague, they may clarify which keys and records they can transfer."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "화재 때 인명 장부를 먼저 꺼냈다. 제한된 위험 대응만 평가하며 수질 검사의 전문 숙련은 발급하지 않았다.",
      "en": "She retrieved personnel registers first during a fire. Limited hazard response is reflected; specialist water-testing skill is not issued."
    },
