    "traits": [
      {
        "id": "k019-price-restraint",
        "name": {
          "ko": "단수 가격 억제",
          "en": "Restrain cutoff prices"
        },
        "description": {
          "ko": "단수 골목의 가격을 올리지 않는다.",
          "en": "Does not raise prices in cutoff lanes."
        },
        "behavior": {
          "ko": "단수 골목의 가격을 올리지 않는다.",
          "en": "Does not raise prices in cutoff lanes."
        },
        "stress": {
          "ko": "가락의 가격 원장이 여의도 선석까지 삼켜 서부 식수가 동부 시세로 팔리는 것.",
          "en": "That Garak's price ledger would swallow the Yeouido berths and western drinking water would sell at eastern prices."
        },
        "relationship": {
          "ko": "정모란의 선석 추첨을 경매로 집행하는 계약이고, 구태윤의 양천 수통과 순번을 나누며, 남윤경의 비상 시세 제의를 원한으로 돌려보낸다.",
          "en": "A contract executing Jeong Moran's berth lottery by auction, splitting order with Gu Taeyun's Yangcheon canteens, and sending Nam Yungyeong's emergency price offer back as a grudge."
        },
        "effects": []
      },
      {
        "id": "k019-standard-before-sale",
        "name": {
          "ko": "낙찰보다 기준",
          "en": "Standards before sale"
        },
        "description": {
          "ko": "낙찰된 물도 기준 미달이면 출항시키지 않는다.",
          "en": "Keeps sold water from sailing if it fails standards."
        },
        "behavior": {
          "ko": "낙찰된 물도 기준 미달이면 출항시키지 않는다.",
          "en": "Keeps sold water from sailing if it fails standards."
        },
        "stress": {
