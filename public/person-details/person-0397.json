      {
        "id": "evidenced-choice",
        "name": {
          "ko": "증거 없는 의혹 보류",
          "en": "Withholds unsupported suspicion"
        },
        "description": {
          "ko": "의료열차 무기와 호송 입찰함의 같은 끈을 증언했다. 장교망은 의심하지만 증인 없는 의혹을 원장에 올리지 않는다.",
          "en": "Testifies that medical-train weapons and the escort bidding box used the same cord. Suspects an officer network but will not register unsupported accusations."
        },
        "behavior": {
          "ko": "확인된 선택에서는 증거 없는 의혹 보류을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "의혹이 커져도 증인 확보 전 기록을 미룰 수 있다.",
          "en": "May postpone recording even urgent suspicions until witnesses exist."
        },
        "relationship": {
          "ko": "박태겸의 조사 시각과 문도윤의 게시를 증언에 맞춘다.",
          "en": "Aligns testimony with Park Taegyeom’s investigation times and Mun Doyun’s notices."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "교구 명부와 선거 봉인을 지켜 다음 대주교 비밀 선거의 절차와 명동역 인준이 끊기지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
