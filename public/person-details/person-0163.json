    "skills": [
      {
        "id": "k162-will-crosscheck",
        "name": {
          "ko": "유언 교차검증",
          "en": "Will cross-checking"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "k162-choice",
        "name": {
          "ko": "진본 선언을 보류",
          "en": "Withholds authenticity declarations"
        },
        "description": {
          "ko": "먹지 번짐을 사람 말보다 먼저 읽고, 증인 한 명의 확신은 기록으로 치지 않는다. 조용하나 필적이 어긋나면 자리에서 일어나지 않는다.",
          "en": "He read ink smears before human words and counted one witness's certainty as no record. Quiet, he did not rise from his seat for anything but a handwriting mismatch."
        },
        "behavior": {
          "ko": "일화. 봄의 세 유언이 같은 날 접수되자 홍예준은 세 장을 나란히 펼치고 진본 선언을 보류했다.",
          "en": "Anecdote. When the spring's three testaments were received on the same day, Hong Yejun spread the three sheets side by side and suspended the declaration of originals."
        },
        "stress": {
          "ko": "공포. 편집된 음성 한 조각이 문서 인준보다 먼저 나가 서기가 위조의 들러리가 되는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That one edited fragment of voice would go out before the document ratification, and the clerk would become the procession of forgery. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 윤서린의 인준 심사에 서기 원장을 바치고, 차세온의 필적 난외를 낮에 옮기며, 란세온의 내부 폭로를 봉인 증언으로만 받는다.",
          "en": "Relations. Offered the clerk's ledger to Yun Seorin's ratification examination, moved Cha Seon's handwriting margin by day, and took Ran Seon's inside exposure only as sealed testimony."
        },
        "effects": []
      },
      {
        "id": "k162-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 주사. 직함은 유언 검증 서기. 필적과 파형을 같은 책에 겹쳐 두고, 독립 증언이 둘 미만이면 검증 도장을 덮는다.",
          "en": "Office. Rank: registrar. Title: testament verification clerk. He laid handwriting and waveform overlaid in one book and covered the verification stamp with fewer than two independent testimonies."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 유언 검증 서기. 필적과 파형을 같은 책에 겹쳐 두고, 독립 증언이 둘 미만이면 검증 도장을 덮는다.",
          "en": "Office. Rank: registrar. Title: testament verification clerk. He laid handwriting and waveform overlaid in one book and covered the verification stamp with fewer than two independent testimonies."
        },
        "stress": {
          "ko": "공포. 편집된 음성 한 조각이 문서 인준보다 먼저 나가 서기가 위조의 들러리가 되는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That one edited fragment of voice would go out before the document ratification, and the clerk would become the procession of forgery. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 윤서린의 인준 심사에 서기 원장을 바치고, 차세온의 필적 난외를 낮에 옮기며, 란세온의 내부 폭로를 봉인 증언으로만 받는다.",
          "en": "Relations. Offered the clerk's ledger to Yun Seorin's ratification examination, moved Cha Seon's handwriting margin by day, and took Ran Seon's inside exposure only as sealed testimony."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "세 유언을 나란히 놓고 독립 증언 둘을 요구한다. 진본 판단은 아직 미결이며 소문을 곧 사실로 받아들이지 않는다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Sets three wills side by side and requires two independent witnesses. Authenticity remains unresolved, and rumor is not accepted as fact. Titles and ambitions are not treated as accomplished authority or results."
    },
