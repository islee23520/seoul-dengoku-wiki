    "skills": [
      {
        "id": "outpost-duty-handover",
        "name": {
          "ko": "초소 당직 인계",
          "en": "Outpost duty handover"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "초소를 집처럼 여긴다",
          "en": "Treats the outpost as home"
        },
        "description": {
          "ko": "당직과 봉화 시각을 함께 게시하나 공동승인 문서를 두라는 쪽지를 태운다. 공동 승인 준수 문장과 독자 거점 욕구의 충돌을 남긴다.",
          "en": "Duty and beacon times are posted together, yet a note requiring joint approval papers was burned. Stated joint checks conflict with a desire for a distinct outpost."
        },
        "behavior": {
          "ko": "초소 당직을 집처럼 여기고, 공동승인 문서를 초소에 두라는 쪽지를 태운다. 한 번 본 불빛을 교대 일지에 먼저 적는다.",
          "en": "He treated the outpost duty post as home and burned any note that told him to keep joint-approval papers at the outpost. A light he had seen once he wrote into the rotation log first."
        },
        "stress": {
          "ko": "공포. 초소 당직이 오인 봉화의 발판이 되어 고지와 교량이 같은 밤에 열리는 것.",
          "en": "Fear. That outpost duty would become the footstool of a mistaken beacon and the hill and the bridges would open on the same night."
        },
        "relationship": {
          "ko": "관계. 문하율의 초병 명령을 기지에서 집행하고, 판늘샘의 순찰 호각을 당직과 나눈다. 곽민재의 급수 점검을 감시 공백으로 여기지 않으려 일지를 겹친다.",
          "en": "Relations. Executed Mun Hayul's sentry orders at the base and shared the whistle with Pan Neulsaem's patrol. He overlapped the logs so Gwak Minjae's water inspections would not read as a watch gap."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 병장. 직함은 아관사 능선 초소 기지 당직장, 문하율의 실무 담당자. 당직 명과 봉화 시각을 같은 칠판에 붙이고, 외부 무장 접근은 양군의 공동 승인 없이 막는다.",
          "en": "Office. Rank: sergeant. Title: ridge outpost base duty chief, duty officer of Mun Hayul. He posted the duty roster and the beacon hours on one chalkboard and blocked armed outside approach without Go Seojun's escort."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 병장. 직함은 아관사 능선 초소 기지 당직장, 문하율의 실무 담당자. 당직 명과 봉화 시각을 같은 칠판에 붙이고, 외부 무장 접근은 양군의 공동 승인 없이 막는다.",
          "en": "Recorded duty and limits: Office. Rank: sergeant. Title: ridge outpost base duty chief, duty officer of Mun Hayul. He posted the duty roster and the beacon hours on one chalkboard and blocked armed outside approach without Go Seojun's escort."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 초소 당직이 오인 봉화의 발판이 되어 고지와 교량이 같은 밤에 열리는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That outpost duty would become the footstool of a mistaken beacon and the hill and the bridges would open on the same night."
        },
        "relationship": {
          "ko": "관계. 문하율의 초병 명령을 기지에서 집행하고, 판늘샘의 순찰 호각을 당직과 나눈다. 곽민재의 급수 점검을 감시 공백으로 여기지 않으려 일지를 겹친다.",
          "en": "Relations. Executed Mun Hayul's sentry orders at the base and shared the whistle with Pan Neulsaem's patrol. He overlapped the logs so Gwak Minjae's water inspections would not read as a watch gap."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "당직과 봉화 시각을 함께 게시하나 공동승인 문서를 두라는 쪽지를 태운다. 공동 승인 준수 문장과 독자 거점 욕구의 충돌을 남긴다.",
      "en": "Duty and beacon times are posted together, yet a note requiring joint approval papers was burned. Stated joint checks conflict with a desire for a distinct outpost."
    },
