    "skills": [
      {
        "id": "joint-transport-clause-transcription",
        "name": {
          "ko": "공동호송 조항 정서",
          "en": "Joint transport clause transcription"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "빈 교량 칸에는 붓을 멈춘다",
          "en": "Stops writing at a blank bridge clause"
        },
        "description": {
          "ko": "빠진 교량 조항 앞에서 보조 서명을 멈추고 의료 조항과 원장 번호를 맞췄다. 보조 문서 수행이지 독자 조약권은 아니다.",
          "en": "A blank bridge clause stopped a supporting signature; medical clauses and ledger numbers were aligned. This is supporting document work, not independent treaty power."
        },
        "behavior": {
          "ko": "먹물이 마르기 전의 구두 통과를 보조 서명으로 치지 않는다. 조용하나 교량 조항이 비면 붓을 내려놓는다.",
          "en": "He did not count a verbal passage, given before the ink dried, as an assistant signature. Quiet, he set the brush down whenever a bridge clause ran empty."
        },
        "stress": {
          "ko": "공포. 위조 정서본이 보조 함에 섞여 자신이 오인 봉화의 손이 되는 것.",
          "en": "Fear. That a forged fair copy would mix into the assistant box and he would become the hand of a mistaken beacon."
        },
        "relationship": {
          "ko": "관계. 초나루의 신내 서기 원장과 조항 번호를 맞추고, 창해온의 의료 조항을 교량 칸에 옮긴다. 고서준의 공동통치 날인만 보조 함의 열쇠로 둔다.",
          "en": "Relations. Matched article numbers with Cho Naru's Sinnae clerk ledger and moved Chang Haeon's medical articles into the bridge column. Allowed only Go Seojun's joint-rule stamp as the assistant box's key."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 공동실무원. 직함은 양군 공동호송 서명 보조. 보조 서명 시각과 증인 이름을 같은 줄에 적고, 양군 인장이 모두 없으면 함을 잠근다.",
          "en": "Office. Rank: sergeant. Title: joint convoy signing assistant. He wrote the assistant signing hour and the witness names on one line and locked the box with fewer than two stamps."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 공동실무원. 직함은 양군 공동호송 서명 보조. 보조 서명 시각과 증인 이름을 같은 줄에 적고, 양군 인장이 모두 없으면 함을 잠근다.",
          "en": "Recorded duty and limits: Office. Rank: sergeant. Title: joint convoy signing assistant. He wrote the assistant signing hour and the witness names on one line and locked the box with fewer than two stamps."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 위조 정서본이 보조 함에 섞여 자신이 오인 봉화의 손이 되는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That a forged fair copy would mix into the assistant box and he would become the hand of a mistaken beacon."
        },
        "relationship": {
          "ko": "관계. 초나루의 신내 서기 원장과 조항 번호를 맞추고, 창해온의 의료 조항을 교량 칸에 옮긴다. 고서준의 공동통치 날인만 보조 함의 열쇠로 둔다.",
          "en": "Relations. Matched article numbers with Cho Naru's Sinnae clerk ledger and moved Chang Haeon's medical articles into the bridge column. Allowed only Go Seojun's joint-rule stamp as the assistant box's key."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "빠진 교량 조항 앞에서 보조 서명을 멈추고 의료 조항과 원장 번호를 맞췄다. 보조 문서 수행이지 독자 조약권은 아니다.",
      "en": "A blank bridge clause stopped a supporting signature; medical clauses and ledger numbers were aligned. This is supporting document work, not independent treaty power."
    },
