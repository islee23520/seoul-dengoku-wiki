    "traits": [
      {
        "id": "k040-care-before-spoils",
        "name": {
          "ko": "전리품보다 진료",
          "en": "Care before spoils"
        },
        "description": {
          "ko": "필터를 쌓아 두는 장교를 피하고 배급이 비면 의무 배식을 연다.",
          "en": "Avoids filter-hoarding officers and opens medical meals when rations run out."
        },
        "behavior": {
          "ko": "필터를 쌓아 두는 장교를 피하고 배급이 비면 의무 배식을 연다.",
          "en": "Avoids filter-hoarding officers and opens medical meals when rations run out."
        },
        "stress": {
          "ko": "필터 원단이 동부 보호계약에 묶여 금천 작업반이 탁수와 분진 속에 방치되는 것.",
          "en": "That filter fabric would be bound to the eastern protection contract, and the Geumcheon work squads would be left in turbid water and dust."
        },
        "relationship": {
          "ko": "임채원의 필터 규격을 진료에 적용하는 사제에 가깝고, 한지온의 배급 솥이 비면 의무 배식을 열며, 최은재의 필터 인증 도장이 떨어지면 출고를 잠근다.",
          "en": "Near an apprentice applying Im Chaewon's filter standards to care, opening duty meals whenever Han Jion's ration pot ran empty, and locking releases whenever Choi Eunjae's filter certification stamp lapsed."
        },
        "effects": []
      },
      {
        "id": "k040-certified-release",
        "name": {
          "ko": "인증 뒤 출고",
          "en": "Release after certification"
        },
        "description": {
          "ko": "인증 도장이 없으면 필터 출고를 잠근다.",
          "en": "Blocks filter release without certification seals."
        },
        "behavior": {
          "ko": "인증 도장이 없으면 필터 출고를 잠근다.",
          "en": "Blocks filter release without certification seals."
        },
        "stress": {
          "ko": "필터 원단이 동부 보호계약에 묶여 금천 작업반이 탁수와 분진 속에 방치되는 것.",
          "en": "That filter fabric would be bound to the eastern protection contract, and the Geumcheon work squads would be left in turbid water and dust."
        },
        "relationship": {
          "ko": "임채원의 필터 규격을 진료에 적용하는 사제에 가깝고, 한지온의 배급 솥이 비면 의무 배식을 열며, 최은재의 필터 인증 도장이 떨어지면 출고를 잠근다.",
          "en": "Near an apprentice applying Im Chaewon's filter standards to care, opening duty meals whenever Han Jion's ration pot ran empty, and locking releases whenever Choi Eunjae's filter certification stamp lapsed."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "약재 배분과 필터 규격 적용이 확인된다. 분진 기침 관찰을 고난도 수술이나 전문 연구 숙련으로 환산하지 않는다.",
      "en": "Medicine allocation and applying filter standards are confirmed. Observing dust coughs does not grant advanced surgery or research proficiency."
    },
