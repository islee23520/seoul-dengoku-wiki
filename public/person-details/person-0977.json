    "traits": [
      {
        "id": "departure-check-disposition",
        "name": {
          "ko": "출발 조건 확인",
          "en": "Checks departure conditions"
        },
        "description": {
          "ko": "서명 없는 배차를 그대로 통과시키지 않는다.",
          "en": "Does not allow unsigned dispatch through."
        },
        "behavior": {
          "ko": "서명 없는 배차를 그대로 통과시키지 않는다.",
          "en": "Does not allow unsigned dispatch through."
        },
        "stress": {
          "ko": "당직 공백이 통행과 기록을 강국에 의존하게 할 것을 경계한다.",
          "en": "Fears vacant duty making passage and records dependent on great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Maintains handover ties with senior duty workers of the same living area."
        },
        "effects": []
      },
      {
        "id": "bounded-handover",
        "name": {
          "ko": "경계를 지키는 인계",
          "en": "Bounded handover"
        },
        "description": {
          "ko": "당직을 잇되 없는 권한을 만들지 않는다.",
          "en": "Keeps duty continuous without inventing authority."
        },
        "behavior": {
          "ko": "자기 열쇠와 기록만 넘긴다.",
          "en": "Hands over only duty keys and records."
        },
        "stress": {
          "ko": "당직 공백이 외부 의존으로 번질 것을 경계한다.",
          "en": "Fears vacant duty becoming dependence."
        },
        "relationship": {
          "ko": "선배 당직과 인수인계로 연결된다.",
          "en": "Maintains handover ties with senior duty workers of the same living area."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "배차표 없는 출발을 열차 제지로 막았다. 짧은 일화와 인계만으로 전문 지휘·전투·제도 성립을 추정하지 않는다.",
      "en": "Prevented undocumented departure by stopping the train. The short anecdote and handover do not establish expert command, combat or institutional success."
    },
