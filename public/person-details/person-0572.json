    "skills": [
      {
        "id": "k572-request-routing",
        "name": {
          "ko": "청탁 창구 회송",
          "en": "Request routing to public desk"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "k572-choice",
        "name": {
          "ko": "관문 편의를 사적으로 주지 않음",
          "en": "No private gate favors"
        },
        "description": {
          "ko": "일화. 2125년 사적 청탁을 돌려보내고 공개 창구로 보냈다. 이 일로 관문 당직 자리의 서명이 장부에 올랐다. 이 선택을 넘어선 지속 성향은 미확인이다.",
          "en": "Anecdote. In 2125 he sent a private petition back and passed it to the public window. By this deed the signature of the gate duty post rose into the ledger. A lasting disposition beyond this choice is unconfirmed."
        },
        "behavior": {
          "ko": "일화. 2125년 사적 청탁을 돌려보내고 공개 창구로 보냈다. 이 일로 관문 당직 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he sent a private petition back and passed it to the public window. By this deed the signature of the gate duty post rose into the ledger."
        },
        "stress": {
          "ko": "공포. 관문 당직 당직이 비면 동부 관문과 하남·남양주·의정부·연천의 속국 통행이 끊기는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That the gate duty duty post would stand empty and the State's passage would cuts the eastern gates and the vassal roads to Hanam, Namyangju, Uijeongbu and Yeoncheon. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k572-boundary",
        "name": {
          "ko": "당직 연속성을 중시",
          "en": "Values duty continuity"
        },
        "description": {
          "ko": "당직 공백을 피하고 기록을 믿는 원문 성향이다. 반복 문구이므로 개인의 특별한 장점으로 확대하지 않는다.",
          "en": "The source favors unbroken shifts and written records. Repeated wording does not establish a distinctive exceptional virtue."
        },
        "behavior": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "stress": {
          "ko": "공포. 관문 당직 당직이 비면 동부 관문과 하남·남양주·의정부·연천의 속국 통행이 끊기는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That the gate duty duty post would stand empty and the State's passage would cuts the eastern gates and the vassal roads to Hanam, Namyangju, Uijeongbu and Yeoncheon. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "일화. 2125년 사적 청탁을 돌려보내고 공개 창구로 보냈다. 이 일로 관문 당직 자리의 서명이 장부에 올랐다. 단일 일화와 반복 당직 문구만 있어 장기 성향·광범위 경력·후속 결과는 미확인이다.",
      "en": "Anecdote. In 2125 he sent a private petition back and passed it to the public window. By this deed the signature of the gate duty post rose into the ledger. Only one anecdote and repeated duty wording are available; enduring disposition, broader experience, and later results remain unconfirmed."
    },
