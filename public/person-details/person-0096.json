    "traits": [
      {
        "id": "challenge-hidden-sources",
        "name": {
          "ko": "출처 숨김 추궁",
          "en": "Challenge Hidden Sources"
        },
        "description": {
          "ko": "유하은은 원단과 기어의 출처를 숨기는 공방을 강하게 의심한다.",
          "en": "Yu Haeun is sharply suspicious of workshops that conceal the origins of fabric and gears."
        },
        "behavior": {
          "ko": "숨겨진 자재 출처를 집요하게 추궁하고 출고 수량을 직능 칠판에 공개한다.",
          "en": "Yu presses workshops about concealed material origins and publishes shipment quantities on the trade board."
        },
        "stress": {
          "ko": "보호계약이 원단을 군수용으로 묶을 우려가 커지면 자재 출처와 출고 내역의 공개를 더 요구할 수 있다.",
          "en": "If a protection contract threatens to bind fabric to military use, Yu may demand fuller disclosure of material origins and shipments."
        },
        "relationship": {
          "ko": "남윤경의 가격 원장이 성수 시세를 가로챈다고 판단하면 거래 협력보다 추궁과 불신이 앞설 수 있다.",
          "en": "If Yu judges Nam Yungyeong's price ledger to be capturing Seongsu prices, questioning and distrust may outweigh cooperation."
        },
        "effects": []
      },
      {
        "id": "civilian-packing-first",
        "name": {
          "ko": "민수 패킹 우선",
          "en": "Civilian Packing First"
        },
        "description": {
          "ko": "유하은은 군수 우선보다 생활 급수에 필요한 민수용 펌프 패킹을 지키려 한다.",
          "en": "Yu Haeun seeks to protect civilian pump packing needed for everyday water supply over routine military priority."
        },
        "behavior": {
          "ko": "군수 우선은 수비대의 누수 경보가 있을 때만 허용하고 경쟁하는 임채원과도 필터 패킹을 교환한다.",
          "en": "Yu permits military priority only under a guard leak warning and exchanges filter packing even with rival Im Chaewon."
        },
        "stress": {
          "ko": "원단이 군화 우선으로 묶여 민수 패킹이 사라질 위험이 커지면 민수 물량 확보에 더 완강해질 수 있다.",
          "en": "If boot-first fabric allocation threatens to eliminate civilian packing, Yu may become firmer about securing civilian quantities."
        },
        "relationship": {
          "ko": "임채원과 원자재를 다투더라도 필터 패킹 교환이 민수 공급을 지킨다면 협력을 이어갈 수 있다.",
          "en": "Despite competing with Im Chaewon over raw materials, Yu may preserve filter-packing exchanges when they sustain civilian supply."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "가죽 공정과 출고 수량을 공개하며 필터 패킹을 교환한다. 실제 공정·거래에 한정하며 소형 기어 제조 전체를 발급하지 않는다.",
      "en": "She discloses leather processes and release quantities and exchanges filter packing. Actual process and trade evidence supports the profile, not complete small-gear manufacturing mastery."
    },
