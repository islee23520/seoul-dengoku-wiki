    "traits": [
      {
        "id": "k175-disposition",
        "name": {
          "ko": "검수 없는 부품 거부",
          "en": "Rejecting untested parts"
        },
        "description": {
          "ko": "제동 마모로 야간 운행 거리를 읽고, 공구함 뚜껑을 열어 두는 도제를 교대에서 뺀다. 말수는 적고 시운전 소음으로 대답한다.",
          "en": "He read night-run distance from brake wear and struck from the rotation any apprentice who left the tool box open. Few of words, he answered with trial-run noise."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 용산창 제동 정비사. 출고 전 제동 두께를 칠판에 쓰고, 창동 시험 도장 없는 부품은 달지 않는다.",
          "en": "Office. Rank: registrar. Title: Yongsan warehouse brake mechanic. He wrote the brake thickness on the chalkboard before release and fitted no part without the Changdong trial stamp."
        },
        "stress": {
          "ko": "공포. 가문 창고의 환적 독점이 제동 부품까지 잠가 억류 열차가 창에 박히는 것.",
          "en": "Fear. That the house warehouse's transshipment monopoly would lock even the brake parts and the detained train would be nailed into the warehouse."
        },
        "relationship": {
          "ko": "관계. 아이작 워커의 정비 일지를 현장에서 집행하는 사제이고, 박태겸의 도제 경로를 창에서 받치며, 이홍원의 교환 수련 규격을 검수한다.",
          "en": "Relations. An apprentice executing Isaac Walker's maintenance logs in the field, he backed Park Taegyeom's apprentice route at the warehouse and inspected I Hongwon's exchange-training standards."
        },
        "effects": []
      },
      {
        "id": "k175-choice",
        "name": {
          "ko": "공구 규율",
          "en": "Tool discipline"
        },
        "description": {
