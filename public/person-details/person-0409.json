    "skills": [
      {
        "id": "ratification-messages",
        "name": {
          "ko": "비준 전갈 운송",
          "en": "Ratification message delivery"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "전달 전에 자격 확인",
          "en": "Checks eligibility before delivery"
        },
        "description": {
          "ko": "출석을 두 장소에 붙이고 군사호적이 섞이자 비준 전갈을 잠갔다. 숨이 차도 사본 두 장을 함께 운반한다.",
          "en": "Posts attendance in two places and locks ratification messages after military numbers appear. Carries both copies despite breathlessness."
        },
        "behavior": {
          "ko": "확인된 선택에서는 전달 전에 자격 확인을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "명부 혼입 때 전갈 전달을 멈출 수 있다.",
          "en": "May halt delivery when registers mix."
        },
        "relationship": {
          "ko": "안태경의 쪽지를 봉인 상태로 나르고 천늘우와 순번을 맞춘다.",
          "en": "Carries An Taegyeong’s notes sealed and matches order with Cheon Neulwoo."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "조합원 직접투표가 대외 교섭안 비준의 필수 날인이 되게 해 조합원 투표 없는 서명을 전령로에서 무효로 만든다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "투표 명부가 군사호적과 섞인 전갈 한 장으로 정동노총이 암사의 대리 투표장이 되는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "안태경의 쪽지를 봉인 상태로 나르고 천늘우와 순번을 맞춘다.",
          "en": "Carries An Taegyeong’s notes sealed and matches order with Cheon Neulwoo."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "출석을 두 장소에 붙이고 군사호적이 섞이자 비준 전갈을 잠갔다. 숨이 차도 사본 두 장을 함께 운반한다.",
      "en": "Posts attendance in two places and locks ratification messages after military numbers appear. Carries both copies despite breathlessness."
    },
