    "traits": [
      {
        "id": "k575-disposition",
        "name": {
          "ko": "배분을 앞세움",
          "en": "Distribution first"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 교도. 직함은 경매 서기.",
          "en": "Office. Rank: lay instructor. Title: auction clerk."
        },
        "stress": {
          "ko": "공포. 경매 서기 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the auction clerk duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k575-choice",
        "name": {
          "ko": "손실 공개 책임",
          "en": "Responsibility to disclose loss"
        },
        "description": {
          "ko": "일화. 2125년 썩기 시작한 곡물을 먼저 나눠 주고 손실 장부를 공개했다. 이 일로 경매 서기 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he distributed the grain that had begun to rot first and published the loss ledger. By this deed the signature of the auction clerk post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "stress": {
          "ko": "공포. 경매 서기 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the auction clerk duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "곡물 배분과 손실 공개를 함께 했다. 경매 서기 직함만으로 낙찰 심사나 경매 진행 숙련을 만들지 않았다.",
      "en": "Combines grain distribution with loss disclosure. The auction-clerk title does not grant award review or auction-running skill."
    },
