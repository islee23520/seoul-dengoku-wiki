    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "서명 역할 분리",
          "en": "Separates signature roles"
        },
        "description": {
          "ko": "빈 교대 서명을 역순으로 찾아 당직을 확인하고 조정인 도장과 보조 서명을 분리했다.",
          "en": "Traces missing shift signatures backward and separates auxiliary signatures from the mediator’s stamp."
        },
        "behavior": {
          "ko": "확인된 선택에서는 서명 역할 분리을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "누락이 나오면 교대 순서를 거꾸로 짚을 수 있다.",
          "en": "May retrace shifts backward after a gap."
        },
        "relationship": {
          "ko": "남윤경의 조정 도장과 보조 서명을 겹치지 않게 둔다.",
          "en": "Keeps auxiliary signatures separate from Nam Yungyeong’s mediation stamp."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "교구 인수인계 장부를 지켜 교황 없는 선거를 둘러싼 다툼에도 명동역의 인준이 이어지게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "다음 대주교 선거의 혼란 속에 자신이 맡은 명동역 인준 명부 당직 장부의 서명이 사라지는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "남윤경의 조정 도장과 보조 서명을 겹치지 않게 둔다.",
          "en": "Keeps auxiliary signatures separate from Nam Yungyeong’s mediation stamp."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "빈 교대 서명을 역순으로 찾아 당직을 확인하고 조정인 도장과 보조 서명을 분리했다.",
      "en": "Traces missing shift signatures backward and separates auxiliary signatures from the mediator’s stamp."
