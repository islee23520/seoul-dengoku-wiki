    "traits": [
      {
        "id": "k537-action-priority",
        "name": {
          "ko": "매복을 먼저 읽는다",
          "en": "Read the ambush first"
        },
        "description": {
          "ko": "2125년 능선 초계 중 매복 흔적을 먼저 읽어 피해를 막았다.",
          "en": "In 2125, on a ridge patrol, he read the ambush traces first and prevented the harm. By this deed the signature of the power installation patrol post rose into the ledger."
        },
        "behavior": {
          "ko": "2125년 능선 초계 중 매복 흔적을 먼저 읽어 피해를 막았다.",
          "en": "In 2125, on a ridge patrol, he read the ambush traces first and prevented the harm. By this deed the signature of the power installation patrol post rose into the ledger."
        },
        "stress": {
          "ko": "전력장치 순찰대 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the power installation patrol duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k537-bounded-handover",
        "name": {
          "ko": "기록으로 잇는 당직",
          "en": "Duty linked by records"
        },
        "description": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "behavior": {
