    "traits": [
      {
        "id": "continuity-through-transcription",
        "name": {
          "ko": "필사로 연결",
          "en": "Continuity Through Transcription"
        },
        "description": {
          "ko": "주바인은 젖은 인준 문서의 내용을 필사본으로 이어 남기는 편이다.",
          "en": "Ju Bain favors carrying the contents of a wet approval document forward through a handwritten copy."
        },
        "behavior": {
          "ko": "승강장에서 물에 젖은 인준 문서를 말려 필사본으로 남겼다.",
          "en": "Ju Bain dried a water-soaked approval document on the platform and preserved a handwritten copy."
        },
        "stress": {
          "ko": "문서 손상이 장부의 연결을 위협하면 남길 수 있는 내용을 필사로 보전하려 할 수 있다.",
          "en": "If document damage threatens ledger continuity, Ju Bain may preserve recoverable contents through transcription."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 필사본을 통해 손상된 문서의 내용을 이어 전달하려 할 수 있다.",
          "en": "In handovers with senior duty staff, Ju Bain may use the handwritten copy to pass on the damaged document's contents."
        },
        "effects": []
      },
      {
        "id": "preserve-keys-and-records",
        "name": {
          "ko": "열쇠와 기록 보존",
          "en": "Preserve Keys and Records"
        },
        "description": {
          "ko": "주바인은 자기 직위의 열쇠와 기록을 다음 당직으로 잇는 것을 중시한다.",
          "en": "Ju Bain values carrying the position's keys and records forward to the next duty holder."
        },
        "behavior": {
          "ko": "젖은 문서를 필사본으로 남기고 자기 직위에 속한 열쇠와 기록만 인계한다.",
          "en": "Ju Bain preserves a handwritten copy of the wet document and transfers only the position's keys and records."
        },
        "stress": {
          "ko": "당직 공백으로 통행이 볼모가 될까 우려하면 기록의 손실과 인계 단절을 더 경계할 수 있다.",
          "en": "Fear that a duty gap could leave passage hostage may heighten vigilance against record loss and broken handovers."
        },
        "relationship": {
          "ko": "선배 당직과는 남겨진 기록과 직위의 열쇠를 통해 인계의 연속성을 지키려 할 수 있다.",
          "en": "With senior duty staff, Ju Bain may maintain handover continuity through preserved records and the position's keys."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "젖은 문서의 필사본을 남겼다. 문서 복구와 장부 정정 이력만 근거로 쓰며 농업 숙련은 보류한다.",
      "en": "He produced a copy of a wet document. Document recovery and ledger correction are supported; farming skill remains unissued."
    },
