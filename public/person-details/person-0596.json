    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "수정에 서명을 남긴다",
          "en": "Signs corrections"
        },
        "description": {
          "ko": "이중 지급을 대조해 한 줄을 지우고 서명했다. 기록 처리의 좁은 강점이며 방역 전문성은 직함에서 부여하지 않는다.",
          "en": "A duplicate payment was reconciled, removed, and signed. This is a narrow record-handling strength, not sanitation expertise bestowed by title."
        },
        "behavior": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다. 제기동의 중립 의료국 흰십자단에서 담당 전문의의 도제로 배우며, 적아 구분 없이 중증도만으로 치료한다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "stress": {
          "ko": "공포. 방역 수련의 당직이 비면 흰십자단의 통행이 강국 볼모가 되는 것.",
          "en": "Fear. That the quarantine registrar duty post would stand empty and the League's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 수련의. 직함은 방역 수련의. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: member. Title: quarantine registrar. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 수련의. 직함은 방역 수련의. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Recorded duty and limits: Office. Rank: member. Title: quarantine registrar. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 방역 수련의 당직이 비면 흰십자단의 통행이 강국 볼모가 되는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That the quarantine registrar duty post would stand empty and the League's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
