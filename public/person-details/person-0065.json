    "traits": [
      {
        "id": "stop-without-enough-witnesses",
        "name": {
          "ko": "증인 부족에 중지",
          "en": "Stop Without Enough Witnesses"
        },
        "description": {
          "ko": "임시온은 안전심사 날인만으로 열람을 허용하지 않고 독립 증인 두 명을 요구한다.",
          "en": "Im Sion requires two independent witnesses rather than allowing access on a safety-review stamp alone."
        },
        "behavior": {
          "ko": "증인이 한 명뿐인 열람을 멈추고 열람증의 발급 경로를 추적한다.",
          "en": "He stops access supported by only one witness and traces the access permit’s issuance route."
        },
        "stress": {
          "ko": "위조 열람증이 서고를 선전 자료로 바꿀 우려가 있다면 증인 요건과 발급 경로 확인을 더 엄격히 할 수 있다.",
          "en": "If a forged permit could turn the archive into propaganda material, he may enforce witness requirements and issuance checks more strictly."
        },
        "relationship": {
          "ko": "열람 요청이 증인 요건을 채우지 못한다면 정호준의 재현 기록 원칙을 공유하더라도 허용하지 않을 수 있다.",
          "en": "He may refuse an access request lacking sufficient witnesses even when the requester shares Jeong Hojun’s reproducible-record principle."
        },
        "effects": []
      },
      {
        "id": "independent-original-preservation",
        "name": {
          "ko": "원본 독립 보존",
          "en": "Independent Original Preservation"
        },
        "description": {
          "ko": "임시온은 검증 가능한 원본을 군사 감독과 선전 용도에서 분리해 보존하려 한다.",
          "en": "Im Sion seeks to preserve verifiable originals separately from military oversight and propaganda uses."
        },
        "behavior": {
          "ko": "군사 감독 문서를 서고 바깥 별치함으로 옮기고 감시 기록을 봉쇄 증거로 보관한다.",
          "en": "He moves military oversight documents to an external separate box and retains monitoring records as blockade evidence."
        },
        "stress": {
          "ko": "위조 문서가 지식의 검증 가능성을 무너뜨릴 위험이 있다면 원본 보존과 감사 가능한 대여 기록을 우선할 수 있다.",
          "en": "If forged documents threaten the verifiability of knowledge, he may prioritize original preservation and auditable lending records."
        },
        "relationship": {
          "ko": "공개 시점에 의견이 달라도 원본 보존이 위협받는다면 최지우와 협력할 수 있다.",
          "en": "He may cooperate with Choi Jiwoo when original preservation is threatened despite differences over publication timing."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "증인이 부족한 열람을 중지하고 발급 경로를 조사했다. 기록 통제와 추적을 평가하며 암호 해독 능력은 추가하지 않는다.",
      "en": "He stopped access with missing witnesses and traced permit issuance. Record controls and provenance checks are supported, not cryptanalysis."
    },
