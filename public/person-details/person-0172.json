    "traits": [
      {
        "id": "k171-disposition",
        "name": {
          "ko": "시간 준수에 엄격함",
          "en": "Strict about timing"
        },
        "description": {
          "ko": "실리적이나 시각표를 어기는 사람을 가혹하게 다룬다. 어느 진영 열차든 시간을 지키면 얼굴을 가리지 않는다.",
          "en": "Pragmatic, she dealt harshly with anyone who broke the timetable. Any faction's train, if it kept its hour, she took without asking its face."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 열차 배차원. 상호 인질 대신 도제 탑승을 증명으로 받고, 편도만 온 열차는 창에서 하루를 묶는다.",
          "en": "Office. Rank: registrar. Title: train dispatcher. She took apprentice boarding instead of mutual hostages as proof and held one-way trains at the warehouse for a day."
        },
        "stress": {
          "ko": "공포. 한재목의 철도계약이 독점 조항으로 바뀌어 배차권이 수문 아래로 빨려 들어가는 것.",
          "en": "Fear. That Han Jaemok's rail contract would turn into a monopoly clause and the dispatch authority would be sucked under the water gates."
        },
        "relationship": {
          "ko": "관계. 박태겸의 지휘로 한재목의 서부 철도계약을 운용한다. 오서율에게 계약 공증을 맡기고, 루카스 슈나이더와 창고 환적 순서를 나눈다.",
          "en": "Relations. Ran Han Jaemok's western rail contract under Park Taegyeom's command. Left the contract notarization to Oh Seoyul and split the warehouse transshipment order with Lukas Schneider."
        },
        "effects": []
      },
      {
        "id": "k171-choice",
        "name": {
          "ko": "진영보다 운행 조건",
          "en": "Operating terms before faction"
        },
        "description": {
          "ko": "일화. 뚝섬 급수계약 만료 소식이 용산 배차판에 붙자 서부 급수열차가 창 점유를 하루 더 요구했다.",
          "en": "Anecdote. When the news of the Ttukseom water contract's expiry was pasted on the Yongsan dispatch board, the western water train demanded one more day of warehouse occupation."
        },
        "behavior": {
          "ko": "관계. 박태겸의 지휘로 한재목의 서부 철도계약을 운용한다. 오서율에게 계약 공증을 맡기고, 루카스 슈나이더와 창고 환적 순서를 나눈다.",
          "en": "Relations. Ran Han Jaemok's western rail contract under Park Taegyeom's command. Left the contract notarization to Oh Seoyul and split the warehouse transshipment order with Lukas Schneider."
        },
        "stress": {
          "ko": "공포. 한재목의 철도계약이 독점 조항으로 바뀌어 배차권이 수문 아래로 빨려 들어가는 것.",
          "en": "Fear. That Han Jaemok's rail contract would turn into a monopoly clause and the dispatch authority would be sucked under the water gates."
        },
        "relationship": {
          "ko": "관계. 박태겸의 지휘로 한재목의 서부 철도계약을 운용한다. 오서율에게 계약 공증을 맡기고, 루카스 슈나이더와 창고 환적 순서를 나눈다.",
          "en": "Relations. Ran Han Jaemok's western rail contract under Park Taegyeom's command. Left the contract notarization to Oh Seoyul and split the warehouse transshipment order with Lukas Schneider."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "탑승 증명을 인질 대신 받고 편도 열차를 묶는다. 계약과 환적 순서를 운용하지만 창 점유 요구를 해결한 성과는 미확인이다.",
      "en": "She accepts boarding proof instead of hostages and holds one-way trains. She administers contract and transfer order; resolution of the siding claim is unconfirmed."
    },
