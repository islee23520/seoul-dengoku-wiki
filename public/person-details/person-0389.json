    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "표결 집행 중시",
          "en": "Enforces collective votes"
        },
        "description": {
          "ko": "봉쇄 표결 뒤 청과 저울을 사흘 잠갔다. 품목을 맞추고 교섭 조항을 찾지만 봉쇄가 구휼에 미친 결과는 기록되지 않았다.",
          "en": "Locks the produce scales for three days after the blockade vote. Coordinates goods and seeks bargaining clauses; consequences for relief remain undocumented."
        },
        "behavior": {
          "ko": "확인된 선택에서는 표결 집행 중시을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "흉작 소문 앞에서 거래를 잠그는 쪽으로 기울 수 있다.",
          "en": "May lean toward suspending trade amid harvest rumors."
        },
        "relationship": {
          "ko": "남시윤의 표결을 집행하며 천나솔과 저울을 맞춘다.",
          "en": "Enforces Nam Siyun’s vote and coordinates scales with Cheon Nasol."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "사제단 소집 봉인을 지켜 다음 대주교 비밀 선거의 절차와 명동역 인준이 끊기지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "사제단 소집 봉인이 지워져 교황 없는 선출의 정당성 논쟁에서 자신의 서명이 의심받는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "남시윤의 표결을 집행하며 천나솔과 저울을 맞춘다.",
          "en": "Enforces Nam Siyun’s vote and coordinates scales with Cheon Nasol."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "봉쇄 표결 뒤 청과 저울을 사흘 잠갔다. 품목을 맞추고 교섭 조항을 찾지만 봉쇄가 구휼에 미친 결과는 기록되지 않았다.",
      "en": "Locks the produce scales for three days after the blockade vote. Coordinates goods and seeks bargaining clauses; consequences for relief remain undocumented."
    },
