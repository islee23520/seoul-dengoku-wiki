      }
    ],
    "traits": [
      {
        "id": "review-incorrect-reports",
        "name": {
          "ko": "틀린 보고 재검토",
          "en": "Review Incorrect Reports"
        },
        "description": {
          "ko": "고유진은 훈련의 최초 보고가 틀렸을 때 검토를 다시 여는 성향을 보인다.",
          "en": "Go Yujin shows a willingness to reopen review when an initial training report proves incorrect."
        },
        "behavior": {
          "ko": "교량 습격 훈련의 최초 보고 오류 뒤 참관 칸을 다시 열었다.",
          "en": "After the initial report in a bridge-attack exercise proved wrong, he reopened the observation slot."
        },
        "stress": {
          "ko": "보고 오류가 당직 연속성과 통행을 위협한다고 느끼면 최초 판단을 재검토하려 할 수 있다.",
          "en": "If a reporting error appears to threaten duty continuity and passage, he may revisit the initial assessment."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때는 틀린 최초 보고를 확정 사실처럼 넘기지 않으려 할 수 있다.",
          "en": "During handover, he may avoid presenting the incorrect initial report to the senior duty holder as settled fact."
        },
        "effects": []
      },
      {
        "id": "reopen-observation-channels",
        "name": {
          "ko": "참관 창구 다시 열기",
          "en": "Reopen Observation Channels"
        },
        "description": {
          "ko": "고유진은 보고의 신뢰가 흔들리면 참관을 통한 재확인을 허용하는 성향을 보인다.",
          "en": "Go Yujin shows an inclination to allow renewed observation when a report loses credibility."
        },
        "behavior": {
          "ko": "틀린 최초 보고 뒤 닫혀 있던 참관 칸을 다시 열어 훈련을 확인할 여지를 만들었다.",
          "en": "He reopened the observation slot after the incorrect initial report, allowing the exercise to be checked again."
        },
        "stress": {
          "ko": "당직 공백과 통행 종속을 우려하는 상황에서는 잘못된 보고를 유지하기보다 참관 재개를 택할 수 있다.",
          "en": "When concerned about a duty gap and dependent passage, he may favor renewed observation over retaining a flawed report."
        },
        "relationship": {
          "ko": "선배 당직과는 재개한 참관의 경위를 인계하며 같은 확인 근거를 공유하려 할 수 있다.",
          "en": "He may share the grounds for renewed observation with the senior duty holder during handover."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "교량 훈련의 틀린 최초 보고 뒤 참관을 재개했다. 훈련 검토 경험은 있으나 실전 승리로 환산하지 않는다.",
      "en": "She reopened observer access after an incorrect initial exercise report. Exercise review is supported, not combat victory."
    },
