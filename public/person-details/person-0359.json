    "skills": [
      {
        "id": "approval-notice-delivery",
        "name": {
          "ko": "승인 전갈 전달",
          "en": "Approval notice delivery"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "진본 전갈만 나른다",
          "en": "Carries verified notices"
        },
        "description": {
          "ko": "서로 다른 면제 전갈을 잠그고 진본 대조를 요구했다. 봉인 운송과 문서 분별은 확인되지만 최종 진위 판정은 없다.",
          "en": "Conflicting exemption notices were locked away pending authenticity comparison. Sealed delivery and scrutiny are supported, not a final authenticity finding."
        },
        "behavior": {
          "ko": "봉인 끈이 느슨하면 출발을 거부하고, 빈 면제 칸이 찍힌 전갈을 사고 원인으로 본다. 숫자와 인장을 사람 말보다 믿는다.",
          "en": "She refused departure whenever a seal cord sat loose and read a dispatch stamped with an empty exemption column as a cause of accidents. She trusted numbers and stamps over people's words."
        },
        "stress": {
          "ko": "공포. 세 강국의 서로 다른 면제 전갈이 같은 주에 붙어 세리가 일방의 군사 비용 징수원으로 찍히는 것.",
          "en": "Fear. That three great powers' different exemption dispatches, pasted in the same week, would stamp the customs officer a protection-money collector."
        },
        "relationship": {
          "ko": "관계. 하윤목의 관문 원장을 봉인 상태로만 나르는 지휘를 받고, 영한뫼의 통과 원장과 순번을 나눈다. 정유라의 손실보상 조항을 전갈 말미에 옮기려 한다.",
          "en": "Relations. Under command to carry Ha Yunmok's gate ledger only under seal, he shared order with Yeong Hanmoe's passage ledger. Sought to move Jeong Yura's loss-compensation clause into the tail of the dispatches."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 공동실무원. 직함은 양군 승인 전령, 하윤목의 실무 담당자. 통과 품목과 급수 시간을 같은 전갈에 적고, 군사 면제는 양군 결재와 계약감사 문구가 있는 통행증만 배달한다.",
          "en": "Office. Rank: sergeant. Title: gate joint-approval courier, duty officer of Ha Yunmok. He wrote the passage items and the water-supply hours on the same dispatch and delivered military exemptions only on passage permits bearing an audit clause."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 공동실무원. 직함은 양군 승인 전령, 하윤목의 실무 담당자. 통과 품목과 급수 시간을 같은 전갈에 적고, 군사 면제는 양군 결재와 계약감사 문구가 있는 통행증만 배달한다.",
          "en": "Recorded duty and limits: Office. Rank: sergeant. Title: gate joint-approval courier, duty officer of Ha Yunmok. He wrote the passage items and the water-supply hours on the same dispatch and delivered military exemptions only on passage permits bearing an audit clause."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 세 강국의 서로 다른 면제 전갈이 같은 주에 붙어 세리가 일방의 군사 비용 징수원으로 찍히는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That three great powers' different exemption dispatches, pasted in the same week, would stamp the customs officer a protection-money collector."
        },
        "relationship": {
          "ko": "관계. 하윤목의 관문 원장을 봉인 상태로만 나르는 지휘를 받고, 영한뫼의 통과 원장과 순번을 나눈다. 정유라의 손실보상 조항을 전갈 말미에 옮기려 한다.",
          "en": "Relations. Under command to carry Ha Yunmok's gate ledger only under seal, he shared order with Yeong Hanmoe's passage ledger. Sought to move Jeong Yura's loss-compensation clause into the tail of the dispatches."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "서로 다른 면제 전갈을 잠그고 진본 대조를 요구했다. 봉인 운송과 문서 분별은 확인되지만 최종 진위 판정은 없다.",
      "en": "Conflicting exemption notices were locked away pending authenticity comparison. Sealed delivery and scrutiny are supported, not a final authenticity finding."
    },
