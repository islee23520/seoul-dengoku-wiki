    "skills": [
      {
        "id": "closure",
        "name": {
          "ko": "위험 구간 폐쇄",
          "en": "Hazardous-route closure"
        },
        "rating": 45
      },
      {
        "id": "departure",
        "name": {
          "ko": "배차표·출발 확인",
          "en": "Departure and dispatch checks"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "act-on-hazard-reports",
        "name": {
          "ko": "위험 보고 실행",
          "en": "Act on Hazard Reports"
        },
        "description": {
          "ko": "우금민은 붕괴 보고를 남기는 데 그치지 않고 구간 폐쇄로 연결하는 편이다.",
          "en": "U Geummin favors linking a collapse report to section closure rather than leaving it as a report alone."
        },
        "behavior": {
          "ko": "침수 구간 붕괴 보고를 미루지 않고 당장 폐쇄했다.",
          "en": "U Geummin did not delay the flooded-section collapse report and immediately closed the section."
        },
        "stress": {
          "ko": "위험 보고와 통행 지속이 충돌한다면 보고에 따른 폐쇄를 우선할 수 있다.",
          "en": "If a hazard report conflicts with continued passage, U Geummin may prioritize closure in response to the report."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 보고 내용과 실제 폐쇄 조치를 함께 전달하려 할 수 있다.",
          "en": "During handovers with senior duty staff, U Geummin may convey both the report and the closure action."
        },
        "effects": []
      },
      {
        "id": "handover-through-records",
        "name": {
          "ko": "기록으로 인계",
          "en": "Handover Through Records"
        },
        "description": {
          "ko": "우금민은 큰소리보다 장부를 믿고 기록을 통해 당직을 잇는 편이다.",
          "en": "U Geummin trusts the ledger over loud assertions and favors connecting duty through records."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 넘겨 장부가 끊기지 않도록 잇는다.",
          "en": "U Geummin transfers only the position's keys and records to keep the ledger connected."
        },
        "stress": {
          "ko": "당직 공백이 통행을 볼모로 만들까 우려하면 인계 기록의 연속성을 더 살필 수 있다.",
          "en": "Fear that a duty gap could leave passage hostage may increase attention to continuity in handover records."
        },
        "relationship": {
          "ko": "선배 당직과는 구두 확신보다 넘겨줄 기록을 인계의 근거로 삼을 수 있다.",
          "en": "With senior duty staff, U Geummin may base handovers on transferable records rather than verbal assurances."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "붕괴 보고 뒤 폐쇄를 실행했다. 보고와 조건 집행의 한정된 근거이며 재난 전략가로 읽지 않는다.",
      "en": "She acted on a collapse report by closing the route. Limited reporting and enforcement evidence does not make her a disaster strategist."
    },
