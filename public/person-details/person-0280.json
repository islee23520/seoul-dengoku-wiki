    "traits": [
      {
        "id": "k279-priority",
        "name": {
          "ko": "부상 먼저",
          "en": "Injury before nationality"
        },
        "description": {
          "ko": "봉복은 작업 조와 순찰 교대의 부상을 돌보고 사고 활력을 게시한다. 하룻밤 넘긴 당직은 체력 근거지만 신체 건강 판정은 아니다.",
          "en": "Bongbok treats crew and patrol injuries and posts accident vital signs. Extended overnight duty supports endurance, not an assessment of bodily health."
        },
        "behavior": {
          "ko": "사고 활력 기록을 의무실 문에 붙이고, 야간 수술은 반장과 도제의 서명이 함께 있어야 시작한다.",
          "en": "Office. Rank: assistant manager. Title: base medic. He pasted accident vital records on the infirmary door and started night surgery only with the squad leader's and the apprentice's signatures together."
        },
        "stress": {
          "ko": "제동 불량 부상자가 사택 민병 병상으로 옮겨져 기지 사고가 인구 분쟁으로 바뀌는 것.",
          "en": "Fear. That a casualty of bad brakes would be moved to a residential militia sickbed and a base accident would turn into a population dispute."
        },
        "relationship": {
          "ko": "조우찬의 작업 조 부상을 맡고, 권도하의 북문 순찰 교대를 진료한다. 전미리의 의료열차가 강남역에 설 때 병상을 비워 둔다.",
          "en": "Relations. Took Jo Woochan's work-squad injuries and treated Gwon Doha's north gate patrol rotations. Emptied sickbeds whenever Jeon Miri's medical train stopped at Changdong."
        },
        "effects": []
      },
      {
        "id": "k279-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 사원. 직함은 강남역 사택 의무원. 사고 활력 기록을 의무실 문에 붙이고, 야간 수술은 반장과 도제의 서명이 함께 있어야 시작한다.",
          "en": "Office. Rank: assistant manager. Title: base medic. He pasted accident vital records on the infirmary door and started night surgery only with the squad leader's and the apprentice's signatures together."
        },
        "stress": {
          "ko": "공포. 제동 불량 부상자가 사택 민병 병상으로 옮겨져 기지 사고가 인구 분쟁으로 바뀌는 것.",
          "en": "Fear. That a casualty of bad brakes would be moved to a residential militia sickbed and a base accident would turn into a population dispute."
        },
        "relationship": {
          "ko": "관계. 조우찬의 작업 조 부상을 맡고, 권도하의 북문 순찰 교대를 진료한다. 전미리의 의료열차가 강남역에 설 때 병상을 비워 둔다.",
          "en": "Relations. Took Jo Woochan's work-squad injuries and treated Gwon Doha's north gate patrol rotations. Emptied sickbeds whenever Jeon Miri's medical train stopped at Changdong."
        },
        "effects": []
      }
    ],
