    "traits": [
      {
        "id": "check-defects-before-derailment",
        "name": {
          "ko": "탈선 전 결함 확인",
          "en": "Check Defects Before Derailment"
        },
        "description": {
          "ko": "고별호는 직접 확인한 차륜 결함을 열차 정지 판단에 반영하는 성향을 보인다.",
          "en": "Go Byeolho shows a tendency to base a train-stop decision on a directly checked wheel defect."
        },
        "behavior": {
          "ko": "탈선 직전 바퀴 결함을 손으로 확인하고 열차를 세웠다.",
          "en": "He checked a wheel defect by touch immediately before derailment and stopped the train."
        },
        "stress": {
          "ko": "당직 공백과 통행 종속을 우려하는 상황에서는 확인된 결함을 방치하지 않으려 할 수 있다.",
          "en": "When concerned about a duty gap and dependent passage, he may be reluctant to leave a verified defect unaddressed."
        },
        "relationship": {
          "ko": "선배 당직에게는 바퀴에서 확인한 결함과 열차를 멈춘 이유를 구체적으로 인계하려 할 수 있다.",
          "en": "He may give the senior duty holder a concrete account of the wheel defect and the reason for stopping the train."
        },
        "effects": []
      },
      {
        "id": "fact-based-handover",
        "name": {
          "ko": "사실로 인계",
          "en": "Fact-Based Handover"
        },
        "description": {
          "ko": "고별호는 큰소리보다 기록과 직접 확인한 사실에 인계의 무게를 두는 성향이다.",
          "en": "Go Byeolho gives handover weight to records and directly verified facts rather than loud assertions."
        },
        "behavior": {
          "ko": "직접 확인한 바퀴 결함으로 열차를 세우고 자기 직위의 열쇠와 기록을 넘긴다.",
          "en": "He stops the train on a directly verified wheel defect and hands over his post's keys and records."
        },
        "stress": {
          "ko": "당직 공백이 통행을 위태롭게 할까 우려되면 추정보다 확인된 결함과 조치 기록에 의지할 수 있다.",
          "en": "If a duty gap threatens passage, he may rely on the verified defect and action record rather than speculation."
        },
        "relationship": {
          "ko": "선배 당직과는 결함의 확인 내용과 정지 조치를 공유해 인계의 근거를 분명히 하려 할 수 있다.",
          "en": "He may clarify handover grounds with the senior duty holder by sharing what was verified and why the train was stopped."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "차륜 결함을 확인해 탈선 직전 열차를 멈췄다. 검사 경험이며 공학 교육 경력이나 광역 물류망 운영은 없다.",
      "en": "He identified a wheel defect and stopped a train before derailment. Inspection experience is supported, not an engineering education or regional logistics control."
    },
