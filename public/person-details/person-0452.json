  "relations": {
    "outgoing": [
      {
        "from": "심다현",
        "type": "계약",
        "to": "라세영",
        "basis": "심다현은 방역 당직을 넘길 때 출입 기록과 젖은 문서에서 보존한 필사본을 라세영에게 가져간다. 라세영은 격리 출입 도장과 해제 기록을 확인하며 심다현과 함께 누락을 찾고, 수질·약효 기록이 도착한 뒤 해제를 판단한다."
      }
    ],
