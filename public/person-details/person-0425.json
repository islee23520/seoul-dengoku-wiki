    "skills": [
      {
        "id": "k425-hazard-closure",
        "name": {
          "ko": "붕괴 구간 폐쇄",
          "en": "Collapse-zone closure"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "k425-action-priority",
        "name": {
          "ko": "보고를 미루지 않는다",
          "en": "Do not delay reports"
        },
        "description": {
          "ko": "2125년 침수 구간 붕괴 보고를 미루지 않고 당장 폐쇄했다.",
          "en": "In 2125 he did not sit on the collapse report of a flooded section and closed it on the spot. By this deed the signature of the work-squad courier post rose into the ledger."
        },
        "behavior": {
          "ko": "2125년 침수 구간 붕괴 보고를 미루지 않고 당장 폐쇄했다.",
          "en": "In 2125 he did not sit on the collapse report of a flooded section and closed it on the spot. By this deed the signature of the work-squad courier post rose into the ledger."
        },
        "stress": {
          "ko": "작업반 전령 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the work-squad courier duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k425-bounded-handover",
        "name": {
          "ko": "기록으로 잇는 당직",
          "en": "Duty linked by records"
        },
        "description": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "behavior": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "stress": {
          "ko": "작업반 전령 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the work-squad courier duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "2125년 침수 구간 붕괴 보고를 미루지 않고 당장 폐쇄했다. 짧은 행위와 인수인계가 근거여서 다른 분야의 숙련이나 보정은 발급하지 않았다.",
      "en": "In 2125 he did not sit on the collapse report of a flooded section and closed it on the spot. By this deed the signature of the work-squad courier post rose into the ledger. The brief action and handover support only limited strengths; no unrelated proficiency or numeric trait bonus is issued."
    },
