    "skills": [
      {
        "id": "k163-claim-testimony",
        "name": {
          "ko": "청구서 증언 대조",
          "en": "Claim and testimony comparison"
        },
        "rating": 60
      },
      {
        "id": "k163-bypass-operation",
        "name": {
          "ko": "우회 급수 개통",
          "en": "Bypass supply opening"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "k163-choice",
        "name": {
          "ko": "구두 연장을 거부",
          "en": "Rejects verbal extensions"
        },
        "description": {
          "ko": "만료일을 손가락으로 세고, 구두로 연장하자는 사신을 증인석에서 내려보낸다. 숫자는 믿되 빈칸 조항은 믿지 않는다.",
          "en": "She counted expiry days on her fingers and sent down from the witness stand any envoy who proposed a verbal extension. She trusted numbers but not blank clauses."
        },
        "behavior": {
          "ko": "일화. 2125년 동파 관로를 녹이는 대신 우회 급수로를 열었다. 이 일로 급수계약 인준 청구 증인 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125, instead of thawing the frozen pipes, she opened a bypass waterway. By this deed the signature of the water contract ratification claim witness post rose into the ledger."
        },
        "stress": {
          "ko": "공포. 자신이 서명한 증언이 집단 단수 조항의 면죄부가 되는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That testimony she signed would become the indulgence of a collective cutoff clause. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 오서율의 공증 청구를 증인석에서 받치고, 한재목의 서부 문안을 읽어 주며, 임하준의 실종 뒤에 남은 만료 표시를 증언의 뼈대로 삼는다.",
          "en": "Relations. Backed O Seoyul's notarization claim from the witness stand, read Han Jaemok's western draft aloud, and made the expiry marks Im Hajun left behind after his disappearance the frame of her testimony."
        },
        "effects": []
      },
      {
        "id": "k163-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 주사. 직함은 급수계약 인준 청구 증인. 청구서와 증인 진술을 같은 시각에 붙이고, 인장이 마르기 전의 사본은 증언에서 뺀다.",
          "en": "Office. Rank: registrar. Title: water contract ratification claim witness. She pasted the claims and witness statements at the same hour and struck copies taken before the stamps dried from her testimony."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 급수계약 인준 청구 증인. 청구서와 증인 진술을 같은 시각에 붙이고, 인장이 마르기 전의 사본은 증언에서 뺀다.",
          "en": "Office. Rank: registrar. Title: water contract ratification claim witness. She pasted the claims and witness statements at the same hour and struck copies taken before the stamps dried from her testimony."
        },
        "stress": {
          "ko": "공포. 자신이 서명한 증언이 집단 단수 조항의 면죄부가 되는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That testimony she signed would become the indulgence of a collective cutoff clause. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 오서율의 공증 청구를 증인석에서 받치고, 한재목의 서부 문안을 읽어 주며, 임하준의 실종 뒤에 남은 만료 표시를 증언의 뼈대로 삼는다.",
          "en": "Relations. Backed O Seoyul's notarization claim from the witness stand, read Han Jaemok's western draft aloud, and made the expiry marks Im Hajun left behind after his disappearance the frame of her testimony."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "청구서와 증언의 시각을 맞추고 구두 연장을 배제한다. 우회 급수 경험은 있지만 조약 체결이나 분쟁 해결 결과는 없다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Aligns claims with testimony timing and rejects verbal extensions. Bypass experience is recorded, but treaty authority and dispute resolution are not. Titles and ambitions are not treated as accomplished authority or results."
    },
