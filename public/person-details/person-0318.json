    "skills": [
      {
        "id": "k317-agreement-transcription-review",
        "name": {
          "ko": "약정 정서 대조",
          "en": "Agreement transcription review"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "k317-priority",
        "name": {
          "ko": "빈 조항에 멈춤",
          "en": "Stops at missing clauses"
        },
        "description": {
          "ko": "초나루는 인장 하나와 빈 조항 번호를 보고 함을 잠근 뒤 다른 서명 원장과 대조했다. 성립하지 않은 초안의 효력을 만들지 않는다.",
          "en": "Cho Naru locked a draft with one seal and a blank clause, then compared another signature ledger. No validity is granted to the incomplete draft."
        },
        "behavior": {
          "ko": "서명 시각과 증인 이름을 같은 줄에 적고, 인장이 둘 미만이면 함을 잠근다.",
          "en": "Office. Rank: convoy hand. Title: joint convoy treaty signing clerk. He wrote the signing hour and the witness names on one line and locked the box with fewer than two stamps."
        },
        "stress": {
          "ko": "위조 정서본 한 장이 먼저 나가 자신이 노선 분할의 들러리가 되는 것.",
          "en": "Fear. That one forged fair copy would go out first and he would become the procession of partition."
        },
        "relationship": {
          "ko": "장세화의 중립 호송 초안을 정서하고, 근주하의 수서 서명 원장과 조항을 맞춘다. 정유라의 회의 통지를 봉인 상태로만 펼친다.",
          "en": "Relations. Drafted Jang Sehwa's joint convoy plan and matched the articles with Geun Juha's Suseo signature ledger. Unfolded Jung Yura's Lesser States Council notice only under seal."
        },
        "effects": []
      },
      {
        "id": "k317-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 호송원. 직함은 중립 호송 약정 서명 서기. 서명 시각과 증인 이름을 같은 줄에 적고, 인장이 둘 미만이면 함을 잠근다.",
          "en": "Office. Rank: convoy hand. Title: joint convoy treaty signing clerk. He wrote the signing hour and the witness names on one line and locked the box with fewer than two stamps."
        },
        "stress": {
          "ko": "공포. 위조 정서본 한 장이 먼저 나가 자신이 노선 분할의 들러리가 되는 것.",
          "en": "Fear. That one forged fair copy would go out first and he would become the procession of partition."
        },
        "relationship": {
          "ko": "관계. 장세화의 중립 호송 초안을 정서하고, 근주하의 수서 서명 원장과 조항을 맞춘다. 정유라의 회의 통지를 봉인 상태로만 펼친다.",
          "en": "Relations. Drafted Jang Sehwa's joint convoy plan and matched the articles with Geun Juha's Suseo signature ledger. Unfolded Jung Yura's Lesser States Council notice only under seal."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "초나루는 인장 하나와 빈 조항 번호를 보고 함을 잠근 뒤 다른 서명 원장과 대조했다. 성립하지 않은 초안의 효력을 만들지 않는다.",
      "en": "Cho Naru locked a draft with one seal and a blank clause, then compared another signature ledger. No validity is granted to the incomplete draft."
    },
