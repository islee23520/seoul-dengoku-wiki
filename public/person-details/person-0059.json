    "skills": [
      {
        "id": "certify",
        "name": {
          "ko": "인증 조항 검토",
          "en": "Certification-clause review"
        },
        "rating": 65
      },
      {
        "id": "referral",
        "name": {
          "ko": "공개 창구 안내",
          "en": "Public-channel referral"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "no-secret-clauses",
        "name": {
          "ko": "비공개 조항 거부",
          "en": "No Secret Clauses"
        },
        "description": {
          "ko": "최은재는 인증을 흥정 수단이 아니라 공개 조건에 묶인 절차로 본다.",
          "en": "Choi Eunjae treats certification as a process bound to open terms rather than a bargaining asset."
        },
        "behavior": {
          "ko": "인증 사본을 신청국과 마곡 서고에 함께 남기고 비공개 성능 조항이 있으면 날인을 거부한다.",
          "en": "She leaves certification copies with both the applicant country and Magok archive and refuses to stamp secret performance clauses."
        },
        "stress": {
          "ko": "폐쇄 연구파가 인증을 보호비로 팔 우려가 있다면 공개 원장과 조건 공개를 더 엄격히 지킬 수 있다.",
          "en": "If a closed research faction might sell certification as protection payments, she may enforce open ledgers and disclosed terms more strictly."
        },
        "relationship": {
          "ko": "계약의 공개 범위를 넓힐 수 있다면 정호준과 협력하고 정유라의 기술공유 문장을 인증 조항에 반영할 수 있다.",
          "en": "She may cooperate with Jeong Hojun and incorporate Jeong Yura’s technology-sharing language when this broadens contract transparency."
        },
        "effects": []
      },
      {
        "id": "attention-to-on-site-faults",
        "name": {
          "ko": "현장 고장 관심",
          "en": "Attention to On-Site Faults"
        },
        "description": {
          "ko": "최은재의 호기심은 성능표의 빈칸보다 현장에서 고장 난 펌프에 더 오래 머문다.",
          "en": "Choi Eunjae’s curiosity lingers longer on a broken on-site pump than on gaps in a performance sheet."
        },
        "behavior": {
          "ko": "고장 난 펌프를 오래 살피고 임채원의 필터 검증을 맡는다.",
          "en": "She spends time examining broken pumps and undertakes filter verification for Im Chaewon."
        },
        "stress": {
          "ko": "인증이 보호비 거래로 변할 우려가 있다면 현장 상태를 외면하는 인증에 더 경계할 수 있다.",
          "en": "If certification risks becoming a protection-payment trade, she may be more wary of certification that ignores actual site conditions."
        },
        "relationship": {
          "ko": "필터의 실제 성능을 확인해야 한다면 임채원과의 검증 동맹을 활용할 수 있다.",
          "en": "She may rely on her verification alliance with Im Chaewon when a filter’s actual performance needs checking."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "공개 계약 범위를 설계하고 인증 사본을 양쪽에 남긴다. 고장 펌프를 살피는 호기심은 반영하나 수리 숙련은 부여하지 않는다.",
      "en": "He designs disclosure boundaries and retains certification copies on both sides. Interest in broken pumps supports curiosity, not repair skill."
    },
