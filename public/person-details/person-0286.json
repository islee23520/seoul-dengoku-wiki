    "traits": [
      {
        "id": "k285-priority",
        "name": {
          "ko": "통행세 거부",
          "en": "Rejects toll demands"
        },
        "description": {
          "ko": "두국은 순찰 교대와 경량 호송 접속을 맞춘다. 통행세 요구를 거부하는 강경함이 있고 실제 빈 칸 화물은 미확인이다.",
          "en": "Duguk coordinates patrol shifts and light escort connections. He firmly rejects toll demands, while the missing slot’s actual cargo remains unknown."
        },
        "behavior": {
          "ko": "호송 인원과 차륜 점검표를 같은 칠판에 붙이고, 무장 탑재는 상무와 감사의 날인만 인정한다.",
          "en": "Office. Rank: assistant manager. Title: north gate convoy outpost chief. He pasted the convoy personnel and the wheel check table on one chalkboard and recognized arms loading only with the Elder's and the auditor's stamps."
        },
        "stress": {
          "ko": "북문이 군사 호송로로 바뀌어 궤도기병이 사택 민병으로 흡수되는 것.",
          "en": "Fear. That the north gate would turn into a military convoy route and the rail cavalry would be absorbed into a residential militia."
        },
        "relationship": {
          "ko": "권도하의 북문 순찰을 거점에서 받고, 용모의 교대와 횃불을 나눈다. 하세온의 경량 호송과 접속 시각을 맞춘다.",
          "en": "Relations. Received Gwon Doha's north gate patrol at the outpost and split the rotations and torches with Yong Mo. Matched the link hours with Ha Seon's light convoys."
        },
        "effects": []
      },
      {
        "id": "k285-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 사원. 직함은 강남역 북문 호송 거점장. 호송 인원과 차륜 점검표를 같은 칠판에 붙이고, 무장 탑재는 상무와 감사의 날인만 인정한다.",
          "en": "Office. Rank: assistant manager. Title: north gate convoy outpost chief. He pasted the convoy personnel and the wheel check table on one chalkboard and recognized arms loading only with the Elder's and the auditor's stamps."
        },
        "stress": {
          "ko": "공포. 북문이 군사 호송로로 바뀌어 궤도기병이 사택 민병으로 흡수되는 것.",
          "en": "Fear. That the north gate would turn into a military convoy route and the rail cavalry would be absorbed into a residential militia."
        },
        "relationship": {
          "ko": "관계. 권도하의 북문 순찰을 거점에서 받고, 용모의 교대와 횃불을 나눈다. 하세온의 경량 호송과 접속 시각을 맞춘다.",
          "en": "Relations. Received Gwon Doha's north gate patrol at the outpost and split the rotations and torches with Yong Mo. Matched the link hours with Ha Seon's light convoys."
        },
        "effects": []
