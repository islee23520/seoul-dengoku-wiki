      {
        "id": "alarm",
        "name": {
          "ko": "경보·봉쇄 조정",
          "en": "Alarm and closure coordination"
        },
        "rating": 65
      },
      {
        "id": "hearing",
        "name": {
          "ko": "증인 대질 진행",
          "en": "Witness confrontation"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "alarm-based-decisions",
        "name": {
          "ko": "경보에 따른 결단",
          "en": "Alarm-Based Decisions"
        },
        "description": {
          "ko": "이봄결은 대담하게 움직이되 사람의 직감보다 무인 감시기의 경보를 따른다.",
          "en": "Lee Bomgyeol acts boldly but follows unmanned-monitor alarms before human intuition."
        },
        "behavior": {
          "ko": "경보 구간을 주민대표와 공유하고 임시온의 감시 기록 없이는 외곽 출동을 하지 않는다.",
          "en": "She shares alarm zones with resident representatives and does not deploy to the outskirts without Im Sion’s monitoring records."
        },
        "stress": {
          "ko": "봉쇄조가 연구자를 가두는 쪽으로 돌아설 우려가 있다면 출동 근거와 경보 공유를 더 중시할 수 있다.",
          "en": "If blockade teams risk turning toward imprisoning researchers, she may give greater weight to deployment evidence and shared alarms."
        },
        "relationship": {
          "ko": "외곽 출동의 근거가 필요하다면 임시온의 감시 기록에 의존하고 김도하의 대피 경로를 지키려 할 수 있다.",
          "en": "When an outer-area deployment needs justification, she may rely on Im Sion’s records while protecting Kim Doha’s evacuation routes."
        },
        "effects": []
      },
      {
        "id": "release-conditions-observed",
        "name": {
          "ko": "해제 조건 준수",
          "en": "Release Conditions Observed"
        },
        "description": {
          "ko": "이봄결은 봉쇄 해제를 안전심사관의 표본 합격에 묶는다.",
          "en": "Lee Bomgyeol ties blockade release to sample approval by the safety reviewer."
        },
        "behavior": {
          "ko": "안전심사관의 표본이 합격하는 때에만 봉쇄 해제를 선언한다.",
          "en": "She announces blockade release only when the safety reviewer’s samples pass."
        },
        "stress": {
          "ko": "봉쇄망이 연구자를 가두는 장치가 될 우려가 있다면 해제 판단을 안전심사 조건에 계속 묶으려 할 수 있다.",
          "en": "If the blockade network risks becoming a tool for confining researchers, she may seek to keep release decisions bound to safety-review conditions."
        },
        "relationship": {
          "ko": "정하린의 표본 판정이 내려지지 않았다면 그 거부권을 받치며 독자적으로 봉쇄를 풀지 않을 수 있다.",
          "en": "Without Jeong Harin’s sample approval, she may uphold the reviewer’s veto rather than lift the blockade independently."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "경보를 공유하고 표본 합격 뒤에만 봉쇄를 푼다. 현장 조직은 확인되지만 무력 지원 표현만으로 고급 개인 전투를 부여하지 않는다.",
      "en": "She shares alarms and releases closures only after samples pass. Field coordination is evident; armed support does not establish elite personal combat."
    },
