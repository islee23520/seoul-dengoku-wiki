    "skills": [
      {
        "id": "bargain",
        "name": {
          "ko": "교대 조건 조정",
          "en": "Shift-condition mediation"
        },
        "rating": 50
      },
      {
        "id": "handover",
        "name": {
          "ko": "기록·열쇠 인수인계",
          "en": "Record and key handover"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "direct-crew-consultation",
        "name": {
          "ko": "작업반과 직접 협의",
          "en": "Direct Crew Consultation"
        },
        "description": {
          "ko": "홍자원은 태업 작업반과 조건을 직접 나누며 교대의 길을 찾는 쪽이다.",
          "en": "Hong Jawon seeks a way to resume shifts by discussing conditions directly with a work-to-rule crew."
        },
        "behavior": {
          "ko": "태업 작업반과 밤새 조건을 나눠 다음 교대를 열었다.",
          "en": "They discussed conditions with the crew through the night and enabled the next shift."
        },
        "stress": {
          "ko": "태업이 당직 공백으로 이어질 우려가 있으면 조건 협의를 지속하려 할 수 있다.",
          "en": "If the slowdown threatens a gap in duty coverage, they may persist with discussions of conditions."
        },
        "relationship": {
          "ko": "작업반과 갈등이 생긴다면 일방적 지시보다 조건을 직접 주고받는 방식을 택할 수 있다.",
          "en": "If conflict arises with the crew, they may choose direct discussion of conditions over unilateral instructions."
        },
        "effects": []
      },
      {
        "id": "connect-the-next-duty-shift",
        "name": {
          "ko": "다음 당직 연결",
          "en": "Connect the Next Duty Shift"
        },
        "description": {
          "ko": "홍자원은 현재의 갈등을 다음 교대가 열리는 방향으로 풀려는 성향을 보인다.",
          "en": "Hong Jawon shows a tendency to address present conflict toward enabling the next shift."
        },
        "behavior": {
          "ko": "밤샘 협의를 이어 실제로 다음 교대가 시작될 수 있게 했다.",
          "en": "They sustained overnight discussions until the next shift could begin."
        },
        "stress": {
          "ko": "당직 공백이 태욱그룹의 통행을 강국에 종속시킬 우려가 커지면 교대 재개를 더 중시할 수 있다.",
          "en": "Fear that a vacant shift could make Taewook Group's passage dependent on a powerful state may heighten their focus on resuming shifts."
        },
        "relationship": {
          "ko": "작업반과 선배 당직 사이를 조율해야 한다면 다음 교대의 성립을 공통 목표로 삼을 수 있다.",
          "en": "When coordinating between the crew and senior duty staff, they may use the next shift's resumption as a shared goal."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "태업 조건을 밤새 나눠 교대를 열었다. 협의와 인내의 좁은 강점을 평가하고 수질 전문 기술은 추가하지 않는다.",
      "en": "He spent the night mediating work-to-rule conditions to open a shift. Bargaining and persistence are narrow strengths; water expertise is not added."
    },
