    "skills": [
      {
        "id": "escort-passage-record-comparison",
        "name": {
          "ko": "호송 통과 기록 대조",
          "en": "Escort passage record comparison"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "구두 통과는 세워 둔다",
          "en": "Holds verbal passage requests"
        },
        "description": {
          "ko": "구두 통행증 요청을 멈추고 통과 시각을 서명 원장과 맞춰 두 장소에 남겼다. 확인된 문서 검증만 발급한다.",
          "en": "A verbal passage request was held while transit time was checked against signed records and left in two places. Only recorded verification supports issuance."
        },
        "behavior": {
          "ko": "회의 호송의 통과 시각을 봉인보다 먼저 확인하고, 구두 합의를 통행증으로 바꾸려는 사신을 문 앞에 세운다. 예의는 지키되 날짜를 고치는 손은 용서하지 않는다.",
          "en": "He confirmed a council convoy's passage hours before the seals and stood at the door any envoy who tried to turn a verbal agreement into a passage permit. He kept his manners but never forgave a hand that changed a date."
        },
        "stress": {
          "ko": "공포. 위조 회의 통과증 한 장이 약소국을 강국별로 쪼개 증인석이 매수의 창구가 되는 것.",
          "en": "Fear. That one forged council pass would split the lesser states by great power and the witness stand would become a window of bribery."
        },
        "relationship": {
          "ko": "관계. 정유라의 공동교섭 호송을 관문에서 증언하고, 근주하의 서명 원장과 시각을 맞춘다. 장세화의 상호호송 초안을 회의 전에만 펼친다.",
          "en": "Relations. Testified to Jeong Yura's joint-negotiation convoy at the gate and matched the hours with Geun Juha's signature ledger. Unfolded Jang Sehwa's mutual convoy draft only before the council."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 공동실무원. 직함은 양군 협의 관문 증인. 통과 전갈을 관문과 회의장에 동시에 남기고, 암살·매수 소문은 증인 없이 원장에 올리지 않는다.",
          "en": "Office. Rank: sergeant. Title: lesser-states council gate witness. He left the passage dispatch at the gate and the council hall at once and raised assassination or bribery rumors into the ledger without witnesses never."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 공동실무원. 직함은 양군 협의 관문 증인. 통과 전갈을 관문과 회의장에 동시에 남기고, 암살·매수 소문은 증인 없이 원장에 올리지 않는다.",
          "en": "Recorded duty and limits: Office. Rank: sergeant. Title: lesser-states council gate witness. He left the passage dispatch at the gate and the council hall at once and raised assassination or bribery rumors into the ledger without witnesses never."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 위조 회의 통과증 한 장이 약소국을 강국별로 쪼개 증인석이 매수의 창구가 되는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That one forged council pass would split the lesser states by great power and the witness stand would become a window of bribery."
        },
        "relationship": {
          "ko": "관계. 정유라의 공동교섭 호송을 관문에서 증언하고, 근주하의 서명 원장과 시각을 맞춘다. 장세화의 상호호송 초안을 회의 전에만 펼친다.",
          "en": "Relations. Testified to Jeong Yura's joint-negotiation convoy at the gate and matched the hours with Geun Juha's signature ledger. Unfolded Jang Sehwa's mutual convoy draft only before the council."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "구두 통행증 요청을 멈추고 통과 시각을 서명 원장과 맞춰 두 장소에 남겼다. 확인된 문서 검증만 발급한다.",
      "en": "A verbal passage request was held while transit time was checked against signed records and left in two places. Only recorded verification supports issuance."
    },
