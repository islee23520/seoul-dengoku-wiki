    "skills": [
      {
        "id": "duty-dispatch-posting",
        "name": {
          "ko": "당직 출고 시각 게시",
          "en": "Duty and dispatch posting"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "교대 시각 중시",
          "en": "Prioritizes shift times"
        },
        "description": {
          "ko": "당직 명과 출고 시각을 함께 게시하고 시험 서명 없는 무장 접근을 막는다. 비공개 파견 줄의 존재를 기록하지만 해결은 미확인이다.",
          "en": "Posts duty names and dispatch times together and blocks armed access without test signatures. Records a private dispatch line without a documented resolution."
        },
        "behavior": {
          "ko": "확인된 선택에서는 교대 시각 중시을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "비공개 파견 앞에서 출고를 보류할 수 있다.",
          "en": "May withhold dispatch over private deployments."
        },
        "relationship": {
          "ko": "수늘결과 당직을 나누고 은보람의 게시판을 우선 둔다.",
          "en": "Shares duty with Su Neulgyeol and gives Eun Boram’s postings priority."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "시청역 조합 차량정비소를 독립 조합국 고유 거점으로 남겨 강국 호위병이 유치선에 서는 관행을 끊는다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "기지 당직이 인질 파견의 발판이 되어 은보람의 공개 시험이 내부에서 깨지는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "수늘결과 당직을 나누고 은보람의 게시판을 우선 둔다.",
          "en": "Shares duty with Su Neulgyeol and gives Eun Boram’s postings priority."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "당직 명과 출고 시각을 함께 게시하고 시험 서명 없는 무장 접근을 막는다. 비공개 파견 줄의 존재를 기록하지만 해결은 미확인이다.",
      "en": "Posts duty names and dispatch times together and blocks armed access without test signatures. Records a private dispatch line without a documented resolution."
    },
