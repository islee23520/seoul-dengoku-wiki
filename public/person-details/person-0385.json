    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "기록 노출을 가림",
          "en": "Selects what records expose"
        },
        "description": {
          "ko": "개봉 흔적과 지도 빈칸의 겹침을 증언하고 우회 실측을 넘긴다. 비공개 배급을 원판 제목에 남기지 않는 선택도 보존한다.",
          "en": "Testifies about overlapping opening marks and map gaps and submits alternate-route measurements. Also avoids naming hidden rations in the master title."
        },
        "behavior": {
          "ko": "확인된 선택에서는 기록 노출을 가림을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "민감한 공급 기록 앞에서 표제를 줄일 수 있다.",
          "en": "May limit titles when supply records are sensitive."
        },
        "relationship": {
          "ko": "라진우에게 실측을 넘기고 판효담의 칠판에 좌표를 붙인다.",
          "en": "Sends measurements to Ra Jinwoo and posts coordinates on Pan Hyodam’s board."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "교구 명부와 선거 봉인을 지켜 다음 대주교 비밀 선거의 절차와 명동역 인준이 끊기지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
