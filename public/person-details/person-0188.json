    "traits": [
      {
        "id": "k187-disposition",
        "name": {
          "ko": "거절도 공개함",
          "en": "Publishing refusals too"
        },
        "description": {
          "ko": "빈칸이 있는 배차표를 사고보다 고의로 보고, 열람을 거절하는 원로에게는 청구서를 두 장 남긴다. 실리적이나 시각을 지우는 손을 가혹하게 다룬다.",
          "en": "He read a dispatch sheet with blanks as intent rather than accident and left two invoices with any elder who refused inspection. Pragmatic, he dealt harshly with a hand that erased hours."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 배차 기록 열람 청구인. 열람 청구와 거절 사유를 배차판에 같이 붙이고, 하루를 넘긴 비밀 편성은 무효라고 적는다.",
          "en": "Office. Rank: registrar. Title: dispatch record inspection claimant. He pasted the inspection claim and the refusal reason together on the dispatch board and wrote that a secret formation running past a day stood void."
        },
        "stress": {
          "ko": "공포. 열람이 기각된 뒤 자신의 이름이 무기 칸 증인란에 홀로 남는 것.",
          "en": "Fear. That after the inspection was rejected, his name alone would remain in the weapons column's witness line."
        },
        "relationship": {
          "ko": "관계. 박태겸의 배차 원장 열람을 청구하고, 레아 마르탱의 난외 노트를 근거로 삼으며, 올렉산드르 셰우첸코가 붙인 제동 불량 시각을 같은 줄에 겹친다.",
          "en": "Relations. Claimed inspection of Park Taegyeom's dispatch ledger, used Léa Martin's margin notes as grounds, and overlaid the brake-defect hours Oleksandr Shevchenko had posted on the same line."
        },
        "effects": []
      },
      {
        "id": "k187-choice",
        "name": {
          "ko": "빈칸을 의심함",
          "en": "Suspicion of gaps"
        },
        "description": {
          "ko": "일화. 겨울의 검은 배차표가 의료열차 무기와 북부 후계시험 부품 조작을 동시에 드러내자 마르틴 호라크는 창 전 편성의 열람을 청구했다.",
          "en": "Anecdote. When the winter black dispatch sheet exposed both the medical train's weapons and the northern succession trial's parts rigging, Martin Horák claimed inspection of the warehouse formations."
        },
        "behavior": {
          "ko": "관계. 박태겸의 배차 원장 열람을 청구하고, 레아 마르탱의 난외 노트를 근거로 삼으며, 올렉산드르 셰우첸코가 붙인 제동 불량 시각을 같은 줄에 겹친다.",
          "en": "Relations. Claimed inspection of Park Taegyeom's dispatch ledger, used Léa Martin's margin notes as grounds, and overlaid the brake-defect hours Oleksandr Shevchenko had posted on the same line."
        },
        "stress": {
          "ko": "공포. 열람이 기각된 뒤 자신의 이름이 무기 칸 증인란에 홀로 남는 것.",
          "en": "Fear. That after the inspection was rejected, his name alone would remain in the weapons column's witness line."
        },
        "relationship": {
          "ko": "관계. 박태겸의 배차 원장 열람을 청구하고, 레아 마르탱의 난외 노트를 근거로 삼으며, 올렉산드르 셰우첸코가 붙인 제동 불량 시각을 같은 줄에 겹친다.",
          "en": "Relations. Claimed inspection of Park Taegyeom's dispatch ledger, used Léa Martin's margin notes as grounds, and overlaid the brake-defect hours Oleksandr Shevchenko had posted on the same line."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "전 편성 열람을 청구하고 난외 노트와 불량 시각을 겹친다. 열람 청구는 검증 행동이며 조작의 전체 배후를 밝혔다는 뜻은 아니다.",
      "en": "He requests access to every formation and compares marginal notes with defect times. This is verification work, not proof that he solved the entire conspiracy."
    },
