    "skills": [
      {
        "id": "k312-separate-carriage-seal-custody",
        "name": {
          "ko": "칸 봉인 분리 보관",
          "en": "Separate carriage seal custody"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "k312-priority",
        "name": {
          "ko": "권한 분리",
          "en": "Separates authority"
        },
        "description": {
          "ko": "국감은 칸 열쇠와 무기함 봉인을 나누고 입회 수색을 고수한다. 빠진 당직자는 아직 특정되지 않았다.",
          "en": "Gukgam separates carriage keys from weapon-box seals and insists on witnessed searches. The missing duty worker is not identified."
        },
        "behavior": {
          "ko": "칸 열쇠와 무기함 봉인을 분리해 보관하고, 수색은 통행 심사관 입회 아래에서만 한다.",
          "en": "Office. Rank: clerk. Title: medical train defense shop outpost chief, duty officer of Gwak Taesan. He kept the car keys and the weapons-box seal in separate custody and conducted searches only under the passage examiner's attendance."
        },
        "stress": {
          "ko": "수비창 안에서 암사제 무기를 숨긴 자가 나와 장세화의 중립이 내부에서 깨지는 것.",
          "en": "Fear. That someone hiding Amsa-made weapons inside the defense shop would break Jang Sehwa's neutrality from within."
        },
        "relationship": {
          "ko": "곽태산의 지휘로 수비창을 맡고, 문시온과 봉인 입회를 공유한다. 전미리의 환자 칸을 창 쪽에서 지킨다.",
          "en": "Relations. Held the defense shop under Gwak Taesan's command and shared the sealing attendance with Mun Sion. Shielded Jeon Miri's patient cars on the shop side."
        },
        "effects": []
      },
      {
        "id": "k312-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 서기. 직함은 의료열차 수비창 거점장, 곽태산의 실무 담당자. 칸 열쇠와 무기함 봉인을 분리해 보관하고, 수색은 통행 심사관 입회 아래에서만 한다.",
          "en": "Office. Rank: clerk. Title: medical train defense shop outpost chief, duty officer of Gwak Taesan. He kept the car keys and the weapons-box seal in separate custody and conducted searches only under the passage examiner's attendance."
        },
        "stress": {
          "ko": "공포. 수비창 안에서 암사제 무기를 숨긴 자가 나와 장세화의 중립이 내부에서 깨지는 것.",
          "en": "Fear. That someone hiding Amsa-made weapons inside the defense shop would break Jang Sehwa's neutrality from within."
        },
        "relationship": {
          "ko": "관계. 곽태산의 지휘로 수비창을 맡고, 문시온과 봉인 입회를 공유한다. 전미리의 환자 칸을 창 쪽에서 지킨다.",
          "en": "Relations. Held the defense shop under Gwak Taesan's command and shared the sealing attendance with Mun Sion. Shielded Jeon Miri's patient cars on the shop side."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "국감은 칸 열쇠와 무기함 봉인을 나누고 입회 수색을 고수한다. 빠진 당직자는 아직 특정되지 않았다.",
      "en": "Gukgam separates carriage keys from weapon-box seals and insists on witnessed searches. The missing duty worker is not identified."
    },
