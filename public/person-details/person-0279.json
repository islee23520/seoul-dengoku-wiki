    "traits": [
      {
        "id": "k278-priority",
        "name": {
          "ko": "공개 저울 신뢰",
          "en": "Trust in public scales"
        },
        "description": {
          "ko": "모소는 회수 로트를 인수하고 수리 중량표를 송장에 옮긴다. 가문 주문도 인준 전에는 막지만 독립적 반권위는 아니다.",
          "en": "Moso receives recovered lots and transfers repair weight tables to invoices. He blocks unapproved family orders without rejecting authority itself."
        },
        "behavior": {
          "ko": "입고 중량을 두 증인이 보고, 가문 문장이 찍힌 주문서는 회장실 인준 전 출고를 막는다.",
          "en": "Office. Rank: assistant manager. Title: wheel and steel logistics merchant. Two witnesses reported intake weights, and he blocked the release of any order stamped with a house seal before the seniority council's ratification."
        },
        "stress": {
          "ko": "회수 철재가 군수 전용으로 빠져 민생 열차가 영영 멈추는 것.",
          "en": "Fear. That salvage steel would leave as munitions-only and the civil trains would stop forever."
        },
        "relationship": {
          "ko": "황노을의 회수 저울과 출고를 맞추고, 봉국의 회수장에서 로트를 인수한다. 강민서의 수리 규격 중량표를 송장에 옮긴다.",
          "en": "Relations. Matched releases with Hwang Noeul's salvage scales and took over lots at Bong Guk's salvage yard. Moved Gang Minseo's repair-standard weight tables onto the invoices."
        },
        "effects": []
      },
