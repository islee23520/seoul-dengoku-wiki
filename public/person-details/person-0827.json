    "skills": [
      {
        "id": "closure",
        "name": {
          "ko": "위험 구간 폐쇄",
          "en": "Hazardous-route closure"
        },
        "rating": 45
      },
      {
        "id": "departure",
        "name": {
          "ko": "배차표·출발 확인",
          "en": "Departure and dispatch checks"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "close-immediately-after-reporting",
        "name": {
          "ko": "보고 뒤 바로 닫기",
          "en": "Close Immediately After Reporting"
        },
        "description": {
          "ko": "임사우는 붕괴 위험을 보고에만 남겨 두지 않고 즉시 구간 폐쇄로 연결하는 성향을 보인다.",
          "en": "Im Sau shows a disposition to follow a collapse report with immediate closure rather than leave it at reporting."
        },
        "behavior": {
          "ko": "침수 구간의 붕괴 보고를 미루지 않고 해당 구간을 당장 폐쇄했다.",
          "en": "He reported the flooded section’s collapse without delay and closed the section immediately."
        },
        "stress": {
          "ko": "통행 유지와 붕괴 위험이 충돌하면 위험 구간을 닫는 결정을 늦추지 않으려 할 수 있다.",
          "en": "If maintaining passage conflicts with collapse danger, he may resist delaying closure of the hazardous section."
        },
        "relationship": {
          "ko": "선배 당직에게 인계할 때 붕괴 보고와 폐쇄 상태를 함께 명확히 전하려 할 수 있다.",
          "en": "When handing over to senior duty staff, he may seek to communicate both the collapse report and closure status clearly."
        },
        "effects": []
      },
      {
        "id": "guard-against-shift-gaps",
        "name": {
          "ko": "교대 공백 경계",
          "en": "Guard Against Shift Gaps"
        },
        "description": {
          "ko": "임사우는 위험 구간을 닫더라도 당직과 기록의 연결이 끊기지 않는 것을 중시한다.",
          "en": "Im Sau values continuity of duty and records even when a hazardous section must be closed."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록을 인계하며 장부를 다음 당직으로 잇는 쪽을 우선한다.",
          "en": "He prioritizes passing his position’s keys and records onward to keep the ledger connected to the next shift."
        },
        "stress": {
          "ko": "당직 공백이 통행을 강국의 볼모로 만들까 우려되면 폐쇄 이후 인계의 연속성에 더 민감해질 수 있다.",
          "en": "If he fears a duty gap could leave passage hostage to a powerful state, he may become more attentive to continuity after closure."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과는 폐쇄 구간의 책임이 인계에서 빠지지 않도록 확인하려 할 수 있다.",
          "en": "With senior duty staff in his community, he may seek to ensure responsibility for the closed section is not lost in handover."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "침수 붕괴 구간을 당장 폐쇄했다. 제한된 경로 안전 판단이며 의료 구조 훈련이나 군 경험은 확인되지 않는다.",
      "en": "He promptly closed a flooded collapse section. Limited route-safety judgment is supported; medical rescue training and military experience are not established."
    },
