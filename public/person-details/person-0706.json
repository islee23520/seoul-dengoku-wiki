    "traits": [
      {
        "id": "k706-priority",
        "name": {
          "ko": "배차를 잇는 노동",
          "en": "Labor preserving dispatch"
        },
        "description": {
          "ko": "정나준의 확인된 행동은 2125년 고장 난 제동을 밤새 고쳐 다음 교대 배차를 지켰다.  짧은 일화 밖의 경력과 반복 성과는 미확인이다.",
          "en": "정나준: Anecdote. In 2125 he repaired a failed brake through the night and kept the next rotation's dispatch. By this deed the signature of the wheel mechanic post rose into the ledger. Further career and repeated results remain unconfirmed."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: assistant manager. Title: wheel mechanic. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "성하전자 차륜 정비사 당직이 비면 성하전자의 바깥 작업장 두 곳이 강남역 본사와 끊기는 것.",
          "en": "Fear. That the wheel mechanic duty post would stand empty and the Group's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k706-accountability",
        "name": {
          "ko": "당직의 연속성",
          "en": "Continuity of duty"
        },
        "description": {
          "ko": "큰소리보다 기록을 믿고 자기 직위의 열쇠와 기록만 넘긴다.",
          "en": "Trusts records over loud claims and hands over only the keys and records of the position."
        },
        "behavior": {
          "ko": "관직. 품계 사원. 직함은 성하전자 차륜 정비사. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: assistant manager. Title: wheel mechanic. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "공포. 성하전자 차륜 정비사 당직이 비면 성하전자의 바깥 작업장 두 곳이 강남역 본사와 끊기는 것.",
          "en": "Fear. That the wheel mechanic duty post would stand empty and the Group's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "정나준의 확인된 행동은 2125년 고장 난 제동을 밤새 고쳐 다음 교대 배차를 지켰다.  짧은 일화 밖의 경력과 반복 성과는 미확인이다.",
      "en": "정나준: Anecdote. In 2125 he repaired a failed brake through the night and kept the next rotation's dispatch. By this deed the signature of the wheel mechanic post rose into the ledger. Further career and repeated results remain unconfirmed."
