    "traits": [
      {
        "id": "k1008-trait-1",
        "name": {
          "ko": "현장 조정가",
          "en": "Field coordinator"
        },
        "description": {
          "ko": "연결 비용과 물자 배분 조건을 주민에게 설명한다.",
          "en": "Explains connection costs and distribution terms to residents."
        },
        "behavior": {
          "ko": "연결 비용과 물자 배분 조건을 주민에게 설명한다.",
          "en": "Explains connection costs and distribution terms to residents."
        },
        "stress": {
          "ko": "생활 전력·경작 도구 수리에 남길 부품과 중계기에 쓸 부품의 순서가 충돌하면 주민과 배분 순서를 협의한다.",
          "en": "Discusses allocation order with residents when parts for household power and cultivation-tool repairs compete with parts for the relay."
        },
        "relationship": {
          "ko": "김연규와 선후배 관계이며 신종목과 현장 운용을 나누었다.",
          "en": "Is Kim Yeonggyu’s junior and shared field operation with Shin Jongmok."
        },
        "effects": [
          {
            "ability": "negotiation",
            "delta": 4
          }
        ]
      },
      {
        "id": "k1008-trait-2",
        "name": {
          "ko": "생존자 기록 중시",
          "en": "Survivor records matter"
        },
        "description": {
          "ko": "연락 종료를 생존자의 부재와 같게 보지 않는다.",
          "en": "Does not treat closed contact as absence of a survivor."
        },
        "behavior": {
          "ko": "연락 종료를 생존자의 부재와 같게 보지 않는다.",
          "en": "Does not treat closed contact as absence of a survivor."
        },
        "stress": {
          "ko": "침묵만으로 자동 종료를 서두르지 않는다.",
          "en": "Does not rush automatic closure on silence alone."
        },
        "relationship": {
          "ko": "돌아온 응답의 시각·전력을 남겨 주민의 연락을 이어 간다.",
          "en": "Records returning responses’ time and power use to keep resident contacts alive."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "끊긴 연락처에서 응답이 돌아오자 시각과 전력 사용량을 기록했고 이동식 민간 중계기를 더했다. 수서 생활권에서 공동 경작과 배분을 주민과 협의하며 물자를 두고 다투지 않아도 되는 길을 찾는다. 경작지·경작권·수확량은 확정하지 않는다. 유도 훈련은 군사 지휘 이력과 별개다.",
      "en": "He recorded time and power use when a closed contact responded again and added a mobile civilian relay. In the Suseo living area he discusses communal cultivation and distribution with residents, seeking a way to avoid fighting over supplies. No plot, cultivation right or harvest quantity is confirmed. Judo training is separate from military command history."
    },
