    "skills": [
      {
        "id": "seed",
        "name": {
          "ko": "온습도·종자 출고 확인",
          "en": "Temperature and seed-release checks"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "no-record-gaps",
        "name": {
          "ko": "기록 공백 불허",
          "en": "No Record Gaps"
        },
        "description": {
          "ko": "박진솔은 종자 보존의 온습도 기록에 한 칸의 공백도 허용하지 않는다.",
          "en": "Park Jinsol tolerates no gaps in seed-preservation temperature and humidity records."
        },
        "behavior": {
          "ko": "온도 로그가 끊긴 상자는 전시 징발 문서가 있어도 손대지 않고 출고에는 이중 날인을 요구한다.",
          "en": "She leaves boxes with interrupted temperature logs untouched even under wartime requisition and requires two approvals for release."
        },
        "stress": {
          "ko": "전력 단절이 보존고를 약탈 창고로 만들 우려가 있다면 온도 로그와 반출 조건을 더 엄격히 지킬 수 있다.",
          "en": "If power loss threatens to turn the repository into a plunder storehouse, she may enforce temperature logs and release conditions more strictly."
        },
        "relationship": {
          "ko": "정하린이 반출을 잠근다면 이중 날인 원칙에 따라 그 결정을 따를 수 있다.",
          "en": "If Jeong Harin locks down removal, she may follow that decision in accordance with the dual-approval rule."
        },
        "effects": []
      },
      {
        "id": "no-seed-trading",
        "name": {
          "ko": "종자 거래 거부",
          "en": "No Seed Trading"
        },
        "description": {
          "ko": "박진솔은 종자를 군량 협상물이나 보호비가 아닌 공동의 보존 자산으로 본다.",
          "en": "Park Jinsol views seeds as a shared preservation asset rather than military bargaining stock or protection payments."
        },
        "behavior": {
          "ko": "씨앗을 군량 협상물로 부르는 태도를 배척하고 종자 원장을 공개 자산으로 올리려 한다.",
          "en": "She rejects treating seeds as military bargaining stock and seeks to establish the seed ledger as a public asset."
        },
        "stress": {
          "ko": "냉온고 정지로 종자가 보호비로 흩어질 위험이 있다면 거래보다 보존 통제를 우선할 수 있다.",
          "en": "If storage failure risks dispersing seeds as protection payments, she may prioritize preservation controls over trade."
        },
        "relationship": {
          "ko": "남윤경의 가격 원장이 종자 시세를 매기기 시작한다면 적대적으로 돌아설 수 있다.",
          "en": "She may turn hostile if Nam Yungyeong’s price ledger begins assigning market prices to seeds."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "온습도 로그와 이중 날인으로 종자 반출을 관리한다. 보존 업무를 평가하며 관로 대장 일화를 공학 전체 숙련으로 확대하지 않는다.",
      "en": "He controls seed release through temperature logs and dual signatures. Preservation work is supported; a pipeline-register episode does not establish broad engineering."
    },
