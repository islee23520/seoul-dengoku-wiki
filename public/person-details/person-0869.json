      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "문 밖에서 절차를 연다",
          "en": "Starts procedure outside the door"
        },
        "description": {
          "ko": "무장 난입자를 문 밖에서 붙들고 명부 재점검으로 넘겼다. 현장 제압과 절차를 연결한 행동에 한정한다.",
          "en": "An armed intruder was held outside the door and passed into roster review. The profile stays with that link between restraint and procedure."
        },
        "behavior": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "stress": {
          "ko": "공포. 능선 순찰대 당직이 비면 아관사의 통행이 강국 볼모가 되는 것.",
          "en": "Fear. That the ridge patrol duty post would stand empty and the Government's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 병장. 직함은 아관사 능선 순찰대. 자기 직위의 열쇠와 기록만 넘기고, 전쟁과 급수의 양군 승인 없이 한쪽 군령만으로 권한을 만들지 않는다.",
          "en": "Office. Rank: sergeant. Title: ridge patrol. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 병장. 직함은 아관사 능선 순찰대. 자기 직위의 열쇠와 기록만 넘기고, 전쟁과 급수의 양군 승인 없이 한쪽 군령만으로 권한을 만들지 않는다.",
          "en": "Recorded duty and limits: Office. Rank: sergeant. Title: ridge patrol. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 능선 순찰대 당직이 비면 아관사의 통행이 강국 볼모가 되는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That the ridge patrol duty post would stand empty and the Government's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "무장 난입자를 문 밖에서 붙들고 명부 재점검으로 넘겼다. 현장 제압과 절차를 연결한 행동에 한정한다.",
      "en": "An armed intruder was held outside the door and passed into roster review. The profile stays with that link between restraint and procedure."
    },
