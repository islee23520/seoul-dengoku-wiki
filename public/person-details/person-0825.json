      {
        "id": "k825-action-priority",
        "name": {
          "ko": "야간 출입 책임",
          "en": "Responsibility for night access"
        },
        "description": {
          "ko": "2125년 야간 무단 도꾼을 붙잡아 경비 암호패를 갈았다.",
          "en": "In 2125 he caught a night illegal crosser and reissued the guard code tags. By this deed the signature of the power installation patrol post rose into the ledger."
        },
        "behavior": {
          "ko": "2125년 야간 무단 도꾼을 붙잡아 경비 암호패를 갈았다.",
          "en": "In 2125 he caught a night illegal crosser and reissued the guard code tags. By this deed the signature of the power installation patrol post rose into the ledger."
        },
        "stress": {
          "ko": "전력장치 순찰대 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the power installation patrol duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
