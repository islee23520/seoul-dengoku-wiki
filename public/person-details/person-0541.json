  "relations": {
    "outgoing": [
      {
        "from": "민연우",
        "type": "계약",
        "to": "섭도윤",
        "basis": "민연우는 습격에서 챙긴 호송 인명 장부와 사본을 섭도윤에게 전달한다. 섭도윤은 인원 누락을 확인할 증언과 함께 기록청과 회의장에 소식을 보내, 호송 손실이 화물 숫자로만 전해지지 않게 한다."
      }
    ],
