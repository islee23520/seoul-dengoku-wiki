    "traits": [
      {
        "id": "stop-without-dispatch-grounds",
        "name": {
          "ko": "배차 근거 없으면 정지",
          "en": "Stop Without Dispatch Grounds"
        },
        "description": {
          "ko": "주북석은 배차표와 서명이 없는 출발을 그대로 허용하지 않는 쪽이다.",
          "en": "Ju Bukseok does not let a departure proceed without a dispatch sheet and signature."
        },
        "behavior": {
          "ko": "배차표 없는 열차를 세워 서명 없는 출발을 막았다.",
          "en": "They stopped a train without a dispatch sheet and prevented its unsigned departure."
        },
        "stress": {
          "ko": "통행을 이어야 한다는 부담이 커져도 출발 근거가 없으면 정지를 택할 수 있다.",
          "en": "Even under pressure to keep passage moving, they may choose a stop when departure grounds are missing."
        },
        "relationship": {
          "ko": "출발을 재촉하는 상대와 충돌한다면 배차표와 서명을 확인 기준으로 제시할 수 있다.",
          "en": "If they clash with someone urging departure, they may present the dispatch sheet and signature as verification criteria."
        },
        "effects": []
      },
      {
        "id": "documented-authority",
        "name": {
          "ko": "기록된 권한",
          "en": "Documented Authority"
        },
        "description": {
          "ko": "주북석은 출발의 서명 근거와 자기 직위의 권한 범위를 중시한다.",
          "en": "Ju Bukseok values signed grounds for departure and the limits of their own authority."
        },
        "behavior": {
          "ko": "서명 없는 출발을 막고 인계에서는 자기 직위의 열쇠와 기록만 넘긴다.",
          "en": "They prevent unsigned departures and limit handovers to their own keys and records."
        },
        "stress": {
          "ko": "당직 공백을 피하려는 압박이 있어도 없는 권한을 만들어 해결하지 않으려 할 수 있다.",
          "en": "Even under pressure to avoid a vacant shift, they may resist resolving matters by inventing authority."
        },
        "relationship": {
          "ko": "선배 당직과 책임 범위를 맞출 때 서명과 인계 기록을 공통 근거로 삼을 수 있다.",
          "en": "When aligning responsibilities with a senior duty colleague, they may rely on signatures and handover records."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "서명 없이 떠날 열차를 세웠다. 출발 확인이 근거이고 전령 직함을 속도·전투·운전 숙련으로 바꾸지 않았다.",
      "en": "She stopped a train departing without signatures. Departure checking is supported; a messenger title does not establish speed, combat, or driving skill."
    },
