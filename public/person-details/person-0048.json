    "traits": [
      {
        "id": "k048-continue-in-blackout",
        "name": {
          "ko": "정전 중 수술 지속",
          "en": "Continue surgery in blackout"
        },
        "description": {
          "ko": "정전에도 손전화 불빛 아래 수술을 계속했다.",
          "en": "Continued surgery by handset light during a blackout."
        },
        "behavior": {
          "ko": "정전에도 손전화 불빛 아래 수술을 계속했다.",
          "en": "Continued surgery by handset light during a blackout."
        },
        "stress": {
          "ko": "가짜 약품이 공방 골목에 퍼져 진료소가 강국 보호를 받는 제조망의 창구가 되는 것.",
          "en": "That counterfeit drugs would spread through workshop alleys, and the clinic would become a maker network's window under great-power protection."
        },
        "relationship": {
          "ko": "진우람의 금천 의무와 환자 이송을 나누고, 임채원의 방호 출고를 진료 수량에 맞추며, 류은비의 약효 검증을 구로 표본으로 돕는다.",
          "en": "Splitting patient transfers with Jin Uram's Geumcheon care, matching Im Chaewon's protective releases to care volumes, and helping Ryu Eunbi's drug-efficacy verification with Guro specimens."
        },
        "effects": []
      },
      {
        "id": "k048-medical-record-boundary",
        "name": {
          "ko": "진료 기록의 경계",
          "en": "Boundary of medical records"
        },
        "description": {
          "ko": "진료 기록을 군수 명부로 달라는 요구를 거절한다.",
          "en": "Rejects demands to turn medical records into military registers."
        },
        "behavior": {
          "ko": "진료 기록을 군수 명부로 달라는 요구를 거절한다.",
          "en": "Rejects demands to turn medical records into military registers."
        },
        "stress": {
          "ko": "가짜 약품이 공방 골목에 퍼져 진료소가 강국 보호를 받는 제조망의 창구가 되는 것.",
          "en": "That counterfeit drugs would spread through workshop alleys, and the clinic would become a maker network's window under great-power protection."
        },
        "relationship": {
          "ko": "진우람의 금천 의무와 환자 이송을 나누고, 임채원의 방호 출고를 진료 수량에 맞추며, 류은비의 약효 검증을 구로 표본으로 돕는다.",
          "en": "Splitting patient transfers with Jin Uram's Geumcheon care, matching Im Chaewon's protective releases to care volumes, and helping Ryu Eunbi's drug-efficacy verification with Guro specimens."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "정전 중 수술 수행은 명시된 기술 근거다. 환자 이송과 필터 일정도 운영하나 수술 결과나 모든 의학 분야의 숙련은 미확인이다.",
      "en": "Surgery during a blackout explicitly supports a learned skill. Also coordinates transfers and filter schedules, without assuming outcomes or mastery of all medicine."
    },
