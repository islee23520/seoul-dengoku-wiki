    "traits": [
      {
        "id": "k889-action-priority",
        "name": {
          "ko": "명단을 잠근다",
          "en": "Lock the names away"
        },
        "description": {
          "ko": "경비대가 공방에 들어와 복구복무자 명단을 내놓으라고 한다. 차동환은 명단을 기록관 당직의 열쇠로 잠가 두고, 경비대가 찾아온 시각과 인원을 등기 기록에 옮겨 강민서에게 보낸다.",
          "en": "The guard force walks into the workshop and demands the list of restoration-service registrants. Cha Donghwan locks the list away with the records-duty key, copies into the registry record the hour the guard came and how many came, and sends it to Gang Minseo."
        },
        "behavior": {
          "ko": "경비대가 공방에 들어와 복구복무자 명단을 내놓으라고 한다. 차동환은 명단을 기록관 당직의 열쇠로 잠가 두고, 경비대가 찾아온 시각과 인원을 등기 기록에 옮겨 강민서에게 보낸다.",
          "en": "The guard force walks into the workshop and demands the list of restoration-service registrants. Cha Donghwan locks the list away with the records-duty key, copies into the registry record the hour the guard came and how many came, and sends it to Gang Minseo."
        },
        "stress": {
          "ko": "복구복무 기록관 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the restoration service registrar duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k889-bounded-handover",
        "name": {
          "ko": "기록으로 잇는 당직",
