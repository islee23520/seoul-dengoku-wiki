    "skills": [
      {
        "id": "seal-maintenance",
        "name": {
          "ko": "봉인 정비",
          "en": "Seal maintenance"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "눈금 맞추기",
          "en": "Aligns measures"
        },
        "description": {
          "ko": "저울 봉인이 풀린 사건을 증언하고 입고 무게의 눈금을 맞춘다. 사건 목격만으로 봉쇄 원인을 밝혀낸 조사 능력을 부여하지 않는다.",
          "en": "Testifies about a loosened scale seal and coordinates incoming weight measures. Witnessing the incident does not establish investigative mastery."
        },
        "behavior": {
          "ko": "확인된 선택에서는 눈금 맞추기을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "봉인 이상 때 확인 절차에 머물 수 있다.",
          "en": "May linger over verification when seals look wrong."
        },
        "relationship": {
          "ko": "동미온과 입고 눈금을 맞추고 은태호의 경매를 받친다.",
          "en": "Coordinates intake measures with Dong Mion and supports Eun Taeho’s auctions."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "교구 명부와 선거 봉인을 지켜 다음 대주교 비밀 선거의 절차와 명동역 인준이 끊기지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "교구 명부와 선거 봉인이 지워져 교황 없는 선출의 정당성 논쟁에서 자신의 서명이 의심받는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "동미온과 입고 눈금을 맞추고 은태호의 경매를 받친다.",
          "en": "Coordinates intake measures with Dong Mion and supports Eun Taeho’s auctions."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "저울 봉인이 풀린 사건을 증언하고 입고 무게의 눈금을 맞춘다. 사건 목격만으로 봉쇄 원인을 밝혀낸 조사 능력을 부여하지 않는다.",
      "en": "Testifies about a loosened scale seal and coordinates incoming weight measures. Witnessing the incident does not establish investigative mastery."
    },
