    "skills": [
      {
        "id": "queue-administration",
        "name": {
          "ko": "배급 대기열 집행",
          "en": "Ration queue administration"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "중단 압박을 버팀",
          "en": "Resists suspension pressure"
        },
        "description": {
          "ko": "배급 중단 요구에도 광장 원장을 유지하고 남하 가족에게 임시표를 준다. 선거 보좌는 하지만 투표권은 없다.",
          "en": "Keeps the square register despite demands to stop rations and gives temporary tickets to arriving families. Assists elections without a vote."
        },
        "behavior": {
          "ko": "확인된 선택에서는 중단 압박을 버팀을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "중단 요구가 커질수록 장부를 지키는 데 집중할 수 있다.",
          "en": "May focus more narrowly on keeping the register under suspension pressure."
        },
        "relationship": {
          "ko": "전나경의 지휘 아래 방늘재와 대기열을 나눈다.",
          "en": "Works under Jeon Nagyeong and coordinates queues with Bang Neuljae."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "사제단 소집 봉인을 지켜 다음 대주교 비밀 선거의 절차와 명동역 인준이 끊기지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "사제단 소집 봉인이 지워져 교황 없는 선출의 정당성 논쟁에서 자신의 서명이 의심받는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "전나경의 지휘 아래 방늘재와 대기열을 나눈다.",
          "en": "Works under Jeon Nagyeong and coordinates queues with Bang Neuljae."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "배급 중단 요구에도 광장 원장을 유지하고 남하 가족에게 임시표를 준다. 선거 보좌는 하지만 투표권은 없다.",
      "en": "Keeps the square register despite demands to stop rations and gives temporary tickets to arriving families. Assists elections without a vote."
