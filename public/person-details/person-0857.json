      {
        "id": "k857-action-priority",
        "name": {
          "ko": "출발 전에 서명",
          "en": "Signatures before departure"
        },
        "description": {
          "ko": "2125년 배차표 없는 열차를 세워 서명 없는 출발을 막았다.",
          "en": "In 2125 he stopped a dispatch-sheetless train and blocked an unsigned departure. By this deed the signature of the work-squad courier post rose into the ledger."
        },
        "behavior": {
          "ko": "2125년 배차표 없는 열차를 세워 서명 없는 출발을 막았다.",
          "en": "In 2125 he stopped a dispatch-sheetless train and blocked an unsigned departure. By this deed the signature of the work-squad courier post rose into the ledger."
        },
        "stress": {
          "ko": "작업반 전령 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the work-squad courier duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
