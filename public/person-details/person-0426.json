    "traits": [
      {
        "id": "preserve-wet-documents",
        "name": {
          "ko": "젖은 문서 보존",
          "en": "Preserve Wet Documents"
        },
        "description": {
          "ko": "최수아는 손상된 인준 문서도 기록으로 남기려는 보존 태도를 보인다.",
          "en": "Choi Sua shows a disposition to preserve damaged ratification documents as usable records."
        },
        "behavior": {
          "ko": "승강장에서 물에 젖은 인준 문서를 말리고 필사본을 남겼다.",
          "en": "Choi Sua dried a water-soaked ratification document at a platform and made a handwritten copy."
        },
        "stress": {
          "ko": "기록 공백이 태욱그룹의 통행을 볼모로 만들 우려가 있으면 손상 문서의 내용 보존을 우선할 수 있다.",
          "en": "If a record gap threatens to make Taeuk Group's passage hostage to a powerful nation, Choi Sua may prioritize preserving damaged documents' contents."
        },
        "relationship": {
          "ko": "선배 당직자와 인수인계할 때 훼손된 문서도 이어받을 수 있는 기록으로 남기는 일을 중시할 수 있다.",
          "en": "In handovers with senior duty staff, Choi Sua may emphasize leaving damaged documents in a form successors can use."
        },
        "effects": []
      },
      {
        "id": "handover-accountability",
        "name": {
          "ko": "인수인계 책임",
          "en": "Handover Accountability"
        },
        "description": {
          "ko": "최수아는 당직과 장부가 끊기지 않도록 자기 몫의 인수인계를 중시한다.",
          "en": "Choi Sua values handing over personal responsibilities so duty coverage and ledgers remain continuous."
        },
        "behavior": {
          "ko": "당직을 이어가는 쪽을 택하고 자기 직위의 열쇠와 기록만 넘긴다.",
          "en": "Choi Sua chooses continuity of duty and hands over only the keys and records belonging to the position."
        },
        "stress": {
          "ko": "당직 공백이 태욱그룹의 통행을 위협하면 다음 당직자에게 기록을 잇는 일을 더욱 중시할 수 있다.",
          "en": "If a duty vacancy threatens Taeuk Group's passage, Choi Sua may place greater weight on passing records to the next duty holder."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직자와는 권한 확대보다 열쇠와 기록의 인수인계를 중심으로 신뢰를 쌓으려 할 수 있다.",
          "en": "With senior duty staff in the same locality, Choi Sua may build trust through key and record handovers rather than expanded authority."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "젖은 인준 문서를 말려 필사했다. 기록 보존은 확인되지만 종자 생물학이나 조직 지휘 근거는 없다.",
      "en": "She dried and copied a wet approval document. Preservation is supported, not seed biology or organizational command."
    },
