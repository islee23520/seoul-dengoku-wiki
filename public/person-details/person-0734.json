    "skills": [
      {
        "id": "transmission-gap-check",
        "name": {
          "ko": "송신 공백 확인",
          "en": "Transmission gap checking"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "k734-disposition",
        "name": {
          "ko": "변경 완료를 경계함",
          "en": "Caution about completed changes"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 중계 당직. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: registrar. Title: relay duty. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "공포. 중계 당직 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the relay duty duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 크리스토퍼 스콧은 송신 공백의 확인 기록을 레아 마르탱에게 넘긴다. 레아 마르탱은 게시된 배차 사본의 시각을 확인해 공백 동안 전해지지 않은 변경을 완료 게시로 남기지 않는다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Christopher Scott gives Léa Martin records verifying transmission gaps. Léa checks times on posted dispatch copies rather than marking changes not transmitted during the gap as posted."
        },
        "effects": []
      },
      {
        "id": "k734-choice",
        "name": {
          "ko": "이중 확인 배치",
          "en": "Arranging dual checks"
        },
        "description": {
          "ko": "일화. 2125년 편집 공백이 발견된 밤에 당직 두 명을 세워 이중 확인을 만들었다. 이 일로 중계 당직 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. On the night an editing gap was found in 2125, he stood up two duty hands and made a double check. By this deed the signature of the relay duty post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 크리스토퍼 스콧은 송신 공백의 확인 기록을 레아 마르탱에게 넘긴다. 레아 마르탱은 게시된 배차 사본의 시각을 확인해 공백 동안 전해지지 않은 변경을 완료 게시로 남기지 않는다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Christopher Scott gives Léa Martin records verifying transmission gaps. Léa checks times on posted dispatch copies rather than marking changes not transmitted during the gap as posted."
        },
        "stress": {
          "ko": "공포. 중계 당직 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the relay duty duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 크리스토퍼 스콧은 송신 공백의 확인 기록을 레아 마르탱에게 넘긴다. 레아 마르탱은 게시된 배차 사본의 시각을 확인해 공백 동안 전해지지 않은 변경을 완료 게시로 남기지 않는다.",
