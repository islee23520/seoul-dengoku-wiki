    "skills": [
      {
        "id": "measure",
        "name": {
          "ko": "측량 실측·도면 대조",
          "en": "Survey and drawing comparison"
        },
        "rating": 60
      },
      {
        "id": "seal",
        "name": {
          "ko": "봉인·사본 대조",
          "en": "Seal and copy comparison"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "no-guessed-distances",
        "name": {
          "ko": "추측 거리 배제",
          "en": "No Guessed Distances"
        },
        "description": {
          "ko": "송별하는 추측한 거리 대신 현장에서 확인한 측량 수치만 기록하려 한다.",
          "en": "Song Byeolha seeks to record field-verified measurements rather than guessed distances."
        },
        "behavior": {
          "ko": "측량 숫자를 현장에서 두 번 읽고 도면과 어긋나면 기록을 멈춘다.",
          "en": "They read measurement figures twice on site and stop recording when the figures conflict with the drawing."
        },
        "stress": {
          "ko": "잘못된 거리가 방재 경계로 확정될 우려가 커지면 불일치를 해소하기 전 기록을 멈추려 할 수 있다.",
          "en": "If an incorrect distance risks becoming a disaster-prevention boundary, they may halt recording until the discrepancy is resolved."
        },
        "relationship": {
          "ko": "정호준과 공개 원칙을 함께 지키더라도 측량 원본의 반출 요청에는 선을 그을 수 있다.",
          "en": "Even while sharing Jeong Hojun's openness principle, they may draw a boundary against removing measurement originals."
        },
        "effects": []
      },
      {
        "id": "reject-unmeasured-revisions",
        "name": {
          "ko": "실측 없는 수정 반려",
          "en": "Reject Unmeasured Revisions"
        },
        "description": {
          "ko": "송별하는 현장 실측이 없는 측량 기록 수정을 받아들이지 않는 쪽이다.",
          "en": "Song Byeolha does not accept revisions to measurement records without on-site measurements."
        },
        "behavior": {
          "ko": "실측 없는 수정 요청은 반려하고 그 사유만 난외에 남긴다.",
          "en": "They reject revision requests lacking field measurements and leave only the reason in the margin."
        },
        "stress": {
          "ko": "부정확한 수정이 실험동 봉인으로 이어질 우려가 있으면 실측 근거 요구를 더 엄격히 지킬 수 있다.",
          "en": "If an inaccurate revision could lead to the experimental building being sealed, they may adhere more strictly to requiring measured grounds."
        },
        "relationship": {
          "ko": "수정 요청자와 의견이 갈린다면 반려 사유를 남기고 원본을 교차검증할 수 있는 상태로 지키려 할 수 있다.",
          "en": "If they disagree with a revision requester, they may document the rejection reason and preserve the original for cross-verification."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "측량 수치를 두 번 읽고 도면과 다르면 멈춘다. 실측 대조는 확인되나 원본 반출 금지를 비공개 연구 전체 권한으로 확대하지 않는다.",
      "en": "She reads measured values twice and stops on disagreement with drawings. Survey checks are supported; restrictions on originals do not imply broader secret-research authority."
    },
