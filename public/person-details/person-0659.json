    "traits": [
      {
        "id": "k659-priority",
        "name": {
          "ko": "구조 이동 먼저",
          "en": "Rescue movement first"
        },
        "description": {
          "ko": "우바민의 확인된 행동은 2125년 폭설에 막힌 환승 통로를 뚫어 부상자를 먼저 옮겼다.  반복 성과와 구체적 전문 경력은 미확인이다.",
          "en": "우바민: Anecdote. In 2125 he broke open the snow-blocked transfer passage and moved the injured first. By this deed the signature of the dispatch courier post rose into the ledger. Repeated results and detailed professional experience remain unconfirmed."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: convoy hand. Title: dispatch courier. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "배차 전령 당직이 비면 신내운수의 통행이 노선 면허의 볼모가 되는 것.",
          "en": "Fear. That the dispatch courier duty post would stand empty and the City's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k659-accountability",
        "name": {
