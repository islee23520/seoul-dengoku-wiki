    "skills": [
      {
        "id": "split-custody",
        "name": {
          "ko": "열쇠 봉인 분리 보관",
          "en": "Split key and seal custody"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "권한을 한 손에 모으지 않음",
          "en": "Avoids concentrated custody"
        },
        "description": {
          "ko": "서고 출입을 몸으로 막고 열쇠와 봉인을 분리한다. 수색 입회를 요구하지만 풀린 끈의 원인은 아직 밝혀지지 않았다.",
          "en": "Physically blocks archive entry and separates keys from seals. Requires witnessed searches; the loosened cord’s cause remains unknown."
        },
        "behavior": {
          "ko": "확인된 선택에서는 권한을 한 손에 모으지 않음을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "내부 위조 의심 때 출입 통제를 강화할 수 있다.",
          "en": "May tighten access when internal forgery is suspected."
        },
        "relationship": {
          "ko": "하서진의 초안함을 지키며 곽은재의 감사표를 온도 일지와 맞춘다.",
          "en": "Guards Ha Seojin’s drafts and matches Gwak Eunjae’s audits to temperature logs."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "지하 서고 방어를 독립 조합국 고유 직능으로 남겨 강국 호위병이 초안함 옆에 서는 관행을 없앤다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "방어조 안에서 위조 정서본을 숨긴 자가 나와 정유라의 표준 서식이 내부에서 깨지는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "하서진의 초안함을 지키며 곽은재의 감사표를 온도 일지와 맞춘다.",
          "en": "Guards Ha Seojin’s drafts and matches Gwak Eunjae’s audits to temperature logs."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "서고 출입을 몸으로 막고 열쇠와 봉인을 분리한다. 수색 입회를 요구하지만 풀린 끈의 원인은 아직 밝혀지지 않았다.",
      "en": "Physically blocks archive entry and separates keys from seals. Requires witnessed searches; the loosened cord’s cause remains unknown."
    },
