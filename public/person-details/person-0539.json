    "skills": [
      {
        "id": "departure",
        "name": {
          "ko": "배차표·출발 확인",
          "en": "Departure and dispatch checks"
        },
        "rating": 50
      },
      {
        "id": "handover",
        "name": {
          "ko": "기록·열쇠 인수인계",
          "en": "Record and key handover"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "block-departures-without-dispatch-sheets",
        "name": {
          "ko": "배차표 없는 출발 저지",
          "en": "Block Departures Without Dispatch Sheets"
        },
        "description": {
          "ko": "우은민은 배차표와 서명이 없는 출발을 받아들이지 않는 절차적 성향을 보인다.",
          "en": "U Eunmin shows a procedural reluctance to accept departures lacking a dispatch sheet and signature."
        },
        "behavior": {
          "ko": "배차표 없는 열차를 세워 서명 없는 출발을 막았다.",
          "en": "He stopped a train without a dispatch sheet and prevented an unsigned departure."
        },
        "stress": {
          "ko": "당직 공백이 통행을 강국의 볼모로 만들까 우려되면 출발 기록의 누락에 더 신중해질 수 있다.",
          "en": "If a duty gap could make passage hostage to a powerful state, he may become more cautious about missing departure records."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때는 배차표와 서명의 유무를 분명히 전달하려 할 수 있다.",
          "en": "During handover, he may clearly communicate whether the dispatch sheet and signature are present."
        },
        "effects": []
      },
      {
        "id": "authority-limited-to-records",
        "name": {
          "ko": "권한은 기록만큼",
          "en": "Authority Limited to Records"
        },
        "description": {
          "ko": "우은민은 자기 직위의 열쇠와 기록을 넘기되 없는 권한은 만들지 않는 성향이다.",
          "en": "U Eunmin confines himself to handing over his post's keys and records without inventing authority."
        },
        "behavior": {
          "ko": "출발 확인에서는 배차표와 서명을 요구하고 인계에서는 자기 직위의 범위를 지킨다.",
          "en": "He requires a dispatch sheet and signature for departure checks and keeps handover within his post's scope."
        },
        "stress": {
          "ko": "당직 공백으로 통행이 위태로워져도 명시되지 않은 권한보다 확인 가능한 기록에 의지하려 할 수 있다.",
          "en": "Even if a duty gap threatens passage, he may rely on verifiable records rather than unspecified authority."
        },
        "relationship": {
          "ko": "선배 당직에게도 넘길 열쇠와 기록의 범위를 분명히 하려 할 수 있다.",
          "en": "He may make the scope of the keys and records being transferred clear to the senior duty holder."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "배차표 없는 열차를 세웠다. 실제 출발 확인을 평가하며 공방 전령 직함에서 정비 숙련은 끌어오지 않는다.",
      "en": "He stopped a train without a dispatch sheet. Departure checking is supported, not workshop repair inferred from a messenger title."
    },
