    "skills": [
      {
        "id": "triage-bed-allocation",
        "name": {
          "ko": "중증도 병상 배정",
          "en": "Triage bed allocation"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "적도 환자로 본다",
          "en": "Enemies remain patients"
        },
        "description": {
          "ko": "적의 부상자를 중증도로 받고 임상 판단으로 병상을 연다. 풀린 봉인과 약품 출처 문제의 수습 성공은 미확인이다.",
          "en": "Enemy casualties enter by severity and beds open on clinical judgment. Successful resolution of the loosened seal and medicine provenance issue remains unconfirmed."
        },
        "behavior": {
          "ko": "적의 부상도 중증도만으로 들이고, 진료소를 전리품 창구로 부르라는 쪽지를 찢는다. 진료 소견 표를 침상 발치에 붙인다. 제기동의 중립 의료국 흰십자단에서 수련의를 지도하고 후계자를 지정하며, 적아 구분 없이 중증도만으로 치료한다.",
          "en": "He took even an enemy's wounded in by severity alone and tore up any note that called the clinic a war-booty window. He pasted the contribution-labor table at the foot of the sickbeds."
        },
        "stress": {
          "ko": "공포. 가짜 해열제가 침상에서 쓰인 뒤 진료소가 보호창고 하청으로 찍히는 것.",
          "en": "Fear. That after counterfeit febrifuges were used at the sickbeds the clinic would be stamped a protection-warehouse subcontract."
        },
        "relationship": {
          "ko": "관계. 은채윤의 지휘로 병상을 나누고, 방한울의 당직 원장을 문에 붙인다. 백온의 피난민을 중증도 순으로 받는다.",
          "en": "Relations. Divided the sickbeds under Eun Chaeyun's command and pasted Bang Hanul's duty roster on the door. Received Baek On's refugees in severity order."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 전문의. 직함은 청량리 진료소 전문의. 중증도 표와 진료 소견을 나란히 게시하고, 우선 치료 요청은 담당 전문의의 임상 판단을 거친 뒤에만 침상을 연다.",
          "en": "Office. Rank: supervisor. Title: Cheongnyangni clinic outpost chief, duty officer of Eun Chaeyun. She posted the severity table and contribution labor side by side and opened a sickbed for a priority care request only after it rose to the guild council."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 전문의. 직함은 청량리 진료소 전문의. 중증도 표와 진료 소견을 나란히 게시하고, 우선 치료 요청은 담당 전문의의 임상 판단을 거친 뒤에만 침상을 연다.",
          "en": "Recorded duty and limits: Office. Rank: supervisor. Title: Cheongnyangni clinic outpost chief, duty officer of Eun Chaeyun. She posted the severity table and contribution labor side by side and opened a sickbed for a priority care request only after it rose to the guild council."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 가짜 해열제가 침상에서 쓰인 뒤 진료소가 보호창고 하청으로 찍히는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That after counterfeit febrifuges were used at the sickbeds the clinic would be stamped a protection-warehouse subcontract."
        },
        "relationship": {
          "ko": "관계. 은채윤의 지휘로 병상을 나누고, 방한울의 당직 원장을 문에 붙인다. 백온의 피난민을 중증도 순으로 받는다.",
          "en": "Relations. Divided the sickbeds under Eun Chaeyun's command and pasted Bang Hanul's duty roster on the door. Received Baek On's refugees in severity order."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "적의 부상자를 중증도로 받고 임상 판단으로 병상을 연다. 풀린 봉인과 약품 출처 문제의 수습 성공은 미확인이다.",
      "en": "Enemy casualties enter by severity and beds open on clinical judgment. Successful resolution of the loosened seal and medicine provenance issue remains unconfirmed."
    },
