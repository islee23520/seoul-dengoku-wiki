    "traits": [
      {
        "id": "k797-choice",
        "name": {
          "ko": "보류 중에도 기록",
          "en": "Records during suspension"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "일화. 윤서린이 인준을 보류한 채 함의 봉인만 확인하는 날이 이어진다. 류달현은 봉인을 확인한 시각을 교대마다 연속 기록에 남기고, 보류된 인준 청구를 접수한 차례대로 다음 당직에게 넘긴다.",
          "en": "Anecdote. Day after day Yun Seorin holds ratification and only checks the seal on the case. Ryu Dalhyeon records the time of each seal check in the continuous record at every shift, and passes the held ratification claims to the next shift in the order they were received."
        },
        "stress": {
          "ko": "공포. 인준 기록관 당직이 비면 도심 통행의 도장과 명부가 끊겨 질서 계열 여덟 나라의 인준이 멈추는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That the ratification registrar duty post would stand empty and the Government's passage would become a break in the eight states' recognition. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k797-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 주사. 직함은 인준 기록관. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: registrar. Title: ratification registrar. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 인준 기록관. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: registrar. Title: ratification registrar. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "공포. 인준 기록관 당직이 비면 도심 통행의 도장과 명부가 끊겨 질서 계열 여덟 나라의 인준이 멈추는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That the ratification registrar duty post would stand empty and the Government's passage would become a break in the eight states' recognition. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "일화. 윤서린이 인준을 보류한 채 함의 봉인만 확인하는 날이 이어진다. 류달현은 봉인을 확인한 시각을 교대마다 연속 기록에 남기고, 보류된 인준 청구를 접수한 차례대로 다음 당직에게 넘긴다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Anecdote. Day after day Yun Seorin holds ratification and only checks the seal on the case. Ryu Dalhyeon records the time of each seal check in the continuous record at every shift, and passes the held ratification claims to the next shift in the order they were received. Titles and ambitions are not treated as accomplished authority or results."
    },
