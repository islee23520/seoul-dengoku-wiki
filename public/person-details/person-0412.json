    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "창구를 공개함",
          "en": "Keeps windows public"
        },
        "description": {
          "ko": "대기표와 공증 창구를 매일 공개하고 비준 소문에는 직접 방송을 잡는다. 군수 화차를 회의 호송 뒤에 둔다.",
          "en": "Posts queue tickets and notary windows daily and broadcasts personally when ratification rumors arise. Holds military freight until meeting escorts depart."
        },
        "behavior": {
          "ko": "확인된 선택에서는 창구를 공개함을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "봉쇄 소문 때 직접 방송으로 응답할 수 있다.",
          "en": "May respond personally over the broadcast to closure rumors."
        },
        "relationship": {
          "ko": "안태경의 출석을 집행하고 정유라의 교섭을 우선 게시한다.",
          "en": "Implements An Taegyeong’s attendance and posts Jeong Yura’s bargaining first."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "시청역 대합실을 계약·투표·감사가 한 지붕에서 서명되는 남부 창구로 남겨 강국 외부 통제 창구를 승강장에 열지 못하게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "세 초안 소문만으로 대합실이 봉쇄되고 조합원이 후문 밀차로 흩어지는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
