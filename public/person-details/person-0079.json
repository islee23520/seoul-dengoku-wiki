    "traits": [
      {
        "id": "resist-disclosure-delays",
        "name": {
          "ko": "공개 지연 불복",
          "en": "Resist Disclosure Delays"
        },
        "description": {
          "ko": "고초윤은 혼란 방지를 명분으로 검사 공개를 늦추는 것을 정치적 개입으로 본다.",
          "en": "Go Choyun regards delaying inspection disclosure to prevent unrest as political interference."
        },
        "behavior": {
          "ko": "지연 명령서는 받은 시각만 기록하고 집행하지 않으며 공개 시각을 흥정하지 않는다.",
          "en": "Go Choyun records only the receipt time of delay orders, does not execute them, and refuses to bargain over disclosure timing."
        },
        "stress": {
          "ko": "은폐가 급수와 냉동재고를 함께 무너뜨릴 우려가 커지면 지연 명령에 더욱 단호할 수 있다.",
          "en": "If concealment threatens both water supplies and frozen stocks, Go Choyun may become firmer against delay orders."
        },
        "relationship": {
          "ko": "정호준의 즉시 공개론을 따르면서도 봉인 해제에는 주민대표와 안전심사의 동시 날인을 요구할 수 있다.",
          "en": "Go Choyun may follow Jeong Hojun's immediate-disclosure position while still requiring simultaneous resident and safety-review stamps for unsealing."
        },
        "effects": []
      },
      {
        "id": "no-missing-inspection-figures",
        "name": {
          "ko": "검사 숫자 공백 거부",
          "en": "No Missing Inspection Figures"
        },
        "description": {
          "ko": "고초윤은 탁도 수치 한 칸의 누락도 검사 공개의 결함으로 여긴다.",
          "en": "Go Choyun treats even one missing turbidity figure as a defect in inspection disclosure."
        },
        "behavior": {
          "ko": "탁도 숫자의 빈칸을 용납하지 않으며 봉인 구역 진입 허가를 거절한 사건에서는 우회 검증을 설계했다.",
          "en": "Go Choyun rejects blank turbidity entries and designed alternative verification in the incident involving refusal of sealed-zone entry permission."
        },
        "stress": {
          "ko": "은폐의 책임이 연구자에게 전가될 우려가 있으면 검사 수치의 공백을 더욱 경계할 수 있다.",
          "en": "If researchers risk being blamed for concealment, Go Choyun may be especially wary of gaps in inspection figures."
        },
        "relationship": {
          "ko": "장예린의 검사망을 증언으로 뒷받침할 때도 수치가 빠지지 않은 공개 기록을 중시할 수 있다.",
          "en": "When supporting Jang Yerin's inspection network through testimony, Go Choyun may emphasize complete public numerical records."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "검사표의 이중 날인을 확인하고 우회 검증을 설계했다. 공개 입회와 검증 설계를 평가하며 검사망 전체 운영을 복사하지 않는다.",
      "en": "He checks dual signatures and designed alternate verification. Disclosure witnessing is supported without copying control of the entire inspection network."
    },
