    "traits": [
      {
        "id": "k029-trait-1",
        "name": {
          "ko": "등록보다 시민권",
          "en": "Citizenship before registration"
        },
        "description": {
          "ko": "수리하는 손을 복무 조건에 종속시키지 않으려 한다.",
          "en": "Resists subordinating repairing hands to service terms."
        },
        "behavior": {
          "ko": "수리하는 손을 복무 조건에 종속시키지 않으려 한다.",
          "en": "Resists subordinating repairing hands to service terms."
        },
        "stress": {
          "ko": "부품이 막혀도 등록 조건의 상자를 되돌린다.",
          "en": "Returns the box even when parts access is at stake."
        },
        "relationship": {
          "ko": "한재목과 공급 동맹을 유지하면서 배우진의 조건에 맞선다.",
          "en": "Maintains supply ties with Han Jaemok while opposing Bae Woojin’s terms."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "복구복무자 등록을 거부한 사람을 시민권 줄에 올렸고 등록 명부가 부품의 대가로 제시되자 상자를 봉해 돌려보냈다. 공방의 자율성을 지키는 선택은 서부 급수에 남긴 빚과 분리되지 않는다.",
      "en": "She placed people refusing restoration-service registration on the citizenship line and returned a sealed parts box when registration was demanded as its price. Protecting workshop autonomy also left a debt to western water supply."
    },
