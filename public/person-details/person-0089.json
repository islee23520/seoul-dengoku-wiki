    "skills": [
      {
        "id": "workshop",
        "name": {
          "ko": "공정 분할·교대 조정",
          "en": "Process distribution and shift coordination"
        },
        "rating": 65
      },
      {
        "id": "bargain",
        "name": {
          "ko": "교대 조건 조정",
          "en": "Shift-condition mediation"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "divide-work-processes",
        "name": {
          "ko": "공정 나누기",
          "en": "Divide Work Processes"
        },
        "description": {
          "ko": "한소미는 핵심 공정을 여러 공방에 나누고 공동 기록으로 묶으려 한다.",
          "en": "Han Somi favors distributing core processes among workshops under shared records."
        },
        "behavior": {
          "ko": "핵심 공정을 분산하고 마지막 조립 기록은 평의회 금고에 두며 교대 조건을 직접 협의한다.",
          "en": "She distributes core processes, stores final assembly records in the council vault, and directly negotiates shift conditions."
        },
        "stress": {
          "ko": "공방이 세습 직능의 하청으로 밀릴 우려가 커지면 공정 분산과 공동 승인에 더 무게를 둘 수 있다.",
          "en": "If workshops risk becoming hereditary subcontractors, she may place greater weight on distributed processes and joint approval."
        },
        "relationship": {
          "ko": "임하준에게 공정 분할의 빚을 인정하면서도 박세린의 가문 대행이 공정을 독점하려 하면 견제할 수 있다.",
          "en": "She acknowledges her debt to Im Hajun for process division but may check Park Serin if family representation threatens to monopolize those processes."
        },
        "effects": []
      },
      {
        "id": "oppose-hereditary-succession",
        "name": {
          "ko": "혈통 승계 반대",
          "en": "Oppose Hereditary Succession"
        },
        "description": {
          "ko": "한소미는 총관의 정당성이 혈통이 아니라 공방의 동의에서 나와야 한다고 본다.",
          "en": "Han Somi believes the chief's legitimacy should come from workshop consent rather than bloodline."
        },
        "behavior": {
          "ko": "빈 도장은 대표 연서로 대행하고 공동규격과 총관 선임을 평의회 투표와 공방 동의에 연결한다.",
          "en": "She substitutes representative co-signatures for the vacant seal and ties shared standards and chief selection to council votes and workshop consent."
        },
        "stress": {
          "ko": "가문 편 유언이 진본으로 인준될 가능성이 커지면 세습을 막는 동의 절차를 더 강하게 요구할 수 있다.",
          "en": "If a family-favoring will seems likely to be authenticated, she may press harder for consent procedures that block hereditary succession."
        },
        "relationship": {
          "ko": "임초원과 후계를 경쟁하더라도 혈통을 앞세우는 박세린과는 더 근본적인 갈등을 빚을 수 있다.",
          "en": "Although she competes with Im Chowon over succession, her conflict with bloodline-focused Park Serin may be more fundamental."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "공정을 여러 공방에 나누고 태업 작업반과 교대를 협의했다. 공방 동의의 제도 구상과 직접 조정이 근거이며 손끝 비유를 전투 기술로 쓰지 않는다.",
      "en": "She distributes processes among workshops and negotiated a shift with a work-to-rule crew. Consent-based institutional planning and mediation are supported; nimble hands do not imply combat skill."
    },
