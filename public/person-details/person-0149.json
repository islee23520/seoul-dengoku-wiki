    "traits": [
      {
        "id": "k148-choice",
        "name": {
          "ko": "빈 조항을 거부",
          "en": "Rejects empty clauses"
        },
        "description": {
          "ko": "계산이 빠르고 문구의 빈칸을 싫어한다. 구두 약속은 약속이 아니라고 반복한다.",
          "en": "Quick of arithmetic, he hated blanks in wording. He repeated that a verbal promise was not a promise."
        },
        "behavior": {
          "ko": "일화. 뚝섬 급수계약 만료일이 공증 원장에 빨갛게 표시된 채 세 강국의 서로 다른 문안이 동시에 들어왔다.",
          "en": "Anecdote. With the Ttukseom water contract's expiry day marked red on the notary ledger, three great powers' different drafts arrived at once."
        },
        "stress": {
          "ko": "공포. 집단 단수 조항을 공증한 뒤 그 물이 서울역 자체에 꺼지는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That after he notarized a collective cutoff clause, that water would stop at Seoul Station itself. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 윤서린에게 공증 권한을 위임받았고 한재목의 서부 급수문안을 심사 중이다. 권시온과는 용산 철도계약 공증을 거래한다.",
          "en": "Relations. Received notary authority delegated from Yun Seorin and was reviewing Han Jaemok's western water draft. Traded the notarization of the Yongsan rail contract with Gwon Sion."
        },
        "effects": []
      },
      {
        "id": "k148-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 주사. 직함은 계약 공증관. 조항마다 종료 조건과 증인란을 강제하고, 인장이 마른 뒤에만 사본을 내준다.",
          "en": "Office. Rank: registrar. Title: contract notary. He forced exit conditions and witness lines into every clause and gave out copies only after the stamps dried."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 계약 공증관. 조항마다 종료 조건과 증인란을 강제하고, 인장이 마른 뒤에만 사본을 내준다.",
          "en": "Office. Rank: registrar. Title: contract notary. He forced exit conditions and witness lines into every clause and gave out copies only after the stamps dried."
        },
        "stress": {
          "ko": "공포. 집단 단수 조항을 공증한 뒤 그 물이 서울역 자체에 꺼지는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That after he notarized a collective cutoff clause, that water would stop at Seoul Station itself. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 윤서린에게 공증 권한을 위임받았고 한재목의 서부 급수문안을 심사 중이다. 권시온과는 용산 철도계약 공증을 거래한다.",
          "en": "Relations. Received notary authority delegated from Yun Seorin and was reviewing Han Jaemok's western water draft. Traded the notarization of the Yongsan rail contract with Gwon Sion."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "종료 조건과 증인란을 요구하고 마른 인장 뒤에 사본을 내준다. 세 문안 접수는 교섭 타결이나 헌법 제정의 성과가 아니다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Requires termination conditions and witnesses before releasing sealed copies. Receiving three drafts is not a negotiated settlement or constitution-making. Titles and ambitions are not treated as accomplished authority or results."
    },
