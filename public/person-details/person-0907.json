    "skills": [
      {
        "id": "review",
        "name": {
          "ko": "훈련 보고 재검토",
          "en": "Exercise report review"
        },
        "rating": 50
      },
      {
        "id": "guard",
        "name": {
          "ko": "출입 저지·암호패 교체",
          "en": "Entry control and pass replacement"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "correct-false-reports",
        "name": {
          "ko": "틀린 보고 정정",
          "en": "Correct False Reports"
        },
        "description": {
          "ko": "신새민은 틀린 최초 보고를 고정된 판단으로 두지 않고 재검토하려는 성향을 보인다.",
          "en": "Sin Saemin shows a disposition to revisit an incorrect initial report rather than treat it as settled judgment."
        },
        "behavior": {
          "ko": "교량 습격 훈련에서 최초 보고가 틀리자 참관 칸을 다시 열어 재검토의 여지를 만들었다.",
          "en": "When the initial report in a bridge-attack drill proved wrong, he reopened the observation section to allow review."
        },
        "stress": {
          "ko": "당직 연속성을 지켜야 한다는 부담 속에서도 보고 오류가 드러나면 판단을 다시 확인하려 할 수 있다.",
          "en": "Even under pressure to maintain duty continuity, he may recheck judgment when a reporting error emerges."
        },
        "relationship": {
          "ko": "선배 당직과는 틀린 보고를 그대로 넘기기보다 재검토 필요를 공유하려 할 수 있다.",
          "en": "With senior duty staff, he may seek to share the need for review rather than pass on an incorrect report unchanged."
        },
        "effects": []
      },
      {
        "id": "allow-observation-again",
        "name": {
          "ko": "참관 다시 허용",
          "en": "Allow Observation Again"
        },
        "description": {
          "ko": "신새민은 보고가 틀렸을 때 다시 관찰할 수 있도록 여지를 여는 성향을 보인다.",
          "en": "Sin Saemin shows a disposition to reopen opportunities for observation when a report proves incorrect."
        },
        "behavior": {
          "ko": "교량 습격 훈련의 최초 보고 오류 뒤 참관 칸을 다시 열었다.",
          "en": "He reopened the observation section after the initial report error in the bridge-attack drill."
        },
        "stress": {
          "ko": "오류를 둔 채 당직을 이어야 할 우려가 생기면 참관을 다시 허용해 확인 기회를 확보하려 할 수 있다.",
          "en": "If he risks continuing duty with an unresolved error, he may reopen observation to secure another chance to check."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 최초 보고뿐 아니라 다시 확인할 여지도 함께 전달하려 할 수 있다.",
          "en": "During handover to senior duty staff, he may seek to convey room for renewed checking alongside the initial report."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "교량 훈련 보고가 틀리자 참관을 다시 열었다. 수정 가능한 판단을 평가하며 훈련 참가를 실전 전과로 바꾸지 않았다.",
      "en": "She reopened observation after an incorrect bridge-exercise report. Revisable judgment is reflected; participation is not treated as combat achievement."
    },
