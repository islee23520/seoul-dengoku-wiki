    "traits": [
      {
        "id": "transparent-losses",
        "name": {
          "ko": "손실 공개",
          "en": "Transparent Losses"
        },
        "description": {
          "ko": "구선율은 식량 손실을 감추기보다 주민에게 드러내는 태도를 보인다.",
          "en": "Gu Seonyul favors making food losses visible to residents rather than concealing them."
        },
        "behavior": {
          "ko": "썩기 시작한 곡물을 먼저 나눠 주고 그 손실 장부를 공개했다.",
          "en": "Gu Seonyul distributed grain that had begun to spoil and disclosed the loss ledger."
        },
        "stress": {
          "ko": "식량 손실과 급수계약의 위험이 겹치면 주민이 확인할 수 있는 기록을 더욱 중시할 수 있다.",
          "en": "If food losses coincide with risky water contracts, Gu Seonyul may place greater weight on records residents can inspect."
        },
        "relationship": {
          "ko": "김도하의 주민대표 연서를 집행할 때 손실을 공개하는 방식으로 주민에게 설명하려 할 수 있다.",
          "en": "When implementing Kim Doha's residents' petition, Gu Seonyul may seek to explain losses through open records."
        },
        "effects": []
      },
      {
        "id": "no-auctions-without-rations",
        "name": {
          "ko": "배급 없는 경매 중단",
          "en": "No Auctions Without Rations"
        },
        "description": {
          "ko": "구선율은 시장 거래보다 원수와 식량의 최저선을 우선한다.",
          "en": "Gu Seonyul places minimum raw-water and food provision ahead of market transactions."
        },
        "behavior": {
          "ko": "원수 배급표가 비면 경매를 중단하고 연구 파견 인원보다 배급 솥 숫자를 먼저 표결에 올린다.",
          "en": "Gu Seonyul halts auctions when the raw-water ration sheet is empty and puts ration-pot counts to a vote before research staffing."
        },
        "stress": {
          "ko": "급수계약이 주민 명부를 넘길 위험이 있으면 배급을 거래 조건보다 앞세울 수 있다.",
          "en": "If a water contract threatens to surrender the residents' register, Gu Seonyul may put ration safeguards ahead of deal terms."
        },
        "relationship": {
          "ko": "한지온과 식량을 교환할 때도 주민의 원수·식량 최저선이 지켜지는지를 중시할 수 있다.",
          "en": "In food exchanges with Han Jion, Gu Seonyul may prioritize maintaining residents' minimum water and food provision."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "썩는 곡물을 먼저 배분하고 손실을 공개했다. 식량 거래와 부패 대응을 평가하며 종자 연구 숙련은 없다.",
      "en": "She distributed spoiling grain first and disclosed losses. Food exchange and spoilage response are supported, not seed research."
    },
