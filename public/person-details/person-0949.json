    "skills": [
      {
        "id": "hazardous-section-closure",
        "name": {
          "ko": "위험 구간 폐쇄",
          "en": "Hazardous section closure"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "보고 뒤 바로 닫는다",
          "en": "Closes promptly after a report"
        },
        "description": {
          "ko": "침수 붕괴 보고를 미루지 않고 구간을 닫았다. 위험 인지의 좁은 강점은 반영하되 이후 복구나 구조 성과는 없다.",
          "en": "Flooding collapse was reported without delay and the section closed. Narrow hazard awareness is reflected; later repairs or rescue outcomes are not recorded."
        },
        "behavior": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "stress": {
          "ko": "공포. 초소 전령 당직이 비면 아관사의 통행이 강국 볼모가 되는 것.",
          "en": "Fear. That the outpost courier duty post would stand empty and the Government's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 병장. 직함은 아관사 초소 전령. 자기 직위의 열쇠와 기록만 넘기고, 전쟁과 급수의 양군 승인 없이 한쪽 군령만으로 권한을 만들지 않는다.",
          "en": "Office. Rank: sergeant. Title: outpost courier. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 병장. 직함은 아관사 초소 전령. 자기 직위의 열쇠와 기록만 넘기고, 전쟁과 급수의 양군 승인 없이 한쪽 군령만으로 권한을 만들지 않는다.",
          "en": "Recorded duty and limits: Office. Rank: sergeant. Title: outpost courier. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 초소 전령 당직이 비면 아관사의 통행이 강국 볼모가 되는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That the outpost courier duty post would stand empty and the Government's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "침수 붕괴 보고를 미루지 않고 구간을 닫았다. 위험 인지의 좁은 강점은 반영하되 이후 복구나 구조 성과는 없다.",
      "en": "Flooding collapse was reported without delay and the section closed. Narrow hazard awareness is reflected; later repairs or rescue outcomes are not recorded."
    },
