    "traits": [
      {
        "id": "k056-public-order-before-dispatch",
        "name": {
          "ko": "공개 순서 뒤 출고",
          "en": "Dispatch after public ordering"
        },
        "description": {
          "ko": "추첨과 숙련 공개 전에 들어온 요구를 미룬다.",
          "en": "Defers requests arriving before lottery and skill publication."
        },
        "behavior": {
          "ko": "추첨과 숙련 공개 전에 들어온 요구를 미룬다.",
          "en": "Defers requests arriving before lottery and skill publication."
        },
        "stress": {
          "ko": "병참 열차가 차단문 전투조의 탄약칸으로 바뀌고, 규격맹이 부품 봉쇄의 다른 이름이 되는 것.",
          "en": "That commissariat trains would turn into the barrier-gate combat squads' ammunition cars, and the Fabrication The Gauge would become another name for the parts blockade."
        },
        "relationship": {
          "ko": "최다인의 공병 작업반과 출고 순서를 다투고, 강민서의 규격맹 통일안을 물자표로 옮기며, 서부 호송의 기바름과 부품 칸을 교환한다.",
          "en": "Contesting release order with Choi Dain's engineering squads, moving Gang Minseo's fabrication alliance unification plan onto supply tables, and exchanging parts columns with Ki Bareum of the western convoys."
        },
        "effects": []
      },
      {
        "id": "k056-repair-not-ammunition",
        "name": {
          "ko": "수리 물자를 지킨다",
          "en": "Protect repair supplies"
        },
        "description": {
          "ko": "비밀 군수 칸을 출력과 함께 잠근다.",
          "en": "Locks secret military compartments with generator output."
        },
        "behavior": {
          "ko": "비밀 군수 칸을 출력과 함께 잠근다.",
          "en": "Locks secret military compartments with generator output."
        },
        "stress": {
          "ko": "병참 열차가 차단문 전투조의 탄약칸으로 바뀌고, 규격맹이 부품 봉쇄의 다른 이름이 되는 것.",
          "en": "That commissariat trains would turn into the barrier-gate combat squads' ammunition cars, and the Fabrication The Gauge would become another name for the parts blockade."
        },
        "relationship": {
          "ko": "최다인의 공병 작업반과 출고 순서를 다투고, 강민서의 규격맹 통일안을 물자표로 옮기며, 서부 호송의 기바름과 부품 칸을 교환한다.",
