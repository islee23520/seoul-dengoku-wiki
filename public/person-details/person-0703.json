    "traits": [
      {
        "id": "k703-disposition",
        "name": {
          "ko": "상할 곡물 먼저",
          "en": "Spoiling grain first"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 교도. 직함은 얼음 물류상.",
          "en": "Office. Rank: lay instructor. Title: ice logistics merchant."
        },
        "stress": {
          "ko": "공포. 얼음 물류상 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the ice logistics merchant duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k703-choice",
        "name": {
          "ko": "공개 손실 감수",
          "en": "Accepting public loss disclosure"
        },
        "description": {
          "ko": "일화. 2125년 썩기 시작한 곡물을 먼저 나눠 주고 손실 장부를 공개했다. 이 일로 얼음 물류상 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he distributed the grain that had begun to rot first and published the loss ledger. By this deed the signature of the ice logistics merchant post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "stress": {
          "ko": "공포. 얼음 물류상 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the ice logistics merchant duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "상하기 시작한 곡물을 나누며 손실을 드러냈다. 배급과 기록의 제한된 근거이고 가문 재정 운영은 없다.",
      "en": "Shares grain beginning to spoil and exposes the loss. Supports limited distribution and records, not house financial management."
    },
