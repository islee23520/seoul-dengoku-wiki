    "traits": [
      {
        "id": "k348-trait-1",
        "name": {
          "ko": "먼저 막고 함께 승인",
          "en": "Early controls with joint approval"
        },
        "description": {
          "ko": "위험 소문에 통행 조건을 먼저 강화한다.",
          "en": "Tightens access conditions early in response to risk reports."
        },
        "behavior": {
          "ko": "위험 소문에 통행 조건을 먼저 강화한다.",
          "en": "Tightens access conditions early in response to risk reports."
        },
        "stress": {
          "ko": "정수 중단 소문이 돌면 능선 통행을 허가제로 묶는다.",
          "en": "Places ridge travel under permits when water interruption is rumored."
        },
        "relationship": {
          "ko": "탁서윤의 결재를 건너뛰어 전쟁·급수를 결정할 수 없다.",
          "en": "Cannot bypass Tak Seoyun’s approval on war or water."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "정수 중단 소문이 돌자 능선 통행을 허가제로 바꾸었다. 고서준과 탁서윤의 지휘부는 별도로 선출되어 서로를 감시하며 전쟁과 급수는 공동 승인을 거친다. 선제 대응이 단독 결정권을 뜻하지 않는다.",
      "en": "He introduced ridge-access permits after rumors of interrupted water purification. His command and Tak Seoyun’s are independently elected and monitor each other; war and water require joint approval. Early action does not grant unilateral authority."
    },
