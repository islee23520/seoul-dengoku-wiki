    "skills": [
      {
        "id": "k505-sealed-record-linking",
        "name": {
          "ko": "봉인·등기 기록 연결",
          "en": "Linking seal and registry records"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "k505-action-priority",
        "name": {
          "ko": "봉인과 빚의 줄",
          "en": "Seal records and debt entries"
        },
        "description": {
          "ko": "동방사가 펌프 부품 상자 대신 내밀었던 복구복무자 명부의 사본이 기록관 당직에 들어온다. 박하은은 강민서가 봉한 채 돌려보낸 상자의 봉인 기록을 사본 옆에 붙이고, 한재목의 서부 급수와 배우진의 병조 사이에 남은 빚이 어느 줄에서 비롯하는지 등기 순서대로 적는다.",
          "en": "A copy of the restoration-service roster that the Eastern Command once offered in place of the pump-parts crates reaches the records duty. Park Haeun pins the seal record of the crates Gang Minseo sent back sealed beside the copy, and writes out in registry order the line from which the debt between Han Jaemok's western water supply and Bae Woojin's military bureau begins."
        },
        "behavior": {
          "ko": "동방사가 펌프 부품 상자 대신 내밀었던 복구복무자 명부의 사본이 기록관 당직에 들어온다. 박하은은 강민서가 봉한 채 돌려보낸 상자의 봉인 기록을 사본 옆에 붙이고, 한재목의 서부 급수와 배우진의 병조 사이에 남은 빚이 어느 줄에서 비롯하는지 등기 순서대로 적는다.",
          "en": "A copy of the restoration-service roster that the Eastern Command once offered in place of the pump-parts crates reaches the records duty. Park Haeun pins the seal record of the crates Gang Minseo sent back sealed beside the copy, and writes out in registry order the line from which the debt between Han Jaemok's western water supply and Bae Woojin's military bureau begins."
        },
        "stress": {
          "ko": "복구복무 기록관 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the restoration service registrar duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k505-bounded-handover",
        "name": {
          "ko": "기록으로 잇는 당직",
          "en": "Duty linked by records"
        },
        "description": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "behavior": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "stress": {
          "ko": "복구복무 기록관 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the restoration service registrar duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "동방사가 펌프 부품 상자 대신 내밀었던 복구복무자 명부의 사본이 기록관 당직에 들어온다. 박하은은 강민서가 봉한 채 돌려보낸 상자의 봉인 기록을 사본 옆에 붙이고, 한재목의 서부 급수와 배우진의 병조 사이에 남은 빚이 어느 줄에서 비롯하는지 등기 순서대로 적는다. 짧은 행위와 인수인계가 근거여서 다른 분야의 숙련이나 보정은 발급하지 않았다.",
      "en": "A copy of the restoration-service roster that the Eastern Command once offered in place of the pump-parts crates reaches the records duty. Park Haeun pins the seal record of the crates Gang Minseo sent back sealed beside the copy, and writes out in registry order the line from which the debt between Han Jaemok's western water supply and Bae Woojin's military bureau begins. The brief action and handover support only limited strengths; no unrelated proficiency or numeric trait bonus is issued."
    },
