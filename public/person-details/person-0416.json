    "skills": [
      {
        "id": "signature-clause-recording",
        "name": {
          "ko": "서명 조항 정서",
          "en": "Signature and clause transcription"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "조항과 증인 분리 기록",
          "en": "Records clauses and witnesses distinctly"
        },
        "description": {
          "ko": "투표 인장이 마를 때까지 함을 잠그고 식량과 호송 조항을 따로 모았다. 하나의 서명으로 여러 초안을 묶으라는 요구를 거절한다.",
          "en": "Keeps the box locked until voting stamps dry and records food and escort clauses separately. Rejects combining several drafts under one signature."
        },
        "behavior": {
          "ko": "확인된 선택에서는 조항과 증인 분리 기록을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "번호가 비거나 성급한 통합 요구가 오면 붓을 놓을 수 있다.",
          "en": "May stop writing over missing numbers or rushed consolidation."
        },
        "relationship": {
          "ko": "초나루와 창고운의 조항을 모으고 안태경의 출석을 증인으로 둔다.",
          "en": "Collects Cho Naru’s and Chang Goun’s clauses and uses An Taegyeong’s attendance as witness evidence."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "공동교섭 문안을 시청역 서기 원장에만 유효하게 남겨 강국이 서로 다른 대외 초안으로 도장을 쪼개지 못하게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "위조 정서본 한 장이 먼저 나가 자신이 분할 복속의 들러리가 되는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "초나루와 창고운의 조항을 모으고 안태경의 출석을 증인으로 둔다.",
          "en": "Collects Cho Naru’s and Chang Goun’s clauses and uses An Taegyeong’s attendance as witness evidence."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "투표 인장이 마를 때까지 함을 잠그고 식량과 호송 조항을 따로 모았다. 하나의 서명으로 여러 초안을 묶으라는 요구를 거절한다.",
      "en": "Keeps the box locked until voting stamps dry and records food and escort clauses separately. Rejects combining several drafts under one signature."
    },
