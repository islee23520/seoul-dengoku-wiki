    "skills": [
      {
        "id": "save-register",
        "name": {
          "ko": "위기 인명 장부 보존",
          "en": "Emergency preservation of personnel registers"
        },
        "rating": 45
      },
      {
        "id": "departure",
        "name": {
          "ko": "배차표·출발 확인",
          "en": "Departure and dispatch checks"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "save-ledgers-before-cargo",
        "name": {
          "ko": "화물보다 장부 구조",
          "en": "Save Ledgers Before Cargo"
        },
        "description": {
          "ko": "김아호는 화물보다 인명 장부의 보존을 우선하는 성향을 보인다.",
          "en": "Kim Aho shows a disposition to prioritize preserving the register of people over cargo."
        },
        "behavior": {
          "ko": "호송 중 습격을 받자 화물보다 인명 장부부터 챙겼다.",
          "en": "When the convoy was attacked, he secured the register of people before the cargo."
        },
        "stress": {
          "ko": "습격과 당직 단절의 우려가 겹치면 기록을 잃지 않는 선택에 더 무게를 둘 수 있다.",
          "en": "If attack pressure coincides with fears of interrupted duty, he may give greater weight to preserving records."
        },
        "relationship": {
          "ko": "선배 당직과의 인계에서는 화물보다 먼저 지킨 인명 기록의 연속성을 중시할 수 있다.",
          "en": "In handovers with senior duty staff, he may emphasize continuity of the personal records he prioritized over cargo."
        },
        "effects": []
      },
      {
        "id": "next-handover-accountability",
        "name": {
          "ko": "다음 인계 책임",
          "en": "Next Handover Accountability"
        },
        "description": {
          "ko": "김아호는 지켜낸 인명 장부를 다음 당직으로 이어 넘기는 책임을 중시한다.",
          "en": "Kim Aho values responsibility for carrying the preserved register forward to the next duty shift."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 인계하며 장부가 끊기지 않도록 맡은 범위를 지킨다.",
          "en": "He hands over only his position’s keys and records, staying within his remit to maintain ledger continuity."
        },
        "stress": {
          "ko": "당직 공백이 통행의 종속으로 이어질까 우려되면 다음 인계의 누락을 더 경계할 수 있다.",
          "en": "If a duty gap could make passage dependent on a powerful state, he may become more alert to handover omissions."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과는 맡은 기록을 정확히 이어 주는 책임을 통해 신뢰를 쌓으려 할 수 있다.",
          "en": "With senior duty staff in his community, he may seek trust through accountable transfer of the records in his care."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "호송 습격에서 인명 장부를 챙겼다. 기록을 선택한 행동이며 난입자를 제압했다고 쓰지 않았다.",
      "en": "She preserved personnel registers during a convoy attack. The choice of records is supported; subduing attackers is not claimed."
    },
