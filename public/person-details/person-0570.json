    "traits": [
      {
        "id": "mark-missing-safety-stamps",
        "name": {
          "ko": "빈 안전 날인 표시",
          "en": "Mark Missing Safety Stamps"
        },
        "description": {
          "ko": "유바영은 주민대표 날인과 별개로 요구된 안전심사 날인의 공백을 분명히 드러내는 편이다.",
          "en": "Yu Bayeong favors making the missing required safety-review stamp explicit despite the resident representative's stamp."
        },
        "behavior": {
          "ko": "종자 출고 요청서의 안전심사 날인 칸이 비었다는 사실을 인수인계 기록 첫 줄에 적었다.",
          "en": "Yu Bayeong wrote on the first handover line that the seed-release request lacked a safety-review stamp."
        },
        "stress": {
          "ko": "주민대표 날인과 박진솔의 안전심사 요구가 맞물릴 때 빈 칸을 기록해 미충족 조건을 드러내려 할 수 있다.",
          "en": "When the resident representative's stamp meets Bak Jinsol's safety-review requirement, Yu Bayeong may record the blank field to expose the unmet condition."
        },
        "relationship": {
          "ko": "다음 당직이 요청을 넘겨받을 때 안전심사 날인이 없다는 사실을 먼저 알리려 할 수 있다.",
          "en": "Yu Bayeong may make the missing safety-review stamp the first fact conveyed to the next duty holder."
        },
        "effects": []
      },
      {
        "id": "requests-and-keys-together",
        "name": {
          "ko": "요청서와 열쇠 함께",
          "en": "Requests and Keys Together"
        },
        "description": {
          "ko": "유바영은 미완료 요청의 문서와 관련 열쇠를 함께 넘겨 인계 맥락을 보존하는 편이다.",
          "en": "Yu Bayeong favors preserving handover context by transferring an incomplete request with its associated key."
        },
        "behavior": {
          "ko": "날인 공백을 기록한 뒤 요청서와 보존고 열쇠를 한데 묶어 다음 당직에게 건넸다.",
          "en": "After recording the missing stamp, Yu Bayeong bundled the request with the storage key and handed them to the next duty holder."
        },
        "stress": {
          "ko": "당직 공백이 통행을 볼모로 만들까 우려하면 미완료 조건과 열쇠가 분리되지 않도록 살필 수 있다.",
          "en": "Fear that a duty gap could leave passage hostage may encourage keeping the unresolved condition and key together."
        },
        "relationship": {
          "ko": "다음 당직과는 요청서와 열쇠를 함께 전달해 남은 확인 사항을 공유하려 할 수 있다.",
          "en": "With the next duty holder, Yu Bayeong may share outstanding checks by transferring the request and key together."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "안전심사 날인이 빈 종자 요청을 인계 첫 줄에 기록하고 열쇠와 묶어 넘겼다. 구체적인 출고 조건 확인이 강점이다.",
      "en": "She marked a missing safety signature first and passed the request with the key. Specific seed-release checks are her supported strength."
    },
