    "skills": [
      {
        "id": "defect-reporting",
        "name": {
          "ko": "정비 결함 보고",
          "en": "Maintenance defect reporting"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "공개 시험을 지킴",
          "en": "Protects public testing"
        },
        "description": {
          "ko": "탈선 직전 결함을 보고한 생애와 시험 점수 게시가 있다. 비공개 파견 명단이 돌자 시험 창을 닫았다.",
          "en": "Has a recorded pre-derailment defect report and posts examination scores. Closes the test window when private dispatch lists circulate."
        },
        "behavior": {
          "ko": "확인된 선택에서는 공개 시험을 지킴을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "파견 압박 때 출고 스위치를 잠글 수 있다.",
          "en": "May lock dispatch switches under pressure for deployments."
        },
        "relationship": {
          "ko": "은보람의 규칙을 실무로 받치며 원초온과 공구를 나눈다.",
          "en": "Supports Eun Boram’s rules in practice and shares tools with Won Choon."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "시청역 조합 차량정비소 전문 인력 추천을 공개 숙련 시험과 정비 서명으로 바꿔 조합원 총회에서 파벌의 독점 추천을 깨뜨린다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "정비창이 강국에 기술자를 넘기는 인질 창구가 되어 공구가 인장의 하청이 되는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "은보람의 규칙을 실무로 받치며 원초온과 공구를 나눈다.",
          "en": "Supports Eun Boram’s rules in practice and shares tools with Won Choon."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "탈선 직전 결함을 보고한 생애와 시험 점수 게시가 있다. 비공개 파견 명단이 돌자 시험 창을 닫았다.",
      "en": "Has a recorded pre-derailment defect report and posts examination scores. Closes the test window when private dispatch lists circulate."
    },
