    "traits": [
      {
        "id": "k298-priority",
        "name": {
          "ko": "중증도 우선",
          "en": "Severity first"
        },
        "description": {
          "ko": "전미리는 부족한 처방량을 나눠 모두에게 배분했다. 활력 안정 뒤에 배차 요구를 받으며 국적보다 들것 순서를 둔다.",
          "en": "Jeon Miri divided scarce prescriptions among everyone. She accepts dispatch requests after vital stabilization and puts stretcher order before nationality."
        },
        "behavior": {
          "ko": "중증도 표와 이송 시각을 의료조 당직실에 붙이고, 배차조의 빈 슬롯 요구는 환자 활력이 안정된 뒤에만 받는다.",
          "en": "Office. Rank: convoy hand. Title: medical assistant. She pasted the severity table and transfer hours in the medical crew's duty room and took the dispatch crew's empty-slot demands only after the patients' vitals were stable."
        },
        "stress": {
          "ko": "환자 칸이 군수 칸으로 오인되어 호송대 전체가 무장 해제를 당하는 것.",
          "en": "Fear. That the patient cars would be mistaken for munitions cars and the whole convoy squad would be disarmed."
        },
        "relationship": {
          "ko": "장세화와 류은비의 의료동맹을 현장에서 집행하고, 안도한의 배차 독주를 견제하며, 은채윤에게 제기동 수용 병상을 빌려 쓴다.",
          "en": "Relations. Executed the medical alliance of Jang Sehwa and Ryu Eunbi in the field, checked An Dohan's dispatch solo runs, and borrowed sickbeds from Eun Chaeyun in Jegi-dong."
        },
        "effects": []
      },
      {
        "id": "k298-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 호송원. 직함은 의료 조원. 중증도 표와 이송 시각을 의료조 당직실에 붙이고, 배차조의 빈 슬롯 요구는 환자 활력이 안정된 뒤에만 받는다.",
          "en": "Office. Rank: convoy hand. Title: medical assistant. She pasted the severity table and transfer hours in the medical crew's duty room and took the dispatch crew's empty-slot demands only after the patients' vitals were stable."
        },
        "stress": {
          "ko": "공포. 환자 칸이 군수 칸으로 오인되어 호송대 전체가 무장 해제를 당하는 것.",
          "en": "Fear. That the patient cars would be mistaken for munitions cars and the whole convoy squad would be disarmed."
        },
        "relationship": {
          "ko": "관계. 장세화와 류은비의 의료동맹을 현장에서 집행하고, 안도한의 배차 독주를 견제하며, 은채윤에게 제기동 수용 병상을 빌려 쓴다.",
          "en": "Relations. Executed the medical alliance of Jang Sehwa and Ryu Eunbi in the field, checked An Dohan's dispatch solo runs, and borrowed sickbeds from Eun Chaeyun in Jegi-dong."
        },
        "effects": []
      }
