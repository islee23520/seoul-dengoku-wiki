    ],
    "traits": [
      {
        "id": "k447-disposition",
        "name": {
          "ko": "체포 뒤 암호 교체",
          "en": "Changing passes after arrest"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 교도. 직함은 시장 순찰대.",
          "en": "Office. Rank: lay instructor. Title: market patrol."
        },
        "stress": {
          "ko": "공포. 시장 순찰대 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the market patrol duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k447-choice",
        "name": {
          "ko": "밤의 침입 차단",
          "en": "Blocking night intrusion"
        },
        "description": {
          "ko": "일화. 2125년 야간 무단 도꾼을 붙잡아 경비 암호패를 갈았다. 이 일로 시장 순찰대 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he caught a night illegal crosser and reissued the guard code tags. By this deed the signature of the market patrol post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "stress": {
          "ko": "공포. 시장 순찰대 당직이 비면 중앙정보부의 문서와 부품이 강국 볼모가 되는 것.",
          "en": "Fear. That the market patrol duty post would stand empty and the State's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "야간 도꾼을 붙잡고 암호패를 갈았다. 단일 체포와 재침입 방지의 근거이며 순찰대 전체 지휘는 없다.",
      "en": "Catches a night intruder and changes the pass. Supports one arrest and prevention, not patrol-wide command."
    },
