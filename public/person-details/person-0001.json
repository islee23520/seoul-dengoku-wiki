      {
        "id": "k001-joint-signatures",
        "name": {
          "ko": "연서 확인",
          "en": "Joint-signature checking"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "k001-trait-1",
        "name": {
          "ko": "서명 뒤의 수문",
          "en": "Signatures before sluices"
        },
        "description": {
          "ko": "연서 없는 개방을 경계한다.",
          "en": "Guards against opening without joint signatures."
        },
        "behavior": {
          "ko": "연서 없는 개방을 경계한다.",
          "en": "Guards against opening without joint signatures."
        },
        "stress": {
          "ko": "공급 독촉과 탁도 초과가 겹치면 서명을 보류한다.",
          "en": "Withholds a signature when pressure for supply meets excessive turbidity."
        },
        "relationship": {
          "ko": "이서담의 거부권과 자기 헌장 사이의 갈등을 안고 있다.",
          "en": "His charter ambition remains in tension with I Seodam’s veto."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "연서를 받은 뒤 수문을 여는 습관과 자기 헌장으로 갑문을 묶으려는 야망이 함께 있다. 탁도 초과 때 공급 독촉에도 서명을 보류했으나 박누리의 밸브를 자기 뜻으로 열지는 못했다.",
      "en": "He waits for joint signatures before opening sluices while seeking a charter of his own. Under pressure to maintain a turbid supply, he withheld his signature but could not open Park Nuri’s valve."
    },
