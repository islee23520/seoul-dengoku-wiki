      {
        "id": "evidenced-choice",
        "name": {
          "ko": "야간 흔적을 남김",
          "en": "Leaves night records"
        },
        "description": {
          "ko": "야간 무단 도꾼을 붙잡고 암호패를 교체했다. 야간 군량 수레를 기록하지만 전투나 부대 지휘 전반의 성과는 없다.",
          "en": "Catches an unauthorized night thief and replaces password tags. Records military carts at night; broader combat and command success are unrecorded."
        },
        "behavior": {
          "ko": "확인된 선택에서는 야간 흔적을 남김을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "무단 접근 뒤 경비 확인이 엄격해질 수 있다.",
          "en": "May tighten checks after unauthorized approaches."
        },
        "relationship": {
          "ko": "라진우의 순번 지휘를 받고 원주온과 당직을 나눈다.",
          "en": "Follows Ra Jinwoo’s rotation and shares duty with Won Juon."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "교구 명부와 선거 봉인을 지켜 다음 대주교 비밀 선거의 절차와 명동역 인준이 끊기지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "교구 명부와 선거 봉인이 지워져 교황 없는 선출의 정당성 논쟁에서 자신의 서명이 의심받는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
