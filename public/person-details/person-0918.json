    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "인명 기록 먼저",
          "en": "People records first"
        },
        "description": {
          "ko": "역사 화재 때 인명 장부부터 가지고 나왔다. 교구 교대 서명을 확인하지만 단일 일화 밖의 성과는 미확인이다.",
          "en": "Brought the people register out first during the station fire. Checks diocesan shift signatures; achievement beyond the single anecdote is unconfirmed."
        },
        "behavior": {
          "ko": "확인된 선택에서는 인명 기록 먼저을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "장부 서명이 사라지면 인수인계 확인에 집중할 수 있다.",
          "en": "May focus on handover verification when ledger signatures disappear."
        },
        "relationship": {
          "ko": "선배 당직과 기록을 인계한다. 이 선택을 모든 거래의 원칙으로 확대하지 않는다.",
          "en": "Hands records to senior duty workers. This choice is not generalized to every transaction."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "교구 인수인계 장부를 지켜 교황 없는 선거를 둘러싼 다툼에도 명동역의 인준이 이어지게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "다음 대주교 선거의 혼란 속에 자신이 맡은 명동역 인준 명부 당직 장부의 서명이 사라지는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "선배 당직과 기록을 인계한다. 이 선택을 모든 거래의 원칙으로 확대하지 않는다.",
          "en": "Hands records to senior duty workers. This choice is not generalized to every transaction."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "역사 화재 때 인명 장부부터 가지고 나왔다. 교구 교대 서명을 확인하지만 단일 일화 밖의 성과는 미확인이다.",
      "en": "Brought the people register out first during the station fire. Checks diocesan shift signatures; achievement beyond the single anecdote is unconfirmed."
