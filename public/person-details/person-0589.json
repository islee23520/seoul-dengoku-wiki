    "skills": [
      {
        "id": "k589-flood-closure",
        "name": {
          "ko": "침수 구간 폐쇄",
          "en": "Flood section closure"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "k589-choice",
        "name": {
          "ko": "위험 구간 즉시 닫음",
          "en": "Closes dangerous sections promptly"
        },
        "description": {
          "ko": "일화. 2125년 침수 구간 붕괴 보고를 미루지 않고 당장 폐쇄했다. 이 일로 사본 전령 자리의 서명이 장부에 올랐다. 이 선택을 넘어선 지속 성향은 미확인이다.",
          "en": "Anecdote. In 2125 he did not sit on the collapse report of a flooded section and closed it on the spot. By this deed the signature of the copy courier post rose into the ledger. A lasting disposition beyond this choice is unconfirmed."
        },
        "behavior": {
          "ko": "일화. 2125년 침수 구간 붕괴 보고를 미루지 않고 당장 폐쇄했다. 이 일로 사본 전령 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he did not sit on the collapse report of a flooded section and closed it on the spot. By this deed the signature of the copy courier post rose into the ledger."
        },
        "stress": {
          "ko": "공포. 사본 전령 당직이 비면 도심 통행의 도장과 명부가 끊겨 질서 계열 여덟 나라의 인준이 멈추는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That the copy courier duty post would stand empty and the Government's passage would become a break in the eight states' recognition. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k589-boundary",
        "name": {
          "ko": "당직 연속성을 중시",
          "en": "Values duty continuity"
        },
        "description": {
          "ko": "당직 공백을 피하고 기록을 믿는 원문 성향이다. 반복 문구이므로 개인의 특별한 장점으로 확대하지 않는다.",
          "en": "The source favors unbroken shifts and written records. Repeated wording does not establish a distinctive exceptional virtue."
        },
        "behavior": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "stress": {
          "ko": "공포. 사본 전령 당직이 비면 도심 통행의 도장과 명부가 끊겨 질서 계열 여덟 나라의 인준이 멈추는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That the copy courier duty post would stand empty and the Government's passage would become a break in the eight states' recognition. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "일화. 2125년 침수 구간 붕괴 보고를 미루지 않고 당장 폐쇄했다. 이 일로 사본 전령 자리의 서명이 장부에 올랐다. 단일 일화와 반복 당직 문구만 있어 장기 성향·광범위 경력·후속 결과는 미확인이다.",
      "en": "Anecdote. In 2125 he did not sit on the collapse report of a flooded section and closed it on the spot. By this deed the signature of the copy courier post rose into the ledger. Only one anecdote and repeated duty wording are available; enduring disposition, broader experience, and later results remain unconfirmed."
    },
