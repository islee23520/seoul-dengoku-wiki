    "skills": [
      {
        "id": "k159-copy-auction",
        "name": {
          "ko": "공증 사본 경매",
          "en": "Notarized copy auction"
        },
        "rating": 65
      },
      {
        "id": "k159-seal-check",
        "name": {
          "ko": "공증 인장 확인",
