    "traits": [
      {
        "id": "no-defective-shipments",
        "name": {
          "ko": "불량 출고 거부",
          "en": "No Defective Shipments"
        },
        "description": {
          "ko": "윤북율은 출고 직전에도 불량 부품을 넘기지 않는 품질 확인 성향을 보인다.",
          "en": "Yun Bugyul shows a quality-checking disposition by refusing to pass on defective parts even just before shipment."
        },
        "behavior": {
          "ko": "불량 부품 상자를 출고 직전에 되돌려 보냈다.",
          "en": "He returned a box of defective parts immediately before shipment."
        },
        "stress": {
          "ko": "당직 공백과 통행 종속을 우려하더라도 확인된 불량을 그대로 출고하는 데 신중할 수 있다.",
          "en": "Even when concerned about duty gaps and dependent passage, he may be cautious about shipping confirmed defects."
        },
        "relationship": {
          "ko": "선배 당직에게는 반송한 부품 상자와 불량 판단을 분명히 인계하려 할 수 있다.",
          "en": "He may clearly hand over the returned parts box and the defect judgment to the senior duty holder."
        },
        "effects": []
      },
      {
        "id": "maintain-record-continuity",
        "name": {
          "ko": "기록 잇기",
          "en": "Maintain Record Continuity"
        },
        "description": {
          "ko": "윤북율은 자기 직위의 기록을 이어 장부와 당직의 중단을 피하는 데 무게를 둔다.",
          "en": "Yun Bugyul values carrying his post's records forward to avoid breaks in the ledger and duty."
        },
        "behavior": {
          "ko": "불량 부품을 반송하고 자기 직위의 열쇠와 기록을 넘겨 장부의 연속성을 지향한다.",
          "en": "He returns defective parts and passes on his post's keys and records to support ledger continuity."
        },
        "stress": {
          "ko": "당직이 비어 통행이 강국의 볼모가 될까 우려되면 반송 조치와 인계 기록이 끊기지 않도록 더 신경 쓸 수 있다.",
          "en": "If vacant duty could make passage hostage to a powerful state, he may take greater care to connect the return action with handover records."
        },
        "relationship": {
          "ko": "선배 당직과는 출고하지 않은 이유를 기록으로 이어 주는 인계를 중시할 수 있다.",
          "en": "He may value handover that gives the senior duty holder a recorded reason why the parts were not shipped."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "불량 부품 상자를 되돌려 보냈다. 출고 검사와 생애의 차륜 보고만 평가하며 물류망 전체 운영 권한은 없다.",
      "en": "She returned a defective-parts box. Release checks and wheel reporting are supported, not authority over an entire logistics network."
    },
