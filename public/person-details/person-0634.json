    "skills": [
      {
        "id": "bargain",
        "name": {
          "ko": "교대 조건 조정",
          "en": "Shift-condition mediation"
        },
        "rating": 50
      },
      {
        "id": "handover",
        "name": {
          "ko": "기록·열쇠 인수인계",
          "en": "Record and key handover"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "patient-separation-of-conditions",
        "name": {
          "ko": "조건을 나누는 인내",
          "en": "Patient Separation of Conditions"
        },
        "description": {
          "ko": "오마호는 태업 작업반과 조건을 나누어 논의하는 데 밤을 들일 만큼 끈기를 보였다.",
          "en": "O Maho showed persistence by spending the night discussing separate conditions with the slowdown crew."
        },
        "behavior": {
          "ko": "태업 작업반과 밤새 조건을 나눠 다음 교대를 열었다.",
          "en": "O Maho worked through conditions with the slowdown crew overnight and opened the next shift."
        },
        "stress": {
          "ko": "태업이 교대 중단으로 이어질 때 조건을 나누어 협의를 계속하려 할 수 있다.",
          "en": "When a slowdown threatens the next shift, O Maho may keep negotiating by separating the conditions."
        },
        "relationship": {
          "ko": "작업반과 갈등이 생기면 큰소리보다 구체적인 조건 협의를 택할 수 있다.",
          "en": "In conflict with a crew, O Maho may favor discussion of concrete conditions over loud assertions."
        },
        "effects": []
      },
      {
        "id": "protect-the-next-shift",
        "name": {
          "ko": "다음 교대 지키기",
          "en": "Protect the Next Shift"
        },
        "description": {
          "ko": "오마호는 작업반과의 갈등 속에서도 다음 교대를 여는 데 무게를 둔다.",
          "en": "O Maho places weight on opening the next shift despite conflict with the crew."
        },
        "behavior": {
          "ko": "태업 작업반과 밤새 조건을 조정해 다음 교대가 이어지게 했다.",
          "en": "O Maho adjusted conditions with the slowdown crew overnight so the next shift could proceed."
        },
        "stress": {
          "ko": "당직 공백이 통행을 볼모로 만들까 우려하면 교대를 잇기 위한 협의를 지속할 수 있다.",
          "en": "Fear that a duty gap could leave passage hostage may sustain negotiations aimed at continuing the shifts."
        },
        "relationship": {
          "ko": "작업반과 다음 당직 사이에서는 교대를 재개할 수 있는 조건을 연결하려 할 수 있다.",
          "en": "Between the crew and the next duty holder, O Maho may try to connect conditions that allow the shift to resume."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "태업 작업반과 밤새 조건을 조정해 다음 교대를 열었다. 직접 협의와 지속력은 있으나 수질 검사 수행은 없다.",
      "en": "She negotiated overnight with a work-to-rule crew to open the next shift. Direct mediation and persistence are supported, not water testing."
    },
