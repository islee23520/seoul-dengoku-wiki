    "skills": [
      {
        "id": "k140-limited-escort",
        "name": {
          "ko": "귀환 시각 호송 관리",
          "en": "Return-timed escort management"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "k140-choice",
        "name": {
          "ko": "잠금 앞에서 돌아섬",
          "en": "Turns back at a locked bridge"
        },
        "description": {
          "ko": "교량 위 민병 바리케이드를 구원 대상이 아니라 통과 거부로 읽고, 구두 주둔 허가를 명령으로 받지 않는다. 경로는 짧고 귀환 시각은 미리 적는다.",
          "en": "He read the militia barricade on the bridge not as a rescue target but as a passage refusal, and took no verbal garrison permit as an order. His routes were short and he wrote the return hours in advance."
        },
        "behavior": {
          "ko": "일화. 2125년 호송 도중 습격을 만나 화물보다 인명 장부부터 챙겼다. 이 일로 보호군 파견 호송책 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125, meeting a raid mid-convoy, he secured the roster of lives before the freight. By this deed the signature of the protection force dispatch convoy master post rose into the ledger."
        },
        "stress": {
          "ko": "공포. 호송 열차가 성동 교량에서 멈추고, 그 정차가 주둔의 기정사실이 되는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That the convoy train would stop on the Seongdong bridge and that stop would become the established fact of garrison. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 한보라의 순찰열차 배차에 호송 칸을 붙이고, 배우진의 파견안을 실행하되 기하겸의 교량 잠금 앞에서는 기록을 남기고 돌아선다.",
          "en": "Relations. Coupling a convoy car onto Han Bora's patrol dispatch and executing Bae Woojin's dispatch plan, but turning back with a record before Ki Hagyeom's bridge lock."
        },
        "effects": []
      },
      {
        "id": "k140-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 병장. 직함은 보호군 파견 호송책. 파견 명단은 상수행정 날인과 동방사 암호패가 함께 있어야 출발하고, 귀환 시각이 빈 칸은 고덕 유치선에서 되돌린다.",
          "en": "Office. Rank: sergeant. Title: protection force dispatch convoy master. A dispatch roster departed only with both the water administration's stamp and the escort's code tags, and he turned back at the Godeok siding any roster whose return column stood empty."
        },
        "behavior": {
          "ko": "관직. 품계 병장. 직함은 보호군 파견 호송책. 파견 명단은 상수행정 날인과 동방사 암호패가 함께 있어야 출발하고, 귀환 시각이 빈 칸은 고덕 유치선에서 되돌린다.",
          "en": "Office. Rank: sergeant. Title: protection force dispatch convoy master. A dispatch roster departed only with both the water administration's stamp and the escort's code tags, and he turned back at the Godeok siding any roster whose return column stood empty."
        },
        "stress": {
          "ko": "공포. 호송 열차가 성동 교량에서 멈추고, 그 정차가 주둔의 기정사실이 되는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That the convoy train would stop on the Seongdong bridge and that stop would become the established fact of garrison. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 한보라의 순찰열차 배차에 호송 칸을 붙이고, 배우진의 파견안을 실행하되 기하겸의 교량 잠금 앞에서는 기록을 남기고 돌아선다.",
          "en": "Relations. Coupling a convoy car onto Han Bora's patrol dispatch and executing Bae Woojin's dispatch plan, but turning back with a record before Ki Hagyeom's bridge lock."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "일화. 2125년 호송 도중 습격을 만나 화물보다 인명 장부부터 챙겼다. 이 일로 보호군 파견 호송책 자리의 서명이 장부에 올랐다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Anecdote. In 2125, meeting a raid mid-convoy, he secured the roster of lives before the freight. By this deed the signature of the protection force dispatch convoy master post rose into the ledger. Titles and ambitions are not treated as accomplished authority or results."
    },
