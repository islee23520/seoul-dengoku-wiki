    "skills": [
      {
        "id": "contract-testimony",
        "name": {
          "ko": "계약 서명 증언",
          "en": "Contract signature testimony"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "물 공급과 군사 근거 분리",
          "en": "Separates water rights from military grounds"
        },
        "description": {
          "ko": "군사 개입과 최소 급수권을 한 줄에 넣으라는 사신을 내려보냈다. 종료 조건과 감사표 날짜를 사본 증언에 맞췄다.",
          "en": "Rejects an envoy seeking to combine military intervention with minimum water rights. Aligns expiry terms and audit dates with signature testimony."
        },
        "behavior": {
          "ko": "확인된 선택에서는 물 공급과 군사 근거 분리을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "증언을 잘라 쓰려 할 때 말을 좁힐 수 있다.",
          "en": "May narrow testimony when others try to excerpt it."
        },
        "relationship": {
          "ko": "임하준의 종료 조건과 흥미리의 날짜를 증언에 맞춘다.",
          "en": "Aligns Im Hajun’s termination terms with Heung Miri’s dates in testimony."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "물 공급 최저선과 계약 종료 조건을 공개 증언으로 남겨 조합원 지지와 군사 개입 근거가 한 장에서 섞이지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "자신의 증언이 배우진의 군사 개입 근거로만 잘리는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "임하준의 종료 조건과 흥미리의 날짜를 증언에 맞춘다.",
          "en": "Aligns Im Hajun’s termination terms with Heung Miri’s dates in testimony."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "군사 개입과 최소 급수권을 한 줄에 넣으라는 사신을 내려보냈다. 종료 조건과 감사표 날짜를 사본 증언에 맞췄다.",
      "en": "Rejects an envoy seeking to combine military intervention with minimum water rights. Aligns expiry terms and audit dates with signature testimony."
    },
