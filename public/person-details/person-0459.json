  "relations": {
    "outgoing": [
      {
        "from": "우경민",
        "type": "계약",
        "to": "이준택",
        "basis": "우경민은 유치선에서 발견한 바퀴 결함을 이준택에게 알리고 차륜·펌프 정비에 필요한 부품을 넘긴다. 이준택은 제동 시험과 출고 점검을 거쳐 공방과 수비대의 도장을 함께 받아, 결함을 고친 차량이 확인 없이 선로로 나가지 않게 한다."
      }
    ],
