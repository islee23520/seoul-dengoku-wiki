    "skills": [
      {
        "id": "k147-medical-dispatch",
        "name": {
          "ko": "중증도 배차",
          "en": "Severity-based dispatch"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "k147-choice",
        "name": {
          "ko": "환자를 병력과 분리",
          "en": "Separates patients from troops"
        },
        "description": {
          "ko": "원칙적이지만 환자 앞에서는 절차를 접는다. 이름 없는 시신을 장부에 남기는 일을 자신의 본분으로 본다.",
          "en": "Principled, but she folded procedure before patients. She saw leaving nameless dead in the ledger as her own calling."
        },
        "behavior": {
          "ko": "일화. 북한산보국문 피난 가족이 암사 복무계약서와 함께 급수권 철표를 들고 서울역 의무실로 몰려왔다.",
          "en": "Anecdote. The refugee families of Bukhansan Bogukmun crowded into the Seoul Station infirmary carrying withdrawal notices bound with Amsa service contracts."
        },
        "stress": {
          "ko": "공포. 이송 명단이 군사호적과 합쳐져 피난민이 병력 숫자로만 남는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That the transfer lists would merge with military registries and the refugees would remain as troop numbers alone. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 윤서린의 추대 세력에 속하고 류은비에게 약품 배정 장부를 빚졌다. 신보람의 가족 이송을 우선 기록으로 남긴다.",
          "en": "Relations. Belonged to Yun Seorin's endorsement faction and owed Ryu Eunbi the medicine-allocation ledger. Left Shin Boram's family transfer as a priority record."
        },
        "effects": []
      },
      {
        "id": "k147-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 주사. 직함은 의료이송 기록관. 중증도 순 배차를 공개하고, 무기와 환자가 한 열차에 타면 즉시 운행을 취소한다.",
          "en": "Office. Rank: registrar. Title: medical-transfer registrar. She published severity-order dispatches and cancelled a run at once whenever weapons and patients boarded one train."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 의료이송 기록관. 중증도 순 배차를 공개하고, 무기와 환자가 한 열차에 타면 즉시 운행을 취소한다.",
          "en": "Office. Rank: registrar. Title: medical-transfer registrar. She published severity-order dispatches and cancelled a run at once whenever weapons and patients boarded one train."
        },
        "stress": {
          "ko": "공포. 이송 명단이 군사호적과 합쳐져 피난민이 병력 숫자로만 남는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That the transfer lists would merge with military registries and the refugees would remain as troop numbers alone. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 윤서린의 추대 세력에 속하고 류은비에게 약품 배정 장부를 빚졌다. 신보람의 가족 이송을 우선 기록으로 남긴다.",
          "en": "Relations. Belonged to Yun Seorin's endorsement faction and owed Ryu Eunbi the medicine-allocation ledger. Left Shin Boram's family transfer as a priority record."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "중증도 배차를 공개하고 무기와 환자의 혼승을 취소한다. 의료 기록과 배차의 수행은 진료 전문성을 뜻하지 않는다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Posts severity-based dispatch and cancels mixed weapons and patient transport. Medical records and dispatch do not establish clinical expertise. Titles and ambitions are not treated as accomplished authority or results."
    },
