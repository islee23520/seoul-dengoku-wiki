    "traits": [
      {
        "id": "k024-joint-inspection",
        "name": {
          "ko": "함께 펼친 사본",
          "en": "Jointly opened copies"
        },
        "description": {
          "ko": "한쪽만 온 열람은 빈 봉투로 돌려보낸다.",
          "en": "Returns an empty envelope when only one side attends."
        },
        "behavior": {
          "ko": "한쪽만 온 열람은 빈 봉투로 돌려보낸다.",
          "en": "Returns an empty envelope when only one side attends."
        },
        "stress": {
          "ko": "자신이 날인한 사본이 조작된 음성기록과 묶여 물 계약 전체가 위조로 몰리는 것.",
          "en": "That copies he stamped would be bundled with a doctored voice record, and the whole Sluice Charter would be branded a forgery."
        },
        "relationship": {
          "ko": "윤서린의 인준 심사에 서부 사본을 넘기고, 장필규의 난외 해석을 경계하며, 뚝섬 공방 서기 고은하와 쪽수를 맞춘다.",
          "en": "Passing the western copies to Yun Seorin's ratification examination, wary of Jang Pilgyu's margin readings, and matching page counts with Go Eunha, the Ttukseom workshop clerk."
        },
        "effects": []
      },
      {
        "id": "k024-physical-document-trust",
        "name": {
          "ko": "도장과 쪽수",
          "en": "Seals and page counts"
        },
        "description": {
          "ko": "사람 말보다 도장 각인과 쪽수를 확인한다.",
          "en": "Checks seal engravings and page counts before trusting words."
        },
        "behavior": {
          "ko": "사람 말보다 도장 각인과 쪽수를 확인한다.",
          "en": "Checks seal engravings and page counts before trusting words."
        },
        "stress": {
          "ko": "자신이 날인한 사본이 조작된 음성기록과 묶여 물 계약 전체가 위조로 몰리는 것.",
          "en": "That copies he stamped would be bundled with a doctored voice record, and the whole Sluice Charter would be branded a forgery."
        },
        "relationship": {
          "ko": "윤서린의 인준 심사에 서부 사본을 넘기고, 장필규의 난외 해석을 경계하며, 뚝섬 공방 서기 고은하와 쪽수를 맞춘다.",
          "en": "Passing the western copies to Yun Seorin's ratification examination, wary of Jang Pilgyu's margin readings, and matching page counts with Go Eunha, the Ttukseom workshop clerk."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "대질과 사본 입회가 확인된다. 잉크·쪽수의 대조는 문서 업무이며 전문 감정의 성공률이나 외교 논변은 미확인이다.",
      "en": "Confrontation and witnessed copy inspection are confirmed. Page and ink comparison is documentary work, without a measured forensic success rate or diplomatic argumentation."
    },
