    "skills": [
      {
        "id": "hearing",
        "name": {
          "ko": "증인 대질 진행",
          "en": "Witness confrontation"
        },
        "rating": 45
      },
      {
        "id": "handover",
        "name": {
          "ko": "기록·열쇠 인수인계",
          "en": "Record and key handover"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "disclose-conflicting-testimony",
        "name": {
          "ko": "갈린 증언 공개",
          "en": "Disclose Conflicting Testimony"
        },
        "description": {
          "ko": "홍상훈은 서로 어긋난 증언을 공개적으로 맞대어 확인하는 태도를 보인다.",
          "en": "Hong Sanghun shows a preference for comparing conflicting testimony openly."
        },
        "behavior": {
          "ko": "두 증인의 말이 갈라지자 공개 대질을 열었다.",
          "en": "Hong Sanghun arranged a public confrontation when two witnesses gave conflicting accounts."
        },
        "stress": {
          "ko": "증언 충돌이 장부의 연속성을 흔들면 한쪽 말을 임의로 채택하기보다 공개 확인을 선호할 수 있다.",
          "en": "If conflicting testimony threatens ledger continuity, Hong Sanghun may prefer open checking over arbitrarily accepting one account."
        },
        "relationship": {
          "ko": "선배 당직자와 기록을 넘길 때도 서로 다른 설명을 공개적으로 확인하는 방식을 선호할 수 있다.",
          "en": "When handing records over with senior duty staff, Hong Sanghun may prefer openly checking differing explanations."
        },
        "effects": []
      },
      {
        "id": "duty-continuity",
        "name": {
          "ko": "당직 연속성",
          "en": "Duty Continuity"
        },
        "description": {
          "ko": "홍상훈은 큰소리보다 장부를 믿고 당직이 이어지는 쪽을 우선한다.",
          "en": "Hong Sanghun trusts ledger entries over loud assertions and prioritizes uninterrupted duty coverage."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록을 넘기며 태욱그룹의 장부를 끊기지 않게 잇고자 한다.",
          "en": "Hong Sanghun hands over the position's keys and records and seeks to keep Taeuk Group's ledger continuous."
        },
        "stress": {
          "ko": "당직 공백이 통행을 강국의 볼모로 만들 우려가 있으면 인수인계의 연속성을 더욱 중시할 수 있다.",
          "en": "If a duty gap risks making passage hostage to a powerful nation, Hong Sanghun may emphasize handover continuity more strongly."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직자에게는 기록과 열쇠를 이어받고 넘기는 책임을 중심으로 협력할 수 있다.",
          "en": "Hong Sanghun may cooperate with senior local duty staff around the responsibility to receive and pass on records and keys."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "두 증인의 말이 갈리자 공개 대질을 열었다. 제한된 중재를 평가하며 수질 계측은 직함만 있어 숙련을 부여하지 않았다.",
      "en": "He arranged confrontation of conflicting witnesses. Limited mediation is supported; a water-measurement title alone earns no skill."
    },
