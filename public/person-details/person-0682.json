      },
      {
        "id": "handover",
        "name": {
          "ko": "기록·열쇠 인수인계",
          "en": "Record and key handover"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "adjust-slowdown-conditions",
        "name": {
          "ko": "태업 조건 조정",
          "en": "Adjust Slowdown Conditions"
        },
        "description": {
          "ko": "홍가훈은 태업 작업반과 조건을 나누어 교대 재개의 접점을 찾는 편이다.",
          "en": "Hong Gahun favors working through conditions with a slowdown crew to find grounds for resuming shifts."
        },
        "behavior": {
          "ko": "태업 작업반과 밤새 조건을 나눠 다음 교대를 열었다.",
          "en": "Hong Gahun worked through conditions with the slowdown crew overnight and opened the next shift."
        },
        "stress": {
          "ko": "태업으로 교대가 막힌다면 조건별 협의를 이어가며 재개 가능성을 찾을 수 있다.",
          "en": "If a slowdown blocks the next shift, Hong Gahun may continue discussing individual conditions to seek a way to resume it."
        },
        "relationship": {
          "ko": "작업반과 갈등이 생기면 구체적인 조건을 나누어 직접 협의하려 할 수 있다.",
          "en": "In conflict with a crew, Hong Gahun may negotiate directly by separating concrete conditions."
        },
        "effects": []
      },
      {
        "id": "guard-against-duty-gaps",
        "name": {
          "ko": "당직 공백 경계",
          "en": "Guard Against Duty Gaps"
        },
        "description": {
          "ko": "홍가훈은 당직 공백이 통행의 의존으로 이어질 가능성을 경계한다.",
          "en": "Hong Gahun is wary that a duty gap could make passage dependent on a powerful state."
        },
        "behavior": {
          "ko": "당직이 이어지는 쪽을 먼저 고르고 밤샘 협의로 다음 교대를 열었다.",
          "en": "Hong Gahun prioritizes uninterrupted duty and opened the next shift through overnight negotiation."
        },
        "stress": {
          "ko": "교대 중단이 통행을 볼모로 만들까 우려하면 재개를 위한 협의를 더 오래 이어갈 수 있다.",
          "en": "Fear that a halted shift could leave passage hostage may sustain longer negotiations for resumption."
        },
        "relationship": {
          "ko": "작업반과 선배 당직을 대할 때 다음 교대로 이어지는 조건을 중시할 수 있다.",
          "en": "With the crew and senior duty staff, Hong Gahun may emphasize conditions that carry work into the next shift."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "밤샘 조건 협의로 교대를 재개했다. 협의 행동을 평가하며 직함만으로 계측 기기 운용을 추가하지 않는다.",
      "en": "He restored a shift through overnight negotiations. Bargaining action is supported; instrument operation is not added from a title."
    },
