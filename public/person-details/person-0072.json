      {
        "id": "seal",
        "name": {
          "ko": "봉인·사본 대조",
          "en": "Seal and copy comparison"
        },
        "rating": 60
      },
      {
        "id": "accounts",
        "name": {
          "ko": "지급 장부 대조",
          "en": "Payment ledger reconciliation"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "persistent-date-checking",
        "name": {
          "ko": "날짜 집요한 대조",
          "en": "Persistent Date Checking"
        },
        "description": {
          "ko": "제라온은 말로 된 합의보다 원장에 남은 날짜와 기록의 일치를 중시한다.",
          "en": "Jeraon values agreement between ledger dates and records over verbal assurances."
        },
        "behavior": {
          "ko": "날짜를 집요하게 대조하고 구두 합의를 원장에 남기지 않는 행위를 비난한다.",
          "en": "Jeraon persistently compares dates and condemns leaving verbal agreements out of the ledger."
        },
        "stress": {
          "ko": "위조 열람증이 서고를 선전 자료로 바꿀 우려가 커지면 기록의 날짜 대조를 더욱 중시할 수 있다.",
          "en": "Concern that a forged access pass could turn the archive into propaganda may heighten Jeraon's emphasis on checking dates."
        },
        "relationship": {
          "ko": "최은재의 인증 범위를 옮길 때도 구두 신뢰보다 원장에 남기는 내용을 중시할 수 있다.",
          "en": "When transferring Choi Eunjae's certification scope, Jeraon may prioritize ledger entries over verbal trust."
        },
        "effects": []
      },
      {
        "id": "protect-original-fields",
        "name": {
          "ko": "원본 칸 지키기",
          "en": "Protect Original Fields"
        },
        "description": {
          "ko": "제라온은 위조가 드러난 사본보다 원본의 기록 칸을 지키는 쪽을 택한다.",
          "en": "Jeraon favors preserving original record fields over retaining copies exposed as forged."
        },
        "behavior": {
          "ko": "위조 도장이 드러난 사건에서 사본을 불사르고 원본 칸을 지켰다.",
          "en": "In the forged-stamp incident, Jeraon burned the copies and protected the original fields."
        },
        "stress": {
          "ko": "서고 기록이 강국의 선전에 이용될 우려가 생기면 원본 보존을 우선할 수 있다.",
          "en": "If archive records risk serving a powerful nation's propaganda, Jeraon may prioritize preserving the originals."
        },
        "relationship": {
          "ko": "임시온의 열람 잠금을 뒷받침할 때 원본 기록의 보존을 협력의 기준으로 삼을 수 있다.",
          "en": "When supporting Im Sion's access restrictions, Jeraon may treat preservation of original records as a condition of cooperation."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "날짜를 대조하고 위조 도장이 드러난 사본을 버리며 원본 칸을 지켰다. 위조 사건의 책임은 불분명해 탐지 전문가로 확장하지 않는다.",
      "en": "He compares dates and discarded a copy after a forged seal was exposed, preserving the original slot. Unclear responsibility prevents assuming a forgery-expert career."
    },
