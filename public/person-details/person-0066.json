    ],
    "traits": [
      {
        "id": "recheck-before-shipment",
        "name": {
          "ko": "출고 전 재확인",
          "en": "Recheck Before Shipment"
        },
        "description": {
          "ko": "허서겸은 연구차량 출고 전에 시운전 기록과 인증 요건을 빈틈없이 확인한다.",
          "en": "Heo Seogyeom checks test-run records and certification requirements thoroughly before research vehicles leave."
        },
        "behavior": {
          "ko": "인증 도장과 심사 봉인을 함께 확인하고 출고 직전 불량 부품 상자를 반송했다.",
          "en": "He checks both certification stamps and review seals and returned a defective-parts box just before shipment."
        },
        "stress": {
          "ko": "정비창이 군사 보호권의 발판으로 팔릴 우려가 있다면 인증이 없는 출고를 더 단호히 막을 수 있다.",
          "en": "If the workshop risks being sold as a foothold for military protection claims, he may block uncertified departures more firmly."
        },
        "relationship": {
          "ko": "최은재의 인증 도장이 빠진다면 유민호의 배차를 지원하는 관계라도 출고를 잠글 수 있다.",
          "en": "If Choi Eunjae’s certification stamp is missing, he may lock shipment even while supporting Yu Minho’s dispatch."
        },
        "effects": []
      },
      {
        "id": "no-disguised-military-supplies",
        "name": {
          "ko": "군수 위장 불허",
          "en": "No Disguised Military Supplies"
        },
        "description": {
          "ko": "허서겸은 연구 물자의 군수 위장과 병기가 의심되는 개조를 거부한다.",
          "en": "Heo Seogyeom rejects military disguises for research materials and modifications suspected of weapon use."
        },
        "behavior": {
          "ko": "병기가 의심되는 개조 차량을 유치선 바깥으로 밀어낸다.",
          "en": "He pushes vehicles with suspected weapons modifications outside the sidings."
        },
        "stress": {
          "ko": "활주로 터가 군사 집결지로 바뀔 위험이 있다면 의심 개조를 연구차량 흐름에서 분리하려 할 수 있다.",
          "en": "If the runway site risks becoming a military assembly area, he may seek to separate suspect modifications from research-vehicle traffic."
        },
        "relationship": {
          "ko": "유민호의 중립 배차망을 지킬 수 있다면 인증된 연구차량 정비로 협력을 이어갈 수 있다.",
          "en": "He may continue supporting Yu Minho through certified research-vehicle maintenance when it preserves dispatch neutrality."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "시운전 빈칸과 인증을 확인하고 불량 부품을 반송한다. 연구차량 정비 업무에 한정하며 철도 건설이나 전투 기술은 없다.",
      "en": "He checks trial records and certification and returns defective parts. Research-vehicle maintenance is supported, not railway construction or combat techniques."
    },
