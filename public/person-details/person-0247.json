    "traits": [
      {
        "id": "member-roster-disposition",
        "name": {
          "ko": "아이 이름을 지킴",
          "en": "Protects children’s names"
        },
        "description": {
          "ko": "이름 누락을 숫자로 메우지 않고 배급을 멈춘다.",
          "en": "Stops distribution rather than filling omitted names with numbers."
        },
        "behavior": {
          "ko": "이름 누락을 숫자로 메우지 않고 배급을 멈춘다.",
          "en": "Stops distribution rather than filling omitted names with numbers."
        },
        "stress": {
          "ko": "아이들이 복무 숫자로 끌려갈 것을 두려워한다.",
          "en": "Fears children taken away as service numbers."
        },
        "relationship": {
          "ko": "백온의 맹세를 가족 회의에서 대변하고 강민서의 시민권 연대를 지지한다. 윤지율에게 이송 우선 기록을 부탁했다.",
          "en": "Represents Baek On’s pledge in family meetings, supports Kang Minseo’s citizenship solidarity and requests Yun Jiyul’s transfer-priority records."
        },
        "effects": []
      },
      {
        "id": "recorded-boundary",
        "name": {
          "ko": "이름 뒤 배급",
          "en": "Rations after names"
        },
        "description": {
          "ko": "이름을 읽고 누락이 있으면 배급을 멈춘다.",
          "en": "Reads names and stops rations when one is missing."
        },
        "behavior": {
          "ko": "이름을 읽고 누락이 있으면 배급을 멈춘다.",
          "en": "Reads names and stops rations when one is missing."
        },
        "stress": {
          "ko": "아이들이 복구복무 숫자로만 기록되어 회랑 밖으로 끌려가는 것.",
          "en": "Fears children taken away as service numbers."
        },
        "relationship": {
          "ko": "백온의 맹세를 가족 회의에서 대변하고 강민서의 시민권 연대를 지지한다. 윤지율에게 이송 우선 기록을 부탁했다.",
          "en": "Represents Baek On’s pledge in family meetings, supports Kang Minseo’s citizenship solidarity and requests Yun Jiyul’s transfer-priority records."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "배급 전에 이름을 읽고 누락 시 배급을 멈춘다. 아이 이름을 빠뜨린 장부를 찢은 행동과 가족회의 대변이 보호 성향의 근거다.",
      "en": "Reads names before distribution and stops it over omissions. Tearing a ledger missing a child’s name and speaking at family meetings ground a protective disposition."
    },
