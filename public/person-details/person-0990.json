    "skills": [
      {
        "id": "departure-check",
        "name": {
          "ko": "출발 확인",
          "en": "Departure checking"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "k990-disposition",
        "name": {
          "ko": "인수 없는 운행 거부",
          "en": "Refusing operation without receipt"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "She chose the side that kept the duty line unbroken first. She trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 호송 전령. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: registrar. Title: convoy courier. She handed over only the keys and records of her own post, and never made authority she did not hold."
        },
        "stress": {
          "ko": "공포. 호송 전령 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the convoy courier duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 이사벨 가르시아는 서명 없는 열차 출발을 에바 노바코바에게 알린다. 에바 노바코바는 점유 창과 탑승 증명을 확인해 출발 인수가 없는 기록을 완료 운행으로 적지 않는다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Isabel García reports an unsigned train departure to Eva Nováková. Eva checks occupied slots and boarding certification rather than entering a departure without receipt verification as completed operation."
        },
        "effects": []
      },
      {
        "id": "k990-choice",
        "name": {
          "ko": "탑승 확인에 넘김",
          "en": "Referring boarding checks"
        },
        "description": {
          "ko": "일화. 2125년 배차표 없는 열차를 세워 서명 없는 출발을 막았다. 이 일로 호송 전령 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 she stopped a dispatch-sheetless train and blocked an unsigned departure. By this deed the signature of the convoy courier post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 이사벨 가르시아는 서명 없는 열차 출발을 에바 노바코바에게 알린다. 에바 노바코바는 점유 창과 탑승 증명을 확인해 출발 인수가 없는 기록을 완료 운행으로 적지 않는다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Isabel García reports an unsigned train departure to Eva Nováková. Eva checks occupied slots and boarding certification rather than entering a departure without receipt verification as completed operation."
        },
        "stress": {
          "ko": "공포. 호송 전령 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the convoy courier duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 이사벨 가르시아는 서명 없는 열차 출발을 에바 노바코바에게 알린다. 에바 노바코바는 점유 창과 탑승 증명을 확인해 출발 인수가 없는 기록을 완료 운행으로 적지 않는다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Isabel García reports an unsigned train departure to Eva Nováková. Eva checks occupied slots and boarding certification rather than entering a departure without receipt verification as completed operation."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "무서명 열차를 세워 에바의 확인에 넘겼다. 인수 없는 완료 기록을 경계하되 실제 탑승 심사 능력은 부여하지 않았다.",
      "en": "Stops an unsigned train and refers it to Eva. Guards against completion without receipt without granting boarding-review expertise."
    },
