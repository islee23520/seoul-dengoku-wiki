    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "위험 보고를 미루지 않음",
          "en": "Reports danger promptly"
        },
        "description": {
          "ko": "붕괴 보고를 미루지 않고 침수 구간을 닫았다. 공동호송 조건을 입찰에 넣고 출고 봉인으로 도착을 확인한다.",
          "en": "Closes a flooded section without delaying the collapse report. Adds joint escort terms to bids and uses dispatch seals to verify arrivals."
        },
        "behavior": {
          "ko": "확인된 선택에서는 위험 보고를 미루지 않음을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "위험 신호가 오면 이용 유지보다 폐쇄를 먼저 택할 수 있다.",
          "en": "May choose closure over continued use when danger appears."
        },
        "relationship": {
          "ko": "장세화의 호송안과 라진우의 봉인을 연결한다.",
          "en": "Connects Jang Sehwa’s escort proposal with Ra Jinwoo’s seals."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
