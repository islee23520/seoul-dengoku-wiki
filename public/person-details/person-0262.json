    "skills": [
      {
        "id": "torch-duty",
        "name": {
          "ko": "고지 횃불 교대 기록",
          "en": "Hill torch-duty recording"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "torch-duty-disposition",
        "name": {
          "ko": "고지의 피난 용도",
          "en": "Refuge purpose of the hill"
        },
        "description": {
          "ko": "고지를 병영으로 쓰자는 말을 배신으로 듣는다.",
          "en": "Treats use of the hill as barracks as betrayal."
        },
        "behavior": {
          "ko": "고지를 병영으로 쓰자는 말을 배신으로 듣는다.",
          "en": "Treats use of the hill as barracks as betrayal."
        },
        "stress": {
          "ko": "신호가 군사 호송 유도등이 될 것을 두려워한다.",
          "en": "Fears signals becoming military escort lights."
        },
        "relationship": {
          "ko": "용국의 회랑 순찰과 횃불을 맞추고, 복모의 우회로가 고지 사각에 들어가는지 본다. 백온의 피난처 맹세를 고지 칠판에 적는다.",
          "en": "Coordinates torches with Yongguk and detours with Bokmo, recording Baek On’s refuge pledge."
        },
        "effects": []
      },
      {
        "id": "recorded-boundary",
        "name": {
          "ko": "외부 무장 제한",
          "en": "Limits external arms"
        },
        "description": {
          "ko": "보고 없는 외부 무장의 고지 접근을 막는다.",
          "en": "Blocks external armed hill access without a report."
        },
        "behavior": {
          "ko": "보고 없는 외부 무장의 고지 접근을 막는다.",
          "en": "Blocks external armed hill access without a report."
        },
        "stress": {
          "ko": "고지 신호가 군사 호송 유도등으로 바뀌는 것.",
          "en": "Fears signals becoming military escort lights."
        },
        "relationship": {
          "ko": "용국의 회랑 순찰과 횃불을 맞추고, 복모의 우회로가 고지 사각에 들어가는지 본다. 백온의 피난처 맹세를 고지 칠판에 적는다.",
          "en": "Coordinates torches with Yongguk and detours with Bokmo, recording Baek On’s refuge pledge."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "횃불 교대를 신도 표와 함께 기록하고 정찰 보고 없는 무장 접근을 막는다. 고지 당직 공백은 해결된 성과가 아니다.",
      "en": "Records torch shifts with member passes and blocks armed access without reconnaissance reports. The hill-duty vacancy remains unresolved."
    },
