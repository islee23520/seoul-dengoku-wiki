    "skills": [
      {
        "id": "stamp-timing-check",
        "name": {
          "ko": "날인 시각 대조",
          "en": "Stamp timing comparison"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "소급 날인 거부",
          "en": "Rejects backdated stamping"
        },
        "description": {
          "ko": "늦은 날인을 소급하라는 요청에 직인을 보관하고 고친 사본을 밖에서 말렸다. 잉크 마름 시각을 다른 인준 기록과 대조한다.",
          "en": "Stores the stamp after a backdating request and dries altered copies outside. Compares ink drying time with other ratification records."
        },
        "behavior": {
          "ko": "확인된 선택에서는 소급 날인 거부을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "날짜 수정 요청 때 보조 직인을 잠글 수 있다.",
          "en": "May lock away the auxiliary stamp after altered-date requests."
        },
        "relationship": {
          "ko": "석주아의 잉크 기록과 맞추고 윤서린의 젖은 목록은 분리한다.",
          "en": "Matches Seok Jua’s ink records and separates Yun Seorin’s damp lists."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "보조 직인이 마른 뒤에만 깃발을 함 걸이에 매달아, 서울역 날짜만으로 명목이 팔리지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "보조 직인이 외부 통제 문장 아래에 숨어 조합원 선거관리회가 빈 의자가 되는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "석주아의 잉크 기록과 맞추고 윤서린의 젖은 목록은 분리한다.",
          "en": "Matches Seok Jua’s ink records and separates Yun Seorin’s damp lists."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "늦은 날인을 소급하라는 요청에 직인을 보관하고 고친 사본을 밖에서 말렸다. 잉크 마름 시각을 다른 인준 기록과 대조한다.",
      "en": "Stores the stamp after a backdating request and dries altered copies outside. Compares ink drying time with other ratification records."
    },
