    "skills": [
      {
        "id": "draft-comparison",
        "name": {
          "ko": "통일안 문안 비교",
          "en": "Unification draft comparison"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "경쟁 초안을 남김",
          "en": "Preserves competing drafts"
        },
        "description": {
          "ko": "초안 한 건만 남자 방송으로 알리고 경쟁 문안의 서명자와 거부권자를 다시 적었다. 권력 형식의 문장 차이를 읽는다.",
          "en": "Broadcasts the loss of competing drafts and relists signatories and veto holders. Reads distinctions between political forms in the wording."
        },
        "behavior": {
          "ko": "확인된 선택에서는 경쟁 초안을 남김을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "한 초안만 남으면 직접 방송할 수 있다.",
          "en": "May broadcast personally when only one draft remains."
        },
        "relationship": {
          "ko": "윤서린의 연방안과 정유라의 협약을 나란히 둔다.",
          "en": "Places Yun Seorin’s federation draft beside Jeong Yura’s agreement."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "통일안을 경쟁하는 공개 초안으로만 남겨 어느 강국도 시청역 서고를 단독 수도로 쓰지 못하게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "하나의 초안만 정서되어 자신이 패권 문서의 손이 되는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "윤서린의 연방안과 정유라의 협약을 나란히 둔다.",
          "en": "Places Yun Seorin’s federation draft beside Jeong Yura’s agreement."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "초안 한 건만 남자 방송으로 알리고 경쟁 문안의 서명자와 거부권자를 다시 적었다. 권력 형식의 문장 차이를 읽는다.",
      "en": "Broadcasts the loss of competing drafts and relists signatories and veto holders. Reads distinctions between political forms in the wording."
    },
