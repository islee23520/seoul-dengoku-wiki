    "skills": [
      {
        "id": "aid-station-bed-coordination",
        "name": {
          "ko": "의무소 병상 조정",
          "en": "Aid station bed coordination"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "무장 대기를 병상 밖으로",
          "en": "Armed waiting outside beds"
        },
        "description": {
          "ko": "들것 순서를 국적보다 앞에 놓고 무장 대기를 침상에 들이지 않는다. 빠진 당직자 문제를 수습한 결과는 없다.",
          "en": "Stretcher order precedes nationality and armed queues stay out of bedside space. Resolution of the absent duty entry is not recorded."
        },
        "behavior": {
          "ko": "들것 순서를 국적보다 앞에 두고, 봉쇄대의 무장 대기를 침상 앞으로 들이라는 쪽지를 찢는다. 온화하나 상수관 파손 소문이 뜨면 문을 직접 잠근다.",
          "en": "He put stretcher order ahead of nationality and tore up any note that told him to bring the blockade's armed wait up to the sickbeds. Mild in manner, he locked the door himself whenever a water-main break rumor rose."
        },
        "stress": {
          "ko": "공포. 의무소가 적대 이동의 대기실로 오인되어 호송 전체가 무장 해제를 당하는 것.",
          "en": "Fear. That the clinic would be mistaken for a waiting room of hostile movement and the whole convoy would be disarmed."
        },
        "relationship": {
          "ko": "관계. 영석온의 당직 침상과 병상을 나누고, 수지완의 대합실 대기와 줄을 맞춘다. 남호성의 의무호송을 도착 확인에 쓴다.",
          "en": "Relations. Shared sickbeds with Yeong Seokon's duty line and matched the queue with Su Jiwan's concourse wait. Used Nam Hoseong's medical convoy for arrival confirmation."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 현장책임자. 직함은 구의수비대 교량 의무소 거점장. 중증도 표와 급수 시간을 문에 붙이고, 무기함 봉인은 통행 심사 입회 없이 열지 않는다.",
          "en": "Office. Rank: company commander. Title: bridge clinic outpost chief. He posted the severity table and the water-supply hours on the door and opened the weapons-box seal only under passage-inspection attendance."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 현장책임자. 직함은 구의수비대 교량 의무소 거점장. 중증도 표와 급수 시간을 문에 붙이고, 무기함 봉인은 통행 심사 입회 없이 열지 않는다.",
          "en": "Recorded duty and limits: Office. Rank: company commander. Title: bridge clinic outpost chief. He posted the severity table and the water-supply hours on the door and opened the weapons-box seal only under passage-inspection attendance."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 의무소가 적대 이동의 대기실로 오인되어 호송 전체가 무장 해제를 당하는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That the clinic would be mistaken for a waiting room of hostile movement and the whole convoy would be disarmed."
        },
        "relationship": {
          "ko": "관계. 영석온의 당직 침상과 병상을 나누고, 수지완의 대합실 대기와 줄을 맞춘다. 남호성의 의무호송을 도착 확인에 쓴다.",
          "en": "Relations. Shared sickbeds with Yeong Seokon's duty line and matched the queue with Su Jiwan's concourse wait. Used Nam Hoseong's medical convoy for arrival confirmation."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "들것 순서를 국적보다 앞에 놓고 무장 대기를 침상에 들이지 않는다. 빠진 당직자 문제를 수습한 결과는 없다.",
      "en": "Stretcher order precedes nationality and armed queues stay out of bedside space. Resolution of the absent duty entry is not recorded."
    },
