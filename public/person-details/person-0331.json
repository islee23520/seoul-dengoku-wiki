    "skills": [
      {
        "id": "bed-order-administration",
        "name": {
          "ko": "병상 순서 집행",
          "en": "Bed order administration"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "우선 치료 압박을 멈춘다",
          "en": "Stops priority pressure"
        },
        "description": {
          "ko": "담당 전문의의 승인 전 우선 요청을 막고 침상 순서를 집행한다. 선반 약의 발견이 감별 성공을 뜻하지 않는다.",
          "en": "Priority requests wait for the supervising clinician and bed order is enforced. Discovery of medicine on a shelf does not establish successful identification."
        },
        "behavior": {
          "ko": "손놀림은 조용하나 치료 순서를 바꾸라는 쪽지를 받으면 침상을 잠근다. 적의 부상도 중증도 표 앞에서는 같은 줄로 본다. 제기동의 중립 의료국 흰십자단에서 담당 전문의의 도제로 배우며, 적아 구분 없이 중증도만으로 치료한다.",
          "en": "Quiet of hand, he locked the sickbeds whenever he received a note to change the care order. An enemy's wound stood in the same line before the severity table."
        },
        "stress": {
          "ko": "공포. 진료실이 전리품 분류장이 되어 자신이 찍은 중증도 표가 한 계절에 휴지가 되는 것.",
          "en": "Fear. That the care room would become a war-booty sorting hall and the severity table he stamped would become scrap paper in a season."
        },
        "relationship": {
          "ko": "관계. 은채윤의 도제로서 침상 순서를 집행하는 사제이고, 방미산의 진료소 병상을 나눈다. 류은비의 치료 원칙을 당직 원장 맨 위에 둔다.",
          "en": "Relations. An apprentice executing the sickbed order as Eun Chaeyun's apprentice, he shared sickbeds with Bang Misan's clinic. Put Ryu Eunbi's care principles at the top of the duty ledger."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 수련의. 직함은 중증도 진료 수련의. 중증도 표와 진료 소견을 나란히 붙이고, 강국 장교의 우선 치료 쪽지는 담당 전문의의 승인 전까지 받지 않는다.",
          "en": "Office. Rank: member. Title: severity ward medic, duty officer of Eun Chaeyun. He pasted the severity table and contribution labor side by side and accepted no great-power officer's priority care note before the guild posted it."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 수련의. 직함은 중증도 진료 수련의. 중증도 표와 진료 소견을 나란히 붙이고, 강국 장교의 우선 치료 쪽지는 담당 전문의의 승인 전까지 받지 않는다.",
          "en": "Recorded duty and limits: Office. Rank: member. Title: severity ward medic, duty officer of Eun Chaeyun. He pasted the severity table and contribution labor side by side and accepted no great-power officer's priority care note before the guild posted it."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 진료실이 전리품 분류장이 되어 자신이 찍은 중증도 표가 한 계절에 휴지가 되는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That the care room would become a war-booty sorting hall and the severity table he stamped would become scrap paper in a season."
        },
        "relationship": {
          "ko": "관계. 은채윤의 도제로서 침상 순서를 집행하는 사제이고, 방미산의 진료소 병상을 나눈다. 류은비의 치료 원칙을 당직 원장 맨 위에 둔다.",
          "en": "Relations. An apprentice executing the sickbed order as Eun Chaeyun's apprentice, he shared sickbeds with Bang Misan's clinic. Put Ryu Eunbi's care principles at the top of the duty ledger."
        },
        "effects": []
      }
    ],
