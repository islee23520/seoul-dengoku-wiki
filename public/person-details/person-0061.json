    "traits": [
      {
        "id": "minimum-living-standards",
        "name": {
          "ko": "생활 최저선",
          "en": "Minimum Living Standards"
        },
        "description": {
          "ko": "김도하는 연구 성과보다 주민의 원수와 식량 최저선을 우선한다.",
          "en": "Kim Doha puts residents’ minimum raw-water and food supplies ahead of research output."
        },
        "behavior": {
          "ko": "배급표가 비면 회의를 멈추고 연구 파견 인원보다 배급 솥 숫자를 먼저 표결에 올린다.",
          "en": "He stops meetings when ration sheets are empty and puts ration-pot counts to a vote before research deployment numbers."
        },
        "stress": {
          "ko": "외부 급수계약이 주민 명부를 넘길 위험이 있다면 원수·식량 최저선에 주민 거부권을 고정하려 할 수 있다.",
          "en": "If an external water contract threatens to surrender the resident register, he may seek to anchor residents’ veto rights to minimum water and food supplies."
        },
        "relationship": {
          "ko": "통행세가 민가 배급을 줄인다면 유민호와 대립하고 원수·식량 교환에서는 한지온과 협력할 수 있다.",
          "en": "He may oppose Yu Minho when transit fees reduce household rations while cooperating with Han Jion on water-for-food exchanges."
        },
        "effects": []
      },
      {
        "id": "public-channels-first",
        "name": {
          "ko": "공개 창구 우선",
          "en": "Public Channels First"
        },
        "description": {
          "ko": "김도하는 사적 청탁보다 주민이 확인할 수 있는 공개 절차를 중시한다.",
          "en": "Kim Doha favors publicly reviewable procedures over private requests."
        },
        "behavior": {
          "ko": "사적 청탁을 공개 창구로 돌리고 대피 경로와 우물 수위를 공개 게시한다.",
          "en": "He redirects private requests to public channels and posts evacuation routes and well levels openly."
        },
        "stress": {
          "ko": "급수계약이 주민 명부를 넘기는 통로가 될 우려가 있다면 공개 게시와 주민 표결을 더 중시할 수 있다.",
          "en": "If a water contract could become a means of surrendering the resident register, he may place greater weight on public notices and resident votes."
        },
        "relationship": {
          "ko": "주민 쪽 심의를 공개적으로 완성할 수 있다면 정호준과의 동맹을 강화할 수 있다.",
          "en": "He may strengthen his alliance with Jeong Hojun when residents’ part of the deliberation can be completed openly."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "배급표가 비면 회의를 멈추고 식량 교환을 한다. 주민 표결과 급수 공개 운영이 강점이며 군사·전투 경력은 없다.",
      "en": "He stops meetings over empty allocations and exchanges food. Resident votes and water notices support management, not military or combat expertise."
    },
