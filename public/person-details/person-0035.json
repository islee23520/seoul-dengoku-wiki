    "traits": [
      {
        "id": "k035-emergency-deadline",
        "name": {
          "ko": "비상에도 사흘",
          "en": "Three days even in emergencies"
        },
        "description": {
          "ko": "재측정 없는 비상 개정에 사흘 기한을 적어 재배포한다.",
          "en": "Redistributes emergency revisions with a three-day remeasurement deadline."
        },
        "behavior": {
          "ko": "재측정 없는 비상 개정에 사흘 기한을 적어 재배포한다.",
          "en": "Redistributes emergency revisions with a three-day remeasurement deadline."
        },
        "stress": {
          "ko": "위조 계측 도장 하나가 천왕 원장 전체를 무효로 만들어 규격맹이 부품 봉쇄로 쪼개지는 것.",
          "en": "That one forged gauging seal would void the whole Cheonwang ledger and the fabrication alliance would split under parts blockades."
        },
        "relationship": {
          "ko": "정시우의 계측 도장을 검증하는 계약이고, 정유라의 종료 조건 문장을 참고하며, 이강묵의 암호 동원 수첩을 원장 밖으로 밀어내려 한다.",
          "en": "A contract verifying Jeong Siwoo's gauging seals, consulting Jeong Yura's exit-condition wording, and trying to push I Gangmuk's cipher mobilization notebook outside the ledger."
        },
        "effects": []
      },
      {
        "id": "k035-parallel-copies",
        "name": {
          "ko": "함께 받는 사본",
          "en": "Copies to both sides"
        },
        "description": {
          "ko": "평의회와 공방에 사본을 동시에 보낸다.",
          "en": "Sends copies to the council and workshops together."
        },
        "behavior": {
          "ko": "평의회와 공방에 사본을 동시에 보낸다.",
          "en": "Sends copies to the council and workshops together."
        },
        "stress": {
          "ko": "위조 계측 도장 하나가 천왕 원장 전체를 무효로 만들어 규격맹이 부품 봉쇄로 쪼개지는 것.",
          "en": "That one forged gauging seal would void the whole Cheonwang ledger and the fabrication alliance would split under parts blockades."
        },
        "relationship": {
          "ko": "정시우의 계측 도장을 검증하는 계약이고, 정유라의 종료 조건 문장을 참고하며, 이강묵의 암호 동원 수첩을 원장 밖으로 밀어내려 한다.",
          "en": "A contract verifying Jeong Siwoo's gauging seals, consulting Jeong Yura's exit-condition wording, and trying to push I Gangmuk's cipher mobilization notebook outside the ledger."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "재측정 없는 개정에 감사 문구를 붙이고 계측 도장을 대조했다. 기록으로 비상 권한을 제한하는 강점이 있으나 모든 위조를 잡는 능력은 아니다.",
      "en": "Attached audit conditions to an unmeasured revision and checked seals. Records constrain emergency power, without guaranteeing detection of every forgery."
    },
