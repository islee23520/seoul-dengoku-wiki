    "skills": [
      {
        "id": "k301-night-intrusion-restraint",
        "name": {
          "ko": "야간 침입 제지",
          "en": "Night intrusion restraint"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "k301-priority",
        "name": {
          "ko": "수비의 절제",
          "en": "Restrained defense"
        },
        "description": {
          "ko": "곽태산은 야간 침입자를 붙잡고 암호패를 갈았다. 환자 칸 보호와 열쇠 분리로 수비가 호송을 압도하지 않게 한다.",
          "en": "Gwak Taesan caught a night intruder and changed the token. Patient-car protection and separated keys keep defense from overshadowing escort."
        },
        "behavior": {
          "ko": "칸 열쇠와 무기함 봉인을 분리해 보관하고, 수색은 통행 심사관 입회 아래에서만 한다.",
          "en": "Office. Rank: convoy hand. Title: medical train defense chief. He kept the car keys and the weapons-box seal in separate custody and conducted searches only under the passage examiner's attendance."
        },
        "stress": {
          "ko": "수비대 안에서 암사제 무기를 숨긴 자가 나와 장세화의 중립이 내부에서 깨지는 것.",
          "en": "Fear. That someone hiding Amsa-made weapons inside the defense squad would break Jang Sehwa's neutrality from within."
        },
        "relationship": {
          "ko": "문시온과 봉인 입회를 공유하고, 전미리의 환자 칸을 지키며, 배우진이 심은 장교 인맥을 의심한다.",
          "en": "Relations. Shared the sealing attendance with Mun Sion, guarded Jeon Miri's patient cars, and suspected the officer network Bae Woojin had planted."
        },
        "effects": []
      },
      {
        "id": "k301-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 호송원. 직함은 의료열차 수비대장. 칸 열쇠와 무기함 봉인을 분리해 보관하고, 수색은 통행 심사관 입회 아래에서만 한다.",
          "en": "Office. Rank: convoy hand. Title: medical train defense chief. He kept the car keys and the weapons-box seal in separate custody and conducted searches only under the passage examiner's attendance."
        },
        "stress": {
          "ko": "공포. 수비대 안에서 암사제 무기를 숨긴 자가 나와 장세화의 중립이 내부에서 깨지는 것.",
          "en": "Fear. That someone hiding Amsa-made weapons inside the defense squad would break Jang Sehwa's neutrality from within."
        },
        "relationship": {
          "ko": "관계. 문시온과 봉인 입회를 공유하고, 전미리의 환자 칸을 지키며, 배우진이 심은 장교 인맥을 의심한다.",
          "en": "Relations. Shared the sealing attendance with Mun Sion, guarded Jeon Miri's patient cars, and suspected the officer network Bae Woojin had planted."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "곽태산은 야간 침입자를 붙잡고 암호패를 갈았다. 환자 칸 보호와 열쇠 분리로 수비가 호송을 압도하지 않게 한다.",
      "en": "Gwak Taesan caught a night intruder and changed the token. Patient-car protection and separated keys keep defense from overshadowing escort."
    },
