    "traits": [
      {
        "id": "k440-action-priority",
        "name": {
          "ko": "틀린 보고 재확인",
          "en": "Recheck mistaken reports"
        },
        "description": {
          "ko": "2125년 교량 습격 훈련에서 최초 보고가 틀리자 참관 칸을 다시 열었다.",
          "en": "In 2125, when the first report of a bridge-raid exercise proved wrong, he reopened the observation column. By this deed the signature of the bridge passage courier post rose into the ledger."
        },
        "behavior": {
          "ko": "2125년 교량 습격 훈련에서 최초 보고가 틀리자 참관 칸을 다시 열었다.",
          "en": "In 2125, when the first report of a bridge-raid exercise proved wrong, he reopened the observation column. By this deed the signature of the bridge passage courier post rose into the ledger."
        },
        "stress": {
          "ko": "교량 통행 전령 당직이 비면 수문국의 통행이 강국 볼모가 되는 것.",
          "en": "That the bridge passage courier duty post would stand empty and the Compact's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "김태운의 지휘 아래 교량 통행과 야간 도하 보고를 맡는다.",
          "en": "Serves under Kim Taeun on bridge passage and night-crossing reports."
        },
        "effects": []
      },
      {
        "id": "k440-bounded-handover",
        "name": {
          "ko": "기록으로 잇는 당직",
          "en": "Duty linked by records"
        },
        "description": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "behavior": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "stress": {
          "ko": "교량 통행 전령 당직이 비면 수문국의 통행이 강국 볼모가 되는 것.",
          "en": "That the bridge passage courier duty post would stand empty and the Compact's passage would become a hostage of the great powers."
