    "skills": [
      {
        "id": "water-board",
        "name": {
          "ko": "급수 게시판 운영",
          "en": "Water-supply notice management"
        },
        "rating": 60
      },
      {
        "id": "referral",
        "name": {
          "ko": "공개 창구 안내",
          "en": "Public-channel referral"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "water-supply-channels-first",
        "name": {
          "ko": "급수 창구 우선",
          "en": "Water Supply Channels First"
        },
        "description": {
          "ko": "변오름은 대합실 운영에서 군수 화차보다 주민의 급수 창구를 먼저 지킨다.",
          "en": "Byeon Oreum prioritizes residents' water-service counters over military freight cars in waiting-hall operations."
        },
        "behavior": {
          "ko": "수압 게시판을 대합실로 옮기고 군수 화차를 급수 창구 앞에 두지 않는다.",
          "en": "Byeon brings water-pressure boards into the waiting hall and keeps military freight cars away from water-service counters."
        },
        "stress": {
          "ko": "계약 만료가 집단 단수로 번질 우려가 커지면 대합실의 급수 정보와 창구 접근을 더 중시할 수 있다.",
          "en": "If contract expiry threatens collective water cutoffs, Byeon may place greater emphasis on waiting-hall supply information and counter access."
        },
        "relationship": {
          "ko": "장민재의 급수권을 창구에서 집행하되 김보람의 봉쇄가 창구를 닫으면 충돌할 수 있다.",
          "en": "Byeon may enforce Jang Minjae's water rights at the counter while clashing with Kim Boram if closures shut it."
        },
        "effects": []
      },
      {
        "id": "turn-away-favor-requests",
        "name": {
          "ko": "청탁 돌려보내기",
          "en": "Turn Away Favor Requests"
        },
        "description": {
          "ko": "변오름은 사적 청탁보다 누구나 이용하는 공개 창구를 통한 처리를 선호한다.",
          "en": "Byeon Oreum favors handling requests through publicly accessible counters rather than private favors."
        },
        "behavior": {
          "ko": "2125년 사적 청탁을 받아들이지 않고 요청자를 공개 창구로 보냈다.",
          "en": "In 2125, Byeon turned away a private favor request and directed the requester to the public counter."
        },
        "stress": {
          "ko": "단수 위험으로 창구의 중요성이 커지면 사적 요청보다 공개 절차를 지키려 할 수 있다.",
          "en": "As cutoff risks make the counter more important, Byeon may try to preserve public procedures over private requests."
        },
        "relationship": {
          "ko": "한소미와 협력하더라도 생활 복구 공약을 공개 방송으로 감시하는 태도를 유지할 수 있다.",
          "en": "Even when cooperating with Han Somi, Byeon may retain a public-broadcast approach to monitoring recovery promises."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "수압 게시판을 대합실로 옮기고 공개 창구로 청탁을 보낸다. 주민 권리의 방송 집행이 중심이며 시민대표의 모든 역량을 복사하지 않았다.",
      "en": "He brings pressure notices into the concourse and redirects favor requests. Broadcast enforcement of resident rights is central, without copying every ability of the citizen representative."
    },
