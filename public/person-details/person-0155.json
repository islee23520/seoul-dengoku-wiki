    "traits": [
      {
        "id": "k154-choice",
        "name": {
          "ko": "확인을 받은 뒤 출발",
          "en": "Departs after confirmation"
        },
        "description": {
          "ko": "봉인 끈이 느슨하면 출발을 거부하고, 구두 전갈을 기록하지 않는 사신을 위조일 수 있다고 본다. 숨이 차도 사본 두 장을 한 손에 쥔다.",
          "en": "She refused departure whenever a seal cord sat loose and read any envoy who did not record verbal dispatches as a potential forger. Short of breath or not, she held two copies in one hand."
        },
        "behavior": {
          "ko": "일화. 강예준의 심사 정지 선언과 지목현의 동부 파견 전갈이 같은 날 전령 가방에 함께 든다. 양해온은 조하린의 보관 확인을 먼저 받아 인준 보류를 달고, 두 전갈 가운데 어느 쪽을 먼저 문서고에 넣을지 인준 시점을 따져 정한다.",
          "en": "Anecdote. Gang Yejun's suspension of review and Ji Mokhyeon's eastern dispatch message end up in the courier bag on the same day. Yang Haeon first obtains Jo Harin's custody confirmation to post the ratification hold, then weighs the ratification timing to decide which message goes into the archive first."
        },
        "stress": {
          "ko": "공포. 위조 인준 전갈 한 장이 유언을 통과시켜 전령망이 강국 하청으로 몰락하는 것. 행동 변화나 상태 효과는 미확정이다.",
          "en": "Fear. That one forged ratification dispatch would pass a testament and the courier network would sink into a great power's subcontract. Changes in behavior or state effects are unconfirmed."
        },
        "relationship": {
          "ko": "관계. 강예준의 심사 정지 선언을 봉인 상태로만 나르는 지휘이고, 마도한의 사본 상자와 순번을 계약으로 나누며, 지목현의 동부 파견 전갈과 인준 시점을 저울질한다.",
          "en": "Relations. Under command to carry Gang Yejun's examination-suspension declaration only under seal, split boxes and order with Ma Dohan by contract, and weighed ratification timing against Ji Mokhyeon's eastern dispatches."
        },
        "effects": []
      },
      {
        "id": "k154-boundary",
        "name": {
          "ko": "업무 경계를 지킴",
          "en": "Maintains work boundaries"
        },
        "description": {
          "ko": "관직. 품계 주사. 직함은 인준 심사 전령. 전갈을 심사관과 문서고에 동시에 보내고, 인준 보류는 강예준의 날인과 조하린의 보관 확인이 둘 다 있어야 달린다.",
          "en": "Office. Rank: registrar. Title: ratification examination courier. He sent the dispatches to the examiner and the archive at once, and a ratification hold ran only with both Gang Yejun's stamp and Jo Harin's custody confirmation."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 인준 심사 전령. 전갈을 심사관과 문서고에 동시에 보내고, 인준 보류는 강예준의 날인과 조하린의 보관 확인이 둘 다 있어야 달린다.",
          "en": "Office. Rank: registrar. Title: ratification examination courier. He sent the dispatches to the examiner and the archive at once, and a ratification hold ran only with both Gang Yejun's stamp and Jo Harin's custody confirmation."
        },
        "stress": {
          "ko": "공포. 위조 인준 전갈 한 장이 유언을 통과시켜 전령망이 강국 하청으로 몰락하는 것. 실제 반응은 아직 기록되지 않았다.",
          "en": "Fear. That one forged ratification dispatch would pass a testament and the courier network would sink into a great power's subcontract. The actual response is not yet recorded."
        },
        "relationship": {
          "ko": "관계. 강예준의 심사 정지 선언을 봉인 상태로만 나르는 지휘이고, 마도한의 사본 상자와 순번을 계약으로 나누며, 지목현의 동부 파견 전갈과 인준 시점을 저울질한다.",
          "en": "Relations. Under command to carry Gang Yejun's examination-suspension declaration only under seal, split boxes and order with Ma Dohan by contract, and weighed ratification timing against Ji Mokhyeon's eastern dispatches."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "보관 확인을 먼저 받아 보류 통지를 달고 인준 시점을 따져 전갈 순서를 정한다. 전달 판단을 독립 외교권으로 바꾸지 않는다. 직함·야망을 이미 이룬 권한이나 성과로 취급하지 않는다.",
      "en": "Obtains custody confirmation before a suspension notice and orders messages around approval timing. Delivery judgment is not independent diplomatic authority. Titles and ambitions are not treated as accomplished authority or results."
    },
