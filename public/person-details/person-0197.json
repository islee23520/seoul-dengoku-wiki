    "skills": [
      {
        "id": "auction-administration",
        "name": {
          "ko": "경매 운영",
          "en": "Auction administration"
        },
        "rating": 75
      },
      {
        "id": "price-recording",
        "name": {
          "ko": "가격 기록",
          "en": "Price recording"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "k196-disposition",
        "name": {
          "ko": "눈짓 거래 중단",
          "en": "Stopping wink deals"
        },
        "description": {
          "ko": "목소리가 맑고 잔인할 만큼 공정하다. 입찰자가 눈짓을 교환하면 즉시 그 품목을 다음 회로 미룬다.",
          "en": "Her voice was clear and fair to the point of cruelty. When bidders exchanged glances she postponed that lot to the next session at once."
        },
        "behavior": {
          "ko": "관직. 품계 교도. 직함은 경매사. 시작가와 낙찰가를 벽에 쓰고, 호송권만은 별도 봉투 경매로 돌린다.",
          "en": "Office. Rank: lay instructor. Title: auctioneer. She wrote the opening and winning bids on the wall and ran the convoy right alone as a sealed-envelope auction."
        },
        "stress": {
          "ko": "공포. 강국이 비공개 직거래로 경매판을 빈 의자로 만드는 것.",
          "en": "Fear. That great powers would make the auction floor empty chairs through closed direct deals."
        },
        "relationship": {
          "ko": "관계. 오해린에게 호송권 비공개 경매를 위임받았고 남윤경과 가격 주도권을 경쟁한다. 신태산의 호송 입찰을 자주 낙찰시킨다.",
          "en": "Relations. Received mandate over the closed convoy-right auction from O Haerin and competed with Nam Yungyeong for price leadership. Often awarded Sin Taesan's convoy bids."
        },
        "effects": []
      },
      {
        "id": "k196-choice",
        "name": {
          "ko": "공개가와 봉투 분리",
          "en": "Separating public prices and envelopes"
        },
        "description": {
          "ko": "일화. 흉작 소문만으로 가락 시세가 뛰자 노량진 경매판에도 빈 상자가 고가로 나가기 시작했다.",
          "en": "Anecdote. When Garak prices jumped on famine rumor alone, empty boxes began going for high prices on the Noryangjin auction floor too."
        },
        "behavior": {
          "ko": "관계. 오해린에게 호송권 비공개 경매를 위임받았고 남윤경과 가격 주도권을 경쟁한다. 신태산의 호송 입찰을 자주 낙찰시킨다.",
          "en": "Relations. Received mandate over the closed convoy-right auction from O Haerin and competed with Nam Yungyeong for price leadership. Often awarded Sin Taesan's convoy bids."
        },
        "stress": {
          "ko": "공포. 강국이 비공개 직거래로 경매판을 빈 의자로 만드는 것.",
          "en": "Fear. That great powers would make the auction floor empty chairs through closed direct deals."
        },
        "relationship": {
          "ko": "관계. 오해린에게 호송권 비공개 경매를 위임받았고 남윤경과 가격 주도권을 경쟁한다. 신태산의 호송 입찰을 자주 낙찰시킨다.",
          "en": "Relations. Received mandate over the closed convoy-right auction from O Haerin and competed with Nam Yungyeong for price leadership. Often awarded Sin Taesan's convoy bids."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "담합 눈짓에 품목을 미루고 공개 가격과 비공개 호송권 봉투를 분리한다. 공정성 주장과 비공개 위임이 함께 있는 운영이다.",
      "en": "Defers lots on collusive glances and separates public prices from sealed convoy rights. Fairness claims coexist with private delegated bidding."
    },
