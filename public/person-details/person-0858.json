    "traits": [
      {
        "id": "dry-and-preserve-documents",
        "name": {
          "ko": "문서 말려 보존",
          "en": "Dry and Preserve Documents"
        },
        "description": {
          "ko": "박다은은 젖은 인준 문서를 말리고 필사본으로 남기는 보존 지향을 보인다.",
          "en": "Park Daeun shows a preservation orientation by drying a wet approval document and retaining a handwritten copy."
        },
        "behavior": {
          "ko": "승강장에서 물에 젖은 인준 문서를 말려 필사본을 만들었다.",
          "en": "They dried the water-soaked approval document at the platform and made a handwritten copy."
        },
        "stress": {
          "ko": "문서 손상이 장부의 연속성을 끊을 우려가 있으면 읽을 수 있는 사본 확보에 집중할 수 있다.",
          "en": "If document damage threatens register continuity, they may focus on securing a readable copy."
        },
        "relationship": {
          "ko": "선배 당직에게 손상 문서를 인계해야 한다면 남긴 필사본을 확인 근거로 삼을 수 있다.",
          "en": "When handing over a damaged document to a senior duty colleague, they may use the retained copy as a reference."
        },
        "effects": []
      },
      {
        "id": "maintain-correction-records",
        "name": {
          "ko": "정정 기록 잇기",
          "en": "Maintain Correction Records"
        },
        "description": {
          "ko": "박다은의 정정 기록 잇기는 제공된 서술의 정정 이력과 장부 연속성 지향에 한정된다.",
          "en": "Park Daeun's maintenance of correction records is limited to the supplied narrative's correction history and aim of register continuity."
        },
        "behavior": {
          "ko": "확인된 행동은 젖은 인준 문서를 필사본으로 남겨 기록의 내용을 이어 보존한 것이다.",
          "en": "The documented action is preserving the content of a wet approval document through a handwritten copy."
        },
        "stress": {
          "ko": "기록 손실이 당직 인계를 끊을 우려가 있으면 정정 내용을 이어 확인할 근거를 중시할 수 있다.",
          "en": "If record loss threatens handover continuity, they may value evidence that allows corrections to remain traceable."
        },
        "relationship": {
          "ko": "인계 상대가 정정 내용을 확인해야 한다면 남은 문서와 기록을 함께 근거로 삼을 수 있다.",
          "en": "If a handover partner needs to verify corrections, they may rely on the surviving documents and records together."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "물에 젖은 인준 문서를 필사본으로 남겼다. 보존 실무와 장부 정정 이력을 평가하며 보존고 전체 운영을 추정하지 않는다.",
      "en": "She copied a water-damaged approval document. Preservation and ledger correction are supported, not control of the whole storage facility."
    },
