    "skills": [
      {
        "id": "emergency-power-allocation",
        "name": {
          "ko": "비상 배전",
          "en": "Emergency power allocation"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "치료 전력을 먼저 잠근다",
          "en": "Reserves power for care"
        },
        "description": {
          "ko": "정전 때 건조실과 진료소 전력을 남기고 경매 조명을 껐다. 연료·출력 기록과 우선 배전 판단에 근거한다.",
          "en": "During an outage they preserved power for drying and care and switched off auction lighting. Fuel and output records support the allocation judgment."
        },
        "behavior": {
          "ko": "연료 냄새에 예민하고 구두 배전을 싫어한다. 건조기보다 경매 조명에 전력을 돌리라는 압박을 모욕으로 여긴다. 제기동의 중립 의료국 흰십자단에서 담당 전문의의 도제로 배우며, 적아 구분 없이 중증도만으로 치료한다.",
          "en": "Sensitive to the smell of fuel, she hated verbal power routing. She took the pressure to divert power from the dryers to the auction lighting as an insult."
        },
        "stress": {
          "ko": "공포. 연료가 바닥난 밤에 생약이 썩고, 그 공백을 암사 보호창고가 메우는 것.",
          "en": "Fear. That on a night when the fuel ran dry the crude herbs would rot, and the Amsa protection warehouse would fill the gap."
        },
        "relationship": {
          "ko": "관계. 천다움의 건조기에 출력을 맞추고, 방미산의 진료소 전력을 같은 일지에 남긴다. 류은비의 치료 물자 우선에는 복종해 왔지만 은폐 배전은 거부해 왔다.",
          "en": "Relations. Matched output to Cheon Daum's dryers and kept Bang Misan's clinic power on the same log. She had obeyed Ryu Eunbi's care-supply priority but refused concealed power routing."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 수련의. 직함은 약재 보관 수련의. 매 교대 연료 잔량과 출력 일지를 봉인해 천다움에게 보내고, 최저 출력 이하면 외부 독촉이 있어도 경매 배전을 끊는다.",
          "en": "Office. Rank: member. Title: herb drying and refrigeration emergency generator operator. Every shift she sealed the fuel remainder and output logs and sent them to Cheon Daum, and below minimum output she cut the auction power even under the merchants' urging."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 수련의. 직함은 약재 보관 수련의. 매 교대 연료 잔량과 출력 일지를 봉인해 천다움에게 보내고, 최저 출력 이하면 외부 독촉이 있어도 경매 배전을 끊는다.",
          "en": "Recorded duty and limits: Office. Rank: member. Title: herb drying and refrigeration emergency generator operator. Every shift she sealed the fuel remainder and output logs and sent them to Cheon Daum, and below minimum output she cut the auction power even under the merchants' urging."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 연료가 바닥난 밤에 생약이 썩고, 그 공백을 암사 보호창고가 메우는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That on a night when the fuel ran dry the crude herbs would rot, and the Amsa protection warehouse would fill the gap."
        },
        "relationship": {
          "ko": "관계. 천다움의 건조기에 출력을 맞추고, 방미산의 진료소 전력을 같은 일지에 남긴다. 류은비의 치료 물자 우선에는 복종해 왔지만 은폐 배전은 거부해 왔다.",
          "en": "Relations. Matched output to Cheon Daum's dryers and kept Bang Misan's clinic power on the same log. She had obeyed Ryu Eunbi's care-supply priority but refused concealed power routing."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "정전 때 건조실과 진료소 전력을 남기고 경매 조명을 껐다. 연료·출력 기록과 우선 배전 판단에 근거한다.",
      "en": "During an outage they preserved power for drying and care and switched off auction lighting. Fuel and output records support the allocation judgment."
    },
