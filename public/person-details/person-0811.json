    "skills": [
      {
        "id": "scout",
        "name": {
          "ko": "매복 징후 관찰",
          "en": "Ambush-sign observation"
        },
        "rating": 50
      },
      {
        "id": "guard",
        "name": {
          "ko": "출입 저지·암호패 교체",
          "en": "Entry control and pass replacement"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "watch-for-ambush-traces",
        "name": {
          "ko": "매복 흔적 관찰",
          "en": "Watch for Ambush Traces"
        },
        "description": {
          "ko": "성숲현은 초계 중 매복의 흔적을 먼저 읽는 관찰 지향을 보인다.",
          "en": "Seong Suphyeon shows an observational disposition toward recognizing ambush traces during patrol."
        },
        "behavior": {
          "ko": "능선 초계에서 매복 흔적을 먼저 알아채 피해를 막았다.",
          "en": "On a ridge patrol, he recognized ambush traces early and prevented harm."
        },
        "stress": {
          "ko": "당직 공백으로 통행이 위협받을 우려가 커지면 초계의 위험 징후에 더 집중할 수 있다.",
          "en": "If fears of a duty gap threatening passage intensify, he may focus more closely on patrol warning signs."
        },
        "relationship": {
          "ko": "선배 당직과 인계할 때 자신이 읽은 매복 징후를 정확히 공유하려 할 수 있다.",
          "en": "In handovers with senior duty staff, he may seek to share the ambush signs he recognized accurately."
        },
        "effects": []
      },
      {
        "id": "prevent-patrol-casualties",
        "name": {
          "ko": "초계 피해 예방",
          "en": "Prevent Patrol Casualties"
        },
        "description": {
          "ko": "성숲현은 초계에서 위험 징후를 피해 예방으로 연결하려는 성향을 보인다.",
          "en": "Seong Suphyeon shows a disposition to turn patrol warning signs into prevention of harm."
        },
        "behavior": {
          "ko": "능선에서 읽은 매복 흔적을 바탕으로 초계 피해를 막았다.",
          "en": "He used the ambush traces recognized on the ridge to prevent patrol harm."
        },
        "stress": {
          "ko": "위험 노출과 당직 유지가 충돌하면 피해를 줄여 당직을 이어 가는 쪽을 택할 수 있다.",
          "en": "If exposure to danger conflicts with maintaining duty, he may favor reducing harm to preserve continuity."
        },
        "relationship": {
          "ko": "선배 당직과는 피해 예방에 필요한 위험 정보를 이어 주는 일을 중시할 수 있다.",
          "en": "With senior duty staff, he may value passing on risk information needed to prevent harm."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "능선 초계에서 매복 흔적을 먼저 읽었다. 징후 관찰과 위험 회피를 평가하며 적 격파나 작전 총괄은 없다.",
      "en": "She saw ambush signs first on ridge patrol. Observation and avoidance are supported, not enemy defeat or overall command."
    },
