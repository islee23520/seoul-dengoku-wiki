    "skills": [
      {
        "id": "audit-access-custody",
        "name": {
          "ko": "감사 열람 보관",
          "en": "Audit access custody"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "공개 열람 전 종결 보류",
          "en": "Withholds closure before public review"
        },
        "description": {
          "ko": "공개 열람이 잡힐 때까지 감사 원본을 잠그고 사본에 단수 칸을 따로 표시했다. 확인된 행동 범위를 넘는 권한과 성과는 부여하지 않는다.",
          "en": "Locks the original audit until public review is scheduled and marks outage fields separately on the copy. No authority or achievement beyond these actions is granted."
        },
        "behavior": {
          "ko": "확인된 선택에서는 공개 열람 전 종결 보류을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "교대가 막히거나 기록이 사라지면 원본과 인계를 재확인할 수 있다.",
          "en": "May recheck originals and handovers when shifts are blocked or records disappear."
        },
        "relationship": {
          "ko": "다음 당직에게 열쇠와 기록을 넘기며 파벌의 인계 방해를 경계한다.",
          "en": "Hands keys and records to the next duty worker and watches for factional obstruction."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "감사 기록관 자리에서 시청역 조합 장부를 끊기지 않게 잇고, 작업장 파벌이 갈려도 조합원 전원의 위원장 직접선거 결과를 지킨다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "감사 기록관 당직이 비고 선거 파벌이 인수인계를 가로막아 정동노총의 통행이 강국 볼모가 되는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "다음 당직에게 열쇠와 기록을 넘기며 파벌의 인계 방해를 경계한다.",
          "en": "Hands keys and records to the next duty worker and watches for factional obstruction."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "공개 열람이 잡힐 때까지 감사 원본을 잠그고 사본에 단수 칸을 따로 표시했다. 확인된 행동 범위를 넘는 권한과 성과는 부여하지 않는다.",
      "en": "Locks the original audit until public review is scheduled and marks outage fields separately on the copy. No authority or achievement beyond these actions is granted."
    },
