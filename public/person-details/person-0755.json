    "skills": [
      {
        "id": "k755-departure-signature-verification",
        "name": {
          "ko": "출발 서명 확인",
          "en": "Departure signature verification"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "k755-priority",
        "name": {
          "ko": "배차표 확인",
          "en": "Checks dispatch sheets"
        },
        "description": {
          "ko": "황사아의 확인된 행동은 2125년 배차표 없는 열차를 세워 서명 없는 출발을 막았다.  반복 성과와 구체적 전문 경력은 미확인이다.",
          "en": "황사아: Anecdote. In 2125 he stopped a dispatch-sheetless train and blocked an unsigned departure. By this deed the signature of the dispatch courier post rose into the ledger. Repeated results and detailed professional experience remain unconfirmed."
        },
        "behavior": {
          "ko": "자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: convoy hand. Title: dispatch courier. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "배차 전령 당직이 비면 신내운수의 통행이 노선 면허의 볼모가 되는 것.",
          "en": "Fear. That the dispatch courier duty post would stand empty and the City's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
      {
        "id": "k755-accountability",
        "name": {
          "ko": "당직의 연속성",
          "en": "Continuity of duty"
        },
        "description": {
          "ko": "큰소리보다 기록을 믿고 자기 직위의 열쇠와 기록만 넘긴다.",
          "en": "Trusts records over loud claims and hands over only the keys and records of the position."
        },
        "behavior": {
          "ko": "관직. 품계 호송원. 직함은 배차 전령. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: convoy hand. Title: dispatch courier. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "공포. 배차 전령 당직이 비면 신내운수의 통행이 노선 면허의 볼모가 되는 것.",
          "en": "Fear. That the dispatch courier duty post would stand empty and the City's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "황사아의 확인된 행동은 2125년 배차표 없는 열차를 세워 서명 없는 출발을 막았다.  반복 성과와 구체적 전문 경력은 미확인이다.",
      "en": "황사아: Anecdote. In 2125 he stopped a dispatch-sheetless train and blocked an unsigned departure. By this deed the signature of the dispatch courier post rose into the ledger. Repeated results and detailed professional experience remain unconfirmed."
    },
