    "traits": [
      {
        "id": "k287-priority",
        "name": {
          "ko": "중량의 공정성",
          "en": "Fair weights"
        },
        "description": {
          "ko": "봉국은 모소의 송장과 회수 로트를 맞추며 시험 철재를 지킨다. 은닉에 대한 가혹함도 남는다.",
          "en": "Bongguk reconciles recovered lots with Moso’s invoices and reserves trial metal, but remains harsh toward concealment."
        },
        "behavior": {
          "ko": "회수 중량을 공개 저울에 올리고, 이씨 가문 전용 칸으로 들어간 철재는 회장실 인준 전 출고를 막는다.",
          "en": "Office. Rank: section chief. Title: steel salvage yard outpost chief, duty officer of Hwang Noeul. He put salvage tonnage on the public scales and blocked the release of any steel that had entered a house-only column before the seniority council's ratification."
        },
        "stress": {
          "ko": "결함 로트가 회수장에서 군수 칸으로 빠져 민생 열차가 멈추는 것.",
          "en": "Fear. That a defective lot would leave the salvage yard into a munitions column and the civil trains would stop."
        },
        "relationship": {
          "ko": "황노을의 지휘로 저울을 지키고, 모소의 물류 송장과 로트를 맞춘다. 조우찬의 시험 차륜에 쓸 철재를 우선 칸에 둔다.",
          "en": "Relations. Kept the scales under Hwang Noeul's command and matched the lots with Mo So's freight invoices. Put the steel for Jo Woochan's trial wheels in the priority column."
        },
        "effects": []
      },
      {
        "id": "k287-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 상무. 직함은 성하전자 철재 회수장 거점장, 황노을의 실무 담당자. 회수 중량을 공개 저울에 올리고, 이씨 가문 전용 칸으로 들어간 철재는 회장실 인준 전 출고를 막는다.",
          "en": "Office. Rank: section chief. Title: steel salvage yard outpost chief, duty officer of Hwang Noeul. He put salvage tonnage on the public scales and blocked the release of any steel that had entered a house-only column before the seniority council's ratification."
        },
        "stress": {
          "ko": "공포. 결함 로트가 회수장에서 군수 칸으로 빠져 민생 열차가 멈추는 것.",
          "en": "Fear. That a defective lot would leave the salvage yard into a munitions column and the civil trains would stop."
        },
        "relationship": {
          "ko": "관계. 황노을의 지휘로 저울을 지키고, 모소의 물류 송장과 로트를 맞춘다. 조우찬의 시험 차륜에 쓸 철재를 우선 칸에 둔다.",
          "en": "Relations. Kept the scales under Hwang Noeul's command and matched the lots with Mo So's freight invoices. Put the steel for Jo Woochan's trial wheels in the priority column."
        },
        "effects": []
      }
    ],
