    "traits": [
      {
        "id": "k052-temporary-reward",
        "name": {
          "ko": "한시 보상",
          "en": "Temporary rewards"
        },
        "description": {
          "ko": "보상을 세습 관직으로 본문에 올리지 않는다.",
          "en": "Does not enter hereditary offices as rewards in the main text."
        },
        "behavior": {
          "ko": "보상을 세습 관직으로 본문에 올리지 않는다.",
          "en": "Does not enter hereditary offices as rewards in the main text."
        },
        "stress": {
          "ko": "과도한 세습권이 길드 평의회를 쪼개고, 그 공백을 경비대가 군수독재로 메우는 것.",
          "en": "That excessive hereditary rights would split the council, and the guards would fill that gap with a munitions dictatorship."
        },
        "relationship": {
          "ko": "정시우의 원로 권한을 보상과 분리하고, 장우석의 규격 원장과 배급 칸을 맞추며, 한소미의 공방 보상 요구를 참고하되 세습은 거절한다.",
          "en": "Separating Jeong Siwoo's elder authority from compensation, matching ration columns with Jang Wooseok's standards ledger, and consulting Han Somi's workshop compensation demands while refusing heredity."
        },
        "effects": []
      },
      {
        "id": "k052-three-party-seal",
        "name": {
          "ko": "삼자의 날인",
          "en": "Three-party seal"
        },
        "description": {
          "ko": "노동·건물·경비의 동시 날인을 요구한다.",
          "en": "Requires labor, building, and guard seals together."
        },
        "behavior": {
          "ko": "노동·건물·경비의 동시 날인을 요구한다.",
          "en": "Requires labor, building, and guard seals together."
        },
        "stress": {
          "ko": "과도한 세습권이 길드 평의회를 쪼개고, 그 공백을 경비대가 군수독재로 메우는 것.",
          "en": "That excessive hereditary rights would split the council, and the guards would fill that gap with a munitions dictatorship."
        },
        "relationship": {
          "ko": "정시우의 원로 권한을 보상과 분리하고, 장우석의 규격 원장과 배급 칸을 맞추며, 한소미의 공방 보상 요구를 참고하되 세습은 거절한다.",
          "en": "Separating Jeong Siwoo's elder authority from compensation, matching ration columns with Jang Wooseok's standards ledger, and consulting Han Somi's workshop compensation demands while refusing heredity."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "공로·물자 분리 기록과 대질이 근거다. 원로 권한과 보상을 나누지만 세습 폐지 완료를 주장하지 않는다.",
      "en": "Separate merit and material records and witness confrontation support the profile. Distinguishing elder powers from rewards does not establish completed abolition of heredity."
    },
