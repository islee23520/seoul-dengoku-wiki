    "skills": [
      {
        "id": "transit-tax-calculation",
        "name": {
          "ko": "통과세 계산",
          "en": "Transit tax calculation"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "빈 면제 칸을 경계",
          "en": "Wary of blank exemptions"
        },
        "description": {
          "ko": "통과품과 급수 시간을 함께 기록하고 사적 청탁을 공개 창구로 보낸다. 세금 실무와 협상 목표를 군사 권한으로 바꾸지 않는다.",
          "en": "Cargo and water times share a ledger; private requests go to the public desk. Tax administration and negotiating goals do not become military authority."
        },
        "behavior": {
          "ko": "숫자와 인장을 좋아하고, 무력으로 세를 깎는 장교를 모욕으로 기억한다. 빈 면제 칸을 위험 신호로 본다.",
          "en": "He liked numbers and stamps and remembered officers who shaved headcounts by force as an insult. He read empty exemption columns as danger signals."
        },
        "stress": {
          "ko": "공포. 세리가 일방의 군사 비용 징수원으로 전락해 정유라의 표준 조약에서 제외되는 것.",
          "en": "Fear. That the customs officer would sink into a protection-money collector and be excluded from Jeong Yura's standard treaty."
        },
        "relationship": {
          "ko": "관계. 정유라의 손실보상 조항을 세율에 넣으려 하고, 배우진의 보호세 요구를 거부하며, 라세영의 검역 도장을 세 계산에 연동한다.",
          "en": "Relations. Sought to put Jeong Yura's loss-compensation clause into the tariff, refused Bae Woojin's protection-tax demand, and linked Ra Seyoung's quarantine stamps to the toll arithmetic."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 공동실무원. 직함은 양군 관문 세리. 통과 품목과 급수 시간을 같은 장부에 적고, 군사 면제는 양군 결재와 계약감사 문구가 있는 통행증만 인정한다.",
          "en": "Office. Rank: sergeant. Title: gate customs officer. He wrote the passage items and the water-supply hours in the same ledger and honored military exemptions only with passage permits bearing an audit clause."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 공동실무원. 직함은 양군 관문 세리. 통과 품목과 급수 시간을 같은 장부에 적고, 군사 면제는 양군 결재와 계약감사 문구가 있는 통행증만 인정한다.",
          "en": "Recorded duty and limits: Office. Rank: sergeant. Title: gate customs officer. He wrote the passage items and the water-supply hours in the same ledger and honored military exemptions only with passage permits bearing an audit clause."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 세리가 일방의 군사 비용 징수원으로 전락해 정유라의 표준 조약에서 제외되는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That the customs officer would sink into a protection-money collector and be excluded from Jeong Yura's standard treaty."
        },
        "relationship": {
          "ko": "관계. 정유라의 손실보상 조항을 세율에 넣으려 하고, 배우진의 보호세 요구를 거부하며, 라세영의 검역 도장을 세 계산에 연동한다.",
          "en": "Relations. Sought to put Jeong Yura's loss-compensation clause into the tariff, refused Bae Woojin's protection-tax demand, and linked Ra Seyoung's quarantine stamps to the toll arithmetic."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "통과품과 급수 시간을 함께 기록하고 사적 청탁을 공개 창구로 보낸다. 세금 실무와 협상 목표를 군사 권한으로 바꾸지 않는다.",
      "en": "Cargo and water times share a ledger; private requests go to the public desk. Tax administration and negotiating goals do not become military authority."
    },
