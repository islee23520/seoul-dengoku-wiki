      {
        "id": "heater-maintenance-disposition",
        "name": {
          "ko": "고장을 밤 넘기지 않음",
          "en": "Does not leave faults overnight"
        },
        "description": {
          "ko": "난로 고장을 하룻밤 넘기는 일을 맹세 위반으로 본다.",
          "en": "Treats leaving a faulty heater overnight as an oath violation."
        },
        "behavior": {
          "ko": "난로 고장을 하룻밤 넘기는 일을 맹세 위반으로 본다.",
          "en": "Treats leaving a faulty heater overnight as an oath violation."
        },
        "stress": {
          "ko": "정비 부품이 당직 승려에게만 열릴 것을 두려워한다.",
          "en": "Fears parts being available only to duty monks."
        },
        "relationship": {
          "ko": "오한결의 연료고 당직과 공구를 나누고, 황세린의 배급 창고 옆 난로를 맡는다. 백온의 공개 배급 시각에 맞춰 불을 살린다.",
          "en": "Shares tools with O Hangyeol’s fuel duty and maintains heaters beside Hwang Serin’s store on Baek On’s ration schedule."
        },
        "effects": []
      },
      {
        "id": "recorded-boundary",
        "name": {
          "ko": "사고 공동 서명",
          "en": "Joint incident signing"
        },
        "description": {
          "ko": "연통 사고에 주지와 정비 당직의 공동 서명을 요구한다.",
          "en": "Requires joint signatures from overseer and maintenance duty on flue incidents."
        },
        "behavior": {
          "ko": "연통 사고에 주지와 정비 당직의 공동 서명을 요구한다.",
          "en": "Requires joint signatures from overseer and maintenance duty on flue incidents."
        },
        "stress": {
          "ko": "난방이 떨어진 밤에 정비 부품이 당직 승려 몫으로만 열리는 것.",
          "en": "Fears parts being available only to duty monks."
        },
        "relationship": {
          "ko": "오한결의 연료고 당직과 공구를 나누고, 황세린의 배급 창고 옆 난로를 맡는다. 백온의 공개 배급 시각에 맞춰 불을 살린다.",
