    "skills": [
      {
        "id": "dispatch",
        "name": {
          "ko": "화차 순서 조정",
          "en": "Freight-car sequencing"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "stop-at-unchalked-compartments",
        "name": {
          "ko": "분필 없는 칸 정지",
          "en": "Stop at Unchalked Compartments"
        },
        "description": {
          "ko": "표누리는 분필과 배정 줄이 없는 유치 칸을 출고 가능한 자리로 인정하지 않는다.",
          "en": "Pyo Nuri does not treat unchalked or unassigned holding compartments as ready for dispatch."
        },
        "behavior": {
          "ko": "호각 전에 공방과 수비 분필을 다시 긋고 줄이 없는 개조칸은 자갈에 세운다.",
          "en": "Pyo redraws workshop and guard chalk marks before the whistle and holds modified compartments without allocation lines on the gravel."
        },
        "stress": {
          "ko": "빈 칸이 숙영 천막으로 바뀔 우려가 커지면 칸 배정 표시와 출고 정지를 더 엄격히 적용할 수 있다.",
          "en": "If empty compartments risk becoming encampments, Pyo may enforce allocation marks and dispatch stops more strictly."
        },
        "relationship": {
          "ko": "이준택의 정비 완료 도장을 받아도 유치 칸의 배정 확인을 거쳐 호각으로 이어갈 수 있다.",
          "en": "Even after receiving Lee Juntaek's maintenance-completion stamp, Pyo may verify holding allocation before sounding the whistle."
        },
        "effects": []
      },
      {
        "id": "synchronize-pump-room-clocks",
        "name": {
          "ko": "펌프실 시각 맞춤",
          "en": "Synchronize Pump-Room Clocks"
        },
        "description": {
          "ko": "표누리는 유치 칠판의 전용줄과 펌프실 호각을 같은 출고 시각에 맞추려 한다.",
          "en": "Pyo Nuri seeks to align the dedicated line on the holding board with the pump-room whistle at one dispatch time."
        },
        "behavior": {
          "ko": "부품 연장이 끊긴 날 전용줄을 고정하고 암사행 칸의 호각을 보류했다.",
          "en": "When the parts extension was cut off, Pyo fixed the dedicated line and withheld the whistle for Amsa-bound compartments."
        },
        "stress": {
          "ko": "군자 호각이 보호 방송에 종속될 우려가 커지면 칠판 배정에 따른 시각 통제를 더 고수할 수 있다.",
          "en": "If Gunja's whistle risks being subordinated to protection broadcasts, Pyo may hold more firmly to board-based timing control."
        },
        "relationship": {
          "ko": "한소미의 제동 부품이 늦으면 전용줄을 미루며 공급 일정에 맞춰 출고를 조정할 수 있다.",
          "en": "If Han Somi's brake parts arrive late, Pyo may postpone the dedicated line and adjust dispatch to the supply schedule."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "전용줄을 고정하고 부품 연장이 끊긴 날 호각을 울리지 않았다. 칸 배정과 출고 시각 조정이 강점이며 차량 정비는 추가하지 않는다.",
      "en": "She fixed the dedicated car line and withheld the whistle when parts supply lapsed. Car allocation and timing are strengths, not vehicle maintenance."
    },
