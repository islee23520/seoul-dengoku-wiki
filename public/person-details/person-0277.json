    "traits": [
      {
        "id": "k276-priority",
        "name": {
          "ko": "재고의 공적 기준",
          "en": "Public inventory standards"
        },
        "description": {
          "ko": "황노을은 공개 저울과 재고 보고로 시험 철재를 따로 둔다. 공급 조건 거래는 확인되지만 광역 자원 장악으로 확대하지 않는다.",
          "en": "Hwang Noeul uses public scales and inventory reports to reserve trial metal. Supply bargaining is documented, not control over regional resources."
        },
        "behavior": {
          "ko": "회수 중량을 공개 저울에 올리고, 이씨 가문 전용 칸으로 들어간 철재는 회장실 인준 전 출고를 막는다.",
          "en": "Office. Rank: assistant manager. Title: steel salvage work squad leader. He put salvage tonnage on the public scales and blocked the release of any steel that had entered a house-only column before the seniority council's ratification."
        },
        "stress": {
          "ko": "회수 철재가 군수 전용으로 빠져 민생 열차가 영영 멈추는 것.",
          "en": "Fear. That salvage steel would leave as munitions-only and the civil trains would stop forever."
        },
        "relationship": {
          "ko": "이홍원에게 재고를 보고하고 신가온에게 차륜 공급 조건을 거래한다. 조우찬의 시험 차륜에 쓸 철재를 우선 떼어 둔다.",
          "en": "Relations. Reported inventory to I Hongwon and traded the wheel supply terms with Shin Gaon. Set aside the steel for Jo Woochan's trial wheels first."
        },
        "effects": []
      },
      {
        "id": "k276-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 사원. 직함은 성하전자 철재 회수 작업반장. 회수 중량을 공개 저울에 올리고, 이씨 가문 전용 칸으로 들어간 철재는 회장실 인준 전 출고를 막는다.",
          "en": "Office. Rank: assistant manager. Title: steel salvage work squad leader. He put salvage tonnage on the public scales and blocked the release of any steel that had entered a house-only column before the seniority council's ratification."
        },
        "stress": {
          "ko": "공포. 회수 철재가 군수 전용으로 빠져 민생 열차가 영영 멈추는 것.",
          "en": "Fear. That salvage steel would leave as munitions-only and the civil trains would stop forever."
        },
        "relationship": {
          "ko": "관계. 이홍원에게 재고를 보고하고 신가온에게 차륜 공급 조건을 거래한다. 조우찬의 시험 차륜에 쓸 철재를 우선 떼어 둔다.",
          "en": "Relations. Reported inventory to I Hongwon and traded the wheel supply terms with Shin Gaon. Set aside the steel for Jo Woochan's trial wheels first."
        },
        "effects": []
      }
    ],
    "narrative": {
