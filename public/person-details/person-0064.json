    "skills": [
      {
        "id": "water-test",
        "name": {
          "ko": "채수·시약 기록",
          "en": "Sampling and reagent records"
        },
        "rating": 65
      },
      {
        "id": "sample",
        "name": {
          "ko": "표본 기록 심사",
          "en": "Sample-record review"
        },
        "rating": 60
      }
    ],
    "traits": [
      {
        "id": "one-pass-is-not-enough",
        "name": {
          "ko": "한 번의 합격 불신",
          "en": "One Pass Is Not Enough"
        },
        "description": {
          "ko": "장예린은 한 번의 합격 판정만으로 관로의 안전을 믿지 않는다.",
          "en": "Jang Yerin does not trust a pipeline’s safety on the strength of one passing result."
        },
        "behavior": {
          "ko": "채수 시각과 시약 로트를 기록하고 박누리의 영등포 표본과 교차검증한다.",
          "en": "She records sampling times and reagent lots and cross-checks Yeongdeungpo samples with Park Nuri."
        },
        "stress": {
          "ko": "검사 공백 사이에 탁수가 골목에 도착할 우려가 있다면 반복 검사와 교차검증을 더 중시할 수 있다.",
          "en": "If turbid water might reach alleys during a testing gap, she may give greater weight to repeated testing and cross-checks."
        },
        "relationship": {
          "ko": "검사 결과의 신뢰성을 높여야 한다면 박누리와의 표본 교차검증 동맹을 활용할 수 있다.",
          "en": "She may draw on her sample-cross-checking alliance with Park Nuri when test reliability needs strengthening."
        },
        "effects": []
      },
      {
        "id": "inspection-over-schedules",
        "name": {
          "ko": "일정보다 검사",
          "en": "Inspection Over Schedules"
        },
        "description": {
          "ko": "장예린은 정치 일정에 맞춘 검사 축소보다 검증 주기를 지키는 데 집요하다.",
          "en": "Jang Yerin persistently protects testing cycles against reductions demanded by political schedules."
        },
        "behavior": {
          "ko": "검사 주기 축소 쪽지를 찢고 기준 초과가 나오면 즉시 송수 중단을 권고한다.",
          "en": "She tears up requests to shorten testing cycles and immediately recommends halting water delivery when limits are exceeded."
        },
        "stress": {
          "ko": "검사망 정지가 군사 보호권의 개입으로 이어질 우려가 있다면 일정 압박에도 검증을 유지하려 할 수 있다.",
          "en": "If a testing shutdown could invite military protection claims, she may seek to sustain verification despite scheduling pressure."
        },
        "relationship": {
          "ko": "한소미의 센서 수리를 기다리는 상황이라면 검사망 유지에 필요한 협력을 중시할 수 있다.",
          "en": "While awaiting Han Somi’s sensor repairs, she may prioritize cooperation needed to keep the testing network operating."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "채수 시각과 시약 로트를 기록하고 봉인 구역의 우회 검증을 설계했다. 반복 검사와 대안 설계가 강점이며 의사 경력은 없다.",
      "en": "She records sampling times and reagent lots and designed alternate verification. Repeated testing and alternatives are strengths, not a medical career."
    },
