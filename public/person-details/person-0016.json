    "traits": [
      {
        "id": "k016-emergency-review",
        "name": {
          "ko": "비상도 재계산",
          "en": "Review emergency rates"
        },
        "description": {
          "ko": "비상 요율도 기한 안에 다시 계산한다.",
          "en": "Recalculates emergency rates within the deadline."
        },
        "behavior": {
          "ko": "비상 요율도 기한 안에 다시 계산한다.",
          "en": "Recalculates emergency rates within the deadline."
        },
        "stress": {
          "ko": "위조 통행증 한 장이 신정 유치선을 가득 채워 보수열차와 급수열차가 동시에 갇히는 것.",
          "en": "That one forged pass would fill the Sinjeong siding and the repair trains and water trains would be trapped at once."
        },
        "relationship": {
          "ko": "유세진의 배차 선언을 원장으로 옮기는 계약이고, 최한결의 보수열차 출고를 기록으로 보증하며, 박태겸의 중계 창구와 서부 요율을 나눈다.",
          "en": "A contract moving Yu Sejin's dispatch declarations into the ledger, guaranteeing Choi Hangyeol's repair-train releases by record, and splitting the western rates with Park Taegyeom's relay window."
        },
        "effects": []
      },
      {
        "id": "k016-private-margins",
        "name": {
          "ko": "난외의 해석",
          "en": "Private margin interpretations"
        },
        "description": {
          "ko": "숫자는 공개하되 해석은 난외에 남긴다.",
          "en": "Publishes figures but retains interpretations in the margins."
        },
        "behavior": {
          "ko": "숫자는 공개하되 해석은 난외에 남긴다.",
          "en": "Publishes figures but retains interpretations in the margins."
        },
        "stress": {
          "ko": "위조 통행증 한 장이 신정 유치선을 가득 채워 보수열차와 급수열차가 동시에 갇히는 것.",
          "en": "That one forged pass would fill the Sinjeong siding and the repair trains and water trains would be trapped at once."
        },
        "relationship": {
          "ko": "유세진의 배차 선언을 원장으로 옮기는 계약이고, 최한결의 보수열차 출고를 기록으로 보증하며, 박태겸의 중계 창구와 서부 요율을 나눈다.",
          "en": "A contract moving Yu Sejin's dispatch declarations into the ledger, guaranteeing Choi Hangyeol's repair-train releases by record, and splitting the western rates with Park Taegyeom's relay window."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "요율 기록과 한 차례 차륜 결함 발견을 함께 반영했다. 금융 후원망이나 광범위한 정비 숙련까지 확대하지 않는다.",
      "en": "Rate records and a single wheel-defect discovery are both reflected, without implying financial patronage or broad maintenance mastery."
    },
