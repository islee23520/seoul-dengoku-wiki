    "skills": [
      {
        "id": "trade",
        "name": {
          "ko": "공개 조건 물류 거래",
          "en": "Logistics under disclosed terms"
        },
        "rating": 65
      },
      {
        "id": "certify",
        "name": {
          "ko": "인증 조항 검토",
          "en": "Certification-clause review"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "shared-scales",
        "name": {
          "ko": "공동 저울",
          "en": "Shared Scales"
        },
        "description": {
          "ko": "구연재는 거래량을 사적인 저울보다 함께 확인할 수 있는 공동 기준으로 재려 한다.",
          "en": "Gu Yeonjae favors shared, checkable measures of traded quantities over private scales."
        },
        "behavior": {
          "ko": "경매장의 불공정 저울을 걷어 내고 공동 저울로 바꿨다.",
          "en": "He removed an unfair auction-house scale and replaced it with shared scales."
        },
        "stress": {
          "ko": "물류가 보호비와 인질 가격에 종속될 우려가 있다면 공동 계량처럼 확인 가능한 거래 기준을 중시할 수 있다.",
          "en": "If logistics risks becoming subject to protection payments and hostage pricing, he may emphasize checkable trading standards such as shared weighing."
        },
        "relationship": {
          "ko": "공개 운송 조건을 유지할 수 있다면 최은재의 인증과 유민호의 중립 배차망에 협력할 수 있다.",
          "en": "He may cooperate with Choi Eunjae’s certification and Yu Minho’s neutral dispatch network when open transport terms can be maintained."
        },
        "effects": []
      },
      {
        "id": "no-hidden-conditions",
        "name": {
          "ko": "숨은 조건 거부",
          "en": "No Hidden Conditions"
        },
        "description": {
          "ko": "구연재는 실리를 추구해도 비공개 성능 조건이 붙은 운송을 받아들이지 않는다.",
          "en": "Gu Yeonjae pursues practical gains but refuses transport bound by undisclosed performance terms."
        },
        "behavior": {
          "ko": "운송 사본을 신청국과 마곡 서고에 함께 남기고 비공개 조항이 있으면 화차를 출발시키지 않는다.",
          "en": "He leaves transport copies with both the applicant country and Magok archive and holds wagons when clauses are undisclosed."
        },
        "stress": {
          "ko": "인증이 보호비로 팔릴 우려가 있다면 선적보다 조건 공개와 원장 보존을 우선할 수 있다.",
          "en": "If certification risks being sold as protection payments, he may prioritize disclosed terms and ledger preservation over shipment."
        },
        "relationship": {
          "ko": "기술공유 조건을 공개 운송에 반영할 수 있다면 정유라의 문장을 운송 조항에 끌어들일 수 있다.",
          "en": "He may incorporate Jeong Yura’s language into transport clauses when technology-sharing terms can be made part of open carriage."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "불공정 저울을 바꾸고 비공개 조건의 선적을 거부한다. 실제 운송 조건 조정이 교섭의 근거이며 기업 창업 경력은 없다.",
      "en": "He replaced an unfair scale and refuses hidden shipping terms. Transport negotiations support bargaining, not company founding."
    },
