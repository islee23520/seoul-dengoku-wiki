    "skills": [
      {
        "id": "pump",
        "name": {
          "ko": "펌프 분해·축 교체",
          "en": "Pump disassembly and shaft replacement"
        },
        "rating": 55
      },
      {
        "id": "wheel",
        "name": {
          "ko": "차륜 결함 점검",
          "en": "Wheel-defect inspection"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "replace-only-necessary-axles",
        "name": {
          "ko": "필요한 축만 교체",
          "en": "Replace Only Necessary Axles"
        },
        "description": {
          "ko": "남남원은 펌프에서 확인된 마모 축만 교체하는 제한적 수리 성향을 보인다.",
          "en": "Nam Namwon shows a targeted repair disposition by replacing only the pump's confirmed worn axle."
        },
        "behavior": {
          "ko": "정지한 펌프를 분해해 마모 축 하나를 교체하고 재가동했다.",
          "en": "He dismantled the stopped pump, replaced one worn axle, and restarted it."
        },
        "stress": {
          "ko": "당직 공백이 통행 종속으로 이어질까 우려되면 확인된 수리 필요에 집중하려 할 수 있다.",
          "en": "If a duty gap could lead to dependent passage, he may focus on the confirmed repair need."
        },
        "relationship": {
          "ko": "선배 당직에게는 교체한 축과 펌프 재가동 결과를 구체적으로 전달하려 할 수 있다.",
          "en": "He may give the senior duty holder a concrete account of the replaced axle and the pump's restart."
        },
        "effects": []
      },
      {
        "id": "hand-over-records-and-tools",
        "name": {
          "ko": "기록과 공구 인계",
          "en": "Hand Over Records and Tools"
        },
        "description": {
          "ko": "남남원은 수리 경험과 자기 직위의 기록을 다음 당직에 잇는 성향을 보이지만 공구 인계 자체는 확인되지 않는다.",
          "en": "Nam Namwon shows an inclination to connect repair experience and post records to the next duty holder, although tool handover itself is unverified."
        },
        "behavior": {
          "ko": "펌프 수리를 수행하고 자기 직위의 열쇠와 기록을 넘기며 공구를 넘겼다는 행동은 자료에 없다.",
          "en": "He repairs the pump and passes on his post's keys and records, while the source does not document transferring tools."
        },
        "stress": {
          "ko": "당직 공백이 통행을 강국의 볼모로 만들까 우려되면 확인 가능한 수리 내용과 기록의 인계를 중시할 수 있다.",
          "en": "If a duty gap could make passage hostage to a powerful state, he may emphasize handing over verifiable repair details and records."
        },
        "relationship": {
          "ko": "선배 당직과는 수리 결과와 직위 기록을 공유하는 인계에 의지할 수 있다.",
          "en": "He may rely on handover that shares repair results and post records with the senior duty holder."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "펌프 분해 후 마모 축 하나를 교체해 재가동했다. 구체적 수리는 확인되며 부품 물류 직함으로 거래 전문성을 추가하지 않는다.",
      "en": "She restarted a pump after replacing a worn shaft. Specific repair is supported; a parts-logistics title does not add trade expertise."
    },
