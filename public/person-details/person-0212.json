    "traits": [
      {
        "id": "k211-disposition",
        "name": {
          "ko": "경매 조명보다 제빙",
          "en": "Ice-making before auction lights"
        },
        "description": {
          "ko": "연료 냄새에 예민하고 구두 배전을 싫어한다. 제빙기보다 경매 조명에 전력을 돌리라는 정치적 압박을 모욕으로 여긴다.",
          "en": "Sensitive to the smell of fuel, she hated verbal power routing. She took the political pressure to divert power from the ice machines to the auction lighting as an insult."
        },
        "behavior": {
          "ko": "관직. 품계 기사. 직함은 노량진 제빙 비상발전 운전장. 매 교대 연료 잔량과 출력 일지를 봉인해 지마루에게 보내고, 최저 출력 이하면 대표의 독촉이 있어도 경매 배전을 끊는다.",
          "en": "Office. Rank: temple student. Title: Noryangjin ice-making emergency generator operator. Every shift she sealed the fuel remainder and output logs and sent them to Ji Maru, and below minimum output she cut the auction power even under the representative's urging."
        },
        "stress": {
          "ko": "공포. 연료가 바닥난 밤에 냉동이 녹고, 그 공백을 수문 보호권이 메우는 것.",
          "en": "Fear. That on a night when the fuel ran dry the cold storage would thaw, and the water-gate protection zone would fill the gap."
        },
        "relationship": {
          "ko": "관계. 지마루의 냉동기지 전력 배분을 발전 쪽에서 받치고, 지윤재의 시운전에 출력을 맞추며, 오해린의 재고 공개에는 복종해 왔지만 은폐 배전은 거부해 왔다.",
          "en": "Relations. Backed Ji Maru's cold-storage depot power distribution from the generation side, matched output to Ji Yunjae's trials, and had obeyed O Haerin's inventory disclosure but refused concealed power routing."
        },
        "effects": []
      },
      {
        "id": "k211-choice",
        "name": {
          "ko": "은폐 배전 거부",
          "en": "Rejecting concealed power allocation"
        },
        "description": {
          "ko": "일화. 2125년 사적 청탁을 돌려보내고 공개 창구로 보냈다. 이 일로 노량진 제빙 비상발전 운전장 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 she sent a private petition back and passed it to the public window. By this deed the signature of the Noryangjin ice-making emergency generator operator post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 지마루의 냉동기지 전력 배분을 발전 쪽에서 받치고, 지윤재의 시운전에 출력을 맞추며, 오해린의 재고 공개에는 복종해 왔지만 은폐 배전은 거부해 왔다.",
          "en": "Relations. Backed Ji Maru's cold-storage depot power distribution from the generation side, matched output to Ji Yunjae's trials, and had obeyed O Haerin's inventory disclosure but refused concealed power routing."
        },
        "stress": {
          "ko": "공포. 연료가 바닥난 밤에 냉동이 녹고, 그 공백을 수문 보호권이 메우는 것.",
          "en": "Fear. That on a night when the fuel ran dry the cold storage would thaw, and the water-gate protection zone would fill the gap."
        },
        "relationship": {
          "ko": "관계. 지마루의 냉동기지 전력 배분을 발전 쪽에서 받치고, 지윤재의 시운전에 출력을 맞추며, 오해린의 재고 공개에는 복종해 왔지만 은폐 배전은 거부해 왔다.",
          "en": "Relations. Backed Ji Maru's cold-storage depot power distribution from the generation side, matched output to Ji Yunjae's trials, and had obeyed O Haerin's inventory disclosure but refused concealed power routing."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "교대 연료·출력을 기록하고 최저선 아래 경매 배전을 끊는다. 오해린에게 복종하면서도 은폐 배전을 거부하는 경계가 있다.",
      "en": "Logs fuel and output each shift and cuts auction supply below the minimum. Obedience to Oh Haerin has a limit at concealed allocation."
    },
