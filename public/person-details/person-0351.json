    "skills": [
      {
        "id": "bridge-inspection",
        "name": {
          "ko": "교량 점검",
          "en": "Bridge inspection"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "근거 없는 봉쇄를 싫어한다",
          "en": "Rejects unsupported closure"
        },
        "description": {
          "ko": "균열과 무게를 공개하며 무장 난입자를 붙들어 명부를 재점검했다. 교량 검증과 제한된 현장 제압은 보이나 대규모 전투는 없다.",
          "en": "Cracks and weights are published; an armed intruder was restrained for roster review. Bridge verification and limited restraint are supported, not large-scale battle."
        },
        "behavior": {
          "ko": "점검 해머를 계약서보다 믿지만, 근거 없는 봉쇄는 병력 낭비라고 본다. 교각 균열을 사람 이름처럼 기억한다.",
          "en": "He trusted an inspection hammer more than a contract, but saw a baseless blockade as a waste of troops. He remembered pier cracks the way he remembered people's names."
        },
        "stress": {
          "ko": "공포. 교량이 일방의 군령으로 상수호위단에 넘어가는 것.",
          "en": "Fear. That the bridges would pass to the water-supply escort under a protection-government pretext."
        },
        "relationship": {
          "ko": "관계. 고서준과 장세화의 통행 협약을 교량에서 집행하고, 심가은의 척후 보고를 검증하며, 남호성의 의무호송을 우선 통과시킨다.",
          "en": "Relations. Executed the passage treaty of Go Seojun and Jang Sehwa at the bridge, verified Sim Gaeun's reconnaissance reports, and passed Nam Hoseong's medical convoy through first."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 중대장. 직함은 아관사 교량 감독. 교각 균열과 통행 무게를 매일 공개하고, 군 통행은 아관사와 구의수비대의 이중 날인을 요구한다.",
          "en": "Office. Rank: company commander. Title: bridge supervisor. He published the pier cracks and passage weights daily and demanded the double stamp of Go Seojun and the water engineers' council for military passage."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 중대장. 직함은 아관사 교량 감독. 교각 균열과 통행 무게를 매일 공개하고, 군 통행은 아관사와 구의수비대의 이중 날인을 요구한다.",
          "en": "Recorded duty and limits: Office. Rank: company commander. Title: bridge supervisor. He published the pier cracks and passage weights daily and demanded the double stamp of Go Seojun and the water engineers' council for military passage."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 교량이 일방의 군령으로 상수호위단에 넘어가는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That the bridges would pass to the water-supply escort under a protection-government pretext."
        },
        "relationship": {
          "ko": "관계. 고서준과 장세화의 통행 협약을 교량에서 집행하고, 심가은의 척후 보고를 검증하며, 남호성의 의무호송을 우선 통과시킨다.",
          "en": "Relations. Executed the passage treaty of Go Seojun and Jang Sehwa at the bridge, verified Sim Gaeun's reconnaissance reports, and passed Nam Hoseong's medical convoy through first."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "균열과 무게를 공개하며 무장 난입자를 붙들어 명부를 재점검했다. 교량 검증과 제한된 현장 제압은 보이나 대규모 전투는 없다.",
      "en": "Cracks and weights are published; an armed intruder was restrained for roster review. Bridge verification and limited restraint are supported, not large-scale battle."
    },
