    "skills": [
      {
        "id": "save-register",
        "name": {
          "ko": "위기 인명 장부 보존",
          "en": "Emergency preservation of personnel registers"
        },
        "rating": 45
      },
      {
        "id": "departure",
        "name": {
          "ko": "배차표·출발 확인",
          "en": "Departure and dispatch checks"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "people-records-over-cargo",
        "name": {
          "ko": "화물보다 인명 기록",
          "en": "People Records Over Cargo"
        },
        "description": {
          "ko": "주다인은 위기에서 화물보다 사람을 식별하는 장부를 우선하는 태도를 보인다.",
          "en": "Ju Dain shows a preference for preserving records identifying people over cargo in a crisis."
        },
        "behavior": {
          "ko": "호송 도중 습격을 만나자 화물보다 인명 장부부터 챙겼다.",
          "en": "When attacked during transport, Ju Dain secured the people register before the cargo."
        },
        "stress": {
          "ko": "호송 위기가 기록과 통행의 연속성을 위협하면 인명 장부를 우선 보전할 수 있다.",
          "en": "If a transport crisis threatens record and passage continuity, Ju Dain may prioritize safeguarding the people register."
        },
        "relationship": {
          "ko": "선배 당직자와 인수인계할 때도 화물 내역보다 인명 장부의 전달을 중시할 수 있다.",
          "en": "In handovers with senior duty staff, Ju Dain may give particular weight to passing on the people register rather than cargo details."
        },
        "effects": []
      },
      {
        "id": "check-departure-conditions",
        "name": {
          "ko": "출발 조건 확인",
          "en": "Check Departure Conditions"
        },
        "description": {
          "ko": "주다인은 무표 출발을 그대로 허용하지 않고 출발 조건을 확인하는 태도를 보인다.",
          "en": "Ju Dain shows a disposition to check departure conditions rather than allow departures without the required schedule."
        },
        "behavior": {
          "ko": "제공된 서사에서 무표 출발을 저지한 이력이 제시된다.",
          "en": "The supplied narrative credits Ju Dain with stopping a departure lacking its required schedule."
        },
        "stress": {
          "ko": "당직 공백이 태욱그룹의 통행을 위협하면 불확실한 출발을 허용하는 데 더욱 신중할 수 있다.",
          "en": "If a duty gap threatens Taeuk Group's passage, Ju Dain may become more cautious about allowing an uncertain departure."
        },
        "relationship": {
          "ko": "선배 당직자와는 자기 직위의 기록을 넘겨 출발 조건 확인이 끊기지 않도록 협력할 수 있다.",
          "en": "Ju Dain may work with senior duty staff to keep departure checks continuous by handing over the position's records."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "습격 때 화물보다 인명 장부를 챙겼고 무표 출발 저지 이력이 있다. 호송 생업은 있어도 전투 승리 근거는 없다.",
      "en": "She saved personnel records over freight during an attack and has an undocumented-departure stop recorded. Escort livelihood does not prove combat victories."
    },
