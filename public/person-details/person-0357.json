    "skills": [
      {
        "id": "duty-triage-documentation",
        "name": {
          "ko": "당직 중증도 기록",
          "en": "Duty triage documentation"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "stated-priority",
        "name": {
          "ko": "상처를 먼저 본다",
          "en": "Looks at wounds first"
        },
        "description": {
          "ko": "상처의 열과 활력으로 부상자를 보고 호송증을 당직 원장에 옮긴다. 혼입된 무장 줄의 해결이나 독립 의료 경력은 미확인이다.",
          "en": "Heat and vitality shape attention to casualties, and transport papers enter the duty ledger. Resolution of armed queues and independent medical experience are unconfirmed."
        },
        "behavior": {
          "ko": "고지 바람보다 상처의 열을 먼저 읽고, 초병의 단독 차단을 진료 중단의 원인으로 적는다. 적의 부상도 활력이 떨어지면 같은 들것으로 본다.",
          "en": "He read a wound's heat before the hill wind and wrote a sentry's solitary blockade down as a cause of interrupted care. An enemy's wound, when the pulse fell, rode the same stretcher."
        },
        "stress": {
          "ko": "공포. 고지가 뚫린 밤에 의무소가 전리품 창구로 바뀌고 잔압 기록과 병상이 함께 비는 것.",
          "en": "Fear. That on the night the hill was pierced the clinic would become a war-booty window and the residual-pressure record and the sickbeds would empty together."
        },
        "relationship": {
          "ko": "관계. 영한뫼의 교량 의무소와 병상을 나누고, 남호성의 호송증을 당직 원장에 옮긴다. 류은비의 치료 원칙을 고지 침상에도 붙인다.",
          "en": "Relations. Shared sickbeds with Yeong Hanmoe's bridge clinic and moved Nam Hoseong's convoy passes into the duty ledger. Pasted Ryu Eunbi's care principles on the hill sickbeds too."
        },
        "effects": []
      },
      {
        "id": "bounded-duty",
        "name": {
          "ko": "자기 당직의 경계",
          "en": "Boundaries of personal duty"
        },
        "description": {
          "ko": "관직. 품계 수비대원. 직함은 구의수비대 능선·교량 당직 의무원. 중증도 표와 급수 시간을 같은 칠판에 붙이고, 단독 전쟁명령 쪽지는 구의수비대의 결재이 풀리기 전에는 침상에 들이지 않는다.",
          "en": "Office. Rank: sergeant. Title: ridge and bridge duty medic. He posted the severity table and the water-supply hours on the same chalkboard and let no wartime sole-command note reach the sickbeds before the engineers' council veto lifted."
        },
        "behavior": {
          "ko": "확인된 당직 수행과 제한: 관직. 품계 수비대원. 직함은 구의수비대 능선·교량 당직 의무원. 중증도 표와 급수 시간을 같은 칠판에 붙이고, 단독 전쟁명령 쪽지는 구의수비대의 결재이 풀리기 전에는 침상에 들이지 않는다.",
          "en": "Recorded duty and limits: Office. Rank: sergeant. Title: ridge and bridge duty medic. He posted the severity table and the water-supply hours on the same chalkboard and let no wartime sole-command note reach the sickbeds before the engineers' council veto lifted."
        },
        "stress": {
          "ko": "이 경계가 흔들릴 때 카드에 명시된 우려: 공포. 고지가 뚫린 밤에 의무소가 전리품 창구로 바뀌고 잔압 기록과 병상이 함께 비는 것.",
          "en": "The card states this concern when those boundaries fail: Fear. That on the night the hill was pierced the clinic would become a war-booty window and the residual-pressure record and the sickbeds would empty together."
        },
        "relationship": {
          "ko": "관계. 영한뫼의 교량 의무소와 병상을 나누고, 남호성의 호송증을 당직 원장에 옮긴다. 류은비의 치료 원칙을 고지 침상에도 붙인다.",
          "en": "Relations. Shared sickbeds with Yeong Hanmoe's bridge clinic and moved Nam Hoseong's convoy passes into the duty ledger. Pasted Ryu Eunbi's care principles on the hill sickbeds too."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "상처의 열과 활력으로 부상자를 보고 호송증을 당직 원장에 옮긴다. 혼입된 무장 줄의 해결이나 독립 의료 경력은 미확인이다.",
      "en": "Heat and vitality shape attention to casualties, and transport papers enter the duty ledger. Resolution of armed queues and independent medical experience are unconfirmed."
    },
