    "traits": [
      {
        "id": "reservoirs-first",
        "name": {
          "ko": "저수조 먼저",
          "en": "Reservoirs First"
        },
        "description": {
          "ko": "장민재는 후계 논의보다 골목 수도와 저수조의 실제 상태를 먼저 살핀다.",
          "en": "Jang Minjae puts the actual condition of neighborhood taps and reservoirs before succession discussions."
        },
        "behavior": {
          "ko": "후계자 이름보다 저수조 수위를 먼저 묻고 동파 관로에는 우회 급수로로 대응했다.",
          "en": "Jang asks about reservoir levels before successor names and responded to frozen pipes by opening a bypass supply route."
        },
        "stress": {
          "ko": "계약 만료가 집단 단수로 번질 조짐이 보이면 회의보다 현장 급수 확보를 더 급하게 여길 수 있다.",
          "en": "If contract expiry appears likely to cause collective water cutoffs, Jang may treat securing local supply as more urgent than meetings."
        },
        "relationship": {
          "ko": "한소미와 동맹을 유지하더라도 생활 복구 공약이 현장 급수로 이어지는지 계속 확인할 수 있다.",
          "en": "Even while allied with Han Somi, Jang may keep checking whether recovery promises produce actual neighborhood water supply."
        },
        "effects": []
      },
      {
        "id": "minimum-water-supply",
        "name": {
          "ko": "급수 최저선",
          "en": "Minimum Water Supply"
        },
        "description": {
          "ko": "장민재는 후계 공백과 거래 조건에도 주민의 최소 급수가 유지되어야 한다고 본다.",
          "en": "Jang Minjae holds that residents' minimum water supply must survive succession vacancies and bargaining terms."
        },
        "behavior": {
          "ko": "골목별 수압을 공개하고 펌프가 군수나 가문 창고로만 향하면 시민 연서로 평의회 소집을 요구한다.",
          "en": "Jang publishes neighborhood water pressure and uses citizen co-signatures to call the council when pumps go only to military or family warehouses."
        },
        "stress": {
          "ko": "집단 단수가 노동자의 이주로 이어질 우려가 커지면 급수 최저선의 헌장 명시를 더 강하게 요구할 수 있다.",
          "en": "If collective cutoffs threaten to displace workers, Jang may press harder to enshrine the supply minimum in the workshop charter."
        },
        "relationship": {
          "ko": "임바다와 최저선 문구를 함께 다듬되 김보람의 야간 봉쇄가 급수 창구를 닫으면 충돌할 수 있다.",
          "en": "Jang may collaborate with Im Bada on minimum-supply wording but clash with Kim Boram when night closures shut water-service counters."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "수압 게시판을 운영하고 동파 때 우회 급수로를 열었다. 생활 급수와 시민 연서가 근거이며 후계 정치의 전권은 없다.",
      "en": "He maintains pressure notices and opened an alternate supply route during freezing. Household supply and citizen petitions are supported, not full control of succession politics."
    },
