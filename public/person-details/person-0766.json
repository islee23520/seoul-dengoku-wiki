    "skills": [
      {
        "id": "casualty-delay-report",
        "name": {
          "ko": "부상자 지연 보고",
          "en": "Casualty delay reporting"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "k766-disposition",
        "name": {
          "ko": "지연에도 환자 우선",
          "en": "Patients first despite delays"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 배차 서기. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: registrar. Title: dispatch clerk. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "공포. 배차 서기 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the dispatch clerk duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 로렌초 콘티는 막힌 통로에서 먼저 옮긴 부상자와 배차 지연을 가브리엘 존슨에게 전한다. 가브리엘 존슨은 환자 명부와 처방을 확인해 늦게 도착한 환자가 진료에서 빠지지 않게 한다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Lorenzo Conti reports injured people moved first through a blocked passage and dispatch delays to Gabriel Johnson. Gabriel checks patient records and prescriptions so late arrivals are not omitted from care."
        },
        "effects": []
      },
      {
        "id": "k766-choice",
        "name": {
          "ko": "인원까지 인계",
          "en": "Handing over counts too"
        },
        "description": {
          "ko": "일화. 2125년 폭설에 막힌 환승 통로를 뚫어 부상자를 먼저 옮겼다. 이 일로 배차 서기 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he broke open the snow-blocked transfer passage and moved the injured first. By this deed the signature of the dispatch clerk post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 로렌초 콘티는 막힌 통로에서 먼저 옮긴 부상자와 배차 지연을 가브리엘 존슨에게 전한다. 가브리엘 존슨은 환자 명부와 처방을 확인해 늦게 도착한 환자가 진료에서 빠지지 않게 한다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Lorenzo Conti reports injured people moved first through a blocked passage and dispatch delays to Gabriel Johnson. Gabriel checks patient records and prescriptions so late arrivals are not omitted from care."
        },
        "stress": {
          "ko": "공포. 배차 서기 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the dispatch clerk duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 로렌초 콘티는 막힌 통로에서 먼저 옮긴 부상자와 배차 지연을 가브리엘 존슨에게 전한다. 가브리엘 존슨은 환자 명부와 처방을 확인해 늦게 도착한 환자가 진료에서 빠지지 않게 한다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Lorenzo Conti reports injured people moved first through a blocked passage and dispatch delays to Gabriel Johnson. Gabriel checks patient records and prescriptions so late arrivals are not omitted from care."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "눈길에서 먼저 옮긴 부상자와 지연을 가브리엘에게 전한다. 늦은 환자를 잇는 실무이며 처방 확인은 의무원의 일이다.",
      "en": "Reports casualties moved first and their delay to Gabriel. Connects late patients without claiming prescription review."
    },
