    "skills": [
      {
        "id": "dispatch-seal-testimony",
        "name": {
          "ko": "배차 봉인 증언",
          "en": "Dispatch seal testimony"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "증언과 소문을 가름",
          "en": "Separates testimony from rumor"
        },
        "description": {
          "ko": "의료열차 무기와 화차의 같은 끈을 증언하고 두 독립 증인 미만이면 도장을 덮는다. 부품 조작 소문과 배차 조사를 구분한다.",
          "en": "Testifies about matching cords on medical-train weapons and freight and withholds stamps without two independent witnesses. Separates parts-tampering rumors from dispatch inquiry."
        },
        "behavior": {
          "ko": "확인된 선택에서는 증언과 소문을 가름을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "누명이나 사후 승인 압박 때 도장을 덮을 수 있다.",
          "en": "May withhold stamping under pressure for blame or retrospective approval."
        },
        "relationship": {
          "ko": "원초온의 당직표와 박태겸의 조사를 맞추되 장교망 의혹은 보류한다.",
          "en": "Matches Won Choon’s duty board with Park Taegyeom’s investigation while withholding officer-network allegations."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "시청역 조합 차량정비소에서 나간 열차의 공식 명령과 비밀 쪽지를 공개 증언으로 남겨 쿠데타 의혹이 계약 감사의 입에서 지워지지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "자신의 증언이 사후 승인의 면죄부나 제3자 누명 중 하나로만 잘리는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "원초온의 당직표와 박태겸의 조사를 맞추되 장교망 의혹은 보류한다.",
          "en": "Matches Won Choon’s duty board with Park Taegyeom’s investigation while withholding officer-network allegations."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "의료열차 무기와 화차의 같은 끈을 증언하고 두 독립 증인 미만이면 도장을 덮는다. 부품 조작 소문과 배차 조사를 구분한다.",
      "en": "Testifies about matching cords on medical-train weapons and freight and withholds stamps without two independent witnesses. Separates parts-tampering rumors from dispatch inquiry."
    },
