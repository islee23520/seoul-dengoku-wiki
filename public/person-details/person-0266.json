      {
        "id": "ration-mediation-disposition",
        "name": {
          "ko": "봉인을 열어 확인",
          "en": "Opens seals for checking"
        },
        "description": {
          "ko": "가짜 약 징후에 배급 줄을 멈추고 상자를 확인한다.",
          "en": "Stops queues and checks boxes over false-medicine signs."
        },
        "behavior": {
          "ko": "가짜 약 징후에 배급 줄을 멈추고 상자를 확인한다.",
          "en": "Stops queues and checks boxes over false-medicine signs."
        },
        "stress": {
          "ko": "가짜 약 기록이 아이 이송 명분이 될 것을 두려워한다.",
          "en": "Fears false-medicine records used to remove children."
        },
        "relationship": {
          "ko": "황세린의 배급 줄에서 피해를 증언하고, 봉감의 약초 의무실에서 해열을 받으며, 류은비에게 북한산보국문 투약 감사를 청한다.",
          "en": "Testifies at Hwang Serin’s queue, receives care from Bonggam and asks Ryu Eunbi for a medication audit."
        },
        "effects": []
      },
      {
        "id": "recorded-boundary",
        "name": {
          "ko": "피해 증언",
          "en": "Testifies to harm"
