    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "전달을 보류할 줄 앎",
          "en": "Withholds delivery when needed"
        },
        "description": {
          "ko": "비상배급 호송이 유찰되자 군량 전갈을 잠갔다. 봉인 상태로 조건을 운반하면서 공동호송안도 전갈에 넣는다.",
          "en": "Locks away military messages after relief transport fails to attract bids. Carries sealed terms while adding joint escort proposals."
        },
        "behavior": {
          "ko": "확인된 선택에서는 전달을 보류할 줄 앎을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "편중된 낙찰 앞에서 전달을 멈출 수 있다.",
          "en": "May halt delivery when awards favor one side."
        },
        "relationship": {
          "ko": "문도윤의 지휘 아래 영미결과 전갈 순번을 나눈다.",
          "en": "Works under Mun Doyun and shares message order with Yeong Migyeol."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
