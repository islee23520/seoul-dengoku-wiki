    "skills": [
      {
        "id": "k311-market-inventory-posting",
        "name": {
          "ko": "시장 재고 게시",
          "en": "Market inventory posting"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "k311-priority",
        "name": {
          "ko": "응급 물자 우선",
          "en": "Emergency supplies first"
        },
        "description": {
          "ko": "복용은 시세와 재고를 공개하고 의무실 물자를 우선 댄다. 숨기는 상인에 대한 잔인함도 공공 기준과 함께 남는다.",
          "en": "Bogyong posts prices and inventory and prioritizes medical supplies. Cruelty toward concealing merchants remains alongside public standards."
        },
        "behavior": {
          "ko": "시세와 재고를 벽에 적고, 무기 문장이 찍힌 주문서는 의료조 게시 전까지 출고를 막는다.",
          "en": "Office. Rank: clerk. Title: northeast neutral market outpost chief. He wrote the prices and inventory on the wall and blocked the release of any order stamped with a weapons clause until the medical crew posted it."
        },
        "stress": {
          "ko": "시장 재고가 군수 전용으로 빠져 의료열차 보급이 멈추는 것.",
          "en": "Fear. That the market inventory would leave as munitions-only and the medical train's supply would stop."
        },
        "relationship": {
          "ko": "복봉의 중계 송장과 시세를 맞추고, 국용의 당직 의무실에 응급 물자를 우선 댄다. 오해린의 시세 방송을 시장 시간에만 참고한다.",
          "en": "Relations. Matched the prices with Bok Bong's relay invoices and put emergency supplies first for Guk Yong's duty infirmary. Consulted O Haerin's price broadcasts only at market hours."
        },
        "effects": []
      },
      {
        "id": "k311-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 서기. 직함은 북동부 중립시장 거점장. 시세와 재고를 벽에 적고, 무기 문장이 찍힌 주문서는 의료조 게시 전까지 출고를 막는다.",
          "en": "Office. Rank: clerk. Title: northeast neutral market outpost chief. He wrote the prices and inventory on the wall and blocked the release of any order stamped with a weapons clause until the medical crew posted it."
        },
        "stress": {
          "ko": "공포. 시장 재고가 군수 전용으로 빠져 의료열차 보급이 멈추는 것.",
          "en": "Fear. That the market inventory would leave as munitions-only and the medical train's supply would stop."
        },
        "relationship": {
          "ko": "관계. 복봉의 중계 송장과 시세를 맞추고, 국용의 당직 의무실에 응급 물자를 우선 댄다. 오해린의 시세 방송을 시장 시간에만 참고한다.",
          "en": "Relations. Matched the prices with Bok Bong's relay invoices and put emergency supplies first for Guk Yong's duty infirmary. Consulted O Haerin's price broadcasts only at market hours."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "복용은 시세와 재고를 공개하고 의무실 물자를 우선 댄다. 숨기는 상인에 대한 잔인함도 공공 기준과 함께 남는다.",
      "en": "Bogyong posts prices and inventory and prioritizes medical supplies. Cruelty toward concealing merchants remains alongside public standards."
    },
