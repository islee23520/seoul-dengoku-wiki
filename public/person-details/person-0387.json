      {
        "id": "dispatch-prioritization",
        "name": {
          "ko": "출고 순서 조정",
          "en": "Dispatch prioritization"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "구휼 출고 우선",
          "en": "Prioritizes relief dispatch"
        },
        "description": {
          "ko": "군량 봉인의 내부 개봉과 당직 누락을 증언한다. 비상배급 마차를 출고 맨 위에 두지만 원인 규명 성과는 없다.",
          "en": "Testifies about military seals opened from inside and missing duty names. Puts relief carts first in dispatch, without a recorded solution to the breach."
        },
        "behavior": {
          "ko": "확인된 선택에서는 구휼 출고 우선을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "당직 누락 앞에서 출고 순서와 잠금을 재확인할 수 있다.",
          "en": "May recheck dispatch order and locks after duty gaps."
        },
        "relationship": {
          "ko": "수한별과 자물쇠를 나누고 전나경의 마차를 먼저 둔다.",
          "en": "Shares locks with Su Hanbyeol and prioritizes Jeon Nagyeong’s carts."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "교구 명부와 선거 봉인을 지켜 다음 대주교 비밀 선거의 절차와 명동역 인준이 끊기지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "교구 명부와 선거 봉인이 지워져 교황 없는 선출의 정당성 논쟁에서 자신의 서명이 의심받는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "수한별과 자물쇠를 나누고 전나경의 마차를 먼저 둔다.",
          "en": "Shares locks with Su Hanbyeol and prioritizes Jeon Nagyeong’s carts."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "군량 봉인의 내부 개봉과 당직 누락을 증언한다. 비상배급 마차를 출고 맨 위에 두지만 원인 규명 성과는 없다.",
      "en": "Testifies about military seals opened from inside and missing duty names. Puts relief carts first in dispatch, without a recorded solution to the breach."
    },
