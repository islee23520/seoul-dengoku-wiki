    "skills": [
      {
        "id": "will",
        "name": {
          "ko": "유언 날짜·사본 대조",
          "en": "Will date and copy comparison"
        },
        "rating": 65
      },
      {
        "id": "seal",
        "name": {
          "ko": "봉인·사본 대조",
          "en": "Seal and copy comparison"
        },
        "rating": 55
      }
    ],
    "traits": [
      {
        "id": "distrust-oral-wills",
        "name": {
          "ko": "구두 유언 불신",
          "en": "Distrust Oral Wills"
        },
        "description": {
          "ko": "정가온은 구두 유언을 진본처럼 취급하는 해석보다 날짜와 문구의 대조를 신뢰한다.",
          "en": "Jeong Gaon trusts comparisons of dates and wording over interpretations that treat oral wills as authentic documents."
        },
        "behavior": {
          "ko": "유언 문구의 날짜를 집요하게 대조하고 감사 날인 없는 단독 해석 방송을 무효로 선언한다.",
          "en": "Jeong persistently compares dates in testamentary wording and declares unilateral interpretation broadcasts invalid without an audit seal."
        },
        "stress": {
          "ko": "위조 유언이 진본으로 굳어질 우려가 커지면 구두 주장에 대한 문서 확인을 더 엄격히 요구할 수 있다.",
          "en": "If a forged will risks being accepted as authentic, Jeong may demand stricter documentary checks on oral claims."
        },
        "relationship": {
          "ko": "박세린의 가문 원장 해석과 충돌할 때 구두 권위보다 대조 가능한 문구를 요구할 수 있다.",
          "en": "When clashing with Park Serin's family-ledger interpretation, Jeong may insist on comparable wording rather than oral authority."
        },
        "effects": []
      },
      {
        "id": "send-copies-simultaneously",
        "name": {
          "ko": "사본 동시 송부",
          "en": "Send Copies Simultaneously"
        },
        "description": {
          "ko": "정가온은 유언 사본이 한 기관의 해석에만 묶이지 않도록 동시 공유를 중시한다.",
          "en": "Jeong Gaon values simultaneous sharing so testamentary copies do not remain subject to one institution's interpretation alone."
        },
        "behavior": {
          "ko": "유언 사본을 봉인해 기록청과 평의회에 동시에 보내고 관련 기록을 나란히 올리려 한다.",
          "en": "Jeong seals testamentary copies for simultaneous delivery to the records office and council and seeks to place related records side by side."
        },
        "stress": {
          "ko": "감사 직위가 후계 분쟁의 도구로 쓰일 우려가 커지면 양쪽 기관의 동시 접근을 더 고수할 수 있다.",
          "en": "If the audit office risks becoming a succession tool, Jeong may insist more strongly on simultaneous access for both institutions."
        },
        "relationship": {
          "ko": "윤서린과의 사본 전달 계약과 한소미와의 문구 조정 동맹에서는 같은 기록의 공유를 협력 기준으로 삼을 수 있다.",
          "en": "In the copy-transfer contract with Yun Seorin and wording alliance with Han Somi, Jeong may make shared access to the same records a condition of cooperation."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "유언 날짜와 사본을 대조하고 두 기관에 봉인본을 보낸다. 감사·문구 조정이 중심이며 위조 사건의 모호한 책임을 무결한 경력으로 바꾸지 않는다.",
      "en": "He compares will dates and copies and sends sealed versions to two institutions. Auditing and wording checks are central; ambiguous responsibility in a forgery episode is not treated as a spotless career."
    },
