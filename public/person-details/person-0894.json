    "skills": [
      {
        "id": "snowbound-patient-transfer",
        "name": {
          "ko": "눈길 환자 이동",
          "en": "Snowbound patient transfer"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "k894-disposition",
        "name": {
          "ko": "부상자 먼저 옮김",
          "en": "Moving casualties first"
        },
        "description": {
          "ko": "당직을 끊지 않는 쪽을 먼저 고른다. 큰소리보다 장부 한 줄을 믿는다.",
          "en": "He chose the side that kept the duty line unbroken first. He trusted one line of the ledger more than a loud voice."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 호송 전령. 자기 직위의 열쇠와 기록만 넘기고, 없는 권한은 만들지 않는다.",
          "en": "Office. Rank: registrar. Title: convoy courier. He handed over only the keys and records of his own post, and never made authority he did not hold."
        },
        "stress": {
          "ko": "공포. 호송 전령 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the convoy courier duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 세바스티안 브라운은 통로에서 먼저 옮긴 부상자를 노아 데이비스에게 인계한다. 노아 데이비스는 이동의무차에서 상태를 확인해 호송 지연이 동상 치료의 누락으로 이어지지 않게 한다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Sebastian Braun hands injured people moved first through a passage to Noah Davis. Noah checks their condition in the mobile medical car so convoy delays do not become missed frostbite care."
        },
        "effects": []
      },
      {
        "id": "k894-choice",
        "name": {
          "ko": "지연 뒤에도 인계",
          "en": "Handoff despite delay"
        },
        "description": {
          "ko": "일화. 2125년 폭설에 막힌 환승 통로를 뚫어 부상자를 먼저 옮겼다. 이 일로 호송 전령 자리의 서명이 장부에 올랐다.",
          "en": "Anecdote. In 2125 he broke open the snow-blocked transfer passage and moved the injured first. By this deed the signature of the convoy courier post rose into the ledger."
        },
        "behavior": {
          "ko": "관계. 같은 생활권 선배 당직과 인수인계로 묶인다. 세바스티안 브라운은 통로에서 먼저 옮긴 부상자를 노아 데이비스에게 인계한다. 노아 데이비스는 이동의무차에서 상태를 확인해 호송 지연이 동상 치료의 누락으로 이어지지 않게 한다.",
          "en": "Relations. Bound by handover to the senior duty line of the same living quarters. Sebastian Braun hands injured people moved first through a passage to Noah Davis. Noah checks their condition in the mobile medical car so convoy delays do not become missed frostbite care."
        },
        "stress": {
          "ko": "공포. 호송 전령 당직이 비면 용산의 배차·환적 인계가 끊기고, 서울 안의 급수·진료·물품 인계 상대에게 확인되지 않은 완료 기록이 넘어가는 것.",
          "en": "Fear. That the convoy courier duty post would stand empty, interrupting dispatch and transshipment handovers in Yongsan and passing unverified completion records to water-supply, medical-care and goods handover counterparts within Seoul."
        },
        "relationship": {
