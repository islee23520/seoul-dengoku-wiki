      {
        "id": "militia",
        "name": {
          "ko": "민병 교대·숙영 차단",
          "en": "Militia shifts and billeting refusal"
        },
        "rating": 60
      },
      {
        "id": "hearing",
        "name": {
          "ko": "증인 대질 진행",
          "en": "Witness confrontation"
        },
        "rating": 45
      }
    ],
    "traits": [
      {
        "id": "no-outside-encampments",
        "name": {
          "ko": "외부 숙영 거부",
          "en": "No Outside Encampments"
        },
        "description": {
          "ko": "기하겸은 외부 장교의 숙영과 지휘를 구원이 아니라 지역 수비의 통제 문제로 본다.",
          "en": "Gi Hagyeom sees outside officers' encampment and command as questions of local defense control rather than rescue."
        },
        "behavior": {
          "ko": "평의회 거부가 붙은 칸에서 외부 장교의 충전과 숙영을 막고 통과 요청은 기록한 뒤 돌려보낸다.",
          "en": "They block outside officers' charging and encampment under council-veto entries and record passage requests before turning them back."
        },
        "stress": {
          "ko": "교량 한 번의 개방이 보호구역 지정으로 이어질 우려가 있으면 분노를 드러내기보다 차단 조건을 유지하려 할 수 있다.",
          "en": "If opening the bridge once could lead to protection-zone designation, they may maintain blocking conditions rather than display anger."
        },
        "relationship": {
          "ko": "김보람의 펌프수비 지휘에는 교대를 맞추되 배우진과 류가온의 외부 진입 요구에는 거부선을 지킬 수 있다.",
          "en": "They may align shifts with Kim Boram's pump-defense command while maintaining refusal boundaries against Bae Ujin's and Ryu Gaon's outside-entry requests."
        },
        "effects": []
      },
      {
        "id": "mobilize-citizens-by-lottery",
        "name": {
          "ko": "시민 추첨 동원",
          "en": "Mobilize Citizens by Lottery"
        },
        "description": {
          "ko": "기하겸은 민병 동원을 외부 지휘자의 요구가 아니라 시민대표의 공개된 추첨 조건에 묶는다.",
          "en": "Gi Hagyeom ties militia mobilization to citizen representatives' public lottery conditions rather than outside commanders' demands."
        },
        "behavior": {
          "ko": "민병 동원은 시민대표의 낮 추첨으로만 열고 김보람의 펌프수비 교대와 맞춘다.",
          "en": "They initiate militia mobilization only through citizen representatives' daytime lottery and align it with Kim Boram's pump-defense shifts."
        },
        "stress": {
          "ko": "거부 조장이 반란 수괴로 기록될 우려가 커지면 개인 명령보다 시민 추첨과 공개 확인의 근거를 더 중시할 수 있다.",
          "en": "If the refusing squad leader risks being recorded as a rebellion ringleader, they may emphasize citizen lottery and public verification over personal orders."
        },
        "relationship": {
          "ko": "시민대표와 김보람에게 동원 절차의 공동 책임을 기대하며 말이 갈리는 경우 공개 확인을 선호할 수 있다.",
          "en": "They may expect citizen representatives and Kim Boram to share responsibility for mobilization procedures and favor public verification when accounts conflict."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "외부 장교의 숙영을 막고 시민 추첨으로 민병 교대를 연다. 조직과 거부 조건은 확인되지만 사격·전투 승리는 확인되지 않는다.",
      "en": "He blocks external officers’ billeting and uses citizen draws for militia shifts. Organization and refusal conditions are supported, not marksmanship or victories."
    },
