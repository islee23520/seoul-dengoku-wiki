    "skills": [
      {
        "id": "k280-patrol-signal-coordination",
        "name": {
          "ko": "순찰 신호 맞춤",
          "en": "Patrol signal coordination"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "k280-priority",
        "name": {
          "ko": "점검 규율",
          "en": "Inspection discipline"
        },
        "description": {
          "ko": "용모는 북문 순찰과 회랑 횃불을 맞추고 호송 시각을 옮긴다. 실무 순찰과 집단 지휘는 구분한다.",
          "en": "Yongmo aligns gate patrol with corridor torches and records escort times. Practical patrol work is distinct from group command."
        },
        "behavior": {
          "ko": "출격 전에 차륜 점검을 의무화하고, 무장 탑재는 상무와 감사의 공동 서명만 인정한다.",
          "en": "Office. Rank: assistant manager. Title: north gate patrol, duty officer of Gwon Doha. He made wheel checks mandatory before sorties and recognized arms loading only with the Elder's and the auditor's joint signature."
        },
        "stress": {
          "ko": "궤도기병이 사택 민병으로 흡수되어 기지가 병영이 되는 것.",
          "en": "Fear. That the rail cavalry would be absorbed into a residential militia and the base would become a barracks."
        },
        "relationship": {
          "ko": "권도하의 지휘로 북문을 돌고, 강태산과 회랑 횃불을 맞춘다. 장세화의 북부 호송 시각을 순찰 칠판에 옮긴다.",
          "en": "Relations. Rounded the north gate under Gwon Doha's command and matched the corridor torches with Kang Taesan. Moved Jang Sehwa's northern convoy hours onto the patrol chalkboard."
        },
        "effects": []
      },
      {
        "id": "k280-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 사원. 직함은 강남역 북문 순찰대, 권도하의 실무 담당자. 출격 전에 차륜 점검을 의무화하고, 무장 탑재는 상무와 감사의 공동 서명만 인정한다.",
          "en": "Office. Rank: assistant manager. Title: north gate patrol, duty officer of Gwon Doha. He made wheel checks mandatory before sorties and recognized arms loading only with the Elder's and the auditor's joint signature."
        },
        "stress": {
          "ko": "공포. 궤도기병이 사택 민병으로 흡수되어 기지가 병영이 되는 것.",
          "en": "Fear. That the rail cavalry would be absorbed into a residential militia and the base would become a barracks."
        },
        "relationship": {
          "ko": "관계. 권도하의 지휘로 북문을 돌고, 강태산과 회랑 횃불을 맞춘다. 장세화의 북부 호송 시각을 순찰 칠판에 옮긴다.",
          "en": "Relations. Rounded the north gate under Gwon Doha's command and matched the corridor torches with Kang Taesan. Moved Jang Sehwa's northern convoy hours onto the patrol chalkboard."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "용모는 북문 순찰과 회랑 횃불을 맞추고 호송 시각을 옮긴다. 실무 순찰과 집단 지휘는 구분한다.",
      "en": "Yongmo aligns gate patrol with corridor torches and records escort times. Practical patrol work is distinct from group command."
    },
