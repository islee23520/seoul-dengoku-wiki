    "traits": [
      {
        "id": "k302-priority",
        "name": {
          "ko": "정비 서명 필요",
          "en": "Requires maintenance signatures"
        },
        "description": {
          "ko": "소두감은 무기 발견 뒤 출고 스위치를 잠그고 연결기를 손본다. 배차 승인만으로 정비를 건너뛰는 것을 거부한다.",
          "en": "Sodugam locked the release switch after weapons were found and maintains couplers. Dispatch approval cannot replace maintenance."
        },
        "behavior": {
          "ko": "배차표와 정비 일지를 같은 칠판에 붙이고, 의료열차 우선권은 장세화의 부서 날인과 정비 서명이 함께 있을 때만 인정한다.",
          "en": "Office. Rank: convoy hand. Title: siding mechanic, duty officer of An Dohan. He pasted the dispatch sheet and the maintenance log on one chalkboard and honored the medical train's priority only when Jang Sehwa's departmental stamp and his maintenance signature stood together."
        },
        "stress": {
          "ko": "정비 안 된 칸이 의료열차로 나가 신내운수가 창동과 암사 사이 하역장으로 떨어지는 것.",
          "en": "Fear. That an unmaintained car would go out as a medical train and the transfer city would fall into a freight yard between Changdong and Amsa."
        },
        "relationship": {
          "ko": "안도한의 배차 실무를 유치선에서 받고, 국소의 기지 당직과 공구를 나눈다. 이홍원의 북부 차륜 교환 시각에 맞춰 연결기를 손본다.",
          "en": "Relations. Received An Dohan's dispatch work at the siding and shared the depot duty and tools with Guk So. Tuned the couplers to I Hongwon's northern wheel-exchange hours."
        },
        "effects": []
      },
      {
        "id": "k302-accountability",
        "name": {
          "ko": "절차를 통한 책임",
          "en": "Procedural accountability"
        },
        "description": {
          "ko": "확인·기록·입회 조건으로 맡은 업무의 책임을 남긴다.",
          "en": "Makes responsibility traceable through the documented checks, records, and attendance conditions."
        },
        "behavior": {
          "ko": "관직. 품계 호송원. 직함은 유치선 정비사, 안도한의 실무 담당자. 배차표와 정비 일지를 같은 칠판에 붙이고, 의료열차 우선권은 장세화의 부서 날인과 정비 서명이 함께 있을 때만 인정한다.",
          "en": "Office. Rank: convoy hand. Title: siding mechanic, duty officer of An Dohan. He pasted the dispatch sheet and the maintenance log on one chalkboard and honored the medical train's priority only when Jang Sehwa's departmental stamp and his maintenance signature stood together."
        },
        "stress": {
          "ko": "공포. 정비 안 된 칸이 의료열차로 나가 신내운수가 창동과 암사 사이 하역장으로 떨어지는 것.",
          "en": "Fear. That an unmaintained car would go out as a medical train and the transfer city would fall into a freight yard between Changdong and Amsa."
        },
        "relationship": {
          "ko": "관계. 안도한의 배차 실무를 유치선에서 받고, 국소의 기지 당직과 공구를 나눈다. 이홍원의 북부 차륜 교환 시각에 맞춰 연결기를 손본다.",
          "en": "Relations. Received An Dohan's dispatch work at the siding and shared the depot duty and tools with Guk So. Tuned the couplers to I Hongwon's northern wheel-exchange hours."
        },
        "effects": []
      }
    ],
