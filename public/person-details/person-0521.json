      {
        "id": "k521-action-priority",
        "name": {
          "ko": "화물보다 장부",
          "en": "Registers before cargo"
        },
        "description": {
          "ko": "2125년 호송 도중 습격을 만나 화물보다 인명 장부부터 챙겼다.",
          "en": "In 2125, meeting a raid mid-convoy, he secured the roster of lives before the freight. By this deed the signature of the work-squad courier post rose into the ledger."
        },
        "behavior": {
          "ko": "2125년 호송 도중 습격을 만나 화물보다 인명 장부부터 챙겼다.",
          "en": "In 2125, meeting a raid mid-convoy, he secured the roster of lives before the freight. By this deed the signature of the work-squad courier post rose into the ledger."
        },
        "stress": {
          "ko": "작업반 전령 당직이 비면 규격맹의 통행이 강국 볼모가 되는 것.",
          "en": "That the work-squad courier duty post would stand empty and the Alliance's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "같은 생활권 선배 당직과 인수인계로 묶인다.",
          "en": "Bound by handover to the senior duty line of the same living quarters."
        },
        "effects": []
      },
