    "skills": [
      {
        "id": "assembly",
        "name": {
          "ko": "조립기록 교차검증",
          "en": "Assembly-record cross-checking"
        },
        "rating": 65
      },
      {
        "id": "seal",
        "name": {
          "ko": "봉인·사본 대조",
          "en": "Seal and copy comparison"
        },
        "rating": 50
      }
    ],
    "traits": [
      {
        "id": "no-assembly-gaps",
        "name": {
          "ko": "조립 공백 거부",
          "en": "No Assembly Gaps"
        },
        "description": {
          "ko": "제하율은 마지막 조립 기록의 빈칸을 공방의 판단 근거를 훼손하는 결함으로 여긴다.",
          "en": "Je Hayul regards gaps in final assembly records as defects that undermine the workshops' basis for judgment."
        },
        "behavior": {
          "ko": "날짜를 대조하고 정가온의 유언 원장을 조립 기록과 교차검증하며 위조 사본 대신 원본 칸을 지킨다.",
          "en": "They compare dates, cross-check Jeong Gaon's will ledger against assembly records, and protect original entries rather than forged copies."
        },
        "stress": {
          "ko": "가문 쪽 유언이 인준될 가능성이 커지면 조립 기록이 하청 장부로 격하되지 않도록 대조 근거를 더 엄격히 챙길 수 있다.",
          "en": "If the family-aligned will appears likely to gain approval, they may scrutinize cross-checks to prevent assembly records becoming subordinate ledgers."
        },
        "relationship": {
          "ko": "정가온과는 기록 대조를 협력의 기준으로 삼고 박세린과의 해석 경쟁에서도 날짜와 조립 근거를 요구할 수 있다.",
          "en": "They may ground cooperation with Jeong Gaon and interpretive disputes with Park Serin in dates and assembly evidence."
        },
        "effects": []
      },
      {
        "id": "distrust-uncountersigned-deputies",
        "name": {
          "ko": "연서 없는 대행 불신",
          "en": "Distrust Uncountersigned Deputies"
        },
        "description": {
          "ko": "제하율은 총관의 공백을 혈통이나 단독 날인으로 메우는 대행보다 공방대표의 연서를 신뢰한다.",
          "en": "Je Hayul trusts workshop representatives' countersignatures over deputies installed through lineage or a sole stamp."
        },
        "behavior": {
          "ko": "기술총관의 빈 도장은 대표 연서로만 대행한다고 원장에 명시하고 공동통치안을 현장 숫자로 뒷받침한다.",
          "en": "They specify that representatives' countersignatures alone may substitute for the technical superintendent's absent stamp and support joint governance with field figures."
        },
        "stress": {
          "ko": "세습 인준이 공방 동의를 대체하려 한다면 대행의 서명 조건을 더 엄격히 확인할 수 있다.",
          "en": "If hereditary approval threatens to replace workshop consent, they may check deputy signature requirements more strictly."
        },
        "relationship": {
          "ko": "한소미의 공동통치안에는 기록으로 협력하되 가문 원장만으로 대행을 정당화하려는 상대와는 충돌할 수 있다.",
          "en": "They may support Han Somi's joint-governance plan through records while clashing with anyone who justifies deputies through family ledgers alone."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "조립기록과 유언 원장을 교차검증하고 공방 연서를 요구한다. 기록 운영에 한정하고 정치 지도자의 군정 능력은 복사하지 않는다.",
      "en": "She cross-checks assembly records and wills and requires workshop signatures. Record management is supported, not borrowed military administration."
    },
