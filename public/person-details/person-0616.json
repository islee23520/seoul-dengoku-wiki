    "traits": [
      {
        "id": "k616-action-priority",
        "name": {
          "ko": "합계 옆의 압력",
          "en": "Pressure beside totals"
        },
        "description": {
          "ko": "배급 합계는 맞는데 골목마다 물줄기가 가늘다는 말이 당직에 들어온다. 성달현은 급수 배분 당직을 돌며 수도꼭지마다 나오는 압력을 합계 옆 칸에 적고, 합계와 압력이 어긋나는 골목에 표시를 달아 이서담에게 먼저 보인다.",
          "en": "Word reaches the duty desk that the ration totals balance yet the water runs thin in alley after alley. Seong Dalhyeon walks the water-distribution duty round, writes the pressure at each tap beside the totals, marks the alleys where totals and pressure disagree, and shows them to I Seodam first."
        },
        "behavior": {
          "ko": "배급 합계는 맞는데 골목마다 물줄기가 가늘다는 말이 당직에 들어온다. 성달현은 급수 배분 당직을 돌며 수도꼭지마다 나오는 압력을 합계 옆 칸에 적고, 합계와 압력이 어긋나는 골목에 표시를 달아 이서담에게 먼저 보인다.",
          "en": "Word reaches the duty desk that the ration totals balance yet the water runs thin in alley after alley. Seong Dalhyeon walks the water-distribution duty round, writes the pressure at each tap beside the totals, marks the alleys where totals and pressure disagree, and shows them to I Seodam first."
        },
        "stress": {
          "ko": "배급구역 서기 당직이 비면 수문국의 통행이 강국 볼모가 되는 것.",
          "en": "That the ration district clerk duty post would stand empty and the Compact's passage would become a hostage of the great powers."
        },
        "relationship": {
          "ko": "이서담의 배급구역 서기로 일하며 급수 배분 당직을 맡는다.",
          "en": "Serves as a ration clerk under I Seodam and manages the water allocation shift."
        },
        "effects": []
      },
      {
        "id": "k616-bounded-handover",
        "name": {
          "ko": "기록으로 잇는 당직",
          "en": "Duty linked by records"
        },
        "description": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
        },
        "behavior": {
          "ko": "열쇠와 기록을 다음 당직에 넘기며 권한을 늘리지 않는다.",
          "en": "Passes keys and records to the next shift without enlarging authority."
