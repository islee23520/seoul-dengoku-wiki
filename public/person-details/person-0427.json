    "skills": [
      {
        "id": "guard",
        "name": {
          "ko": "출입 저지·암호패 교체",
          "en": "Entry control and pass replacement"
        },
        "rating": 55
      },
      {
        "id": "handover",
        "name": {
          "ko": "기록·열쇠 인수인계",
          "en": "Record and key handover"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "stop-unauthorized-intruders",
        "name": {
          "ko": "무단 침입자 저지",
          "en": "Stop Unauthorized Intruders"
        },
        "description": {
          "ko": "정예은은 확인된 야간 무단 도하 사례에서 경계 침범을 넘기지 않은 태도를 보였다.",
          "en": "Jeong Yeeun showed unwillingness to overlook a boundary breach in the documented nighttime unauthorized-crossing incident."
        },
        "behavior": {
          "ko": "야간 무단 도하자를 붙잡은 뒤 경비 암호패를 교체했다.",
          "en": "They caught an unauthorized nighttime crosser and then replaced the security code token."
        },
        "stress": {
          "ko": "당직 공백이 통행을 외부 세력의 볼모로 만들 우려가 있으면 경계의 연속성을 더 중시할 수 있다.",
          "en": "If a duty gap threatens to leave passage hostage to outside powers, they may place greater weight on continuous watch."
        },
        "relationship": {
          "ko": "선배 당직과의 인수인계에서는 확인한 침입과 교체한 암호패를 기록으로 전달하려 할 수 있다.",
          "en": "In handovers with the senior duty holder, they may seek to document the confirmed intrusion and replaced code token."
        },
        "effects": []
      },
      {
        "id": "replace-code-tokens-immediately",
        "name": {
          "ko": "암호패 즉시 교체",
          "en": "Replace Code Tokens Immediately"
        },
        "description": {
          "ko": "정예은은 확인된 침입 뒤 기존 경비 암호패를 그대로 두지 않는 대응을 보였다.",
          "en": "Jeong Yeeun showed a response of not leaving the existing security code token unchanged after a confirmed intrusion."
        },
        "behavior": {
          "ko": "무단 도하자를 붙잡은 사건에서 경비 암호패를 갈아 후속 경계 조치를 취했다.",
          "en": "In the unauthorized-crossing incident, they replaced the security code token as a follow-up security measure."
        },
        "stress": {
          "ko": "통행이 당직 공백 때문에 외부 통제에 놓일 우려가 커지면 암호패 갱신과 인계 누락을 더 경계할 수 있다.",
          "en": "If duty gaps risk placing passage under outside control, they may be more wary of missed token updates and handovers."
        },
        "relationship": {
          "ko": "선배 당직에게 새 암호패와 관련 기록을 자기 직위의 인계 범위 안에서 정확히 넘기려 할 수 있다.",
          "en": "They may seek to pass the new token and related records accurately to the senior duty holder within their role's handover limits."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "야간 무단 도하자를 붙잡고 암호패를 바꿨다. 경비 수행은 확인되지만 부대 지휘나 무장 보유는 근거가 없다.",
      "en": "She caught an unauthorized night crosser and replaced passes. Guard work is supported, not unit command or weapon ownership."
    },
