    "skills": [
      {
        "id": "save-register",
        "name": {
          "ko": "위기 인명 장부 보존",
          "en": "Emergency preservation of personnel registers"
        },
        "rating": 45
      },
      {
        "id": "departure",
        "name": {
          "ko": "배차표·출발 확인",
          "en": "Departure and dispatch checks"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "people-records-despite-attacks",
        "name": {
          "ko": "습격에도 인명 기록",
          "en": "People Records Despite Attacks"
        },
        "description": {
          "ko": "배금원은 호송 습격 중 화물보다 인명 장부를 우선한 사람이다.",
          "en": "Bae Geumwon prioritized the people register over cargo during an attack on a convoy."
        },
        "behavior": {
          "ko": "호송 도중 습격을 만났을 때 화물보다 인명 장부부터 챙겼다.",
          "en": "When the convoy was attacked, they secured the people register before the cargo."
        },
        "stress": {
          "ko": "습격으로 기록과 통행이 함께 위태로워지면 인명 장부의 보존을 우선할 수 있다.",
          "en": "If an attack endangers both records and passage, they may prioritize preserving the people register."
        },
        "relationship": {
          "ko": "호송이나 인계의 우선순위를 함께 정해야 한다면 화물보다 인명 기록을 앞세울 수 있다.",
          "en": "When agreeing on convoy or handover priorities, they may place people records ahead of cargo."
        },
        "effects": []
      },
      {
        "id": "block-unmarked-departures",
        "name": {
          "ko": "무표 출발 저지",
          "en": "Block Unmarked Departures"
        },
        "description": {
          "ko": "배금원의 무표 출발 저지는 제공된 서술에 제시된 기록 근거 중시 성향으로 한정된다.",
          "en": "Bae Geumwon's blocking of unmarked departures is limited to the supplied narrative's emphasis on documented grounds."
        },
        "behavior": {
          "ko": "제공된 서술은 출발 저지를 언급하지만 표식 확인이나 정지 절차의 세부는 제시하지 않는다.",
          "en": "The supplied narrative mentions stopping departures but gives no details of marker checks or stopping procedures."
        },
        "stress": {
          "ko": "기록 없는 이동이 통행의 종속 위험을 키운다고 판단하면 출발을 보류하려 할 수 있다.",
          "en": "If they judge undocumented movement to increase the risk of compromised passage, they may seek to hold departure."
        },
        "relationship": {
          "ko": "출발을 두고 의견이 갈린다면 없는 권한을 주장하기보다 기록 근거를 요구할 수 있다.",
          "en": "If departure becomes disputed, they may ask for documentary grounds rather than claim authority they lack."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "호송 습격 때 인명 장부를 선택했다. 생애의 출발 저지와 함께 기록 보호를 평가하지만 전투 경력으로 환산하지 않는다.",
      "en": "He chose personnel registers during a convoy attack. Alongside the departure stop in his life record, this supports record protection, not a combat career."
    },
