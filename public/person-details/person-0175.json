    "traits": [
      {
        "id": "k174-disposition",
        "name": {
          "ko": "양편에 거래함",
          "en": "Trading with both sides"
        },
        "description": {
          "ko": "대담하고 기회에 빠르다. 가문의 이름을 방패로 쓰면서도 조정관의 배차표를 빈칸처럼 다룬다.",
          "en": "Bold and quick on opportunity. She used the house's name as a shield while treating the Coordinator's dispatch sheet like a blank."
        },
        "behavior": {
          "ko": "관직. 품계 주사. 직함은 선로 가문 배차원. 가문 칸과 공공 칸의 배차를 섞어 놓고, 막판에 전환기로 이익이 큰 쪽을 연다.",
          "en": "Office. Rank: registrar. Title: track house dispatcher. She mixed the dispatches of the house columns and the public columns and, at the last moment, opened whichever side the profit favored."
        },
        "stress": {
          "ko": "공포. 양편을 걸다 들켜 선로 봉쇄대의 인질로 남는 것.",
          "en": "Fear. That betting on both sides would be caught and she would remain a hostage of the track blockade."
        },
        "relationship": {
          "ko": "관계. 알렉산더 밀러의 지휘를 받지만 박태겸에게 가문 동향을 팔아 빚을 졌다. 조우찬에게 창동 시험 차륜을 빼돌린 의혹이 있다.",
          "en": "Relations. Took Alexander Miller's command but sold the house's movements to Park Taegyeom and fell into debt. Carried the suspicion of having spirited out Jo Woochan's Changdong trial wheels."
        },
        "effects": []
      },
      {
        "id": "k174-choice",
        "name": {
          "ko": "막판 이익 선택",
          "en": "Last-minute profit choice"
        },
        "description": {
          "ko": "일화. 억류 열차의 전환기 키가 가문 금고와 조정관실에 하나씩 있다는 소문이 배차판에 붙었다.",
          "en": "Anecdote. A rumor was pasted on the dispatch board: one key of the detained train's switch lay in the house vault, one in the Coordinator's office."
        },
        "behavior": {
          "ko": "관계. 알렉산더 밀러의 지휘를 받지만 박태겸에게 가문 동향을 팔아 빚을 졌다. 조우찬에게 창동 시험 차륜을 빼돌린 의혹이 있다.",
          "en": "Relations. Took Alexander Miller's command but sold the house's movements to Park Taegyeom and fell into debt. Carried the suspicion of having spirited out Jo Woochan's Changdong trial wheels."
        },
        "stress": {
          "ko": "공포. 양편을 걸다 들켜 선로 봉쇄대의 인질로 남는 것.",
          "en": "Fear. That betting on both sides would be caught and she would remain a hostage of the track blockade."
        },
        "relationship": {
          "ko": "관계. 알렉산더 밀러의 지휘를 받지만 박태겸에게 가문 동향을 팔아 빚을 졌다. 조우찬에게 창동 시험 차륜을 빼돌린 의혹이 있다.",
          "en": "Relations. Took Alexander Miller's command but sold the house's movements to Park Taegyeom and fell into debt. Carried the suspicion of having spirited out Jo Woochan's Changdong trial wheels."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "가문 지휘 아래서 동향을 조정관에게 팔고 이익이 큰 쪽으로 전환기를 연다. 차륜 유출은 의혹으로 남겨 실제 숙련으로 계산하지 않았다.",
      "en": "She sells house information to the coordinator and switches toward the greater profit. Suspected wheel diversion is not counted as a performed skill."
    },
