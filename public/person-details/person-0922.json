    "skills": [
      {
        "id": "hearing",
        "name": {
          "ko": "증인 대질 진행",
          "en": "Witness confrontation"
        },
        "rating": 45
      },
      {
        "id": "handover",
        "name": {
          "ko": "기록·열쇠 인수인계",
          "en": "Record and key handover"
        },
        "rating": 40
      }
    ],
    "traits": [
      {
        "id": "confront-conflicting-accounts",
        "name": {
          "ko": "엇갈린 말 대질",
          "en": "Confront Conflicting Accounts"
        },
        "description": {
          "ko": "노하호는 증언이 갈릴 때 공개적으로 서로 맞대어 확인하는 쪽이다.",
          "en": "No Haho responds to conflicting testimony by bringing the accounts together for public examination."
        },
        "behavior": {
          "ko": "두 증인의 말이 갈라지자 공개 대질을 열었다.",
          "en": "They arranged a public confrontation when two witnesses' accounts diverged."
        },
        "stress": {
          "ko": "상반된 증언이 확인을 막는다면 공개 대질로 쟁점을 드러내려 할 수 있다.",
          "en": "If contradictory testimony obstructs verification, they may seek to expose the disputed points through public confrontation."
        },
        "relationship": {
          "ko": "말이 엇갈리는 두 사람 사이에서는 한쪽 말만 따르기보다 함께 확인하는 자리를 마련할 수 있다.",
          "en": "Between two people giving conflicting accounts, they may arrange joint examination rather than simply accept one side."
        },
        "effects": []
      },
      {
        "id": "trust-duty-records",
        "name": {
          "ko": "당직 기록 신뢰",
          "en": "Trust Duty Records"
        },
        "description": {
          "ko": "노하호는 큰소리보다 장부 기록을 믿고 당직의 연속성을 중시한다.",
          "en": "No Haho trusts register entries over loud assertions and values continuous duty coverage."
        },
        "behavior": {
          "ko": "자기 직위의 기록을 인계하고 상반된 말은 공개 대질로 확인한다.",
          "en": "They hand over their position's records and examine conflicting accounts through public confrontation."
        },
        "stress": {
          "ko": "당직 공백이 통행을 위태롭게 할 우려가 있으면 말의 강도보다 남은 기록을 더 중시할 수 있다.",
          "en": "If a vacant shift threatens passage, they may give surviving records more weight than forceful claims."
        },
        "relationship": {
          "ko": "선배 당직과 인계 내용을 확인할 때 장부를 공통 기준으로 삼을 수 있다.",
          "en": "When checking handover contents with a senior duty colleague, they may use the register as a common standard."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "두 증인의 공개 대질을 열었다. 사람 사이 확인의 근거는 있으나 수질 계측을 실제로 수행한 장면은 없다.",
      "en": "She opened a public confrontation between two witnesses. Interpersonal verification is supported; actual water measurement is not shown."
    },
