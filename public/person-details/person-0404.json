    "skills": [
      {
        "id": "voter-register-control",
        "name": {
          "ko": "투표 명부 관리",
          "en": "Voter register control"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "대표성과 보호를 구분",
          "en": "Distinguishes representation from exposure"
        },
        "description": {
          "ko": "명부와 출석을 공개하되 인질 명부 유출 때 가족 칸을 지웠다. 서식과 감사표가 와야 비준 투표를 연다.",
          "en": "Publishes voter lists and attendance but deletes family fields after a hostage-list leak. Opens ratification voting only after forms and audits arrive."
        },
        "behavior": {
          "ko": "확인된 선택에서는 대표성과 보호를 구분을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "호적 혼입 때 투표를 늦출 수 있다.",
          "en": "May delay voting when military registers mix into lists."
        },
        "relationship": {
          "ko": "하서진과 곽은재의 자료를 기다리며 백온의 시민권 명부를 참고한다.",
          "en": "Waits for Ha Seojin’s and Gwak Eunjae’s documents and consults Baek On’s citizenship list."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "조합원 직접투표가 대외 교섭안 비준의 필수 날인이 되게 해 조합원 투표 없는 서명을 무효로 만든다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "투표 명부가 군사호적과 섞여 정동노총이 암사의 대리 투표장이 되는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "하서진과 곽은재의 자료를 기다리며 백온의 시민권 명부를 참고한다.",
          "en": "Waits for Ha Seojin’s and Gwak Eunjae’s documents and consults Baek On’s citizenship list."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "명부와 출석을 공개하되 인질 명부 유출 때 가족 칸을 지웠다. 서식과 감사표가 와야 비준 투표를 연다.",
      "en": "Publishes voter lists and attendance but deletes family fields after a hostage-list leak. Opens ratification voting only after forms and audits arrive."
    },
