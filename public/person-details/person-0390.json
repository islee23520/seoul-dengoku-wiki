    "skills": [
      {
        "id": "power-allocation",
        "name": {
          "ko": "전력 배분",
          "en": "Power allocation"
        },
        "rating": 65
      }
    ],
    "traits": [
      {
        "id": "evidenced-choice",
        "name": {
          "ko": "은폐 배전 거부",
          "en": "Rejects concealed power allocation"
        },
        "description": {
          "ko": "정전 때 시민 배급 칸에 발전을 배정하고 군량 조명을 껐다. 출력을 조정해 왔으나 은폐 배전은 거부했다.",
          "en": "Assigns emergency power to civilian rations and shuts off military lighting during a blackout. Coordinates output but refuses concealed distribution."
        },
        "behavior": {
          "ko": "확인된 선택에서는 은폐 배전 거부을 드러낸다. 다른 상황까지 불변 성향으로 확정하지 않는다.",
          "en": "The recorded choice shows this disposition within its context; it is not established for every situation."
        },
        "stress": {
          "ko": "정전과 봉쇄가 겹치면 공급 우선순위를 좁힐 수 있다.",
          "en": "May narrow supply priorities when blockade and blackout coincide."
        },
        "relationship": {
          "ko": "판효담의 기지와 천솔빛의 광장 사이에서 출력을 나눈다.",
          "en": "Divides output between Pan Hyodam’s base and Cheon Solbit’s square."
        },
        "effects": []
      },
      {
        "id": "handover-continuity",
        "name": {
          "ko": "기록 단절 경계",
          "en": "Concern for record continuity"
        },
        "description": {
          "ko": "사제단 소집 봉인을 지켜 다음 대주교 비밀 선거의 절차와 명동역 인준이 끊기지 않게 한다.",
          "en": "Seeks continuity of the specific records entrusted to this person, rather than new authority."
        },
        "behavior": {
          "ko": "맡은 기록과 서명의 연결을 확인하려 한다.",
          "en": "Seeks to check the continuity of assigned records and signatures."
        },
        "stress": {
          "ko": "사제단 소집 봉인이 지워져 교황 없는 선출의 정당성 논쟁에서 자신의 서명이 의심받는 것.",
          "en": "Loss of the assigned records or a blocked handover may heighten concern about accountability."
        },
        "relationship": {
          "ko": "판효담의 기지와 천솔빛의 광장 사이에서 출력을 나눈다.",
          "en": "Divides output between Pan Hyodam’s base and Cheon Solbit’s square."
        },
        "effects": []
      }
    ],
    "narrative": {
      "ko": "정전 때 시민 배급 칸에 발전을 배정하고 군량 조명을 껐다. 출력을 조정해 왔으나 은폐 배전은 거부했다.",
      "en": "Assigns emergency power to civilian rations and shuts off military lighting during a blackout. Coordinates output but refuses concealed distribution."
    },
