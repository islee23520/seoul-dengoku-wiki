{
  "name": "seoul-dengoku-wiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "node scripts/generate-catalog.mjs && node scripts/generate-clan-crests.mjs",
    "build": "npm run generate && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run generate && vitest run",
    "test:links": "node scripts/check-links.mjs",
    "test:lore-links": "vitest run scripts/test-lore-links.mjs",
    "test:contract": "node scripts/check-contract.mjs",
    "test:artifacts": "vitest run scripts/test-artifact-allowlist.mjs",
    "check:artifacts": "node scripts/check-artifact-allowlist.mjs",
    "test:admission": "vitest run scripts/test-catalog-admission.mjs",
    "test:gate": "vitest run scripts/test-gate.mjs",
    "test:naming-ledger": "vitest run scripts/test-naming-ledger-sources.mjs",
    "test:states": "vitest run scripts/test-state-routes.mjs",
    "test:legacy-routes": "vitest run scripts/test-legacy-world-routes.mjs",
    "test:region-routes": "vitest run scripts/test-region-routes.mjs",
    "test:assets": "vitest run scripts/test-wiki-assets.mjs",
    "test:people": "vitest run scripts/test-people-index.mjs",
    "test:person-details": "vitest run scripts/test-person-details.mjs",
    "test:discovery": "vitest run scripts/test-discovery-index.mjs",
    "test:categories": "vitest run scripts/test-category-registration.mjs",
    "test:territory-map": "vitest run scripts/test-territory-map.mjs",
    "test:updates": "npm run generate && vitest run scripts/test-update-history.mjs",
    "test:timeline": "vitest run scripts/test-timeline-overview.mjs",
    "test:lore-render": "vitest run scripts/test-lore-json-render.mjs",
    "test:lore-json": "vitest run scripts/test-lore-json-validate.mjs",
    "test:glossary": "vitest run scripts/test-glossary-document.mjs",
    "test:document-renderer": "vitest run scripts/test-document-renderer.mjs",
    "test:json-locale-routes": "vitest run scripts/test-json-locale-routes.mjs",
    "test:common-tiers": "vitest run scripts/test-common-tiers.mjs",
    "test:atlas": "vitest run scripts/test-world-atlas.mjs",
    "test:person-id": "vitest run lore/name-pools/verify-person-id-candidates.mjs lore/name-pools/verify-person-id-registry.mjs",
    "test:mongo-load": "vitest run scripts/test-mongo-load.mjs",
    "test:gurps": "vitest run scripts/test-gurps-cast.mjs",
    "test:crests": "vitest run scripts/test-clan-crests.mjs",
    "test:families": "vitest run scripts/test-family-catalog.mjs",
    "test:crests": "vitest run scripts/test-clan-crests.mjs",
    "test:families": "vitest run scripts/test-family-catalog.mjs",
    "db:load": "node scripts/mongo-load.mjs"
  },
  "dependencies": {
    "@seoul-dengoku/publication-manifest": "file:./vendor/seoul-dengoku-publication-manifest-0.1.0.tgz",
    "@seoul-dengoku/document-renderer": "file:./vendor/seoul-dengoku-document-renderer-0.1.2.tgz",
    "@seoul-dengoku/shared-web-ui": "file:./vendor/seoul-dengoku-shared-web-ui-0.1.2.tgz",
    "mermaid": "^11.17.2",
    "proj4": "2.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "mongodb": "^7.6.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^8.3.0",
    "vitest": "5.0.2"
  }
}
