{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seoul-dengoku.linalab.io/lore/name-pools/authoring.schema.json",
  "allOf": [
    {
      "$ref": "../authoring.shared.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "properties": {
        "domain": {
          "const": "name-pools"
        },
        "id": {
          "type": "string",
          "pattern": "^(?:__EXAMPLE__:name-pools|DOC:[A-Za-z0-9-]+)$"
        },
        "data": {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    {"if": {"properties": {"id": {"pattern": "^(?:DOC:|__EXAMPLE__)"}}}, "else": {"properties": {"data": {"required": ["entries"]}}}}
  ]
}
